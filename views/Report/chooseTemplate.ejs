
<!-- ============================================================ -->
<!-- FILE 2: views/report/chooseTemplate.ejs                      -->
<!-- Shown when BOTH doctor + test-default templates exist        -->
<!-- ============================================================ -->
<style>
    .ct-wrap        { height:100vh; display:flex; flex-direction:column; overflow:hidden; }
    .ct-bar         { height:52px; background:#185FA5; display:flex; align-items:center;
                      justify-content:space-between; padding:0 20px; flex-shrink:0; }
    .ct-bar-title   { color:#fff; font-size:14px; font-weight:600; }
    .ct-bar-sub     { color:rgba(255,255,255,.65); font-size:12px; margin-top:1px; }
    .ct-bar-blank   { display:flex; align-items:center; gap:6px; padding:7px 14px;
                      border-radius:7px; border:1px solid rgba(255,255,255,.3);
                      background:rgba(255,255,255,.1); color:#fff; font-size:12px;
                      font-weight:600; cursor:pointer; text-decoration:none; }
    .ct-body        { flex:1; overflow-y:auto; padding:20px; display:flex;
                      flex-direction:column; gap:16px; }
    .ct-hint        { background:#E6F1FB; border:1px solid #B5D4F4; border-radius:10px;
                      padding:12px 16px; font-size:13px; color:#0C447C;
                      display:flex; align-items:center; gap:8px; }
    .ct-grid        { display:grid; grid-template-columns:1fr 1fr; gap:16px; flex:1; min-height:0; }
    @media(max-width:768px) { .ct-grid { grid-template-columns:1fr; } }
    .ct-card        { background:#fff; border:1.5px solid #e2e8f0; border-radius:12px;
                      overflow:hidden; display:flex; flex-direction:column; }
    .ct-card:hover  { border-color:#185FA5; }
    .ct-card-head   { padding:14px 18px 12px; border-bottom:1px solid #f1f5f9; background:#f8f9fb; }
    .ct-card-type   { font-size:10px; font-weight:700; text-transform:uppercase;
                      letter-spacing:.07em; margin-bottom:4px; }
    .ct-card-type.doctor { color:#534AB7; }
    .ct-card-type.test   { color:#3B6D11;  }
    .ct-card-name   { font-size:14px; font-weight:600; color:#111; }
    .ct-card-meta   { font-size:11px; color:#888; margin-top:3px;
                      display:flex; gap:10px; flex-wrap:wrap; }
    .ct-preview     { flex:1; overflow-y:auto; padding:14px 18px;
                      font-size:12px; line-height:1.7; color:#444;
                      max-height:420px; }
    .ct-card-foot   { padding:12px 18px; border-top:1px solid #f1f5f9;
                      display:flex; gap:8px; justify-content:flex-end; }
    .ct-choose-btn  { padding:8px 20px; border-radius:8px; font-size:13px;
                      font-weight:600; border:none; cursor:pointer;
                      display:flex; align-items:center; gap:6px; }
    .ct-choose-btn.primary { background:#185FA5; color:#fff; }
    .ct-choose-btn.primary:hover { background:#0C447C; }
    .ct-choose-btn.outline { background:#fff; color:#185FA5;
                              border:1px solid #B5D4F4; }
    .ct-choose-btn.outline:hover { background:#E6F1FB; }
    </style>
    
    <div class="ct-wrap">
    
      <%# ── Top bar ── %>
      <div class="ct-bar">
        <div>
          <div class="ct-bar-title">
            <%= context.Title %> <%= context.Name %> &mdash; <%= context.TestName %>
          </div>
          <div class="ct-bar-sub">
            <%= context.age %> &nbsp;·&nbsp; <%= context.gender %> &nbsp;·&nbsp; <%= context.registeredOn %>
          </div>
        </div>
        <%# Blank editor option %>
        <form method="POST" action="/report/useTemplate" style="margin:0">
          <input type="hidden" name="patientId"  value="<%= patientId %>">
          <input type="hidden" name="testId"     value="<%= testId %>">
          <input type="hidden" name="templateId" value="">
          <button type="submit" class="ct-bar-blank">
            <i class="bi bi-file-earmark-plus"></i> Start Blank
          </button>
        </form>
      </div>
    
      <%# ── Body ── %>
      <div class="ct-body">
    
        <div class="ct-hint">
          <i class="bi bi-info-circle-fill" style="font-size:16px;flex-shrink:0"></i>
          Two templates are available for this test. Preview both and choose one to open in the editor.
        </div>
    
        <div class="ct-grid">
    
          <%# ── Doctor Template ── %>
          <div class="ct-card">
            <div class="ct-card-head">
              <div class="ct-card-type doctor">
                <i class="bi bi-person-badge"></i> Doctor Template
              </div>
              <div class="ct-card-name"><%= doctorTemplate.Name %></div>
              <div class="ct-card-meta">
                <span>
                  <% if(doctorTemplate.TestId) { %>
                    <i class="bi bi-check-circle-fill" style="color:#27500A"></i> Specific to this test
                  <% } else { %>
                    <i class="bi bi-circle" style="color:#888"></i> Doctor default
                  <% } %>
                </span>
                <span>
                  <i class="bi bi-gender-ambiguous"></i>
                  <%= doctorTemplate.GenderType.charAt(0).toUpperCase() + doctorTemplate.GenderType.slice(1) %>
                </span>
              </div>
            </div>
            <div class="ct-preview">
              <%- doctorTemplate.ContentFilled %>
            </div>
            <div class="ct-card-foot">
              <form method="POST" action="/report/useTemplate" style="margin:0">
                <input type="hidden" name="patientId"  value="<%= patientId %>">
                <input type="hidden" name="testId"     value="<%= testId %>">
                <input type="hidden" name="templateId" value="<%= doctorTemplate.Id %>">
                <button type="submit" class="ct-choose-btn primary">
                  <i class="bi bi-check2"></i> Use This Template
                </button>
              </form>
            </div>
          </div>
    
          <%# ── Test Default Template ── %>
          <div class="ct-card">
            <div class="ct-card-head">
              <div class="ct-card-type test">
                <i class="bi bi-clipboard2-pulse"></i> Test Default Template
              </div>
              <div class="ct-card-name"><%= testTemplate.Name %></div>
              <div class="ct-card-meta">
                <span>
                  <i class="bi bi-circle" style="color:#888"></i> System default for this test
                </span>
                <span>
                  <i class="bi bi-gender-ambiguous"></i>
                  <%= testTemplate.GenderType.charAt(0).toUpperCase() + testTemplate.GenderType.slice(1) %>
                </span>
              </div>
            </div>
            <div class="ct-preview">
              <%- testTemplate.ContentFilled %>
            </div>
            <div class="ct-card-foot">
              <form method="POST" action="/report/useTemplate" style="margin:0">
                <input type="hidden" name="patientId"  value="<%= patientId %>">
                <input type="hidden" name="testId"     value="<%= testId %>">
                <input type="hidden" name="templateId" value="<%= testTemplate.Id %>">
                <button type="submit" class="ct-choose-btn outline">
                  <i class="bi bi-check2"></i> Use This Template
                </button>
              </form>
            </div>
          </div>
    
        </div><!-- .ct-grid -->
      </div><!-- .ct-body -->
    </div><!-- .ct-wrap -->
    