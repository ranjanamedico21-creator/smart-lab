// ── SAVE AS TEMPLATE ──────────────────────────────────────
function openSaveTemplateModal()  { document.getElementById('saveTemplateModal').classList.add('open'); }
function closeSaveTemplateModal() { document.getElementById('saveTemplateModal').classList.remove('open'); }
document.getElementById('saveTemplateModal').addEventListener('click', function(e) {
    if (e.target === this) closeSaveTemplateModal();
});

async function confirmSaveTemplate() {
    if (!editorInstance) return;
    var btn = document.getElementById('confirmSaveTemplateBtn');
    btn.disabled  = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';
    try {
        var res  = await fetch('/report/saveAsDefaultTemplate', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({
                testId:    TEST_ID,
                patientId: PATIENT_ID,
                content:   editorInstance.getData(),
            })
        });
        var data = await res.json();
        if (data.success) {
            closeSaveTemplateModal();
