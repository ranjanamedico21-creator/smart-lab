<style>
    :root {
      --brand:#185FA5; --brand-soft:#E6F1FB; --brand-text:#0C447C;
      --surface:#ffffff; --surface-alt:#F8F9FB;
      --border:rgba(0,0,0,0.08); --border-strong:rgba(0,0,0,0.14);
      --text-primary:#111827; --text-secondary:#6B7280; --text-hint:#9CA3AF;
      --radius-sm:6px; --radius-md:10px; --radius-lg:14px;
      --shadow-card:0 1px 4px rgba(0,0,0,0.06),0 0 0 0.5px rgba(0,0,0,0.08);
    }
    .rr-wrapper { padding:16px 0 40px; }
    .rr-card    { background:var(--surface); border-radius:var(--radius-lg); box-shadow:var(--shadow-card); overflow:hidden; margin-bottom:16px; }
    .rr-card-header { display:flex; align-items:center; justify-content:space-between; padding:18px 24px; border-bottom:1px solid var(--border); }
    .rr-header-left { display:flex; align-items:center; gap:12px; }
    .rr-header-icon { width:36px; height:36px; background:var(--brand-soft); border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; color:var(--brand); font-size:16px; flex-shrink:0; }
    .rr-header-title { font-size:15px; font-weight:600; color:var(--text-primary); margin:0; }
    .rr-header-sub   { font-size:12px; color:var(--text-secondary); margin:2px 0 0; }
    .rr-section { padding:24px; }
    .rr-grid { display:grid; grid-template-columns:1fr 1fr 1fr auto; gap:14px; align-items:flex-end; }
    .rr-field-label { font-size:11px; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:.06em; display:block; margin-bottom:6px; }
    .rr-input-wrap { display:flex; align-items:center; border:1px solid var(--border-strong); border-radius:var(--radius-sm); background:var(--surface); overflow:hidden; transition:border-color .15s; }
    .rr-input-wrap:focus-within { border-color:var(--brand); box-shadow:0 0 0 3px rgba(24,95,165,.1); }
    .rr-input-icon { padding:0 10px; color:var(--text-hint); font-size:13px; flex-shrink:0; }
    .rr-input-wrap input,
    .rr-input-wrap select { border:none; outline:none; background:transparent; font-size:13.5px; color:var(--text-primary); padding:9px 12px 9px 0; width:100%; font-family:inherit; }
    .rr-input-wrap select { appearance:none; cursor:pointer; }
    .rr-input-wrap input::placeholder { color:var(--text-hint); }
    .rr-btn { display:flex; align-items:center; gap:6px; padding:9px 22px; background:var(--brand); color:#fff; border:none; border-radius:var(--radius-sm); font-size:13.5px; font-weight:500; cursor:pointer; transition:background .15s; white-space:nowrap; }
    .rr-btn:hover { background:var(--brand-text); }
    .rr-info-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:24px; }
    .rr-info-card { background:var(--surface-alt); border:1px solid var(--border); border-radius:var(--radius-md); padding:14px 16px; }
    .rr-info-icon { font-size:20px; color:var(--brand); margin-bottom:8px; }
    .rr-info-title { font-size:12px; font-weight:600; color:var(--text-primary); margin-bottom:4px; }
    .rr-info-desc  { font-size:11.5px; color:var(--text-secondary); line-height:1.5; }
    @media(max-width:768px) {
      .rr-grid { grid-template-columns:1fr 1fr; }
      .rr-grid > *:last-child { grid-column:1/-1; }
      .rr-info-grid { grid-template-columns:1fr; }
    }
  </style>
  
  <div class="rr-wrapper">
    <div class="rr-card">
      <div class="rr-card-header">
        <div class="rr-header-left">
          <div class="rr-header-icon"><i class="bi bi-file-earmark-person"></i></div>
          <div>
            <p class="rr-header-title">Doctor Thanks Report</p>
            <p class="rr-header-sub">Patient-wise commission breakdown per referring doctor</p>
          </div>
        </div>
      </div>
  
      <div class="rr-section">
        <%- include("../partials/messages"); %>
  
        <form action="/report/referral/preview" method="post">
          <div class="rr-grid">
  
            <div>
              <label class="rr-field-label">From Date <span style="color:#A32D2D">*</span></label>
              <div class="rr-input-wrap">
                <span class="rr-input-icon"><i class="bi bi-calendar3"></i></span>
                <input type="text" id="FromDate" name="FromDate" placeholder="Select date"
                  value="<%= FromDate %>" autocomplete="off" required>
              </div>
            </div>
  
            <div>
              <label class="rr-field-label">To Date <span style="color:#A32D2D">*</span></label>
              <div class="rr-input-wrap">
                <span class="rr-input-icon"><i class="bi bi-calendar3"></i></span>
                <input type="text" id="ToDate" name="ToDate" placeholder="Select date"
                  value="<%= ToDate %>" autocomplete="off" required>
              </div>
            </div>
  
            <div>
              <label class="rr-field-label">
                Doctor
                <span style="color:var(--text-hint);font-weight:400;font-size:10px;text-transform:none;margin-left:4px;">(all if blank)</span>
              </label>
              <div class="rr-input-wrap">
                <span class="rr-input-icon"><i class="bi bi-person-badge"></i></span>
                <select name="doctorId">
                  <option value="">— All Doctors —</option>
                  <% doctors.forEach(function(d){ %>
                    <option value="<%= d.Id %>"
                      <%= d.Id == selectedDoctor ? 'selected' : '' %>>
                      Dr. <%= d.FirstName %> <%= d.LastName %>
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>
  
            <div>
              <label class="rr-field-label" style="visibility:hidden">.</label>
              <button type="submit" class="rr-btn">
                <i class="bi bi-eye"></i> View Report
              </button>
            </div>
  
          </div>
        </form>
  
        <div class="rr-info-grid">
          <div class="rr-info-card">
            <div class="rr-info-icon"><i class="bi bi-person-badge"></i></div>
            <div class="rr-info-title">Per Doctor</div>
            <div class="rr-info-desc">One section per referring doctor with name, degrees, and total commission summary</div>
          </div>
          <div class="rr-info-card">
            <div class="rr-info-icon"><i class="bi bi-calendar3"></i></div>
            <div class="rr-info-title">Per Date</div>
            <div class="rr-info-desc">Patients grouped by registration date with daily subtotals for each metric</div>
          </div>
          <div class="rr-info-card">
            <div class="rr-info-icon"><i class="bi bi-vials"></i></div>
            <div class="rr-info-title">Per Patient</div>
            <div class="rr-info-desc">Test list with prices, gross, discount, dues, and thanks earned per patient</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  