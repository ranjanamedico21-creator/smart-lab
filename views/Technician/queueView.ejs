<%# views/Technician/queueView.ejs
    Used by: Reception, Marketing, Admin, Technician
    Mobile-first — shows all room queues, allows moving patient to any position
%>

<style>
:root {
  --brand:#185FA5; --brand-dark:#0C447C;
  --surface:#fff; --surface-alt:#F8F9FB;
  --border:rgba(0,0,0,0.08); --border-strong:rgba(0,0,0,0.13);
  --text-primary:#111827; --text-secondary:#6B7280; --text-hint:#9CA3AF;
  --success-bg:#EAF3DE; --success-text:#3B6D11;
  --danger-bg:#FCEBEB;  --danger-text:#A32D2D;
  --warning-bg:#FAEEDA; --warning-text:#854F0B;
  --info-bg:#E6F1FB;    --info-text:#185FA5;
  --priority-bg:#FFF7ED; --priority-text:#C2410C;
  --radius-sm:6px; --radius-md:10px; --radius-lg:14px;
  --shadow:0 1px 6px rgba(0,0,0,.07), 0 0 0 1px rgba(0,0,0,.05);
}

* { box-sizing:border-box; }
.qv-page { padding:8px 0 80px; }

/* Header */
.qv-header { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:14px; flex-wrap:wrap; }
.qv-header-left { display:flex; align-items:center; gap:10px; }
.qv-header-icon { width:40px; height:40px; border-radius:var(--radius-md); background:var(--brand); color:#fff; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
.qv-header-title { font-size:15px; font-weight:800; color:var(--text-primary); margin:0; }
.qv-header-sub   { font-size:11.5px; color:var(--text-secondary); margin:2px 0 0; }
.qv-refresh-btn  { display:inline-flex; align-items:center; gap:5px; padding:6px 12px; border-radius:var(--radius-sm); border:1.5px solid var(--border-strong); background:var(--surface); color:var(--text-secondary); font-size:12px; font-weight:600; cursor:pointer; text-decoration:none; white-space:nowrap; }
.qv-refresh-btn:hover { border-color:var(--brand); color:var(--brand); }

/* Tabs */
.qv-tabs { display:flex; gap:6px; overflow-x:auto; padding-bottom:4px; margin-bottom:14px; scrollbar-width:none; }
.qv-tabs::-webkit-scrollbar { display:none; }
.qv-tab { display:inline-flex; align-items:center; gap:5px; padding:6px 14px; border-radius:99px; font-size:12px; font-weight:600; border:1.5px solid var(--border-strong); background:var(--surface); color:var(--text-secondary); cursor:pointer; white-space:nowrap; transition:all .15s; }
.qv-tab.active { background:var(--brand); color:#fff; border-color:var(--brand); }
.qv-tab-count { padding:1px 6px; border-radius:99px; font-size:10px; font-weight:700; }
.qv-tab.active .qv-tab-count { background:rgba(255,255,255,.25); }
.qv-tab:not(.active) .qv-tab-count { background:var(--surface-alt); color:var(--text-secondary); }

/* Room panel */
.qv-room-panel { display:none; }
.qv-room-panel.active { display:block; }

/* Patient list */
.qv-patient-list { display:flex; flex-direction:column; gap:8px; }

/* Patient card */
.qv-card {
  background:var(--surface); border-radius:var(--radius-lg);
  box-shadow:var(--shadow); overflow:hidden;
  border-left:4px solid var(--border-strong);
}
.qv-card.c-waiting    { border-left-color:#F59E0B; }
.qv-card.c-inprogress { border-left-color:#16a34a; }
.qv-card.c-aborted    { border-left-color:#dc2626; }
.qv-card.c-priority   { border-left-color:#C2410C; background:#FFFBF7; }

.qv-card-main { display:flex; align-items:center; gap:10px; padding:10px 14px; }

.qv-pos { font-size:14px; font-weight:800; color:var(--text-hint); min-width:26px; text-align:center; flex-shrink:0; }
.qv-pos.pos-first { color:var(--brand); }
.qv-pos.pos-inprogress { color:#16a34a; }

.qv-info { flex:1; min-width:0; }
.qv-name { font-size:13px; font-weight:700; color:var(--text-primary); text-transform:capitalize; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-bottom:1px; }
.qv-meta { font-size:11px; color:var(--text-secondary); }
.qv-test { font-size:11.5px; font-weight:600; color:var(--text-primary); text-transform:uppercase; margin-top:2px; }

.qv-right { display:flex; flex-direction:column; align-items:flex-end; gap:4px; flex-shrink:0; }
.qv-status { display:inline-flex; align-items:center; gap:3px; padding:2px 8px; border-radius:99px; font-size:10.5px; font-weight:600; white-space:nowrap; }
.qs-waiting    { background:#FEF9C3; color:#854d0e; border:1px solid #FDE68A; }
.qs-inprogress { background:#DCFCE7; color:#15803d; border:1px solid #BBF7D0; }
.qs-aborted    { background:var(--danger-bg); color:var(--danger-text); border:1px solid rgba(220,38,38,.2); }

.qv-priority-tag { display:inline-flex; align-items:center; gap:3px; padding:2px 7px; border-radius:99px; background:var(--priority-bg); color:var(--priority-text); font-size:10px; font-weight:700; border:1px solid rgba(194,65,12,.2); }

/* Move button */
.qv-move-btn {
  display:inline-flex; align-items:center; gap:4px;
  padding:5px 10px; border-radius:var(--radius-sm);
  font-size:11.5px; font-weight:600;
  background:var(--priority-bg); color:var(--priority-text);
  border:1.5px solid rgba(194,65,12,.3); cursor:pointer;
  font-family:inherit; white-space:nowrap; transition:background .12s;
}
.qv-move-btn:hover { background:#FED7AA; }

/* Info strips */
.qv-strip { padding:5px 14px 7px 52px; border-top:1px solid rgba(0,0,0,.05); font-size:11.5px; display:flex; align-items:flex-start; gap:5px; }
.qv-strip.priority { background:#FFF7ED; color:#C2410C; }
.qv-strip.abort    { background:#fff5f5; color:var(--danger-text); }
.qv-strip i { flex-shrink:0; margin-top:1px; font-size:11px; }

/* Empty */
.qv-empty { display:flex; flex-direction:column; align-items:center; padding:36px 20px; color:var(--text-hint); gap:6px; text-align:center; }

/* ══ MOVE MODAL (bottom sheet) ══════════════════════════════════ */
.qv-modal-backdrop { display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,.5); align-items:flex-end; justify-content:center; }
.qv-modal-backdrop.open { display:flex; }

.qv-modal {
  background:var(--surface); border-radius:20px 20px 0 0;
  width:100%; max-width:540px; max-height:92vh;
  display:flex; flex-direction:column;
  box-shadow:0 -4px 32px rgba(0,0,0,.18);
  animation:qvUp .25s ease;
  padding-bottom:env(safe-area-inset-bottom,16px);
}
@keyframes qvUp { from{transform:translateY(100%)} to{transform:translateY(0)} }

.qv-modal-handle { width:36px; height:4px; border-radius:99px; background:var(--border-strong); margin:12px auto 0; flex-shrink:0; }
.qv-modal-head { padding:14px 18px 10px; display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }
.qv-modal-title { font-size:15px; font-weight:700; color:var(--text-primary); }
.qv-modal-close { width:28px; height:28px; border-radius:6px; background:var(--surface-alt); border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--text-hint); font-size:14px; }

/* Patient being moved — stays at top */
.qv-modal-moving {
  margin:0 18px 10px; padding:10px 12px;
  background:var(--priority-bg); border:1.5px solid rgba(194,65,12,.2);
  border-radius:var(--radius-sm); flex-shrink:0;
}
.qv-modal-moving-label { font-size:9.5px; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:var(--priority-text); margin-bottom:3px; }
.qv-modal-moving-name  { font-size:13px; font-weight:700; color:var(--text-primary); }
.qv-modal-moving-test  { font-size:11.5px; color:var(--text-secondary); }

/* Instruction */
.qv-modal-instr { padding:0 18px 8px; font-size:12px; color:var(--text-secondary); flex-shrink:0; }

/* Scrollable patient list */
.qv-modal-list { flex:1; overflow-y:auto; padding:0 18px 8px; }

/* Position slot rows */
.qv-slot-row { display:flex; align-items:center; gap:10px; margin-bottom:6px; }
.qv-slot-pos { font-size:12px; font-weight:700; color:var(--text-hint); min-width:28px; text-align:right; }

/* Place here button */
.qv-place-btn {
  display:flex; align-items:center; gap:6px;
  width:100%; padding:9px 12px; border-radius:var(--radius-sm);
  border:1.5px dashed rgba(24,95,165,.3); background:var(--info-bg);
  color:var(--info-text); font-size:12px; font-weight:600;
  cursor:pointer; font-family:inherit; transition:background .12s;
}
.qv-place-btn:hover { background:#d0e8f8; border-color:var(--brand); }

/* Existing patient row in modal */
.qv-modal-patient {
  display:flex; align-items:center; gap:8px;
  padding:8px 12px; border-radius:var(--radius-sm);
  background:var(--surface-alt); border:1px solid var(--border);
  width:100%;
}
.qv-modal-patient-name { font-size:12.5px; font-weight:600; color:var(--text-primary); text-transform:capitalize; flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.qv-modal-patient-test { font-size:11px; color:var(--text-secondary); text-transform:uppercase; }
.qv-modal-patient-time { font-size:10.5px; color:var(--text-hint); white-space:nowrap; }

/* Note input */
.qv-modal-note-wrap { padding:8px 18px 4px; flex-shrink:0; }
.qv-modal-note-label { font-size:11.5px; font-weight:600; color:var(--text-secondary); margin-bottom:5px; }
.qv-modal-note-input {
  width:100%; border:1.5px solid var(--border-strong); border-radius:var(--radius-sm);
  padding:9px 12px; font-size:13px; font-family:inherit; color:var(--text-primary);
  outline:none; transition:border-color .15s; resize:none; min-height:60px;
}
.qv-modal-note-input:focus { border-color:var(--brand); box-shadow:0 0 0 3px rgba(24,95,165,.1); }
.qv-modal-note-input.is-err { border-color:#dc2626; }
.qv-modal-note-err { font-size:11.5px; color:#dc2626; margin-top:3px; display:none; padding:0 18px; flex-shrink:0; }
.qv-modal-note-err.show { display:block; }

.qv-modal-foot { padding:10px 18px 14px; border-top:1px solid var(--border); display:flex; gap:8px; flex-shrink:0; }
.qv-modal-cancel-btn  { flex:1; padding:11px; border-radius:var(--radius-sm); font-size:13px; font-weight:600; background:var(--surface-alt); color:var(--text-secondary); border:1px solid var(--border-strong); cursor:pointer; font-family:inherit; }
.qv-modal-confirm-btn { flex:2; padding:11px; border-radius:var(--radius-sm); font-size:13px; font-weight:600; background:var(--priority-text); color:#fff; border:none; cursor:pointer; font-family:inherit; }
.qv-modal-confirm-btn:disabled { opacity:.5; cursor:not-allowed; }

/* Toast */
#qvToastContainer { position:fixed; bottom:20px; left:50%; transform:translateX(-50%); z-index:99999; display:flex; flex-direction:column; gap:6px; align-items:center; pointer-events:none; width:90%; max-width:360px; }
.qv-toast { display:flex; align-items:center; gap:8px; padding:10px 14px; border-radius:10px; width:100%; box-shadow:0 4px 20px rgba(0,0,0,.15); pointer-events:all; animation:qvToastIn .2s ease; background:#1e293b; color:#fff; }
@keyframes qvToastIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
.qv-toast i { font-size:15px; flex-shrink:0; }
.qv-toast-msg { flex:1; font-size:12.5px; font-weight:500; }
</style>

<div id="qvToastContainer"></div>

<!-- Move-to-position modal (bottom sheet) -->
<div class="qv-modal-backdrop" id="qvMoveModal">
  <div class="qv-modal">
    <div class="qv-modal-handle"></div>
    <div class="qv-modal-head">
      <div class="qv-modal-title">⚡ Move to Position</div>
      <button class="qv-modal-close" onclick="closeQvModal()"><i class="bi bi-x-lg"></i></button>
    </div>

    <!-- Patient being moved -->
    <div class="qv-modal-moving">
      <div class="qv-modal-moving-label">Moving patient</div>
      <div class="qv-modal-moving-name" id="qvMovingName">—</div>
      <div class="qv-modal-moving-test" id="qvMovingTest">—</div>
    </div>

    <div class="qv-modal-instr">
      <i class="bi bi-hand-index-thumb me-1" style="color:var(--brand)"></i>
      Tap <strong>Place here</strong> to insert the patient at that position
    </div>

    <!-- Scrollable list with "Place here" slots -->
    <div class="qv-modal-list" id="qvModalList"></div>

    <!-- Reason input -->
    <div class="qv-modal-note-wrap">
      <div class="qv-modal-note-label">
        Reason for moving <span style="color:#dc2626">*</span>
      </div>
      <textarea class="qv-modal-note-input" id="qvNoteInput"
        placeholder="e.g. Patient came from far, doctor urgency, elderly patient…"
        maxlength="200" rows="2"></textarea>
    </div>
    <div class="qv-modal-note-err" id="qvNoteErr">Please enter a reason.</div>

    <div class="qv-modal-foot">
      <button class="qv-modal-cancel-btn" onclick="closeQvModal()">Cancel</button>
      <button class="qv-modal-confirm-btn" id="qvConfirmBtn" onclick="submitMove()">
        <i class="bi bi-arrow-up-circle me-1"></i> Confirm Move
      </button>
    </div>
  </div>
</div>

<div class="qv-page">
<div class="container-fluid">

  <div class="qv-header">
    <div class="qv-header-left">
      <div class="qv-header-icon"><i class="bi bi-list-ol"></i></div>
      <div>
        <p class="qv-header-title">Patient Queue</p>
        <p class="qv-header-sub">
          <%= new Date().toLocaleDateString('en-IN',{weekday:'short',day:'2-digit',month:'short'}) %>
          &nbsp;·&nbsp; Tap ⚡ to move a patient
        </p>
      </div>
    </div>
    <a href="/technician/queueView" class="qv-refresh-btn">
      <i class="bi bi-arrow-clockwise"></i>
      <span id="qvCountdown">30s</span>
    </a>
  </div>

  <% if (!queue || queue.length === 0) { %>
  <div class="qv-empty">
    <i class="bi bi-inbox" style="font-size:32px"></i>
    <p style="font-size:14px;font-weight:600;color:var(--text-secondary)">Queue is empty</p>
    <p style="font-size:12px">No patients waiting today.</p>
  </div>
  <% } else { %>

  <%
    var roomGroups = {};
    queue.forEach(function(q) {
      if (!roomGroups[q.RoomCode]) roomGroups[q.RoomCode] = [];
      roomGroups[q.RoomCode].push(q);
    });
    var roomLabels = { USG:'USG', CT:'CT Scan', MRI:'MRI', XRAY:'X-Ray', PATH:'Path' };
    var roomCodes  = Object.keys(roomGroups);
  %>

  <!-- Tabs -->
  <div class="qv-tabs">
    <% roomCodes.forEach(function(rc, ri) { %>
    <button class="qv-tab <%= ri===0?'active':'' %>" onclick="switchTab('<%= rc %>',this)">
      <%= roomLabels[rc]||rc %>
      <span class="qv-tab-count"><%= roomGroups[rc].filter(function(q){return q.QueueStatus==='Waiting';}).length %></span>
    </button>
    <% }) %>
  </div>

  <!-- Room panels -->
  <% roomCodes.forEach(function(rc, ri) { %>
  <div class="qv-room-panel <%= ri===0?'active':'' %>" id="panel-<%= rc %>">

    <% var roomQ = roomGroups[rc]; %>
    <% if (!roomQ.length) { %>
    <div class="qv-empty"><i class="bi bi-check-circle" style="font-size:28px;color:#16a34a"></i><p style="font-size:13px">No patients waiting</p></div>
    <% } else { %>

    <div class="qv-patient-list">
      <% roomQ.forEach(function(q, i) { %>
      <%
        var isWaiting    = q.QueueStatus === 'Waiting';
        var isInProgress = q.QueueStatus === 'InProgress';
        var isAborted    = q.QueueStatus === 'Aborted';
        var isPriority   = !!q.PriorityNote;
        var arrivalTime  = new Date(q.ArrivalTime).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'});
        var cardClass    = isInProgress ? 'c-inprogress' : isAborted ? 'c-aborted' : isPriority ? 'c-priority' : 'c-waiting';
        var waitingCount = roomQ.filter(function(x){ return x.QueueStatus==='Waiting'; }).length;
      %>
      <div class="qv-card <%= cardClass %>">
        <div class="qv-card-main">

          <!-- Position -->
          <div class="qv-pos <%= i===0&&isWaiting?'pos-first':'' %> <%= isInProgress?'pos-inprogress':'' %>">
            <%= isInProgress ? '▶' : '#'+(i+1) %>
          </div>

          <div class="qv-info">
            <div class="qv-name"><%= q.PatientName %></div>
            <div class="qv-meta"><%= q.Age %> <%= q.Ymd %> · <%= q.Gender==1?'M':'F' %> · <%= q.PhoneNumber %></div>
            <div class="qv-test"><%= q.TestName %></div>
            <% if (isPriority) { %>
            <span class="qv-priority-tag"><i class="bi bi-lightning-charge-fill" style="font-size:9px"></i> Prioritised</span>
            <% } %>
          </div>

          <div class="qv-right">
            <% if (isWaiting) { %>
              <span class="qv-status qs-waiting"><i class="bi bi-hourglass" style="font-size:9px"></i> <%= arrivalTime %></span>
              <% if (waitingCount > 1) { %>
              <button class="qv-move-btn"
                data-queue-id="<%= q.QueueId %>"
                data-room="<%= rc %>"
                data-name="<%= q.PatientName %>"
                data-test="<%= q.TestName %>"
                data-pos="<%= i+1 %>"
                onclick="openMoveModal(this)">
                <i class="bi bi-arrows-move" style="font-size:10px"></i> Move
              </button>
              <% } %>
            <% } else if (isInProgress) { %>
              <span class="qv-status qs-inprogress"><i class="bi bi-activity" style="font-size:9px"></i> Scanning</span>
            <% } else if (isAborted) { %>
              <span class="qv-status qs-aborted"><i class="bi bi-x-circle" style="font-size:9px"></i> Aborted</span>
            <% } %>
          </div>
        </div>

        <% if (isPriority) { %>
        <div class="qv-strip priority">
          <i class="bi bi-lightning-charge-fill"></i>
          <span><strong>Priority:</strong> <%= q.PriorityNote %></span>
        </div>
        <% } %>
        <% if (isAborted && q.StatusNote) { %>
        <div class="qv-strip abort">
          <i class="bi bi-info-circle-fill"></i>
          <span><strong>Abort reason:</strong> <%= q.StatusNote %></span>
        </div>
        <% } %>
      </div>
      <% }) %>
    </div>

    <% } %>
  </div>
  <% }) %>
  <% } %>

</div>
</div>

<%# Pass queue data to JS for building the move modal list %>
<script>
var QV_ROOM_DATA = <%- JSON.stringify(
  Object.fromEntries(
    Object.entries(
      queue.reduce(function(acc, q) {
        if (!acc[q.RoomCode]) acc[q.RoomCode] = [];
        acc[q.RoomCode].push({
          queueId:    q.QueueId,
          name:       q.PatientName,
          test:       q.TestName,
          time:       new Date(q.ArrivalTime).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}),
          status:     q.QueueStatus
        });
        return acc;
      }, {})
    )
  )
) %>;

var _moveQueueId    = null;
var _moveRoomCode   = null;
var _beforeQueueId  = null; // null = place at end

// ── Tab switch ────────────────────────────────────────────────
function switchTab(rc, btn) {
    document.querySelectorAll('.qv-tab').forEach(function(t){ t.classList.remove('active'); });
    document.querySelectorAll('.qv-room-panel').forEach(function(p){ p.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById('panel-' + rc).classList.add('active');
}

// ── Toast ─────────────────────────────────────────────────────
function showQvToast(msg, type, duration) {
    type=type||'info'; duration=duration||3000;
    var colors={success:'#16a34a',danger:'#dc2626',warning:'#F59E0B',info:'#185FA5'};
    var icons={success:'bi-check-circle-fill',danger:'bi-x-circle-fill',warning:'bi-exclamation-triangle-fill',info:'bi-info-circle-fill'};
    var el=document.createElement('div');
    el.className='qv-toast';
    el.innerHTML='<i class="bi '+(icons[type]||'bi-info-circle-fill')+'" style="color:'+(colors[type]||'#185FA5')+'"></i><span class="qv-toast-msg">'+msg+'</span>';
    document.getElementById('qvToastContainer').appendChild(el);
    setTimeout(function(){ if(el.parentNode) el.remove(); }, duration);
}

// ── Open move modal ───────────────────────────────────────────
function openMoveModal(btn) {
    _moveQueueId  = btn.dataset.queueId;
    _moveRoomCode = btn.dataset.room;
    _beforeQueueId = null;

    document.getElementById('qvMovingName').textContent = btn.dataset.name;
    document.getElementById('qvMovingTest').textContent = btn.dataset.test + '  ·  Currently #' + btn.dataset.pos;
    document.getElementById('qvNoteInput').value = '';
    document.getElementById('qvNoteInput').classList.remove('is-err');
    document.getElementById('qvNoteErr').classList.remove('show');
    document.getElementById('qvConfirmBtn').disabled = false;
    document.getElementById('qvConfirmBtn').innerHTML = '<i class="bi bi-arrow-up-circle me-1"></i> Confirm Move';

    // Build the position list — exclude the patient being moved
    var roomPatients = (QV_ROOM_DATA[_moveRoomCode] || []).filter(function(p) {
        return p.status === 'Waiting' && p.queueId != _moveQueueId;
    });

    var list = document.getElementById('qvModalList');
    list.innerHTML = '';

    // "Place at position 1" slot
    list.appendChild(makePlaceSlot(null, 1, 'Place first in queue'));

    roomPatients.forEach(function(p, i) {
        // Existing patient row
        var row = document.createElement('div');
        row.className = 'qv-slot-row';
        row.innerHTML =
            '<div class="qv-slot-pos">' + (i+1) + '</div>' +
            '<div class="qv-modal-patient">' +
                '<div style="flex:1;min-width:0">' +
                    '<div class="qv-modal-patient-name">' + p.name + '</div>' +
                    '<div class="qv-modal-patient-test">' + p.test + '</div>' +
                '</div>' +
                '<div class="qv-modal-patient-time">' + p.time + '</div>' +
            '</div>';
        list.appendChild(row);

        // "Place after this patient" slot
        var label = i === roomPatients.length - 1
            ? 'Place last in queue'
            : 'Place after ' + p.name.split(' ')[0];
        list.appendChild(makePlaceSlot(p.queueId, i + 2, label));
    });

    document.getElementById('qvMoveModal').classList.add('open');
    list.scrollTop = 0;
}

function makePlaceSlot(afterQueueId, position, label) {
    var wrap = document.createElement('div');
    wrap.className = 'qv-slot-row';
    var btn = document.createElement('button');
    btn.className = 'qv-place-btn';
    btn.innerHTML = '<i class="bi bi-arrow-right-circle-fill" style="font-size:14px"></i>' +
                    '<span>#' + position + ' &nbsp;—&nbsp; ' + label + '</span>';
    btn.addEventListener('click', function() {
        // afterQueueId = null means place at position 1 (before all)
        // afterQueueId = someId means place after that patient
        // We pass beforeQueueId to server = the patient who will come AFTER our moved patient
        // Position 1 means beforeQueueId = first patient in list
        selectPosition(btn, afterQueueId, position);
    });
    wrap.appendChild(btn);
    return wrap;
}

function selectPosition(btn, afterQueueId, position) {
    // afterQueueId: patient to place AFTER (null = place before all)
    // Convert to beforeQueueId for the server
    var roomPatients = (QV_ROOM_DATA[_moveRoomCode] || []).filter(function(p) {
        return p.status === 'Waiting' && p.queueId != _moveQueueId;
    });

    if (afterQueueId === null) {
        // Place before first patient
        _beforeQueueId = roomPatients.length > 0 ? roomPatients[0].queueId : null;
    } else {
        // Find the patient after afterQueueId
        var idx = roomPatients.findIndex(function(p){ return p.queueId == afterQueueId; });
        _beforeQueueId = (idx < roomPatients.length - 1) ? roomPatients[idx + 1].queueId : null;
    }

    // Highlight selected slot
    document.querySelectorAll('#qvModalList .qv-place-btn').forEach(function(b){
        b.style.background = '';
        b.style.borderStyle = 'dashed';
        b.innerHTML = b.innerHTML.replace('<i class="bi bi-check-circle-fill"','<i class="bi bi-arrow-right-circle-fill"');
    });
    btn.style.background = '#d0e8f8';
    btn.style.borderStyle = 'solid';
    btn.innerHTML = '<i class="bi bi-check-circle-fill" style="font-size:14px;color:var(--brand)"></i>' +
                    '<span>#' + position + ' selected — scroll down to confirm</span>';

    // Scroll to note input
    document.getElementById('qvNoteInput').scrollIntoView({ behavior:'smooth', block:'center' });
    setTimeout(function(){ document.getElementById('qvNoteInput').focus(); }, 400);
}

function closeQvModal() {
    document.getElementById('qvMoveModal').classList.remove('open');
    _moveQueueId = null; _moveRoomCode = null; _beforeQueueId = null;
}
document.getElementById('qvMoveModal').addEventListener('click', function(e){
    if (e.target === this) closeQvModal();
});

// ── Submit move ───────────────────────────────────────────────
function submitMove() {
    var note = document.getElementById('qvNoteInput').value.trim();

    if (!note) {
        document.getElementById('qvNoteInput').classList.add('is-err');
        document.getElementById('qvNoteErr').classList.add('show');
        document.getElementById('qvNoteInput').scrollIntoView({ behavior:'smooth', block:'center' });
        document.getElementById('qvNoteInput').focus();
        return;
    }

    // Check a position was selected
    var anySelected = Array.from(document.querySelectorAll('#qvModalList .qv-place-btn'))
        .some(function(b){ return b.style.background === 'rgb(208, 232, 248)'; });
    if (!anySelected) {
        showQvToast('Please tap a position in the list above.', 'warning');
        document.getElementById('qvModalList').scrollIntoView({ behavior:'smooth', block:'start' });
        return;
    }

    var btn = document.getElementById('qvConfirmBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Moving…';

    fetch('/technician/moveToPosition', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({
            queueId:       _moveQueueId,
            beforeQueueId: _beforeQueueId,
            roomCode:      _moveRoomCode,
            note:          note
        })
    })
    .then(function(r){ return r.json(); })
    .then(function(d){
        if (d.success) {
            closeQvModal();
            showQvToast('Patient moved to position #' + d.newPosition + '.', 'success');
            setTimeout(function(){ location.reload(); }, 900);
        } else {
            showQvToast(d.message || 'Could not move patient.', 'warning');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-up-circle me-1"></i> Confirm Move';
        }
    })
    .catch(function(){
        showQvToast('Network error.', 'danger');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-arrow-up-circle me-1"></i> Confirm Move';
    });
}

// ── Auto-refresh 30s ──────────────────────────────────────────
var _qvC = 30;
var _qvT = setInterval(function() {
    if (document.getElementById('qvMoveModal').classList.contains('open')) return;
    _qvC--;
    var el = document.getElementById('qvCountdown');
    if (el) el.textContent = _qvC + 's';
    if (_qvC <= 0) { clearInterval(_qvT); location.reload(); }
}, 1000);
</script>
