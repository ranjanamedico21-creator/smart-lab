

<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="utf-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1">

  <title>
    Delivery Challan - <%= challanId %>
  </title>


  <!-- Bootstrap -->

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >


  <!-- Inter Font -->

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >


  <!-- Bootstrap Icons -->

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >


  <style>

    * {
      box-sizing: border-box;
    }


    body {

      font-family: 'Inter', sans-serif;

      background-color: #f5f6f8;

      color: #111827;

      font-size: 13px;

      margin: 0;

      padding: 0;

    }


    /* =========================================================
       SCREEN CONTAINER
    ========================================================= */

    .challan-wrapper {

      max-width: 1200px;

      margin: 25px auto;

      padding: 0 15px;

    }


    .challan-box {

      background: #fff;

      padding: 18px;

      border-radius: 6px;

      box-shadow: 0 2px 10px rgba(0,0,0,.08);

    }


    /* =========================================================
       PRINT BUTTON
    ========================================================= */

    .print-toolbar {

      display: flex;

      justify-content: flex-end;

      margin-bottom: 15px;

    }


    .print-btn {

      display: inline-flex;

      align-items: center;

      gap: 7px;

      border: 1px solid #185FA5;

      background: #185FA5;

      color: #fff;

      border-radius: 5px;

      padding: 8px 15px;

      font-size: 12px;

      font-weight: 600;

      cursor: pointer;

    }


    .print-btn:hover {

      background: #0C447C;

      color: #fff;

    }


    /* =========================================================
       HEADER
    ========================================================= */

    .challan-header {

      border-bottom: 2px solid #000;

      padding-bottom: 8px;

      margin-bottom: 0;

    }


    .company-logo {

      max-height: 65px;

      max-width: 160px;

      object-fit: contain;

    }


    .company-name {

      font-size: 20px;

      font-weight: 800;

      margin-bottom: 3px;

      color: #111827;

    }


    .company-info {

      font-size: 11px;

      line-height: 1.55;

      margin-bottom: 0;

      color: #374151;

    }


    .challan-title {

      font-size: 23px;

      font-weight: 800;

      letter-spacing: .04em;

      text-transform: uppercase;

      margin-bottom: 5px;

      color: #185FA5;

    }


    .challan-subtitle {

      font-size: 9px;

      font-weight: 600;

      text-transform: uppercase;

      letter-spacing: .08em;

      color: #6B7280;

    }


    .challan-number {

      font-size: 13px;

      font-weight: 700;

      margin-top: 5px;

    }


    /* =========================================================
       GST HEADER
    ========================================================= */

    .tax-header {

      background: #f8f9fa;

      border-bottom: 1px solid #d9dee5;

      border-radius: 0 0 4px 4px;

      padding: 7px 5px;

    }


    .tax-header p {

      margin: 0;

      font-size: 11px;

    }


    .tax-header-title {

      font-size: 15px;

      font-weight: 800;

      text-transform: uppercase;

      letter-spacing: .08em;

      color: #185FA5;

    }


    /* =========================================================
       INFORMATION HEADINGS
    ========================================================= */

    .section-heading {

      text-align: center;

      font-size: 12px;

      font-weight: 800;

      text-transform: uppercase;

      text-decoration: underline;

      margin: 7px 0 8px;

    }


    .info-section {

      padding: 7px 10px;

    }


    .info-section.border-right {

      border-right: 1px solid #d5d9df;

    }


    .info-row {

      margin-bottom: 4px;

      font-size: 11px;

      line-height: 1.45;

    }


    .info-row strong {

      font-weight: 700;

    }


    .info-value {

      font-weight: 500;

    }


    /* =========================================================
       CHALLAN DETAILS BOX
    ========================================================= */

    .details-box {

      border-left: 1px solid #d5d9df;

      padding-left: 15px;

    }


    /* =========================================================
       ITEMS TABLE
    ========================================================= */

    .items-heading {

      text-align: center;

      font-size: 12px;

      font-weight: 800;

      text-transform: uppercase;

      text-decoration: underline;

      margin: 8px 0 6px;

    }


    .items-table {

      width: 100%;

      border-collapse: collapse;

      margin-bottom: 0;

    }


    .items-table th {

      background: #f1f3f5;

      border-top: 1px solid #000;

      border-bottom: 1px solid #000;

      padding: 5px 4px;

      font-size: 9.5px;

      font-weight: 800;

      text-transform: uppercase;

      text-align: center;

      white-space: nowrap;

    }


    .items-table td {

      padding: 5px 4px;

      font-size: 10px;

      border-bottom: 1px solid #d9dde2;

      text-align: center;

      vertical-align: middle;

    }


    .items-table td.product {

      text-align: left;

      font-weight: 600;

    }


    .items-table td.batch {

      font-family: monospace;

      font-size: 9.5px;

    }


    .items-table tbody tr:last-child td {

      border-bottom: 1px solid #000;

    }


    /* =========================================================
       BANK / TERMS
    ========================================================= */

    .bottom-section {

      margin-top: 7px;

    }


    .bottom-panel {

      padding: 7px 10px;

    }


    .bottom-panel.border-right {

      border-right: 1px solid #d5d9df;

    }


    .bottom-heading {

      text-align: center;

      font-size: 11px;

      font-weight: 800;

      text-transform: uppercase;

      text-decoration: underline;

      margin-bottom: 7px;

    }


    .bank-row {

      font-size: 10.5px;

      margin-bottom: 3px;

      line-height: 1.45;

    }


    .terms {

      margin: 0;

      padding-left: 17px;

    }


    .terms li {

      font-size: 10px;

      margin-bottom: 3px;

      line-height: 1.4;

    }


    /* =========================================================
       SIGNATURE
    ========================================================= */

    .signature-section {

      margin-top: 7px;

      padding-top: 7px;

      border-top: 1px solid #000;

    }


    .signature-title {

      font-size: 10px;

      font-weight: 800;

      text-transform: uppercase;

      margin-bottom: 25px;

    }


    .signature-line {

      border-bottom: 1px solid #000;

      width: 150px;

      margin: 0 auto 5px;

    }


    .signature-label {

      font-size: 9px;

      color: #555;

    }


    /* =========================================================
       FOOTER
    ========================================================= */

    .challan-footer {

      border-top: 1px solid #000;

      margin-top: 8px;

      padding-top: 5px;

      text-align: center;

      font-size: 8.5px;

      color: #555;

    }


    /* =========================================================
       PRINT
    ========================================================= */

    @page {

      size: A4 portrait;

      margin: 8mm;

    }


    @media print {

      html,
      body {

        width: 210mm;

        background: #fff !important;

      }


      body {

        margin: 0;

        padding: 0;

        font-size: 11px;

      }


      .no-print {

        display: none !important;

      }


      .challan-wrapper {

        width: 100%;

        max-width: none;

        margin: 0;

        padding: 0;

      }


      .challan-box {

        width: 100%;

        padding: 0;

        margin: 0;

        border: none;

        border-radius: 0;

        box-shadow: none;

      }


      .challan-header {

        padding-bottom: 6px;

      }


      .company-logo {

        max-height: 58px;

      }


      .company-name {

        font-size: 18px;

      }


      .company-info {

        font-size: 9px;

      }


      .challan-title {

        font-size: 20px;

      }


      .challan-subtitle {

        font-size: 8px;

      }


      .tax-header {

        padding: 5px 3px;

        -webkit-print-color-adjust: exact;

        print-color-adjust: exact;

      }


      .tax-header p {

        font-size: 9px;

      }


      .tax-header-title {

        font-size: 12px;

      }


      .section-heading,

      .items-heading {

        font-size: 10px;

        margin-top: 5px;

        margin-bottom: 5px;

      }


      .info-section {

        padding: 5px 7px;

      }


      .info-row {

        font-size: 9px;

        margin-bottom: 2px;

      }


      .items-table th {

        padding: 4px 3px;

        font-size: 8px;

        -webkit-print-color-adjust: exact;

        print-color-adjust: exact;

      }


      .items-table td {

        padding: 4px 3px;

        font-size: 8.5px;

      }


      .items-table td.batch {

        font-size: 8px;

      }


      .bottom-section {

        margin-top: 4px;

      }


      .bottom-panel {

        padding: 5px 7px;

      }


      .bottom-heading {

        font-size: 9px;

        margin-bottom: 5px;

      }


      .bank-row {

        font-size: 8.5px;

        margin-bottom: 2px;

      }


      .terms li {

        font-size: 8px;

        margin-bottom: 2px;

      }


      .signature-section {

        margin-top: 4px;

        padding-top: 4px;

      }


      .signature-title {

        font-size: 8.5px;

        margin-bottom: 18px;

      }


      .signature-line {

        width: 125px;

      }


      .signature-label {

        font-size: 8px;

      }


      .challan-footer {

        margin-top: 5px;

        padding-top: 4px;

        font-size: 7.5px;

      }


      /* Keep rows together while printing */

      tr {

        break-inside: avoid;

      }


      .items-table {

        page-break-inside: auto;

      }


      .bottom-section,

      .signature-section {

        break-inside: avoid;

      }

    }


    /* =========================================================
       MOBILE
    ========================================================= */

    @media (max-width: 768px) {

      .challan-box {

        padding: 10px;

      }


      .challan-header .row {

        text-align: center;

      }


      .company-logo {

        margin-bottom: 8px;

      }


      .info-section.border-right,

      .bottom-panel.border-right {

        border-right: none;

        border-bottom: 1px solid #d5d9df;

      }


      .details-box {

        border-left: none;

        padding-left: 0;

      }

    }

  </style>

</head>


<body>


  <div class="challan-wrapper">


    <!-- =====================================================
         PRINT TOOLBAR
    ====================================================== -->

    <div class="print-toolbar no-print">

      <button
        type="button"
        class="print-btn"
        onclick="window.print()"
      >

        <i class="bi bi-printer"></i>

        Print Challan

      </button>

    </div>


    <!-- =====================================================
         MAIN CHALLAN
    ====================================================== -->

    <div class="challan-box">


      <!-- ===================================================
           HEADER
      ==================================================== -->

      <div class="row challan-header align-items-center">


        <!-- LOGO -->

        <div class="col-3 text-start">

          <img
            src="<%= imageBase64 || '/RanjanaImaging.PNG' %>"
            alt="Company Logo"
            class="company-logo"
          >

        </div>


        <!-- COMPANY -->

        <div class="col-5">

          <div class="company-name">

            <%= companyDetails.coreCompany || "Company Name" %>

          </div>


          <p class="company-info">

            <%= companyDetails.coreCompanyAddress || "Company Address" %>

            <br>

            Email:
            <%= companyDetails.coreCompanyEmail || "N/A" %>

            &nbsp; | &nbsp;

            Phone:
            <%= companyDetails.coreCompanyPhoneNumber || "N/A" %>

            <br>

            DL No:
            <%= companyDetails.coreCompanyDLNo || "N/A" %>

          </p>

        </div>


        <!-- CHALLAN TITLE -->

        <div class="col-4 text-end">

          <div class="challan-title">

            Delivery Challan

          </div>


          <div class="challan-subtitle">

            Goods / Material Delivery Document

          </div>


          <div class="challan-number">

            Challan No:
            <%= challanId %>

          </div>

        </div>


      </div>


      <!-- ===================================================
           TAX HEADER
      ==================================================== -->

      <div class="row tax-header text-center align-items-center">


        <div class="col-4">

          <p>

            <strong>GSTIN:</strong>

            <%= companyDetails.coreCompanyGstNo || "N/A" %>

          </p>

        </div>


        <div class="col-4">

          <div class="tax-header-title">

            Delivery Challan

          </div>

        </div>


        <div class="col-4">

          <p>

            Original for Recipient

          </p>

        </div>


      </div>


      <!-- ===================================================
           BILL TO + SHIP TO + CHALLAN DETAILS
      ==================================================== -->

      <div class="row">


        <!-- BILL TO -->

        <div class="col-md-5 info-section border-right">


          <div class="section-heading">

            Bill To

          </div>


          <div class="info-row">

            <strong>Name:</strong>

            <span class="info-value text-capitalize">

              <%= customerDetails?.CustomerName || "N/A" %>

            </span>

          </div>


          <div class="info-row">

            <strong>Address:</strong>

            <span class="info-value text-capitalize">

              <%= customerDetails?.BillingAddress || "N/A" %>

            </span>

          </div>


          <div class="info-row">

            <strong>Contact:</strong>

            <%= customerDetails?.MobileNo || "N/A" %>

          </div>


          <div class="info-row">

            <strong>District:</strong>

            <span class="text-capitalize">

              <%= customerDetails?.BillingDistrict || "N/A" %>

            </span>

            ,

            <strong>State:</strong>

            <%= customerDetails?.BillingState || "N/A" %>

            ,

            <strong>Pincode:</strong>

            <%= customerDetails?.BillingPincode || "N/A" %>

          </div>


          <div class="info-row">

            <strong>GST:</strong>

            <span class="text-uppercase">

              <%= customerDetails?.GstNo || "N/A" %>

            </span>

          </div>


          <div class="info-row">

            <strong>DL:</strong>

            <span class="text-uppercase">

              <%= customerDetails?.DlNo || "N/A" %>

            </span>

          </div>


        </div>


        <!-- SHIP TO -->

        <div class="col-md-4 info-section border-right">


          <div class="section-heading">

            Ship To

          </div>


          <div class="info-row">

            <strong>Name:</strong>

            <span class="info-value text-capitalize">

              <%= customerDetails?.CustomerName || "N/A" %>

            </span>

          </div>


          <div class="info-row">

            <strong>Address:</strong>

            <span class="info-value text-capitalize">

              <%= customerDetails?.SupplyAddress || "N/A" %>

            </span>

          </div>


          <div class="info-row">

            <strong>Contact:</strong>

            <%= customerDetails?.MobileNo || "N/A" %>

          </div>


          <div class="info-row">

            <strong>District:</strong>

            <span class="text-capitalize">

              <%= customerDetails?.SupplyDistrict || "N/A" %>

            </span>

            ,

            <strong>State:</strong>

            <%= customerDetails?.SupplyState || "N/A" %>

            ,

            <strong>Pincode:</strong>

            <%= customerDetails?.SupplyPincode || "N/A" %>

          </div>


          <div class="info-row">

            <strong>GST:</strong>

            <span class="text-uppercase">

              <%= customerDetails?.GstNo || "N/A" %>

            </span>

          </div>


        </div>


        <!-- CHALLAN DETAILS -->

        <div class="col-md-3 info-section">


          <div class="section-heading">

            Challan Details

          </div>


          <div class="details-box">


            <div class="info-row">

              <strong>Challan No.:</strong>

              <%= challanId %>

            </div>


            <div class="info-row">

              <strong>Date:</strong>

              <%= new Date(challans[0].ChallanDate)
                .toLocaleDateString('en-IN', {
                  day: '2-digit',
                  month: 'short',
                  year: 'numeric'
                }) %>

            </div>


            <div class="info-row">

              <strong>Total Items:</strong>

              <%= challans.length %>

            </div>


          </div>

        </div>


      </div>


      <!-- ===================================================
           ITEM DETAILS
      ==================================================== -->

      <div class="items-heading">

        Item Details

      </div>


      <table class="items-table">


        <thead>

          <tr>

            <th style="width:40px;">
              Sr.
            </th>

            <th style="width:35%;">
              Product
            </th>

            <th>
              HSN/SAC
            </th>

            <th>
              Batch
            </th>

            <th>
              Expiry
            </th>

            <th>
              Qty
            </th>

          </tr>

        </thead>


        <tbody>


          <% challans.forEach(function(challan, i) { %>


            <tr>


              <td class="fw-bold">

                <%= i + 1 %>.

              </td>


              <td class="product">

                <%= challan.ProductName || "N/A" %>

              </td>


              <td>

                <%= challan.Hsn || "N/A" %>

              </td>


              <td class="batch">

                <%= challan.BatchNumber || "N/A" %>

              </td>


              <td>

                <%= challan.ExpiryDate
                  ? new Date(challan.ExpiryDate)
                      .toLocaleDateString('en-IN', {
                        month: 'short',
                        year: 'numeric'
                      })
                  : "N/A"
                %>

              </td>


              <td class="fw-bold">

                <%= challan.QuantitySold || 0 %>

              </td>


            </tr>


          <% }); %>


        </tbody>


      </table>


      <!-- ===================================================
           BANK + TERMS
      ==================================================== -->

      <div class="row bottom-section">


        <!-- BANK DETAILS -->

        <div class="col-md-6 bottom-panel border-right">


          <div class="bottom-heading">

            Bank Details

          </div>


          <div class="bank-row">

            <strong>Account Holder:</strong>

            <%= companyDetails.coreCompany || "N/A" %>

          </div>


          <div class="bank-row">

            <strong>Bank Name:</strong>

            <%= companyDetails.coreCompanyBankName || "N/A" %>

          </div>


          <div class="bank-row">

            <strong>Branch Name:</strong>

            <%= companyDetails.coreCompanyBranchName || "N/A" %>

          </div>


          <div class="bank-row">

            <strong>Account Number:</strong>

            <%= companyDetails.coreCompanyAccountNo || "N/A" %>

          </div>


          <div class="bank-row">

            <strong>IFSC Code:</strong>

            <%= companyDetails.coreCompanyIFSCCode || "N/A" %>

          </div>


        </div>


        <!-- TERMS -->

        <div class="col-md-6 bottom-panel">


          <div class="bottom-heading">

            Terms &amp; Conditions

          </div>


          <ol class="terms">

            <li>

              Goods once sold will not be taken back.

            </li>

            <li>

              All disputes subject to Patna jurisdiction only.

            </li>

            <li>

              Our responsibility ceases as soon as goods leave our premises.

            </li>

            <li>

              Delivery ex-premises.

            </li>

          </ol>


        </div>


      </div>


      <!-- ===================================================
           SIGNATURES
      ==================================================== -->

      <div class="row signature-section text-center">


        <div class="col-6">

          <div class="signature-title">

            Recipient Signatory

          </div>


          <div class="signature-line"></div>


          <div class="signature-label">

            Signature

          </div>

        </div>


        <div class="col-6">

          <div class="signature-title">

            Authorized Signatory

          </div>


          <div class="signature-line"></div>


          <div class="signature-label">

            <%= companyDetails.coreCompany || "Authorized Signatory" %>

          </div>

        </div>


      </div>


      <!-- ===================================================
           FOOTER
      ==================================================== -->

      <div class="challan-footer">

        This is a computer-generated delivery challan.

        No signature is required if digitally authenticated.

      </div>


    </div>

  </div>


  <!-- =======================================================
       AUTO PRINT
  ======================================================== -->

  <script>

    document.addEventListener(
      'DOMContentLoaded',
      function () {

        const params =
          new URLSearchParams(window.location.search);

        const isPrint =
          params.get('print') === 'true';


        if (isPrint) {

          setTimeout(
            function () {

              window.print();

            },
            500
          );

        }

      }
    );


    /*
     * Remove ?print=true after printing.
     * This prevents repeated printing on refresh.
     */

    window.addEventListener(
      'afterprint',
      function () {

        try {

          const url =
            new URL(window.location.href);


          if (
            url.searchParams.get('print') === 'true'
          ) {

            url.searchParams.delete('print');


            window.history.replaceState(
              {},
              document.title,
              url.pathname + url.search
            );

          }

        } catch (error) {

          console.log(
            'Unable to clean print URL:',
            error
          );

        }

      }
    );

  </script>


</body>

</html>