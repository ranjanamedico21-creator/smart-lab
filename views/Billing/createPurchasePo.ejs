
<!-- Purchase PO Form Section -->
<section class="pb-5">
  <div class="container-fluid">
    <div class="card border-0 shadow-lg rounded-3 overflow-hidden">
      <div class="card-header bg-primary text-white text-center py-3">
        <h4 class="mb-0 fw-bold"><i class="bi bi-cart-plus me-2"></i>Purchase PO</h4>
      </div>
      
      <div class="card-body p-4">
        <%- include ("../partials/messages"); %>

        <form action="/billing/createPurchasePo" class="needs-validation" novalidate method="POST">
          <!-- Supplier Selection -->
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label for="supplierIdPurchasePo" class="form-label fw-bold">Supplier</label>
              <select name="supplierId" id="supplierIdPurchasePo" class="form-control" required>
                <option value="" disabled selected>Select a supplier</option>
                <% suppliers.forEach(supplier => { %>
                  <option value="<%= supplier.Id %>"><%= supplier.Name %></option>
                <% }); %>
              </select>
              <div class="invalid-feedback">Please select a supplier.</div>
            </div>
            <div class="col-md-4">
              <label for="purchasePoDate" class="form-label fw-semibold">Po Date <span class="text-danger">*</span></label>
              <input type="text" id="purchasePoDate" name="purchasePoDate" class="form-control"
                placeholder="e.g., 03-03-2025"
                value="<%= typeof purchasePoDate !== 'undefined' ? purchasePoDate : '' %>"
                autocomplete="off" required>
              <div class="invalid-feedback">Purchase Po date is required.</div>
            </div>
          </div>

          <!-- Product List Section -->
          <div id="productList" class="mb-4">
            <div class="product-item row g-3 mb-3">
              <div class="col-md-3">
                <label class="form-label fw-bold">Product</label>
                <select name="productId[]" class="form-control ppProduct" data-live-search="true" required>
                  <option value="" disabled selected>Select a product</option>
                  <% products.forEach(product => { %>
                    <option data-supplier-id="<%= product.SupplierId %>" value="<%= product.Id %>"><%= product.ProductName %></option>
                  <% }); %>
                </select>
                <div class="invalid-feedback">Please select a product.</div>
              </div>
              <div class="col-md-2">
                <label class="form-label fw-bold">Quantity</label>
                <input type="number" name="quantity[]" class="form-control" min="1" required>
                <div class="invalid-feedback">Quantity is required.</div>
              </div>
              <div class="col-md-2">
                <label class="form-label fw-bold">MRP</label>
                <input type="number" name="mrp[]" class="form-control" step="0.01" required>
                <div class="invalid-feedback">MRP is required.</div>
              </div>
              <div class="col-md-2">
                <label class="form-label fw-bold">Purchase Price</label>
                <input type="number" name="purchasePrice[]" class="form-control" step="0.01" required>
                <div class="invalid-feedback">Price is required.</div>
              </div>
              <div class="col-md-2">
                <label class="form-label fw-bold">IGST (%)</label>
                <input type="number" name="igst[]" class="form-control" step="0.01" required>
                <div class="invalid-feedback">IGST is required.</div>
              </div>
              <div class="col-md-1 d-flex align-items-end justify-content-center">
                <!--button type="button" class="btn btn-danger removeProduct"><i class="bi bi-trash"></i></button-->
              </div>
            </div>
          </div>
          
          <!-- Add More Button -->
          <div class="row mb-4">
            <div class="col text-center">
              <button type="button" id="addProduct" class="btn btn-success"><i class="bi bi-plus-circle me-2"></i>Add More</button>
            </div>
            <div class="col text-center">
              <a href="/billing/viewPurchasePo" class="btn btn-primary">View Purchase Po</a>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="row">
            <div class="col text-center">
              <button type="submit" class="btn btn-primary px-5">Submit Purchase PO</button>
            </div>
          </div>
          <input type="hidden" name="supplierId" id="supplier">
        </form>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const supplierDropdown = document.getElementById("supplierIdPurchasePo");
    const productList = document.getElementById("productList");
    const addProductButton = document.getElementById("addProduct");
    
    // Store all products data from server
    const allProducts = <%- JSON.stringify(products) %>;

    // Initialize Tom Select for supplier dropdown
    let supplierTomSelect = null;
    if (supplierDropdown) {
        supplierTomSelect = new TomSelect(supplierDropdown, {
            allowEmptyOption: true,
            maxOptions: 300,
            placeholder: 'Select a supplier',
            onChange: function(value) {
                if (value) {
                    // Lock supplier selection
                    this.disable();
                    document.getElementById('supplier').value = value;
                    
                    // Filter all existing product dropdowns
                    filterAllProductDropdowns(parseInt(value));
                }
            }
        });
    }

    // Initialize Tom Select for first product dropdown
    initProductDropdown(document.querySelector('.ppProduct'));

    // Function to initialize Tom Select on a product dropdown
    function initProductDropdown(selectElement, supplierId) {
        if (!selectElement) return;
        
        // If already initialized, destroy first
        if (selectElement.tomselect) {
            selectElement.tomselect.destroy();
        }

        // Get supplier ID for filtering (if not passed, try to get from locked supplier)
        const currentSupplierId = supplierId || (supplierTomSelect ? parseInt(supplierTomSelect.getValue()) : null);

        // Build options array based on supplier filter
        const options = [];
        const optionElements = selectElement.querySelectorAll('option');
        
        optionElements.forEach(opt => {
            const optSupplierId = opt.getAttribute('data-supplier-id');
            const value = opt.value;
            const text = opt.textContent;
            
            // Include placeholder and matching supplier products
            if (!value || !currentSupplierId || (optSupplierId && parseInt(optSupplierId) === currentSupplierId)) {
                options.push({
                    value: value,
                    text: text,
                    supplierId: optSupplierId ? parseInt(optSupplierId) : null
                });
            }
        });

        // Initialize Tom Select
        const ts = new TomSelect(selectElement, {
            allowEmptyOption: true,
            maxOptions: 300,
            placeholder: 'Select a product',
            options: options,
            render: {
                option: function(data, escape) {
                    return '<div>' + escape(data.text) + '</div>';
                },
                item: function(data, escape) {
                    return '<div>' + escape(data.text) + '</div>';
                }
            }
        });

        return ts;
    }

    // Filter all existing product dropdowns when supplier changes
    function filterAllProductDropdowns(supplierId) {
        const productSelects = document.querySelectorAll('.ppProduct');
        productSelects.forEach(select => {
            // Clear current selection
            if (select.tomselect) {
                select.tomselect.clear();
                select.tomselect.destroy();
            }
            
            // Rebuild with filtered options
            initProductDropdown(select, supplierId);
        });
    }

    // Function to add a new product row
    function addProductRow() {
        const supplierId = supplierTomSelect ? parseInt(supplierTomSelect.getValue()) : null;
        
        // Create new row HTML
        const newRow = document.createElement('div');
        newRow.className = 'product-item row g-3 mb-3';
        newRow.innerHTML = `
            <div class="col-md-3">
                <label class="form-label fw-bold">Product</label>
                <select name="productId[]" class="form-control ppProduct" data-live-search="true" required>
                    <option value="" disabled selected>Select a product</option>
                    ${allProducts.map(product => {
                        // Only include options for selected supplier or all if no supplier selected
                        if (!supplierId || product.SupplierId === supplierId) {
                            return `<option data-supplier-id="${product.SupplierId}" value="${product.Id}">${product.ProductName}</option>`;
                        }
                        return '';
                    }).join('')}
                </select>
                <div class="invalid-feedback">Please select a product.</div>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Quantity</label>
                <input type="number" name="quantity[]" class="form-control" min="1" required>
                <div class="invalid-feedback">Quantity is required.</div>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">MRP</label>
                <input type="number" name="mrp[]" class="form-control" step="0.01" required>
                <div class="invalid-feedback">MRP is required.</div>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Purchase Price</label>
                <input type="number" name="purchasePrice[]" class="form-control" step="0.01" required>
                <div class="invalid-feedback">Price is required.</div>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">IGST (%)</label>
                <input type="number" name="igst[]" class="form-control" step="0.01" required>
                <div class="invalid-feedback">IGST is required.</div>
            </div>
            <div class="col-md-1 d-flex align-items-end justify-content-center">
                <button type="button" class="btn btn-danger removeProduct"><i class="bi bi-trash"></i></button>
            </div>
        `;

        productList.appendChild(newRow);

        // Initialize Tom Select on the new product dropdown
        const newSelect = newRow.querySelector('.ppProduct');
        initProductDropdown(newSelect, supplierId);

        // Remove invalid feedback on new inputs
        newRow.querySelectorAll('.form-control').forEach(input => {
            input.classList.remove('is-invalid');
        });
    }

    // Event listener for adding products
    addProductButton.addEventListener("click", function () {
        addProductRow();
    });

    // Event listener for removing products
    productList.addEventListener("click", function (event) {
        if (event.target.closest(".removeProduct")) {
            const row = event.target.closest(".product-item");
            
            // Destroy Tom Select before removing to prevent memory leaks
            const select = row.querySelector('.ppProduct');
            if (select && select.tomselect) {
                select.tomselect.destroy();
            }
            
            row.remove();

            // If no products left, enable supplier dropdown again
            if (productList.querySelectorAll('.product-item').length === 0) {
                if (supplierTomSelect) {
                    supplierTomSelect.enable();
                    supplierTomSelect.clear();
                }
                document.getElementById('supplier').value = '';
            }
        }
    });

    // Form validation
    const form = document.querySelector('form.needs-validation');
    form.addEventListener('submit', function(event) {
        if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
        }
        form.classList.add('was-validated');
    });
});
</script>