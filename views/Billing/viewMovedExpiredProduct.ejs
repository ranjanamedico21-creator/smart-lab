<%- include("../partials/messages"); %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

  :root {
    --navy: #0f172a;
    --navy-mid: #1e293b;
    --navy-light: #334155;
    --slate: #64748b;
    --amber: #f59e0b;
    --amber-light: #fef3c7;
    --emerald: #10b981;
    --emerald-light: #d1fae5;
    --rose: #f43f5e;
    --rose-light: #ffe4e6;
    --sky: #0ea5e9;
    --sky-light: #e0f2fe;
    --border: #e2e8f0;
    --bg: #f8fafc;
    --white: #ffffff;
    --text: #0f172a;
    --muted: #94a3b8;
  }

  body { font-family: 'DM Sans', sans-serif; }

  /* ── PAGE HEADER ─────────────────────────────── */
  .page-header {
    background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%);
    padding: 28px 32px 24px;
    color: #fff;
    position: relative;
    overflow: hidden;
    margin-bottom: 0;
  }
  .page-header::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 220px; height: 220px;
    background: var(--amber);
    opacity: 0.07;
    border-radius: 50%;
  }
  .page-header::after {
    content: '';
    position: absolute;
    bottom: -40px; left: 40%;
    width: 140px; height: 140px;
    background: var(--sky);
    opacity: 0.06;
    border-radius: 50%;
  }
  .page-header h4 {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.3px;
    margin: 0 0 4px;
  }
  .page-header .subtitle {
    font-size: 0.8rem;
    color: #94a3b8;
    font-weight: 400;
  }
  .header-badge {
    background: rgba(245,158,11,0.18);
    color: var(--amber);
    border: 1px solid rgba(245,158,11,0.35);
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 14px;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  /* ── SUMMARY CARDS ───────────────────────────── */
  .stat-card {
    background: var(--white);
    border-radius: 14px;
    border: 1px solid var(--border);
    padding: 20px 22px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .stat-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,0.09);
    transform: translateY(-2px);
  }
  .stat-icon {
    width: 48px; height: 48px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
  }
  .stat-icon.rose    { background: var(--rose-light);    color: var(--rose);    }
  .stat-icon.sky     { background: var(--sky-light);     color: var(--sky);     }
  .stat-icon.emerald { background: var(--emerald-light); color: var(--emerald); }
  .stat-label {
    font-size: 0.7rem;
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 4px;
  }
  .stat-value {
    font-size: 1.3rem;
    font-weight: 700;
    font-family: 'DM Mono', monospace;
    line-height: 1;
  }
  .stat-value.rose    { color: var(--rose); }
  .stat-value.sky     { color: var(--sky); }
  .stat-value.emerald { color: var(--emerald); }

  /* ── FILTER CARD ─────────────────────────────── */
  .filter-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px 22px;
  }
  .filter-card .form-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--slate);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-bottom: 6px;
  }
  .filter-card .form-control,
  .filter-card .form-select {
    border: 1.5px solid var(--border);
    border-radius: 9px;
    font-size: 0.875rem;
    padding: 9px 14px;
    background: var(--bg);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .filter-card .form-control:focus,
  .filter-card .form-select:focus {
    border-color: var(--amber);
    box-shadow: 0 0 0 3px rgba(245,158,11,0.12);
    background: #fff;
  }
  .btn-filter {
    background: var(--navy);
    color: #fff;
    border: none;
    border-radius: 9px;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 10px 18px;
    transition: background 0.15s, transform 0.1s;
  }
  .btn-filter:hover { background: var(--navy-light); color: #fff; transform: translateY(-1px); }
  .btn-move {
    background: transparent;
    color: var(--navy);
    border: 1.5px solid var(--border);
    border-radius: 9px;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 10px 18px;
    transition: all 0.15s;
    text-decoration: none;
    display: inline-block;
    text-align: center;
  }
  .btn-move:hover {
    border-color: var(--amber);
    color: var(--amber);
    background: var(--amber-light);
  }

  /* ── TABLE ───────────────────────────────────── */
  .table-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }
  .table-card table { margin: 0; font-size: 0.85rem; }
  .table-card thead tr {
    background: var(--bg);
    border-bottom: 2px solid var(--border);
  }
  .table-card thead th {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--slate);
    padding: 13px 16px;
    border: none;
    white-space: nowrap;
  }
  .table-card tbody tr {
    border-bottom: 1px solid #f1f5f9;
    transition: background 0.12s;
  }
  .table-card tbody tr:last-child { border-bottom: none; }
  .table-card tbody tr:hover { background: #f8fafc; }
  .table-card tbody tr.settled-row { background: #f0fdf4; }
  .table-card tbody tr.settled-row:hover { background: #dcfce7; }
  .table-card tbody td {
    padding: 13px 16px;
    vertical-align: middle;
    border: none;
  }

  .serial-num {
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .supplier-name { font-weight: 600; font-size: 0.85rem; }
  .product-name  { font-size: 0.83rem; color: var(--navy-light); }

  .badge-batch {
    background: #f1f5f9;
    color: var(--slate);
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    border-radius: 6px;
    padding: 3px 8px;
    font-weight: 500;
  }
  .badge-expiry {
    background: var(--rose-light);
    color: var(--rose);
    font-size: 0.72rem;
    border-radius: 6px;
    padding: 4px 9px;
    font-weight: 600;
  }

  .amount { font-family: 'DM Mono', monospace; font-size: 0.82rem; font-weight: 500; }
  .amount.expired           { color: var(--rose); }
  .amount.settled           { color: var(--sky); }
  .amount.remaining-danger  { color: var(--rose);    font-weight: 700; }
  .amount.remaining-ok      { color: var(--emerald); font-weight: 700; }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    border-radius: 20px;
    padding: 4px 12px;
  }
  .status-badge .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .status-badge.pending { background: var(--rose-light);    color: var(--rose);    }
  .status-badge.partial { background: #fef9c3;              color: #854d0e;        }
  .status-badge.settled { background: var(--emerald-light); color: var(--emerald); }

  .btn-settle {
    background: var(--navy);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 6px 14px;
    cursor: pointer;
    transition: background 0.15s, transform 0.1s;
  }
  .btn-settle:hover { background: var(--amber); transform: translateY(-1px); }

  .completed-tag {
    font-size: 0.72rem;
    color: var(--emerald);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* ── PAGINATION ──────────────────────────────── */
  .pagination .page-link {
    border-radius: 8px !important;
    margin: 0 2px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--navy);
    border: 1.5px solid var(--border);
    padding: 6px 13px;
  }
  .pagination .page-item.active .page-link {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .pagination .page-link:hover {
    background: var(--amber-light);
    border-color: var(--amber);
    color: var(--amber);
  }

  /* ── MODAL ───────────────────────────────────── */
  .modal-content {
    border: none;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(0,0,0,0.18);
  }
  .modal-header {
    background: var(--navy);
    color: #fff;
    border: none;
    padding: 20px 24px;
  }
  .modal-header .btn-close { filter: invert(1); }
  .modal-title { font-weight: 700; font-size: 1rem; }
  .modal-subtitle { font-size: 0.75rem; color: #94a3b8; margin-top: 2px; }

  .modal-alert {
    background: #fffbeb;
    border: 1.5px solid #fde68a;
    border-radius: 10px;
    padding: 16px 20px;
  }
  .modal-alert-label {
    font-size: 0.68rem;
    color: #92400e;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 700;
    margin-bottom: 3px;
  }
  .modal-alert-value {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--navy-mid);
  }
  .modal-alert-amount {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--rose);
    font-family: 'DM Mono', monospace;
  }

  .modal-body { padding: 22px 24px; }
  .modal-footer { border-top: 1px solid var(--border); padding: 16px 24px; gap: 10px; }

  .modal-body .form-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--slate);
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }
  .modal-body .form-control {
    border: 1.5px solid var(--border);
    border-radius: 9px;
    font-size: 0.875rem;
    padding: 9px 14px;
  }
  .modal-body .form-control:focus {
    border-color: var(--amber);
    box-shadow: 0 0 0 3px rgba(245,158,11,0.12);
  }
  .modal-body .input-group-text {
    background: var(--bg);
    border: 1.5px solid var(--border);
    border-right: none;
    border-radius: 9px 0 0 9px;
    color: var(--muted);
  }
  .modal-body .input-group .form-control {
    border-left: none;
    border-radius: 0 9px 9px 0;
  }

  .invoice-empty {
    background: var(--bg);
    border: 1.5px dashed var(--border);
    border-radius: 10px;
    padding: 28px;
    text-align: center;
    color: var(--muted);
    font-size: 0.83rem;
  }
  .invoice-empty i { font-size: 1.8rem; display: block; margin-bottom: 8px; opacity: 0.4; }

  .btn-confirm {
    background: var(--navy);
    color: #fff;
    border: none;
    border-radius: 9px;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 10px 22px;
    transition: background 0.15s;
    cursor: pointer;
  }
  .btn-confirm:hover { background: var(--amber); color: #fff; }
  .btn-cancel {
    background: transparent;
    color: var(--slate);
    border: 1.5px solid var(--border);
    border-radius: 9px;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 10px 18px;
    cursor: pointer;
  }
  .btn-cancel:hover { border-color: var(--rose); color: var(--rose); }
</style>

<%
  let totalExpired   = 0;
  let totalSettled   = 0;
  let totalRemaining = 0;
  expiredList.forEach(row => {
    totalExpired   += Number(row.ExpiredAmount   || 0);
    totalSettled   += Number(row.SettledAmount   || 0);
    totalRemaining += Number(row.RemainingAmount || 0);
  });
%>

<!-- ── HEADER ──────────────────────────────────────── -->
<div class="page-header d-flex justify-content-between align-items-center">
  <div>
    <h4><i class="bi bi-box-seam me-2 opacity-75"></i>Expired Stock Settlement</h4>
    <div class="subtitle">Manage and settle expired inventory with suppliers</div>
  </div>
  <span class="header-badge"><%= pagination.totalRecords %> Records</span>
</div>

<div class="px-4 py-4">

  <!-- ── SUMMARY CARDS ─────────────────────────────── -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="stat-card">
        <div class="stat-icon rose"><i class="bi bi-exclamation-triangle-fill"></i></div>
        <div>
          <div class="stat-label">Total Expired</div>
          <div class="stat-value rose">₹ <%= totalExpired.toFixed(2) %></div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card">
        <div class="stat-icon sky"><i class="bi bi-check2-circle"></i></div>
        <div>
          <div class="stat-label">Total Settled</div>
          <div class="stat-value sky">₹ <%= totalSettled.toFixed(2) %></div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card">
        <div class="stat-icon emerald"><i class="bi bi-wallet2"></i></div>
        <div>
          <div class="stat-label">Total Remaining</div>
          <div class="stat-value emerald">₹ <%= totalRemaining.toFixed(2) %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── FILTER ─────────────────────────────────────── -->
  <div class="filter-card mb-4">
    <form method="post" action="/billing/listExpiredProduct">
      <div class="row g-3 align-items-end">

        <div class="col-md-4">
          <label class="form-label">Supplier</label>
          <select name="supplierId" class="form-select">
            <option value="">All Suppliers</option>
            <% suppliers.forEach(s => { %>
              <option value="<%= s.Id %>" <%= filters.supplierId == s.Id ? 'selected' : '' %>>
                <%= s.Name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">Status</label>
          <select name="status" class="form-select">
            <option value="">All Statuses</option>
            <option value="PENDING"  <%= filters.status === 'PENDING'  ? 'selected' : '' %>>Pending</option>
            <option value="PARTIAL"  <%= filters.status === 'PARTIAL'  ? 'selected' : '' %>>Partial</option>
            <option value="SETTLED"  <%= filters.status === 'SETTLED'  ? 'selected' : '' %>>Settled</option>
          </select>
        </div>

        <div class="col-md-2">
          <button type="submit" class="btn-filter w-100">
            <i class="bi bi-search me-1"></i> Filter
          </button>
        </div>

        <div class="col-md-2">
          <a href="/billing/moveExpiredProductToSupplier/<%= filters.status %>/<%= filters.supplierId %>"
             class="btn-move w-100">
            <i class="bi bi-arrow-right-circle me-1"></i> Move
          </a>
        </div>

      </div>
    </form>
  </div>

  <!-- ── TABLE ──────────────────────────────────────── -->
  <div class="table-card mb-4">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>#</th>
            <th>Supplier</th>
            <th>Product</th>
            <th>Batch</th>
            <th>Expiry</th>
            <th class="text-end">Qty</th>
            <th class="text-end">Expired ₹</th>
            <th class="text-end">Settled ₹</th>
            <th class="text-end">Remaining ₹</th>
            <th class="text-center">Status</th>
            <th class="text-center">Action</th>
          </tr>
        </thead>
        <tbody>

          <% if (expiredList.length === 0) { %>
            <tr>
              <td colspan="11">
                <div style="padding:60px 20px;text-align:center;color:var(--muted);">
                  <i class="bi bi-inbox" style="font-size:2.5rem;display:block;margin-bottom:10px;opacity:0.35;"></i>
                  No expired records found
                </div>
              </td>
            </tr>
          <% } %>

          <% expiredList.forEach((row, i) => {
            const settled   = Number(row.SettledAmount   || 0);
            const remaining = Number(row.RemainingAmount || 0);
            const serial    = ((pagination.currentPage - 1) * pagination.limit) + i + 1;

            let statusClass = 'pending';
            let statusText  = 'Pending';
            if (remaining <= 0) {
              statusClass = 'settled';
              statusText  = 'Settled';
            } else if (settled > 0) {
              statusClass = 'partial';
              statusText  = 'Partial';
            }
          %>

          <tr class="<%= remaining <= 0 ? 'settled-row' : '' %>">

            <td><span class="serial-num"><%= String(serial).padStart(2,'0') %></span></td>

            <td><span class="supplier-name"><%= row.SupplierName %></span></td>

            <td><span class="product-name"><%= row.ProductName %></span></td>

            <td><span class="badge-batch"><%= row.BatchNumber %></span></td>

            <td>
              <span class="badge-expiry">
                <i class="bi bi-calendar-x me-1"></i>
                <%= new Date(row.ExpiryDate).toLocaleDateString('en-GB').replace(/\//g, '-') %>
              </span>
            </td>

            <td class="text-end fw-semibold"><%= row.ExpiredQty %></td>

            <td class="text-end">
              <span class="amount expired">₹ <%= Number(row.ExpiredAmount).toFixed(2) %></span>
            </td>

            <td class="text-end">
              <span class="amount settled">₹ <%= settled.toFixed(2) %></span>
            </td>

            <td class="text-end">
              <span class="amount <%= remaining > 0 ? 'remaining-danger' : 'remaining-ok' %>">
                ₹ <%= remaining.toFixed(2) %>
              </span>
            </td>

            <td class="text-center">
              <span class="status-badge <%= statusClass %>">
                <span class="dot"></span><%= statusText %>
              </span>
            </td>

            <td class="text-center">
              <% if (remaining > 0) { %>
                <button
                  class="btn-settle open-settle-modal"
                  data-id="<%= row.Id %>"
                  data-product="<%= row.ProductName %>"
                  data-supplier="<%= row.SupplierName %>"
                  data-remaining="<%= row.RemainingAmount %>"
                  data-supplierid="<%= row.SupplierId %>">
                  Settle
                </button>
              <% } else { %>
                <span class="completed-tag">
                  <i class="bi bi-check-circle-fill"></i> Completed
                </span>
              <% } %>
            </td>

          </tr>
          <% }) %>

        </tbody>
      </table>
    </div>
  </div>

  <!-- ── PAGINATION ─────────────────────────────────── -->
  <% if (pagination.totalPages > 1) { %>
    <nav>
      <ul class="pagination pagination-sm justify-content-center">

        <li class="page-item <%= pagination.currentPage === 1 ? 'disabled' : '' %>">
          <a class="page-link"
             href="?page=<%= pagination.currentPage - 1 %>&supplierId=<%= filters.supplierId || '' %>&status=<%= filters.status || '' %>">
            <i class="bi bi-chevron-left"></i>
          </a>
        </li>

        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
          <li class="page-item <%= pagination.currentPage === i ? 'active' : '' %>">
            <a class="page-link"
               href="?page=<%= i %>&supplierId=<%= filters.supplierId || '' %>&status=<%= filters.status || '' %>">
              <%= i %>
            </a>
          </li>
        <% } %>

        <li class="page-item <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>">
          <a class="page-link"
             href="?page=<%= pagination.currentPage + 1 %>&supplierId=<%= filters.supplierId || '' %>&status=<%= filters.status || '' %>">
            <i class="bi bi-chevron-right"></i>
          </a>
        </li>

      </ul>
    </nav>
  <% } %>

</div><!-- /px-4 -->


<!-- ── SETTLEMENT MODAL ────────────────────────────── -->
<div class="modal fade" id="settlementModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content shadow">

      <div class="modal-header">
        <div>
          <div class="modal-title">
            <i class="bi bi-box-seam me-2 opacity-75"></i>Expired Stock Settlement
          </div>
          <div class="modal-subtitle">Select an invoice to apply settlement</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <!-- Info Row -->
        <div class="modal-alert mb-4">
          <div class="row g-3">
            <div class="col-md-4">
              <div class="modal-alert-label">Product</div>
              <div class="modal-alert-value" id="modalProduct">—</div>
            </div>
            <div class="col-md-4">
              <div class="modal-alert-label">Supplier</div>
              <div class="modal-alert-value" id="modalSupplier">—</div>
            </div>
            <div class="col-md-4">
              <div class="modal-alert-label">Remaining Amount</div>
              <div class="modal-alert-amount">₹ <span id="modalRemaining">0.00</span></div>
            </div>
          </div>
        </div>

        <!-- Invoice Search -->
        <div class="mb-3">
          <label class="form-label">Search Supplier Invoice</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" id="invoiceSearch" class="form-control"
                   placeholder="Type invoice number...">
          </div>
        </div>

        <!-- Invoice List -->
        <div id="invoiceList" class="list-group mb-3"></div>

        <!-- Product Area -->
        <div id="invoiceProducts">
          <div class="invoice-empty">
            <i class="bi bi-file-earmark-text"></i>
            Select an invoice above to view its products
          </div>
        </div>

      </div>

      <div class="modal-footer">
        <button class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
        <button class="btn-confirm" id="confirmSettlement">
          <i class="bi bi-check2 me-1"></i> Confirm Settlement
        </button>
      </div>

    </div>
  </div>
</div>


<!-- ── MODAL JS ────────────────────────────────────── -->
<script>
  document.querySelectorAll('.open-settle-modal').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('modalProduct').textContent   = btn.dataset.product;
      document.getElementById('modalSupplier').textContent  = btn.dataset.supplier;
      document.getElementById('modalRemaining').textContent = parseFloat(btn.dataset.remaining).toFixed(2);

      // Reset search & lists
      document.getElementById('invoiceSearch').value = '';
      document.getElementById('invoiceList').innerHTML = '';
      document.getElementById('invoiceProducts').innerHTML = `
        <div class="invoice-empty">
          <i class="bi bi-file-earmark-text"></i>
          Select an invoice above to view its products
        </div>`;

      new bootstrap.Modal(document.getElementById('settlementModal')).show();
    });
  });
</script>
