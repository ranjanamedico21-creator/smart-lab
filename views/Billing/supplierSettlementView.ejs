<style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap');
  
    :root {
      --navy: #0f172a;
      --navy-mid: #1e293b;
      --navy-light: #334155;
      --slate: #64748b;
      --muted: #94a3b8;
      --border: #e2e8f0;
      --bg: #f8fafc;
      --white: #ffffff;
      --text: #0f172a;
      --green-bg: #EAF3DE; --green-text: #27500A;
      --amber-bg: #FAEEDA; --amber-text: #633806;
      --red-bg:   #FCEBEB; --red-text:   #791F1F;
      --green-val: #3B6D11;
      --red-val:   #A32D2D;
      --font: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --mono: 'DM Mono', monospace;
    }
  
    body { font-family: var(--font); color: var(--text); font-size: 14px; }
  
    /* ── WRAPPER ──────────────────────────────── */
    .sw { max-width: 1100px; margin: 0 auto; padding: 1.5rem 1.5rem 3rem; }
  
    /* ── CARD ─────────────────────────────────── */
    .sw-card {
      background: var(--white);
      border: 0.5px solid rgba(0,0,0,.1);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 1rem;
    }
  
    /* ── SECTION LABEL ────────────────────────── */
    .sw-label {
      font-size: 11px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: var(--slate);
      margin: 0 0 .85rem;
    }
  
    /* ── HEADER CHIP ──────────────────────────── */
    .chip {
      display: inline-flex;
      align-items: center;
      background: var(--bg);
      border: 0.5px solid rgba(0,0,0,.1);
      border-radius: 20px;
      padding: 4px 12px;
      font-size: 12px;
      color: var(--slate);
      margin-right: 6px;
    }
  
    /* ── STATUS BADGES ────────────────────────── */
    .badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 500;
      padding: 4px 13px;
      border-radius: 20px;
      letter-spacing: .03em;
    }
    .badge-settled { background: var(--green-bg); color: var(--green-text); }
    .badge-partial { background: var(--amber-bg); color: var(--amber-text); }
    .badge-pending { background: var(--red-bg);   color: var(--red-text);   }
  
    /* ── METRICS ──────────────────────────────── */
    .sw-metrics {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 1rem;
    }
    .sw-metric {
      background: var(--bg);
      border-radius: 8px;
      padding: 1rem 1.25rem;
    }
    .sw-metric-lbl {
      font-size: 11px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: var(--slate);
      margin: 0 0 6px;
    }
    .sw-metric-val {
      font-size: 22px;
      font-weight: 500;
      color: var(--text);
      margin: 0;
    }
    .sw-metric-val.pos { color: var(--green-val); }
    .sw-metric-val.neg { color: var(--red-val);   }
  
    /* ── TWO-COL ──────────────────────────────── */
    .sw-two-col {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
      gap: 1rem;
      margin-bottom: 1rem;
    }
  
    /* ── CREDIT NOTE ROWS ─────────────────────── */
    .cn-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      border-bottom: 0.5px solid rgba(0,0,0,.07);
    }
    .cn-row:last-child { border-bottom: none; }
    .cn-num  { font-size: 13px; font-weight: 500; color: var(--text); margin: 0; }
    .cn-date { font-size: 12px; color: var(--slate); margin: 2px 0 0; }
    .cn-amt  { font-size: 14px; font-weight: 500; color: var(--text); margin: 0; }
  
    /* ── TABLE ────────────────────────────────── */
    .sw-tbl { width: 100%; border-collapse: collapse; font-size: 13px; }
    .sw-tbl th {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: var(--slate);
      font-weight: 500;
      padding: 8px 12px;
      border-bottom: 0.5px solid rgba(0,0,0,.1);
      text-align: left;
      white-space: nowrap;
    }
    .sw-tbl td {
      padding: 11px 12px;
      border-bottom: 0.5px solid rgba(0,0,0,.06);
      color: var(--text);
      vertical-align: middle;
    }
    .sw-tbl tr:last-child td { border-bottom: none; }
    .sw-tbl tbody tr:hover td { background: #f9f9fb; }
    .sw-tbl .tr { text-align: right; }
    .sw-tbl .fw5 { font-weight: 500; }
  
    .batch-pill {
      font-family: var(--mono);
      font-size: 12px;
      background: var(--bg);
      border-radius: 4px;
      padding: 2px 7px;
    }
  
    /* ── LEDGER ZERO ──────────────────────────── */
    .ledger-zero { color: var(--green-val); font-weight: 500; }
  
    /* ── ACTION BAR ───────────────────────────── */
    .action-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 1.5rem;
      gap: 10px;
      flex-wrap: wrap;
      padding-top: 1rem;
      border-top: 0.5px solid var(--border);
    }
  
    /* ── BUTTONS ──────────────────────────────── */
    .btn-sw {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      font-size: 13px;
      font-weight: 500;
      border-radius: 8px;
      border: 0.5px solid rgba(0,0,0,.2);
      background: var(--white);
      color: var(--text);
      cursor: pointer;
      text-decoration: none;
      transition: background .12s;
      font-family: var(--font);
    }
    .btn-sw:hover { background: var(--bg); color: var(--text); }
  
    .btn-sw-primary {
      background: var(--navy);
      color: #fff;
      border-color: var(--navy);
    }
    .btn-sw-primary:hover { background: var(--navy-light); color: #fff; }
  
    .btn-sw-danger { border-color: var(--red-val); color: var(--red-val); }
    .btn-sw-danger:hover { background: var(--red-bg); }
  
    /* ── RESPONSIVE ───────────────────────────── */
    @media (max-width: 640px) {
      .sw-metrics   { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .sw-two-col   { grid-template-columns: 1fr; }
    }
  
    @media print {
      body { background: white; }
      .action-bar { display: none; }
      .sw-card { box-shadow: none; border: 1px solid #ddd; }
    }
  </style>
  
  <%
    let totalAccepted = 0;
    let totalRejected = 0;
    let totalAmount   = 0;
    let totalWriteoff = 0;
  
    data.items.forEach(i => {
      totalAccepted += parseFloat(i.AcceptedQuantity || 0);
      totalRejected += (i.Quantity - i.AcceptedQuantity);
      totalAmount   += parseFloat(i.SettledAmount || 0);
    });
  
    data.writeoffs.forEach(w => {
      totalWriteoff += parseFloat(w.TotalAmount || 0);
    });
  %>
  
  <div class="sw">
  
    <!-- ── HEADER ──────────────────────────────── -->
    <div class="sw-card">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap">
        <div>
          <p style="font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--slate);margin:0 0 5px">
            Supplier Settlement
          </p>
          <p style="font-size:21px;font-weight:500;color:var(--text);margin:0 0 10px">
            <%= data.header.SupplierName %>
          </p>
          <div>
            <span class="chip">Return <%= data.header.ReturnNumber %></span>
            <% if (data.header.SettlementDate) { %>
              <span class="chip"><%= data.header.SettlementDate %></span>
            <% } %>
          </div>
        </div>
        <div style="margin-top:4px">
          <% if (data.header.Status === 'SETTLED') { %>
            <span class="badge badge-settled" style="font-size:12px;padding:5px 16px">Settled</span>
          <% } else if (data.header.Status === 'PARTIAL') { %>
            <span class="badge badge-partial" style="font-size:12px;padding:5px 16px">Partial</span>
          <% } else { %>
            <span class="badge badge-pending" style="font-size:12px;padding:5px 16px">Pending</span>
          <% } %>
        </div>
      </div>
    </div>
  
    <!-- ── METRICS ──────────────────────────────── -->
    <div class="sw-metrics">
      <div class="sw-metric">
        <p class="sw-metric-lbl">Accepted qty</p>
        <p class="sw-metric-val"><%= totalAccepted.toFixed(2) %></p>
      </div>
      <div class="sw-metric">
        <p class="sw-metric-lbl"><%= data.header.IsLocked ? 'Rejected qty' : 'Pending qty' %></p>
        <p class="sw-metric-val"><%= totalRejected.toFixed(2) %></p>
      </div>
      <div class="sw-metric">
        <p class="sw-metric-lbl">Total credit</p>
        <p class="sw-metric-val pos">₹ <%= totalAmount.toFixed(2) %></p>
      </div>
      <div class="sw-metric">
        <p class="sw-metric-lbl">Write-off</p>
        <p class="sw-metric-val neg">₹ <%= totalWriteoff.toFixed(2) %></p>
      </div>
    </div>
  
    <!-- ── CREDIT NOTES + WRITE-OFF ─────────────── -->
    <div class="sw-two-col">
  
      <!-- Credit Notes -->
      <div class="sw-card" style="margin:0">
        <p class="sw-label">Credit notes</p>
        <% if (data.creditNotes.length) { %>
          <% data.creditNotes.forEach(cn => { %>
            <div class="cn-row">
              <div>
                <p class="cn-num"><%= cn.CreditNoteNumber %></p>
                <p class="cn-date"><%= cn.CreditDate %></p>
              </div>
              <p class="cn-amt">₹ <%= parseFloat(cn.TotalAmount).toFixed(2) %></p>
            </div>
          <% }) %>
        <% } else { %>
          <p class="empty">No credit notes</p>
        <% } %>
      </div>
  
      <!-- Write-off -->
      <div class="sw-card" style="margin:0">
        <p class="sw-label">Write-off</p>
        <% if (data.writeoffs.length) { %>
          <div style="overflow-x:auto">
            <table class="sw-tbl">
              <thead>
                <tr>
                  <th>Product</th>
                  <th class="tr">Qty</th>
                  <th class="tr">Rate</th>
                  <th class="tr">Total</th>
                </tr>
              </thead>
              <tbody>
                <% data.writeoffs.forEach(w => { %>
                  <tr>
                    <td><%= w.ProductId %></td>
                    <td class="tr"><%= w.RejectedQty %></td>
                    <td class="tr">₹ <%= parseFloat(w.Amount).toFixed(2) %></td>
                    <td class="tr fw5">₹ <%= parseFloat(w.TotalAmount).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="empty">No write-offs</p>
        <% } %>
      </div>
  
    </div>
  
    <!-- ── ITEMS ─────────────────────────────────── -->
    <div class="sw-card">
      <p class="sw-label">Items</p>
      <div style="overflow-x:auto">
        <table class="sw-tbl">
          <thead>
            <tr>
              <th>Product</th>
              <th>Batch</th>
              <th class="tr">Sent</th>
              <th class="tr">Accepted</th>
              <th class="tr">Rejected</th>
              <th class="tr">Settled amount</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% data.items.forEach(item => { %>
              <tr>
                <td class="fw5"><%= item.ProductName %></td>
                <td><span class="batch-pill"><%= item.BatchNumber || '—' %></span></td>
                <td class="tr"><%= item.Quantity %></td>
                <td class="tr"><%= item.AcceptedQuantity %></td>
                <td class="tr"><%= item.Quantity - item.AcceptedQuantity %></td>
                <td class="tr fw5">₹ <%= parseFloat(item.SettledAmount || 0).toFixed(2) %></td>
                <td>
                  <% if (item.Status === 'SETTLED') { %>
                    <span class="badge badge-settled">Settled</span>
                  <% } else if (item.Status === 'PARTIAL') { %>
                    <span class="badge badge-partial">Partial</span>
                  <% } else { %>
                    <span class="badge badge-pending">Pending</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  
    <!-- ── LEDGER ─────────────────────────────────── -->
    <div class="sw-card">
      <p class="sw-label">Ledger</p>
      <div style="overflow-x:auto">
        <table class="sw-tbl">
          <thead>
            <tr>
              <th>Type</th>
              <th>Reference</th>
              <th>Date</th>
              <th class="tr">Debit</th>
              <th class="tr">Credit</th>
              <th class="tr">Balance</th>
            </tr>
          </thead>
          <tbody>
            <% data.ledger.forEach((l, idx) => {
              const isLast  = idx === data.ledger.length - 1;
              const balance = parseFloat(l.BalanceAfter || 0);
            %>
              <tr>
                <td style="color:var(--slate);font-size:12px"><%= l.ReferenceType %></td>
                <td class="fw5"><%= l.ReferenceNumber %></td>
                <td style="color:var(--slate);font-size:12px"><%= l.EntryDate || '—' %></td>
                <td class="tr"><%= l.DebitAmount  ? '₹ ' + parseFloat(l.DebitAmount).toFixed(2)  : '—' %></td>
                <td class="tr"><%= l.CreditAmount ? '₹ ' + parseFloat(l.CreditAmount).toFixed(2) : '—' %></td>
                <td class="tr <%= isLast && balance === 0 ? 'ledger-zero' : 'fw5' %>">
                  ₹ <%= balance.toFixed(2) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  
    <!-- ── ACTIONS ─────────────────────────────────── -->
    <div class="action-bar">
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <% if (data.header.Status !== 'SETTLED') { %>
          <a href="/edit-settlement/<%= expiryReturnId %>" class="btn-sw btn-sw-primary">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M11 2l3 3-8 8H3v-3l8-8z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            </svg>
            Edit settlement
          </a>
        <% } else { %>
          <button class="btn-sw" disabled style="opacity:.45;cursor:not-allowed">
            Locked (Settled)
          </button>
        <% } %>
  
        <a href="/adjust-payment/<%= data.header.SupplierId %>" class="btn-sw">Adjust payment</a>
  
        <form action="/reverse-settlement" method="POST" style="margin:0;display:inline">
          <input type="hidden" name="expiryReturnId" value="<%= expiryReturnId %>">
          <button type="submit" class="btn-sw btn-sw-danger"
            onclick="return confirm('Reverse this settlement?')">
            Reverse
          </button>
        </form>
      </div>
  
      <button class="btn-sw" onclick="window.print()">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
          <rect x="3" y="1" width="10" height="8" rx="1" stroke="currentColor" stroke-width="1.4"/>
          <path d="M3 9v5h10V9" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M1 6h14v6H1z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        </svg>
        Print
      </button>
    </div>
  
  </div><!-- /sw -->
  