<!-- Breadcrumb -->
<div class="d-flex align-items-center gap-2 mb-4 text-muted small">
  <a href="/user/home" class="text-decoration-none text-primary">Home</a>
  <span>›</span>
  <span>Customer list</span>
</div>

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between mb-3">
  <div>
    <h5 class="fw-semibold mb-0">Customers</h5>
    <span class="text-muted small"><%= customers ? customers.length : 0 %> total customers</span>
  </div>
  <a href="/billing/createCustomer" class="btn btn-light btn-sm d-flex align-items-center gap-2 px-3">
    <i class="bi bi-plus" style="font-size:14px;"></i>
    Add customer
  </a>
</div>

<!-- Search & Filter Row -->
<div class="d-flex gap-2 mb-3">
  <div class="input-group input-group-sm" style="max-width:380px;">
    <span class="input-group-text bg-white border-end-0 text-muted">
      <i class="bi bi-search"></i>
    </span>
    <input type="text" class="form-control border-start-0 ps-0"
           placeholder="Search by name, mobile, GST..."
           id="customerSearch" oninput="filterCustomers()">
  </div>
  <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2">
    <i class="bi bi-funnel"></i>
    Filter
  </button>
</div>

<!-- Messages -->
<%- include("../partials/messages"); %>

<!-- Table Card -->
<div class="card border shadow-none rounded-3">

  <% if (customers && customers.length > 0) { %>

  <!-- ===== DESKTOP TABLE ===== -->
  <div class="table-responsive d-none d-md-block">
    <table class="table align-middle mb-0" id="customerTable">
      <thead style="background:#f8f9fa;">
        <tr class="text-uppercase small text-muted" style="font-size:11px; letter-spacing:.04em;">
          <th class="ps-4 fw-semibold border-bottom" style="width:48px;">#</th>
          <th class="fw-semibold border-bottom">Name</th>
          <th class="fw-semibold border-bottom">Mobile</th>
          <th class="fw-semibold border-bottom">GST no.</th>
          <th class="fw-semibold border-bottom">DL no.</th>
          <th class="fw-semibold border-bottom">Created</th>
          <th class="fw-semibold border-bottom text-end pe-4">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% let i = 0; customers.forEach(function(customer) { i++ %>
        <tr class="customer-row border-bottom" style="border-color:#f0f0f0 !important;">

          <td class="ps-4 text-muted small"><%= i %></td>

          <td>
            <div class="d-flex align-items-center gap-2">
              <!-- Avatar initials circle -->
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                   style="width:32px;height:32px;background:#e6f1fb;color:#185fa5;font-size:11px;font-weight:500;">
                <%= customer.CustomerName.split(' ').slice(0,2).map(w=>w[0]).join('').toUpperCase() %>
              </div>
              <a href="/billing/customerLedger/<%= customer.Id %>"
                 class="fw-semibold text-decoration-none text-dark customer-name text-capitalize">
                <%= customer.CustomerName %>
              </a>
            </div>
          </td>

          <td class="text-muted small"><%= customer.MobileNo %></td>

          <td>
            <% if (customer.GstNo) { %>
              <span class="badge rounded-pill fw-normal"
                    style="font-size:11px;background:#eaf3de;color:#3b6d11;border:0.5px solid #c0dd97;padding:4px 10px;">
                <%= customer.GstNo %>
              </span>
            <% } else { %>
              <span class="text-muted small">—</span>
            <% } %>
          </td>

          <td>
            <% if (customer.DlNo) { %>
              <span class="badge rounded-pill fw-normal"
                    style="font-size:11px;background:#e6f1fb;color:#185fa5;border:0.5px solid #b5d4f4;padding:4px 10px;">
                <%= customer.DlNo %>
              </span>
            <% } else { %>
              <span class="text-muted small">—</span>
            <% } %>
          </td>

          <td class="text-muted small">
            <%= new Date(customer.CreatedAt).toLocaleDateString('en-GB',{
              day:'2-digit', month:'short', year:'numeric'
            }) %>
          </td>

          <td class="text-end pe-4">
            <div class="d-flex align-items-center justify-content-end gap-2">
              <a href="/billing/updatePrice/<%= customer.Id %>"
                 class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                 style="font-size:12px;">
                Set price
              </a>
              <a href="/billing/editCustomer/<%= customer.Id %>"
                 class="btn btn-sm btn-light border d-flex align-items-center justify-content-center"
                 style="width:28px;height:28px;border-radius:6px !important;padding:0;">
                <i class="bi bi-pencil text-primary" style="font-size:12px;"></i>
              </a>
            </div>
          </td>

        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>


  <!-- ===== MOBILE CARD VIEW ===== -->
  <div class="d-md-none p-3" id="mobileCards">

    <% let j = 0; customers.forEach(function(customer) { j++ %>

    <div class="card border mb-3 rounded-3 shadow-none customer-mobile-card">
      <div class="card-body p-3">

        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-2">
          <div class="d-flex align-items-center gap-2">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:36px;height:36px;background:#e6f1fb;color:#185fa5;font-size:12px;font-weight:500;">
              <%= customer.CustomerName.split(' ').slice(0,2).map(w=>w[0]).join('').toUpperCase() %>
            </div>
            <div>
              <div class="fw-semibold" style="font-size:14px;"><%= customer.CustomerName %></div>
              <div class="text-muted" style="font-size:12px;">
                <i class="bi bi-telephone me-1"></i><%= customer.MobileNo %>
              </div>
            </div>
          </div>
          <a href="/billing/editCustomer/<%= customer.Id %>"
             class="btn btn-sm btn-light border d-flex align-items-center justify-content-center"
             style="width:30px;height:30px;border-radius:6px !important;padding:0;flex-shrink:0;">
            <i class="bi bi-pencil text-primary" style="font-size:12px;"></i>
          </a>
        </div>

        <!-- Badges -->
        <div class="d-flex flex-wrap gap-1 mb-2">
          <% if (customer.GstNo) { %>
            <span class="badge rounded-pill fw-normal"
                  style="font-size:11px;background:#eaf3de;color:#3b6d11;border:0.5px solid #c0dd97;padding:3px 9px;">
              GST: <%= customer.GstNo %>
            </span>
          <% } %>
          <% if (customer.DlNo) { %>
            <span class="badge rounded-pill fw-normal"
                  style="font-size:11px;background:#e6f1fb;color:#185fa5;border:0.5px solid #b5d4f4;padding:3px 9px;">
              DL: <%= customer.DlNo %>
            </span>
          <% } %>
          <% if (!customer.GstNo && !customer.DlNo) { %>
            <span class="text-muted" style="font-size:12px;">No GST / DL on file</span>
          <% } %>
        </div>

        <!-- Date -->
        <div class="text-muted mb-3" style="font-size:12px;">
          Since <%= new Date(customer.CreatedAt).toLocaleDateString('en-GB',{
            day:'2-digit', month:'short', year:'numeric'
          }) %>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex gap-2">
          <a href="/billing/customerLedger/<%= customer.Id %>"
             class="btn btn-sm btn-outline-secondary w-100 rounded-pill" style="font-size:12px;">
            View ledger
          </a>
          <a href="/billing/updatePrice/<%= customer.Id %>"
             class="btn btn-sm btn-dark w-100 rounded-pill" style="font-size:12px;">
            Set price
          </a>
        </div>

      </div>
    </div>

    <% }); %>
  </div>

  <!-- Table Footer -->
  <div class="d-flex align-items-center justify-content-between px-4 py-3 border-top"
       style="background:#f8f9fa;border-radius:0 0 calc(0.375rem - 1px) calc(0.375rem - 1px);">
    <span class="text-muted small" id="footerCount">
      Showing <%= customers.length %> of <%= customers.length %> customers
    </span>
    <nav>
      <ul class="pagination pagination-sm mb-0">
        <li class="page-item disabled"><a class="page-link">‹</a></li>
        <li class="page-item active"><a class="page-link">1</a></li>
        <li class="page-item disabled"><a class="page-link">›</a></li>
      </ul>
    </nav>
  </div>

  <% } else { %>

  <!-- Empty State -->
  <div class="text-center py-5 my-2">
    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
         style="width:56px;height:56px;background:#f1f3f4;">
      <i class="bi bi-people text-muted" style="font-size:24px;"></i>
    </div>
    <div class="fw-semibold text-muted mb-1">No customers yet</div>
    <div class="text-muted small mb-3">Add your first customer to get started</div>
    <a href="/billing/createCustomer" class="btn btn-sm btn-light px-4 rounded-pill">
      Add customer
    </a>
  </div>

  <% } %>

</div>

<!-- Search filter JS -->
<script>
function filterCustomers() {
  const q = document.getElementById('customerSearch').value.toLowerCase();
  const rows = document.querySelectorAll('#customerTable tbody .customer-row');
  const cards = document.querySelectorAll('.customer-mobile-card');
  let visible = 0;
  rows.forEach(function(row) {
    const text = row.textContent.toLowerCase();
    const show = text.includes(q);
    row.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  cards.forEach(function(card) {
    card.style.display = card.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
  const total = rows.length;
  const el = document.getElementById('footerCount');
  if (el) el.textContent = 'Showing ' + visible + ' of ' + total + ' customers';
}
</script>
