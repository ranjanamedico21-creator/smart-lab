<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Credit Note</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: #f9f9f9;
            font-size: 14px;
        }

        .credit-box {
            background: white;
            padding: 20px;
            min-height: 98vh;
            display: flex;
            flex-direction: column;
        }

        .credit-header {
            border-bottom: 2px solid #000;
        }

        .section-title {
            font-size: 15px;
            font-weight: 600;
            letter-spacing: .5px;
        }

        .customer-box {
            font-size: 14.5px;
            line-height: 1.6;
        }

        .customer-box strong {
            font-weight: 600;
        }

        .table th,
        .table td {
            padding: 6px;
            border: none !important;
        }

        .table thead th {
            background: #f1f3f5;
            font-weight: 600;
            font-size: 13px;
        }

        .summary-box p {
            font-size: 15px;
            line-height: 1.8;
        }

        .footer-section {
            margin-top: auto;
        }

        @media print {

            .no-print {
                display: none;
            }

            body {
                background: white;
                font-size: 12px;
            }

        }
    </style>

</head>

<body>

    <div class="container-fluid my-4 credit-box">

        <div class="text-end mb-3 no-print">
            <button class="btn btn-outline-primary" onclick="window.print()">Print / Download PDF</button>
        </div>

        <!-- COMPANY HEADER -->

        <div class="row credit-header pb-2 align-items-center">

            <div class="col-3">
                <img src="<%=imageBase64%>" class="img-fluid" style="max-height:70px">
            </div>

            <div class="col-9 text-end">

                <h4 class="fw-bold mb-1 text-capitalize">
                    <%= companyDetails.coreCompany %>
                </h4>

                <p class="mb-0 text-capitalize">
                    <%= companyDetails.coreCompanyAddress %>
                </p>

                <small>
                    Email: <%= companyDetails.coreCompanyEmail %> |
                        Phone: <%= companyDetails.coreCompanyPhoneNumber %>
                </small>

                <br>

                <small class="text-uppercase">DL No : <%= companyDetails.coreCompanyDLNo %></small>

            </div>

        </div>

        <!-- TITLE -->

        <div class="row text-center bg-light py-2 mt-3">

            <div class="col">
                <p class="mb-0 text-uppercase"><strong>GSTIN:</strong>
                    <%= companyDetails.coreCompanyGstNo %>
                </p>
            </div>

            <div class="col">
                <h5 class="fw-bold text-uppercase">Credit Note</h5>
            </div>

            <div class="col">
                <p class="mb-0">Sales Return Adjustment</p>
            </div>

        </div>

        <!-- CUSTOMER + CREDIT NOTE -->

        <div class="row mt-3">

            <div class="col-md-7 border-end customer-box">

                <h6 class="text-center text-decoration-underline section-title">Customer Details</h6>

                <p class="mb-1 text-capitalize"><strong>Name :</strong>
                    <%= creditNoteHeader[0].CustomerName %>
                </p>

                <p class="mb-1 text-capitalize"><strong>Address :</strong>
                    <%= creditNoteHeader[0].BillingAddress %>
                </p>

                <p class="mb-1"><strong>Mobile :</strong>
                    <%= creditNoteHeader[0].MobileNo %>
                </p>

                <p class="mb-1 text-capitalize">
                    <strong>Location :</strong>
                    <%= creditNoteHeader[0].BillingDistrict %>,
                        <%= creditNoteHeader[0].BillingState %> -
                            <%= creditNoteHeader[0].BillingPincode %>
                </p>

                <p class="mb-1 text-uppercase"><strong>GST No :</strong>
                    <%= creditNoteHeader[0].GstNo %>
                </p>

                <p class="mb-1 text-uppercase"><strong>DL No :</strong>
                    <%= creditNoteHeader[0].DlNo %>
                </p>

            </div>

            <div class="col-md-5 customer-box">

                <h6 class="text-center text-decoration-underline section-title">Credit Note Details</h6>

                <p class="mb-1"><strong>Credit Note No :</strong>
                    <%= creditNoteHeader[0].CreditNoteNumber %>
                </p>

                <p class="mb-1"><strong>Date :</strong>
                    <%= new Date(creditNoteHeader[0].CreatedAt)
                    .toLocaleDateString('en-GB')
                    .replace(/\//g,'-') %>
                </p>

                <p class="mb-1"><strong>Sales Return ID :</strong></p>

            </div>

        </div>

        <!-- RETURN ITEMS -->

        <div class="table-responsive mt-3">

            <table class="table table-sm text-center">

                <thead>

                    <tr>

                        <th>Sr</th>
                        <th class="text-start">Product</th>
                        <th>HSN</th>
                        <th>Batch</th>
                        <th>Qty</th>
                        <th>Rate</th>
                        <th>SGST</th>
                        <th>CGST</th>
                        <th>Amount</th>

                    </tr>

                </thead>

                <tbody>

                    <% items.forEach((item,i)=>{ %>

                        <tr>

                            <td>
                                <%= i+1 %>
                            </td>

                            <td class="text-start">
                                <%= item.ProductName %>
                            </td>

                            <td>
                                <%= item.Hsn %>
                            </td>

                            <td>
                                <%= item.BatchNumber %>
                            </td>

                            <td>
                                <%= item.Quantity %>
                            </td>

                            <td>
                                <%= item.Rate %>
                            </td>

                            <td>
                                <%= item.SgstAmount %> (<%= item.Sgst %>%)
                            </td>

                            <td>
                                <%= item.CgstAmount %> (<%= item.Cgst %>%)
                            </td>

                            <td>
                                <%= item.Total %>
                            </td>

                        </tr>

                        <% }) %>

                </tbody>

            </table>

        </div>

        <div class="footer-section">

            <hr>

            <!-- BANK + SUMMARY -->

            <div class="row">

                <div class="col-md-6 border-end">

                    <h6 class="text-center text-decoration-underline section-title">Bank Details</h6>

                    <p>

                        <strong>Account Holder :</strong>
                        <%= companyDetails.coreCompany %><br>

                            <strong>Bank Name :</strong>
                            <%= companyDetails.coreCompanyBankName %><br>

                                <strong>Branch :</strong>
                                <%= companyDetails.coreCompanyBranchName %><br>

                                    <strong>Account No :</strong>
                                    <%= companyDetails.coreCompanyAccountNo %><br>

                                        <strong>IFSC :</strong>
                                        <%= companyDetails.coreCompanyIFSCCode %>

                    </p>

                </div>

                <div class="col-md-6 summary-box">

                    <h6 class="text-center text-decoration-underline section-title">Summary</h6>

                    <p>

                        <strong>Taxable Amount :</strong> ₹ <%= parseFloat(summary[0].TaxableAmount).toFixed(2) %><br>

                            <strong>SGST :</strong> ₹ <%= parseFloat(summary[0].TotalSgstAmount).toFixed(2) %><br>

                                <strong>CGST :</strong> ₹ <%= parseFloat(summary[0].TotalCgstAmount).toFixed(2) %><br>

                                    <strong>Total Tax :</strong> ₹
                                    <%= (parseFloat(summary[0].TotalSgstAmount)+parseFloat(summary[0].TotalCgstAmount)).toFixed(2)
                                        %><br>

                                        <strong>Total Credit :</strong> ₹ <%=
                                            parseFloat(summary[0].TotalCreditAmount).toFixed(2) %>

                    </p>

                </div>

            </div>

            <hr>

            <!-- SIGNATURE -->

            <div class="row pt-2">

                <div class="col-md-6">

                    <h6 class="text-uppercase">Terms & Conditions</h6>

                    <p>

                        1. Goods returned as per company policy.<br>
                        2. Credit note will be adjusted in next purchase.<br>
                        3. Subject to Patna jurisdiction.

                    </p>

                </div>

                <div class="col-md-3">

                    <h6>Recipient Signatory</h6>

                    <br><br>

                    <p>(Signature)</p>

                </div>

                <div class="col-md-3 text-end">

                    <h6>Authorized Signatory</h6>

                    <br><br>

                    <p>(Signature)</p>

                </div>

            </div>

        </div>

    </div>

</body>

</html>