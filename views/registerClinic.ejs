<%
  /* views/clinicForm.ejs — shared Register + Update clinic form
     Locals: mode ('create'|'edit'), clinicId, values, errors[], notifications[], users[], hasHeader */
  var isEdit  = mode === 'edit';
  var vals    = (typeof values !== 'undefined' && values) ? values : {};
  var v       = function (k) { return vals[k] == null ? '' : vals[k]; };
  var errList = (typeof errors !== 'undefined' && errors) ? errors : [];
  var STATES  = ['Andhra Pradesh','Arunachal Pradesh','Assam','Bihar','Chhattisgarh','Delhi','Goa','Gujarat','Haryana','Himachal Pradesh','Jharkhand','Karnataka','Kerala','Madhya Pradesh','Maharashtra','Manipur','Meghalaya','Mizoram','Nagaland','Odisha','Punjab','Rajasthan','Sikkim','Tamil Nadu','Telangana','Tripura','Uttar Pradesh','Uttarakhand','West Bengal','Jammu and Kashmir','Ladakh','Chandigarh','Puducherry'];
%>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">

<style>
  .rc{--brand:#185FA5;--brand-soft:#E6F1FB;--brand-dark:#0C447C;--surface:#fff;--surface-alt:#F8F9FB;--border:rgba(0,0,0,.08);--border-strong:rgba(0,0,0,.16);
      --text:#111827;--text-2:#6B7280;--hint:#9CA3AF;--ok-bg:#EAF3DE;--ok:#3B6D11;--warn-bg:#FAEEDA;--warn:#854F0B;--err-bg:#FCEBEB;--err:#A32D2D;
      --r-sm:8px;--r-md:10px;--r-lg:14px;--shadow:0 1px 4px rgba(0,0,0,.06),0 0 0 .5px rgba(0,0,0,.08);
      padding:16px 0 40px;max-width:1200px;margin:0 auto}
  .rc-card{background:var(--surface);border-radius:var(--r-lg);box-shadow:var(--shadow);overflow:hidden}
  .rc-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:18px 24px;border-bottom:1px solid var(--border)}
  .rc-head-l{display:flex;align-items:center;gap:12px}
  .rc-head-ic{width:38px;height:38px;background:var(--brand-soft);border-radius:var(--r-sm);display:flex;align-items:center;justify-content:center;color:var(--brand);font-size:17px}
  .rc-title{font-size:16px;font-weight:600;color:var(--text);margin:0}
  .rc-sub{font-size:12px;color:var(--text-2);margin:2px 0 0}
  .rc-body{display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:24px;padding:20px 24px;align-items:start}
  .rc-box{background:var(--surface-alt);border:1px solid var(--border);border-radius:var(--r-md);padding:18px;margin-bottom:16px}
  .rc-label{font-size:11px;font-weight:700;color:var(--brand);text-transform:uppercase;letter-spacing:.07em;margin-bottom:14px;display:flex;align-items:center;gap:6px}
  .rc-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .rc-full{grid-column:1/-1}
  .rc-f>label{font-size:11px;font-weight:600;color:var(--text-2);text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:6px}
  .rc-req{color:var(--err)}
  .rc-in{display:flex;align-items:center;border:1px solid var(--border-strong);border-radius:var(--r-sm);background:var(--surface);transition:border-color .15s,box-shadow .15s}
  .rc-in:focus-within{border-color:var(--brand);box-shadow:0 0 0 3px rgba(24,95,165,.12)}
  .rc-in>i{padding:0 10px;color:var(--hint);font-size:14px}
  .rc-in input,.rc-in select{border:0;outline:0;background:transparent;font-size:15px;color:var(--text);padding:10px 12px 10px 0;width:100%;min-width:0;font-family:inherit}
  .rc-in select{appearance:none;cursor:pointer}
  .rc-f.err .rc-in{border-color:var(--err);box-shadow:0 0 0 3px rgba(163,45,45,.08)}
  .rc-msg{font-size:12px;color:var(--err);margin-top:4px;display:none}
  .rc-f.err .rc-msg{display:block}
  .rc-hint{font-size:11.5px;color:var(--hint);margin-top:4px}

  .rc-drop{border:2px dashed var(--border-strong);border-radius:var(--r-md);padding:24px 16px;text-align:center;background:var(--surface);cursor:pointer;position:relative;transition:all .2s}
  .rc-drop:hover,.rc-drop.over,.rc-drop:focus-within{border-color:var(--brand);background:var(--brand-soft)}
  .rc-drop input{position:absolute;inset:0;opacity:0;cursor:pointer}
  .rc-chip{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:99px;background:var(--brand-soft);color:var(--brand);font-size:11px;font-weight:500}
  .rc-file{display:none;align-items:center;gap:10px;padding:9px 12px;background:var(--ok-bg);border-radius:var(--r-sm);margin-top:10px}
  .rc-file.show{display:flex}
  .rc-file span{flex:1;font-size:12.5px;color:var(--ok);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .rc-hintbar{display:none;font-size:12px;color:var(--warn);background:var(--warn-bg);border-radius:var(--r-sm);padding:8px 12px;margin-top:10px;gap:7px;align-items:flex-start}
  .rc-hintbar.show{display:flex}

  .rc-preview{position:sticky;top:16px;background:var(--surface-alt);border:1px solid var(--border);border-radius:var(--r-md);padding:16px;min-height:260px}
  .rc-preview-top{display:flex;align-items:center;justify-content:space-between;font-size:11px;font-weight:600;color:var(--text-2);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px}
  .rc-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-height:200px;color:var(--hint);font-size:13px;text-align:center}
  .rc-stage{display:none;max-height:520px;overflow:hidden;border-radius:var(--r-sm);background:#fff}
  .rc-stage img{display:block;max-width:100%}
  .rc-actions{display:none;gap:8px;flex-wrap:wrap;margin-top:12px}
  .rc-result{display:none;margin-top:12px}
  .rc-result img,.rc-current img{width:100%;border-radius:var(--r-sm);border:2px solid rgba(59,109,17,.25);background:#fff}
  .rc-current{margin-bottom:14px}
  .rc-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 24px;background:var(--surface-alt);border-top:1px solid var(--border)}
  .rc-foot-note{font-size:12px;color:var(--hint)}

  @media (max-width:991.98px){ .rc-body{grid-template-columns:1fr} .rc-preview{position:static} }
  @media (max-width:575.98px){
    .rc{padding:8px 0 24px} .rc-head,.rc-body,.rc-foot{padding-left:14px;padding-right:14px}
    .rc-grid{grid-template-columns:1fr} .rc-box{padding:14px}
    .rc-foot{flex-direction:column-reverse;align-items:stretch} .rc-foot .btn{width:100%}
  }
</style>

<div class="rc">
  <%- include("./partials/messages"); %>

  <% if (errList.length) { %>
    <div class="alert alert-danger" role="alert">
      <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>
        The clinic was not saved. Please fix <%= errList.length === 1 ? 'this' : 'these ' + errList.length %>:</div>
      <ul class="mb-0 ps-3"><% errList.forEach(function (m) { %><li><%= m %></li><% }) %></ul>
      <div class="small mt-2 text-body-secondary">Your typed details are kept. If you had cropped a prescription header, please select it again.</div>
    </div>
  <% } %>

  <form id="clinicForm" method="post" enctype="multipart/form-data" novalidate
        action="<%= isEdit ? '/clinic/updateClinicDetails/' + clinicId : '/clinic/registerClinic' %>">

    <div class="rc-card">
      <div class="rc-head">
        <div class="rc-head-l">
          <div class="rc-head-ic"><i class="bi bi-hospital"></i></div>
          <div>
            <p class="rc-title"><%= isEdit ? 'Update Clinic' : 'Register Clinic' %></p>
            <p class="rc-sub"><%= isEdit ? 'Edit details — previous values are kept in clinic history' : 'Add clinic details and its prescription header' %></p>
          </div>
        </div>
        <% if (isEdit) { %>
          <a href="/clinic/attachDoctor/<%= clinicId %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-person-plus"></i> Manage doctors</a>
        <% } %>
      </div>

      <div class="rc-body">
        <!-- LEFT -->
        <div>
          <div class="rc-box">
            <div class="rc-label"><i class="bi bi-building"></i> Clinic information</div>
            <div class="rc-grid">

              <div class="rc-f rc-full">
                <label for="fName">Clinic name <span class="rc-req">*</span></label>
                <div class="rc-in"><i class="bi bi-hospital"></i>
                  <input id="fName" type="text" name="ClinicName" maxlength="150" placeholder="e.g. City Care Clinic" value="<%= v('ClinicName') %>" required autocomplete="organization"></div>
                <div class="rc-msg">Enter the clinic name.</div>
              </div>

              <div class="rc-f">
                <label for="fEmail">Email <span class="rc-req">*</span></label>
                <div class="rc-in"><i class="bi bi-envelope"></i>
                  <input id="fEmail" type="email" name="Email" maxlength="150" placeholder="clinic@example.com" value="<%= v('Email') %>" required autocomplete="email" autocapitalize="off" spellcheck="false"></div>
                <div class="rc-msg">Enter a valid email address.</div>
              </div>

              <div class="rc-f">
                <label for="fPhone">Phone number <span class="rc-req">*</span></label>
                <div class="rc-in"><i class="bi bi-telephone"></i>
                  <input id="fPhone" type="tel" name="PhoneNumber" inputmode="numeric" maxlength="14" placeholder="10-digit number" value="<%= v('PhoneNumber') %>" required autocomplete="tel" data-phone></div>
                <div class="rc-msg">Enter a 10-digit phone number.</div>
              </div>

              <div class="rc-f">
                <label for="fPhone2">Secondary number</label>
                <div class="rc-in"><i class="bi bi-telephone-plus"></i>
                  <input id="fPhone2" type="tel" name="SecondaryNumber" inputmode="numeric" maxlength="14" placeholder="Optional" value="<%= v('SecondaryNumber') %>" data-phone></div>
                <div class="rc-msg">Must be 10 digits and different from the phone number.</div>
              </div>

              <div class="rc-f">
                <label for="fAssigned">Marketing person <span class="rc-req">*</span></label>
                <div class="rc-in"><i class="bi bi-person-badge"></i>
                  <select id="fAssigned" name="AssignedId" required>
                    <option value="">— Select person —</option>
                    <% (users || []).forEach(function (u) { %>
                      <option value="<%= u.Id %>" <%= String(u.Id) === String(v('AssignedId')) ? 'selected' : '' %>><%= [u.FirstName, u.LastName].filter(Boolean).join(' ') || u.Email %></option>
                    <% }) %>
                  </select></div>
                <div class="rc-msg">Select who handles this clinic.</div>
              </div>

              <div class="rc-f rc-full">
                <label for="fAddr">Address line 1 <span class="rc-req">*</span></label>
                <div class="rc-in"><i class="bi bi-geo-alt"></i>
                  <input id="fAddr" type="text" name="Address" maxlength="255" placeholder="Building / Street" value="<%= v('Address') %>" required autocomplete="address-line1"></div>
                <div class="rc-msg">Enter the address.</div>
              </div>

              <div class="rc-f rc-full">
                <label for="fAddr2">Address line 2</label>
                <div class="rc-in"><i class="bi bi-geo"></i>
                  <input id="fAddr2" type="text" name="AdditionalAddress" maxlength="255" placeholder="Area / Locality (optional)" value="<%= v('AdditionalAddress') %>" autocomplete="address-line2"></div>
              </div>

              <div class="rc-f">
                <label for="fKey">Key area <span class="rc-req">*</span></label>
                <div class="rc-in"><i class="bi bi-pin-angle"></i>
                  <input id="fKey" type="text" name="KeyArea" maxlength="150" placeholder="e.g. Kankarbagh" value="<%= v('KeyArea') %>" required></div>
                <div class="rc-msg">Enter the key area.</div>
              </div>

              <div class="rc-f">
                <label for="fLand">Landmark <span class="rc-req">*</span></label>
                <div class="rc-in"><i class="bi bi-signpost-2"></i>
                  <input id="fLand" type="text" name="LandMark" maxlength="150" placeholder="Near / Opposite" value="<%= v('LandMark') %>" required></div>
                <div class="rc-msg">Enter a landmark.</div>
              </div>

              <div class="rc-f">
                <label for="fCity">City <span class="rc-req">*</span></label>
                <div class="rc-in"><i class="bi bi-buildings"></i>
                  <input id="fCity" type="text" name="City" maxlength="100" placeholder="City" value="<%= v('City') %>" required autocomplete="address-level2"></div>
                <div class="rc-msg">Enter the city (letters only).</div>
              </div>

              <div class="rc-f">
                <label for="fState">State <span class="rc-req">*</span></label>
                <div class="rc-in"><i class="bi bi-map"></i>
                  <input id="fState" type="text" name="State" maxlength="100" list="stateList" placeholder="State" value="<%= v('State') %>" required autocomplete="address-level1"></div>
                <datalist id="stateList"><% STATES.forEach(function (s) { %><option value="<%= s %>"><% }) %></datalist>
                <div class="rc-msg">Enter the state.</div>
              </div>

              <div class="rc-f">
                <label for="fPin">Pincode <span class="rc-req">*</span></label>
                <div class="rc-in"><i class="bi bi-mailbox"></i>
                  <input id="fPin" type="text" name="Pincode" inputmode="numeric" maxlength="6" placeholder="6 digits" value="<%= v('Pincode') %>" required autocomplete="postal-code"></div>
                <div class="rc-msg">Pincode must be 6 digits.</div>
              </div>
            </div>
          </div>

          <!-- Header upload -->
          <div class="rc-box" style="margin-bottom:0">
            <div class="rc-label"><i class="bi bi-file-earmark-arrow-up"></i> Prescription header <span class="text-muted fw-normal text-lowercase" style="letter-spacing:0">(optional)</span></div>

            <% if (isEdit && hasHeader) { %>
              <div class="rc-current" id="currentHeader">
                <div class="small fw-semibold text-success mb-1"><i class="bi bi-check-circle-fill"></i> Current header</div>
                <img src="/clinic/header/<%= clinicId %>?t=<%= Date.now() %>" alt="Current prescription header" loading="lazy">
                <div class="form-check mt-2">
                  <input class="form-check-input" type="checkbox" name="removeHeader" value="1" id="removeHeader">
                  <label class="form-check-label small" for="removeHeader">Remove current header</label>
                </div>
              </div>
            <% } %>

            <div class="rc-drop" id="dropZone">
              <input type="file" id="srcFile" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" aria-label="Choose prescription file">
              <i class="bi bi-cloud-arrow-up" style="font-size:28px;color:var(--brand)"></i>
              <div class="fw-semibold" style="font-size:14px"><%= (isEdit && hasHeader) ? 'Upload a new prescription to replace' : 'Drop a prescription here or tap to choose' %></div>
              <div class="d-flex gap-2 justify-content-center flex-wrap mt-2">
                <span class="rc-chip"><i class="bi bi-file-pdf"></i> PDF</span>
                <span class="rc-chip"><i class="bi bi-file-image"></i> JPG</span>
                <span class="rc-chip"><i class="bi bi-file-image"></i> PNG</span>
                <span class="rc-chip">max 10 MB</span>
              </div>
            </div>

            <div class="rc-file" id="fileBar">
              <i class="bi bi-file-check" style="color:var(--ok)"></i>
              <span id="fileName">—</span>
              <button type="button" class="btn btn-sm btn-outline-danger" id="btnClear"><i class="bi bi-x"></i> Remove</button>
            </div>
            <div class="rc-hintbar" id="cropHint"><i class="bi bi-crop"></i>
              <div>Select the <strong>top part</strong> of the prescription (clinic name, logo, doctor) and press <strong>Use this area</strong>.</div></div>
          </div>
        </div>

        <!-- RIGHT: preview -->
        <div>
          <div class="rc-preview">
            <div class="rc-preview-top"><span><i class="bi bi-eye me-1"></i>Preview &amp; crop</span><span id="typeBadge" class="rc-chip" style="display:none"></span></div>
            <div class="rc-empty" id="emptyState"><i class="bi bi-file-earmark-image" style="font-size:32px"></i>Upload a prescription to preview and crop its header</div>
            <div class="rc-empty" id="loadingState" style="display:none"><div class="spinner-border text-primary" role="status"></div>Loading preview…</div>
            <div class="rc-stage" id="stage"><img id="srcImg" alt="Prescription preview"></div>
            <div class="rc-actions" id="actions">
              <button type="button" class="btn btn-success btn-sm" id="btnUse"><i class="bi bi-check2"></i> Use this area</button>
              <button type="button" class="btn btn-outline-primary btn-sm" id="btnRecrop" style="display:none"><i class="bi bi-crop"></i> Change area</button>
            </div>
            <div class="rc-result" id="result">
              <div class="small fw-semibold text-success mb-1"><i class="bi bi-check-circle-fill"></i> Header ready — it will be saved with the clinic</div>
              <img id="resultImg" alt="Cropped header">
            </div>
          </div>
        </div>
      </div>

      <div class="rc-foot">
        <span class="rc-foot-note"><i class="bi bi-shield-check me-1"></i>Fields marked <span class="rc-req">*</span> are required.</span>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/clinic/getClinicListView" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
          <button type="submit" class="btn btn-primary" id="submitBtn">
            <span class="spinner-border spinner-border-sm me-1 d-none" aria-hidden="true"></span>
            <i class="bi bi-check2-circle"></i> <span class="lbl"><%= isEdit ? 'Save changes' : 'Register clinic' %></span>
          </button>
        </div>
      </div>
    </div>

    <input type="file" name="clinicPrescription" id="headerInput" hidden>
  </form>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script>
(function () {
  'use strict';
  var $ = function (id) { return document.getElementById(id); };
  var form = $('clinicForm'), srcFile = $('srcFile'), img = $('srcImg'), headerInput = $('headerInput');
  var cropper = null, loaded = false, cropped = false, dirty = false, submitting = false;
  var MAX_SRC = 10 * 1024 * 1024;

  if (window.pdfjsLib) pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';

  function show(el, on, disp) { el.style.display = on ? (disp || 'block') : 'none'; }
  function alertMsg(msg) { window.alert(msg); }

  /* ── File selection / drag & drop ─────────────────────────────────── */
  var zone = $('dropZone');
  ['dragenter','dragover'].forEach(function (e) { zone.addEventListener(e, function (ev) { ev.preventDefault(); zone.classList.add('over'); }); });
  ['dragleave','drop'].forEach(function (e) { zone.addEventListener(e, function () { zone.classList.remove('over'); }); });
  zone.addEventListener('drop', function (ev) { ev.preventDefault(); if (ev.dataTransfer.files[0]) handleFile(ev.dataTransfer.files[0]); });
  srcFile.addEventListener('change', function () { if (srcFile.files[0]) handleFile(srcFile.files[0]); });

  function handleFile(file) {
    var isPdf = file.type === 'application/pdf' || /\.pdf$/i.test(file.name);
    var isImg = /^image\/(jpe?g|png)$/.test(file.type) || /\.(jpe?g|png)$/i.test(file.name);
    if (!isPdf && !isImg) { alertMsg('Only PDF, JPG or PNG files are allowed.'); srcFile.value = ''; return; }
    if (file.size > MAX_SRC) { alertMsg('File is larger than 10 MB. Please choose a smaller file.'); srcFile.value = ''; return; }

    resetCropState();
    $('fileName').textContent = file.name; $('fileBar').classList.add('show');
    $('typeBadge').textContent = isPdf ? 'PDF' : 'IMAGE'; show($('typeBadge'), true, 'inline-flex');
    show($('emptyState'), false); show($('loadingState'), true, 'flex');
    dirty = true;

    var done = function (dataUrl) {
      img.onload = function () { show($('loadingState'), false); show($('stage'), true); loaded = true; startCropper(); };
      img.onerror = function () { failPreview('Could not read this image. Try another file.'); };
      img.src = dataUrl;
    };
    if (isPdf) renderPdf(file).then(done).catch(function (e) { failPreview('Could not open the PDF (' + (e.message || 'unknown error') + ').'); });
    else { var r = new FileReader(); r.onload = function () { done(r.result); }; r.onerror = function () { failPreview('Could not read the file.'); }; r.readAsDataURL(file); }
  }

  function renderPdf(file) {
    if (!window.pdfjsLib) return Promise.reject(new Error('PDF viewer did not load — check internet connection'));
    return file.arrayBuffer().then(function (buf) { return pdfjsLib.getDocument({ data: new Uint8Array(buf) }).promise; })
      .then(function (pdf) { return pdf.getPage(1); })
      .then(function (page) {
        var vp = page.getViewport({ scale: 2 }), c = document.createElement('canvas');
        c.width = vp.width; c.height = vp.height;
        return page.render({ canvasContext: c.getContext('2d'), viewport: vp }).promise.then(function () { return c.toDataURL('image/jpeg', 0.92); });
      });
  }

  function failPreview(msg) { alertMsg(msg); clearAll(); }

  /* ── Cropper ──────────────────────────────────────────────────────── */
  function startCropper() {
    if (!window.Cropper) { alertMsg('Crop tool did not load — check internet connection.'); return; }
    destroyCropper();
    cropper = new Cropper(img, {
      viewMode: 1, autoCropArea: 1, movable: false, zoomable: false, rotatable: false, scalable: false,
      ready: function () {
        var cd = cropper.getCanvasData();
        cropper.setCropBoxData({ left: cd.left, top: cd.top, width: cd.width, height: cd.height * 0.28 });
      }
    });
    show($('actions'), true, 'flex'); show($('btnUse'), true, 'inline-flex'); show($('btnRecrop'), false);
    $('cropHint').classList.add('show');
  }
  function destroyCropper() { if (cropper) { cropper.destroy(); cropper = null; } }

  $('btnUse').addEventListener('click', function () {
    if (!cropper) return;
    var canvas = cropper.getCroppedCanvas({ maxWidth: 1600, fillColor: '#fff' });
    if (!canvas || canvas.width < 50 || canvas.height < 20) { alertMsg('The selected area is too small.'); return; }
    canvas.toBlob(function (blob) {
      if (!blob) { alertMsg('Could not create the image. Try again.'); return; }
      if (blob.size > 5 * 1024 * 1024) { alertMsg('Cropped header is over 5 MB — select a smaller area.'); return; }
      try {
        var dt = new DataTransfer();
        dt.items.add(new File([blob], 'clinic-header.jpg', { type: 'image/jpeg' }));
        headerInput.files = dt.files;
      } catch (e) {
        alertMsg('This browser cannot attach the cropped image. Please update your browser (Chrome / Edge / Safari 14.1+).'); return;
      }
      $('resultImg').src = URL.createObjectURL(blob);
      show($('result'), true); cropped = true;
      destroyCropper(); show($('stage'), false);
      show($('btnUse'), false); show($('btnRecrop'), true, 'inline-flex');
      $('cropHint').classList.remove('show');
      var rm = $('removeHeader'); if (rm) rm.checked = false;
    }, 'image/jpeg', 0.9);
  });

  $('btnRecrop').addEventListener('click', function () {
    cropped = false; headerInput.value = ''; show($('result'), false); show($('stage'), true); startCropper();
  });

  function resetCropState() {
    destroyCropper(); loaded = false; cropped = false; headerInput.value = '';
    show($('result'), false); show($('stage'), false); show($('actions'), false);
  }
  function clearAll() {
    resetCropState(); srcFile.value = ''; img.removeAttribute('src');
    $('fileBar').classList.remove('show'); $('cropHint').classList.remove('show');
    show($('typeBadge'), false); show($('loadingState'), false); show($('emptyState'), true, 'flex');
  }
  $('btnClear').addEventListener('click', clearAll);

  /* ── Validation ───────────────────────────────────────────────────── */
  var digits = function (s) { s = (s || '').replace(/\D/g, ''); if (s.length === 12 && s.indexOf('91') === 0) s = s.slice(2); if (s.length === 11 && s[0] === '0') s = s.slice(1); return s; };
  document.querySelectorAll('[data-phone]').forEach(function (el) { el.addEventListener('blur', function () { if (el.value) el.value = digits(el.value) || el.value; }); });
  $('fPin').addEventListener('input', function () { this.value = this.value.replace(/\D/g, '').slice(0, 6); });

  function setErr(el, bad) { var f = el.closest('.rc-f'); if (f) f.classList.toggle('err', !!bad); return bad ? 1 : 0; }

  function validate() {
    var bad = 0, val = function (id) { return $(id).value.trim(); };
    bad += setErr($('fName'),    !val('fName'));
    bad += setErr($('fEmail'),   !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val('fEmail')));
    var p1 = digits(val('fPhone')), p2 = digits(val('fPhone2'));
    bad += setErr($('fPhone'),   !/^[1-9]\d{9}$/.test(p1));
    bad += setErr($('fPhone2'),  p2 && (!/^[1-9]\d{9}$/.test(p2) || p2 === p1));
    bad += setErr($('fAssigned'),!val('fAssigned'));
    bad += setErr($('fAddr'),    !val('fAddr'));
    bad += setErr($('fKey'),     !val('fKey'));
    bad += setErr($('fLand'),    !val('fLand'));
    bad += setErr($('fCity'),    !/^[A-Za-zÀ-ɏऀ-ॿ\s.'-]+$/.test(val('fCity')));
    bad += setErr($('fState'),   !/^[A-Za-zÀ-ɏऀ-ॿ\s.'-]+$/.test(val('fState')));
    bad += setErr($('fPin'),     !/^[1-9]\d{5}$/.test(val('fPin')));
    return bad;
  }

  form.addEventListener('input',  function (e) { dirty = true; var f = e.target.closest('.rc-f'); if (f) f.classList.remove('err'); });
  form.addEventListener('change', function () { dirty = true; });

  form.addEventListener('submit', function (e) {
    if (submitting) { e.preventDefault(); return; }
    var bad = validate();
    if (bad) {
      e.preventDefault();
      var first = form.querySelector('.rc-f.err input, .rc-f.err select');
      if (first) { first.scrollIntoView({ behavior: 'smooth', block: 'center' }); setTimeout(function () { first.focus({ preventScroll: true }); }, 250); }
      return;
    }
    if (loaded && !cropped) {
      e.preventDefault();
      alertMsg('You chose a prescription but did not confirm the header area.\n\nPress "Use this area", or press "Remove" to save without a header.');
      $('actions').scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    submitting = true; dirty = false;
    var btn = $('submitBtn');
    btn.disabled = true; btn.querySelector('.spinner-border').classList.remove('d-none'); btn.querySelector('.bi').classList.add('d-none');
    btn.querySelector('.lbl').textContent = 'Saving…';
  });

  window.addEventListener('beforeunload', function (e) { if (dirty && !submitting) { e.preventDefault(); e.returnValue = ''; } });
  window.addEventListener('pageshow', function (e) {
    if (!e.persisted) return;
    submitting = false; var btn = $('submitBtn'); btn.disabled = false;
    btn.querySelector('.spinner-border').classList.add('d-none'); btn.querySelector('.bi').classList.remove('d-none');
    btn.querySelector('.lbl').textContent = '<%= isEdit ? "Save changes" : "Register clinic" %>';
  });
  <% if (errList.length) { %> dirty = true; <% } %>
})();
</script>
