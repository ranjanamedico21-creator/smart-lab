  <button class="bulk-assign-btn" id="bulkAssignBtn" onclick="bulkAssign()">⚡ Assign All</button>
  <button class="bulk-clear" onclick="clearSel()">Deselect</button>
</div>

<!-- ══ REASSIGN MODAL ══ -->
<div class="modal-overlay" id="reassignModal">
  <div class="modal">
    <div class="modal-head">
      <div class="modal-title">Reassign Packet</div>
      <button class="modal-close" onclick="closeModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="modal-info">
        <div class="modal-info-row">
          <div class="modal-info-label">Code</div>
          <div class="modal-info-val code" id="m_code">—</div>
        </div>
        <div class="modal-info-row">
          <div class="modal-info-label">Name</div>
          <div class="modal-info-val" id="m_name">—</div>
        </div>
        <div class="modal-info-row">
          <div class="modal-info-label">Current</div>
          <div class="modal-info-val" id="m_current" style="color:var(--muted)">—</div>
        </div>
      </div>
      <div class="field">
        <label>New Agent User ID *</label>
        <input type="number" class="field-inp" id="m_newUserId" placeholder="Enter user ID" min="1">
      </div>
      <div class="field">
        <label>Reason (optional)</label>
        <input type="text" class="field-inp" id="m_reason" placeholder="e.g. Agent on leave">
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModal()">Cancel</button>
      <button class="btn-confirm" id="m_confirmBtn" onclick="confirmReassign()">Confirm Reassign</button>
    </div>
  </div>
</div>

<div id="toasts"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>

<script>
/*
  ──────────────────────────────────────────────────────────────────
  KEY FIX: use  <%- JSON.stringify(packets) %>  NOT  packets
  The EJS variable "data" was computed above in the <% %> block.
  "packets" is also available but going through "data" is safer
  because we already guaranteed it's an Array up there.
  ──────────────────────────────────────────────────────────────────
*/
const packets      = <%- JSON.stringify(packets) %>;
const currentMonth = '<%- curMonth %>';

let selected   = new Set();
let modalPktId = null;
let leafletMap = null;

/* ── helpers ── */
function esc(s) {
  return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function ini(n) {
  if (!n) return '?';
  return n.trim().split(/\s+/).map(w => w[0]).join('').slice(0,2).toUpperCase();
}
function fmtDate(d) {
  if (!d) return '—';
  try { return new Date(d).toLocaleString('en-IN',{day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}); }
  catch { return String(d); }
}

/* ── table ── */
function renderTable() {
  const search = (document.getElementById('searchInput').value || '').toLowerCase().trim();
  const status = document.getElementById('statusFilter').value;

  const rows = packets.filter(p => {
    const mf = status === 'all' || p.Status === status;
    const ms = !search || [p.PacketCode, p.Name, p.Address, p.assignedUser, p.ReceiverName, p.ReceiverPhone]
      .filter(Boolean).join(' ').toLowerCase().includes(search);
    return mf && ms;
  });

  document.getElementById('visCount').textContent = rows.length;

  if (!rows.length) {
    document.getElementById('tableBody').innerHTML =
      `<tr><td colspan="8"><div class="empty-state"><div class="eico">📭</div><p>No packets match</p></div></td></tr>`;
    return;
  }

  const pillMap = { DELIVERED:'pill-delivered', ASSIGNED:'pill-assigned', UPLOADED:'pill-uploaded' };

  document.getElementById('tableBody').innerHTML = rows.map((p, i) => {
    const isDone = p.Status === 'DELIVERED';
    const isSel  = selected.has(p.Id);

    const userCell = p.assignedUser
      ? `<div class="user-chip"><div class="user-av">${ini(p.assignedUser)}</div><div class="user-name">${esc(p.assignedUser)}</div></div>`
      : `<div class="user-chip"><div class="user-av unassigned">?</div><div class="unassigned-txt">Unassigned</div></div>`;

    const recvCell = p.ReceiverName
      ? `<div class="recv-name">${esc(p.ReceiverName)}</div><div class="recv-phone">${esc(p.ReceiverPhone||'—')}</div>`
      : `<div class="recv-empty">—</div>`;

    let actionCell;
    if (isDone) {
      actionCell = `<span style="font-family:var(--mono);font-size:11px;color:var(--dim)">${fmtDate(p.DeliveredAt)}</span>`;
    } else if (p.assignedUser) {
      /* ── REASSIGN button — calls openReassign() which opens the modal ── */
      actionCell = `<div class="action-cell">
        <button class="btn-reassign-sm" onclick="openReassign(${p.Id})">⇄ Reassign</button>
      </div>`;
    } else {
      actionCell = `<div class="action-cell">
        <form class="assign-form-inline" onsubmit="assignSingle(event,${p.Id})">
          <input type="number" class="assign-inp" name="userId" placeholder="User ID" required min="1">
          <button type="submit" class="btn-assign">Assign</button>
        </form>
      </div>`;
    }

    return `<tr id="row-${p.Id}">
      <td>${!isDone ? `<input type="checkbox" class="row-cb" data-id="${p.Id}" ${isSel?'checked':''} onchange="toggleRow(this)">` : ''}</td>
      <td><span style="font-family:var(--mono);font-size:11px;color:var(--muted)">#${p.Id}</span></td>
      <td><span class="pkt-code">${esc(p.PacketCode)}</span></td>
      <td><div class="pkt-name">${esc(p.Name||'—')}</div>${p.Address?`<div class="pkt-addr">${esc(p.Address)}</div>`:''}</td>
      <td>${userCell}</td>
      <td>${recvCell}</td>
      <td><span class="pill ${pillMap[p.Status]||'pill-uploaded'}"><span class="pill-dot"></span>${esc(p.Status)}</span></td>
      <td>${actionCell}</td>
    </tr>`;
  }).join('');
}

function filterTable() { renderTable(); }

/* ── checkboxes ── */
function toggleRow(cb) {
  const id = parseInt(cb.dataset.id);
  cb.checked ? selected.add(id) : selected.delete(id);
  updateBulkBar();
}
function toggleAll(cb) {
  packets.filter(p => p.Status !== 'DELIVERED').forEach(p => cb.checked ? selected.add(p.Id) : selected.delete(p.Id));
  renderTable(); updateBulkBar();
}
function clearSel() { selected.clear(); renderTable(); updateBulkBar(); }
function updateBulkBar() {
  const n = selected.size;
  document.getElementById('bulkCount').textContent = `${n} selected`;
  document.getElementById('bulkBar').classList.toggle('show', n > 0);
}

/* ── assign single ── */
async function assignSingle(e, packetId) {
  e.preventDefault();
  const userId = parseInt(e.target.querySelector('input[name="userId"]').value);
  if (!userId) return;
  const btn  = e.target.querySelector('button[type="submit"]');
  const orig = btn.innerHTML;
  btn.innerHTML = '<span class="spinner"></span>';
  btn.disabled  = true;
  try {
    const res  = await fetch('/admin/assignPackets', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({packetId,userId}) });
    const json = await res.json();
    if (!res.ok) throw new Error(json.error || 'Failed');
    const p = packets.find(x => x.Id === packetId);
    if (p) { p.Status='ASSIGNED'; p.assignedUserId=userId; p.assignedUser=`User #${userId}`; }
    toast(`Packet #${packetId} assigned to User ${userId}`, 'success');
    renderTable();
  } catch(err) {
    toast(err.message, 'error');
    btn.innerHTML = orig; btn.disabled = false;
  }
}

/* ── bulk assign ── */
async function bulkAssign() {
  const userId = parseInt(document.getElementById('bulkUserId').value);
  if (!userId) { toast('Enter a user ID','error'); return; }
  const ids = [...selected];
  const btn = document.getElementById('bulkAssignBtn');
  btn.innerHTML = '<span class="spinner"></span> Assigning…'; btn.disabled = true;
  try {
    const res  = await fetch('/admin/assignBulk', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({packetIds:ids,userId}) });
    const json = await res.json();
    if (!res.ok) throw new Error(json.error || 'Failed');
    ids.forEach(id => { const p=packets.find(x=>x.Id===id); if(p){p.Status='ASSIGNED';p.assignedUserId=userId;p.assignedUser=`User #${userId}`;} });
    toast(`${json.assigned} packets assigned to User ${userId}`, 'success');
    selected.clear(); renderTable(); updateBulkBar();
  } catch(err) { toast(err.message,'error'); }
  finally { btn.innerHTML='⚡ Assign All'; btn.disabled=false; }
}

/* ════════════════════════════════════════════════════════════
   REASSIGN MODAL — three functions:
   1. openReassign(id)   — populate + open
   2. closeModal()       — close
   3. confirmReassign()  — POST to /admin/reassign
════════════════════════════════════════════════════════════ */
function openReassign(id) {
  const p = packets.find(x => x.Id === id);
  if (!p) { toast('Packet not found', 'error'); return; }

  /* Fill the info panel */
  document.getElementById('m_code').textContent    = p.PacketCode || '—';
  document.getElementById('m_name').textContent    = p.Name       || '—';
  document.getElementById('m_current').textContent = p.assignedUser || 'Unassigned';

  /* Clear form inputs */
  document.getElementById('m_newUserId').value = '';
  document.getElementById('m_reason').value    = '';

  /* Remember which packet */
  modalPktId = id;

  /* Open overlay */
  document.getElementById('reassignModal').classList.add('open');

  /* Focus the input after the CSS transition */
  setTimeout(() => document.getElementById('m_newUserId').focus(), 180);
}

function closeModal() {
  document.getElementById('reassignModal').classList.remove('open');
  modalPktId = null;
}

async function confirmReassign() {
  const newUserId = parseInt(document.getElementById('m_newUserId').value);
  const reason    = document.getElementById('m_reason').value.trim();

  if (!newUserId || isNaN(newUserId)) {
    document.getElementById('m_newUserId').focus();
    toast('Enter a valid user ID', 'error');
    return;
  }

  const btn = document.getElementById('m_confirmBtn');
  btn.innerHTML = '<span class="spinner"></span> Saving…';
  btn.disabled  = true;

  try {
    const res  = await fetch('/packet/reassign', {
      method : 'POST',
      headers: { 'Content-Type': 'application/json' },
      body   : JSON.stringify({ packetId: modalPktId, newUserId, reason }),
    });
    const json = await res.json();
    if (!res.ok) throw new Error(json.error || 'Reassign failed');

    /* Optimistic update in the local packets array */
    const p = packets.find(x => x.Id === modalPktId);
    if (p) { p.assignedUserId = newUserId; p.assignedUser = `User #${newUserId}`; }

    closeModal();
    toast('Packet reassigned successfully', 'success');
    renderTable();
  } catch(err) {
    toast(err.message, 'error');
  } finally {
    btn.innerHTML = 'Confirm Reassign';
    btn.disabled  = false;
  }
}

/* Backdrop click closes modal */
document.getElementById('reassignModal').addEventListener('click', function(e) {
  if (e.target === this) closeModal();
});
/* Escape key closes modal */
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

/* ── Leaflet map ── */
function initMap() {
  if (leafletMap) { leafletMap.invalidateSize(); return; }
  leafletMap = L.map('leaflet-map').setView([25.5941, 85.1376], 11);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution:'© OpenStreetMap contributors', maxZoom:18 }).addTo(leafletMap);
  const greenIcon = L.divIcon({
    className:'',
    html:`<div style="width:12px;height:12px;border-radius:50%;background:#1a6b3c;border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,0.3)"></div>`,
    iconSize:[12,12], iconAnchor:[6,6],
  });
  const pins = packets.filter(p => p.Status==='DELIVERED' && p.Latitude && p.Longitude);
  if (pins.length) {
    const bounds = [];
    pins.forEach(p => {
      const lat=parseFloat(p.Latitude), lng=parseFloat(p.Longitude);
      if (isNaN(lat)||isNaN(lng)) return;
      bounds.push([lat,lng]);
      L.marker([lat,lng],{icon:greenIcon})
        .bindPopup(`<b style="font-family:monospace;color:#c8760a">${esc(p.PacketCode)}</b><br>
          <b>${esc(p.Name||'')}</b><br><br>
          Receiver: ${esc(p.ReceiverName||'—')}<br>
          Phone: ${esc(p.ReceiverPhone||'—')}<br>
          At: ${fmtDate(p.DeliveredAt)}`, {maxWidth:220})
        .addTo(leafletMap);
    });
    if (bounds.length) leafletMap.fitBounds(bounds, {padding:[50,50]});
  }
}

/* ── Audit (AJAX) ── */
async function loadAudit(page=1) {
  document.getElementById('auditLog').innerHTML = `<div class="empty-state"><div class="eico">⏳</div><p>Loading…</p></div>`;
  document.getElementById('auditCount').textContent = '…';
  try {
    const res  = await fetch(`/admin/audit?page=${page}&json=1`);
    if (!res.ok) throw new Error('Server error ' + res.status);
    const json = await res.json();
    renderAudit(json, page);
  } catch(err) {
    document.getElementById('auditLog').innerHTML = `<div class="empty-state"><div class="eico">⚠️</div><p>${err.message}</p></div>`;
  }
}

function renderAudit({ events, page, totalPages }) {
  document.getElementById('auditCount').textContent = `Page ${page} / ${totalPages}`;
  if (!events || !events.length) {
    document.getElementById('auditLog').innerHTML = `<div class="empty-state"><div class="eico">📋</div><p>No audit events yet</p></div>`;
    document.getElementById('auditPages').innerHTML = '';
    return;
  }
  document.getElementById('auditLog').innerHTML = events.map(ev => {
    const typeClass = ev.eventType==='REASSIGN' ? 'reassign' : 'delivery';
    const detail    = ev.eventType==='REASSIGN'
      ? `<span class="dim">${esc(ev.oldUser||'—')}</span> → <strong>${esc(ev.newUser||'—')}</strong>`
      : `To <strong>${esc(ev.receiverName||'—')}</strong> · <span style="font-family:var(--mono);font-size:12px">${esc(ev.receiverPhone||'')}</span>`;
    const pktCode = ev.PacketCode || ev.packetCode || '—';
    return `<div class="audit-row">
      <div class="audit-ts">${fmtDate(ev.eventAt)}</div>
      <div><div class="audit-pkt">${esc(pktCode)}</div><span class="audit-type ${typeClass}">${ev.eventType}</span></div>
      <div class="audit-detail">${detail}<br><span style="font-size:11px;color:var(--muted)">${esc(ev.packetName||'')}</span></div>
      <div class="audit-by">by ${esc(ev.doneBy||'—')}</div>
    </div>`;
  }).join('');
  let pg = `<span class="page-info">Page ${page} / ${totalPages}</span>`;
  if (page > 1)           pg += `<a class="page-btn" onclick="loadAudit(${page-1})">← Prev</a>`;
  if (page < totalPages)  pg += `<a class="page-btn" onclick="loadAudit(${page+1})">Next →</a>`;
  document.getElementById('auditPages').innerHTML = pg;
}

/* ── CSV export ── */
function exportCSV() {
  const cols = ['Id','PacketCode','Name','Address','Status','Month','assignedUser','ReceiverName','ReceiverPhone','DeliveredAt'];
  const rows = [cols.join(',')];
  packets.forEach(p => rows.push(cols.map(c => `"${String(p[c]??'').replace(/"/g,'""')}"`).join(',')));
  const a = Object.assign(document.createElement('a'), {
    href: URL.createObjectURL(new Blob([rows.join('\n')], {type:'text/csv'})),
    download: `packets-${currentMonth}.csv`,
  });
  a.click();
}

/* ── tabs ── */
const SECTIONS = ['packets','map','stats','audit'];
const TITLES   = { packets:'Packet Management', map:'Map View', stats:'Analytics', audit:'Audit Log' };

function switchTab(tab, el) {
  SECTIONS.forEach(s => { const sec=document.getElementById('sec-'+s); if(sec) sec.style.display='none'; });
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  const sec = document.getElementById('sec-'+tab);
  if (sec) sec.style.display = 'block';
  document.getElementById('tab-'+tab)?.classList.add('active');
  document.getElementById('topbarTitle').textContent = TITLES[tab] || '';
  if (tab==='map')   setTimeout(initMap, 60);
  if (tab==='audit') loadAudit(1);
}

/* ── toast ── */
function toast(msg, type='info') {
  const t = Object.assign(document.createElement('div'), { className:`toast ${type}`, textContent:msg });
  document.getElementById('toasts').appendChild(t);
  setTimeout(() => t.remove(), 3800);
}

/* ── boot ── */
SECTIONS.forEach(s => { const sec=document.getElementById('sec-'+s); if(sec) sec.style.display='none'; });
document.getElementById('sec-packets').style.display = 'block';
renderTable();
</script>
</body>
</html>
