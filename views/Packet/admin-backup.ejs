    <div class="map-card">
      <div class="map-head">
        <span style="font-family:var(--mono);font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1.5px">GPS Map — <%= curMonth %></span>
        <span style="font-family:var(--mono);font-size:11px;color:var(--dim)"><%= withGPS %> pins</span>
