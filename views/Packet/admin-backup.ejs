  </div>

  <!-- ══ MAP TAB ══ -->
  <div id="sec-map" class="map-section">
    <div class="stat-strip" style="grid-template-columns:repeat(3,1fr);margin-bottom:16px">
      <div class="stat-card green">
        <div class="stat-label">With GPS</div>
        <div class="stat-num"><%= withGPS %></div>
        <div class="stat-sub">Pinned on map</div>
      </div>
      <div class="stat-card amber">
        <div class="stat-label">No GPS</div>
        <div class="stat-num"><%= withoutGPS %></div>
