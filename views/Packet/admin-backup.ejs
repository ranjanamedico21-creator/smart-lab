<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Panel — Packet Ops</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ink:#0c0c0c;--ink2:#1a1a1a;--ink3:#2c2c2c;
  --muted:#6a6a6a;--dim:#9a9a9a;
  --line:#e8e4de;--line2:#d4cec6;
  --bg:#f5f1eb;--surface:#fffefb;--surface2:#f9f6f1;
  --amber:#c8760a;--amber-light:#fff3e0;--amber-mid:#f5a623;
  --green:#1a6b3c;--green-bg:#e8f5ee;
  --red:#c0392b;--red-bg:#fdf0ee;
  --blue:#1a4fa0;--blue-bg:#e8f0fd;
  --syne:'Syne',sans-serif;
  --mono:'JetBrains Mono',monospace;
  --body:'Instrument Sans',sans-serif;
  --r:6px;--r-lg:10px;
}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:14px;min-height:100vh}

/* TOPBAR */
.topbar{
  position:sticky;top:0;z-index:50;
  background:var(--surface);border-bottom:1px solid var(--line);
  padding:0 24px;height:56px;display:flex;align-items:center;gap:12px
}
.topbar-brand{font-family:var(--syne);font-size:16px;font-weight:800;color:var(--ink);letter-spacing:-0.5px}
.topbar-brand span{color:var(--amber)}
.topbar-sep{width:1px;height:20px;background:var(--line2);flex-shrink:0}
.topbar-title{font-family:var(--syne);font-size:14px;font-weight:600;color:var(--muted)}
.month-pick{
  display:flex;align-items:center;gap:8px;
  background:var(--surface2);border:1px solid var(--line);border-radius:var(--r);padding:5px 12px
}
.month-pick-label{font-family:var(--mono);font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:1.5px}
.month-pick input[type=month]{border:none;background:transparent;font-family:var(--mono);font-size:12px;color:var(--ink);outline:none;cursor:pointer}
.search-bar{flex:1;max-width:260px;position:relative}
.search-bar input{
  width:100%;background:var(--surface2);border:1px solid var(--line);border-radius:var(--r);
  padding:7px 10px 7px 30px;font-family:var(--body);font-size:13px;color:var(--ink);outline:none;transition:border-color 0.2s
}
.search-bar input:focus{border-color:var(--amber);background:#fff}
.search-bar input::placeholder{color:var(--dim)}
.search-ico{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--dim);font-size:13px;pointer-events:none}
.status-select{
  background:var(--surface2);border:1px solid var(--line);border-radius:var(--r);
  padding:7px 10px;font-family:var(--body);font-size:13px;color:var(--ink);outline:none;cursor:pointer
}
.status-select:focus{border-color:var(--amber)}
.topbar-right{margin-left:auto;display:flex;align-items:center;gap:8px}
.admin-chip{
  display:flex;align-items:center;gap:8px;
  background:var(--surface2);border:1px solid var(--line);border-radius:20px;padding:4px 12px 4px 4px
}
.admin-av{
  width:26px;height:26px;border-radius:50%;background:var(--amber);
  display:flex;align-items:center;justify-content:center;
  font-family:var(--syne);font-size:10px;font-weight:700;color:#fff
}
.admin-name-chip{font-size:12px;font-weight:600;color:var(--ink)}

/* CONTENT */
.content{padding:20px 24px}

/* STAT STRIP */
.stat-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px}
.stat-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:14px 16px;position:relative;overflow:hidden}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--line)}
.stat-card.amber::before{background:var(--amber)}
.stat-card.green::before{background:var(--green)}
.stat-card.red::before{background:var(--red)}
.stat-card.blue::before{background:var(--blue)}
.stat-label{font-family:var(--mono);font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
.stat-num{font-family:var(--syne);font-size:26px;font-weight:800;color:var(--ink);letter-spacing:-1px;line-height:1}
.stat-sub{font-size:11px;color:var(--muted);margin-top:3px}

/* TABS */
.tab-bar{display:flex;margin-bottom:18px;border-bottom:1px solid var(--line)}
.tab{
  padding:10px 18px;font-family:var(--body);font-size:13px;font-weight:500;
  color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;
  transition:all 0.15s;display:flex;align-items:center;gap:6px;margin-bottom:-1px;white-space:nowrap
}
.tab:hover{color:var(--ink)}
.tab.active{color:var(--amber);border-bottom-color:var(--amber)}
.tab-badge{font-family:var(--mono);font-size:10px;padding:1px 6px;border-radius:10px;background:var(--amber-light);color:var(--amber)}

/* SECTION HEADER */
.section-header{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.section-title{font-family:var(--syne);font-size:14px;font-weight:700;color:var(--ink);letter-spacing:-0.2px}
.section-count{font-family:var(--mono);font-size:11px;color:var(--muted);background:var(--surface2);border:1px solid var(--line);border-radius:20px;padding:2px 9px}
.section-actions{margin-left:auto;display:flex;gap:8px}
.btn-ghost-sm{background:transparent;color:var(--muted);border:1px solid var(--line);border-radius:var(--r);padding:5px 12px;font-size:12px;font-family:var(--body);cursor:pointer;transition:all 0.12s}
.btn-ghost-sm:hover{border-color:var(--line2);color:var(--ink)}

/* TABLE */
.table-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden}
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse}
thead tr{border-bottom:2px solid var(--line);background:var(--surface2)}
th{font-family:var(--mono);font-size:9px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);padding:11px 14px;text-align:left;white-space:nowrap;font-weight:400}
tbody tr{border-bottom:1px solid var(--line);transition:background 0.12s}
tbody tr:last-child{border-bottom:none}
tbody tr:hover{background:var(--surface2)}
td{padding:12px 14px;vertical-align:middle}
input[type=checkbox]{appearance:none;width:15px;height:15px;border:1.5px solid var(--line2);border-radius:3px;background:#fff;cursor:pointer;position:relative;transition:all 0.12s}
input[type=checkbox]:checked{background:var(--amber);border-color:var(--amber)}
input[type=checkbox]:checked::after{content:'';position:absolute;left:3px;top:1px;width:5px;height:8px;border:2px solid #fff;border-top:none;border-left:none;transform:rotate(45deg)}
.pkt-code{font-family:var(--mono);font-size:11px;font-weight:600;color:var(--amber);background:var(--amber-light);padding:3px 7px;border-radius:4px;border:1px solid rgba(200,118,10,0.15);white-space:nowrap}
.pkt-name{font-size:13px;font-weight:600;color:var(--ink)}
.pkt-addr{font-size:11px;color:var(--muted);margin-top:2px}
.user-chip{display:flex;align-items:center;gap:7px}
.user-av{width:26px;height:26px;border-radius:50%;background:var(--blue-bg);color:var(--blue);display:flex;align-items:center;justify-content:center;font-family:var(--syne);font-size:10px;font-weight:700;flex-shrink:0}
.user-av.unassigned{background:var(--surface2);color:var(--dim);border:1.5px dashed var(--line2)}
.user-name{font-size:13px;font-weight:500;color:var(--ink)}
.unassigned-txt{font-size:12px;color:var(--dim);font-style:italic}
.pill{display:inline-flex;align-items:center;gap:4px;font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:0.5px;padding:3px 8px;border-radius:20px;text-transform:uppercase}
.pill-delivered{background:var(--green-bg);color:var(--green);border:1px solid rgba(26,107,60,0.2)}
.pill-assigned{background:var(--amber-light);color:var(--amber);border:1px solid rgba(200,118,10,0.2)}
.pill-uploaded{background:var(--blue-bg);color:var(--blue);border:1px solid rgba(26,79,160,0.2)}
.pill-dot{width:5px;height:5px;border-radius:50%;background:currentColor}
.recv-name{font-size:12px;font-weight:600;color:var(--ink)}
.recv-phone{font-family:var(--mono);font-size:11px;color:var(--muted);margin-top:1px}
.recv-empty{color:var(--dim);font-size:12px}
.action-cell{display:flex;align-items:center;gap:6px}
.assign-form-inline{display:flex;gap:6px;align-items:center}
.assign-inp{width:80px;background:var(--surface2);border:1px solid var(--line);border-radius:var(--r);padding:5px 8px;font-family:var(--mono);font-size:12px;color:var(--ink);outline:none}
.assign-inp:focus{border-color:var(--amber)}
.btn-assign{background:var(--green-bg);color:var(--green);border:1px solid rgba(26,107,60,0.25);border-radius:var(--r);padding:5px 10px;font-size:11px;font-weight:600;font-family:var(--body);cursor:pointer;white-space:nowrap;transition:all 0.12s}
.btn-assign:hover{background:#d0ead9}
.btn-reassign-sm{background:transparent;color:var(--muted);border:1px solid var(--line);border-radius:var(--r);padding:5px 10px;font-size:11px;font-weight:500;font-family:var(--body);cursor:pointer;transition:all 0.12s}
.btn-reassign-sm:hover{border-color:var(--amber);color:var(--amber)}

/* STATS */
.stats-section{display:none}
.user-stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px}
.user-stat-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:16px 18px}
.usc-header{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.usc-avatar{width:38px;height:38px;border-radius:50%;background:var(--blue-bg);color:var(--blue);display:flex;align-items:center;justify-content:center;font-family:var(--syne);font-size:13px;font-weight:700;flex-shrink:0}
.usc-name{font-family:var(--syne);font-size:14px;font-weight:700;color:var(--ink)}
.usc-id{font-family:var(--mono);font-size:10px;color:var(--muted)}
.usc-nums{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.usc-n{font-family:var(--syne);font-size:20px;font-weight:800;color:var(--ink);line-height:1}
.usc-nl{font-family:var(--mono);font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:1.5px;margin-top:2px}
.progress-bar{height:3px;background:var(--line);border-radius:2px;margin-top:12px;overflow:hidden}
.progress-fill{height:100%;background:var(--amber);border-radius:2px}
.progress-fill.high{background:var(--green)}
.usc-rate{font-family:var(--mono);font-size:10px;color:var(--muted);margin-top:5px}

/* MAP */
.map-section{display:none}
.map-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden}
.map-head{padding:12px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}
#leaflet-map{height:460px;width:100%}

/* AUDIT */
.audit-section{display:none}
.audit-log{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden}
.audit-row{display:grid;grid-template-columns:160px 140px 1fr auto;align-items:center;gap:12px;padding:11px 18px;border-bottom:1px solid var(--line);transition:background 0.12s}
.audit-row:last-child{border-bottom:none}
.audit-row:hover{background:var(--surface2)}
.audit-ts{font-family:var(--mono);font-size:11px;color:var(--muted)}
.audit-pkt{font-family:var(--mono);font-size:11px;color:var(--amber);font-weight:600}
.audit-type{display:inline-flex;align-items:center;gap:4px;font-family:var(--mono);font-size:9px;font-weight:600;padding:2px 7px;border-radius:20px;text-transform:uppercase;margin-top:3px}
.audit-type.reassign{background:var(--blue-bg);color:var(--blue);border:1px solid rgba(26,79,160,0.2)}
.audit-type.delivery{background:var(--green-bg);color:var(--green);border:1px solid rgba(26,107,60,0.2)}
.audit-detail{font-size:13px;color:var(--ink)}
.audit-detail .dim{color:var(--muted)}
.audit-by{font-size:11px;color:var(--dim);text-align:right;white-space:nowrap}
.audit-pages{padding:10px 18px;border-top:1px solid var(--line);display:flex;align-items:center;gap:8px;justify-content:flex-end}
.page-btn{background:var(--surface2);border:1px solid var(--line);border-radius:var(--r);padding:5px 12px;font-family:var(--mono);font-size:11px;color:var(--ink);cursor:pointer;transition:all 0.12s;text-decoration:none;display:inline-block}
.page-btn:hover{border-color:var(--amber);color:var(--amber)}
.page-info{font-family:var(--mono);font-size:11px;color:var(--muted)}

/* EMPTY */
.empty-state{text-align:center;padding:48px 20px;color:var(--muted)}
.empty-state .eico{font-size:32px;margin-bottom:10px;opacity:0.4}

/* BULK BAR */
.bulk-bar{
  position:fixed;bottom:24px;left:50%;
  transform:translateX(-50%) translateY(100px);
  background:var(--ink);border:1px solid var(--ink3);border-radius:12px;
  padding:12px 18px;display:flex;align-items:center;gap:12px;
  box-shadow:0 8px 40px rgba(0,0,0,0.25);z-index:200;
  opacity:0;transition:all 0.3s cubic-bezier(0.34,1.56,0.64,1);white-space:nowrap
}
.bulk-bar.show{transform:translateX(-50%) translateY(0);opacity:1}
.bulk-count-badge{font-family:var(--mono);font-size:11px;background:rgba(200,118,10,0.15);color:var(--amber-mid);border:1px solid rgba(200,118,10,0.25);border-radius:20px;padding:3px 10px}
.bulk-div{width:1px;height:20px;background:var(--ink3)}
.bulk-label{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#666}
.bulk-inp{background:rgba(255,255,255,0.06);border:1px solid var(--ink3);border-radius:6px;padding:7px 10px;color:#eee;font-family:var(--mono);font-size:12px;width:100px;outline:none;transition:border-color 0.15s}
.bulk-inp:focus{border-color:var(--amber-mid)}
.bulk-assign-btn{background:var(--amber);color:#fff;border:none;border-radius:6px;padding:7px 14px;font-family:var(--syne);font-size:12px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;transition:all 0.15s}
.bulk-assign-btn:hover{background:#b5690a}
.bulk-clear{background:transparent;color:#666;border:1px solid var(--ink3);border-radius:6px;padding:7px 10px;font-family:var(--body);font-size:12px;cursor:pointer;transition:all 0.15s}
.bulk-clear:hover{color:#ccc;border-color:#555}

/* MODAL */
.modal-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:300;
  display:flex;align-items:center;justify-content:center;
  opacity:0;pointer-events:none;transition:opacity 0.2s;padding:16px
}
.modal-overlay.open{opacity:1;pointer-events:all}
.modal{
  background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);
  width:440px;max-width:100%;
  box-shadow:0 20px 80px rgba(0,0,0,0.2);
  transform:translateY(16px) scale(0.98);
  transition:transform 0.2s cubic-bezier(0.34,1.2,0.64,1)
}
.modal-overlay.open .modal{transform:translateY(0) scale(1)}
.modal-head{padding:18px 22px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}
.modal-title{font-family:var(--syne);font-size:16px;font-weight:700;color:var(--ink)}
.modal-close{background:none;border:none;cursor:pointer;color:var(--muted);font-size:16px;width:28px;height:28px;border-radius:4px;display:flex;align-items:center;justify-content:center;transition:all 0.12s;line-height:1}
.modal-close:hover{background:var(--surface2);color:var(--ink)}
.modal-body{padding:18px 22px}
.modal-info{background:var(--surface2);border:1px solid var(--line);border-radius:var(--r);padding:12px 14px;margin-bottom:16px}
.modal-info-row{display:flex;gap:10px;align-items:baseline;margin-bottom:6px}
.modal-info-row:last-child{margin-bottom:0}
.modal-info-label{font-family:var(--mono);font-size:9px;text-transform:uppercase;letter-spacing:1.5px;color:var(--muted);min-width:72px;flex-shrink:0}
.modal-info-val{font-size:13px;font-weight:500;color:var(--ink)}
.modal-info-val.code{font-family:var(--mono);font-size:11px;color:var(--amber);background:var(--amber-light);padding:2px 7px;border-radius:4px;border:1px solid rgba(200,118,10,0.15)}
.field{margin-bottom:14px}
.field:last-child{margin-bottom:0}
.field label{display:block;font-family:var(--mono);font-size:9px;text-transform:uppercase;letter-spacing:1.5px;color:var(--muted);margin-bottom:5px}
.field-inp{width:100%;background:var(--surface2);border:1px solid var(--line);border-radius:var(--r);padding:9px 12px;font-family:var(--body);font-size:13px;color:var(--ink);outline:none;transition:border-color 0.15s}
.field-inp:focus{border-color:var(--amber);background:#fff}
.modal-foot{padding:14px 22px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px}
.btn-cancel{background:transparent;border:1px solid var(--line);border-radius:var(--r);padding:8px 16px;font-family:var(--body);font-size:13px;color:var(--muted);cursor:pointer;transition:all 0.12s}
.btn-cancel:hover{border-color:var(--line2);color:var(--ink)}
.btn-confirm{background:var(--amber);color:#fff;border:none;border-radius:var(--r);padding:8px 20px;font-family:var(--syne);font-size:13px;font-weight:700;cursor:pointer;transition:all 0.15s;display:flex;align-items:center;gap:7px}
.btn-confirm:hover{background:#b5690a}
.btn-confirm:disabled{background:var(--dim);cursor:not-allowed}

/* TOAST */
#toasts{position:fixed;top:20px;right:20px;display:flex;flex-direction:column;gap:8px;z-index:999}
.toast{display:flex;align-items:center;gap:10px;background:var(--ink);border:1px solid var(--ink3);border-radius:var(--r);padding:10px 14px;font-size:13px;color:#eee;min-width:230px;box-shadow:0 4px 24px rgba(0,0,0,0.15);animation:slideIn 0.25s cubic-bezier(0.34,1.56,0.64,1) forwards}
.toast.success{border-left:3px solid var(--green)}
.toast.error{border-left:3px solid var(--red)}
.toast.info{border-left:3px solid var(--amber)}
.spinner{width:13px;height:13px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:spin 0.6s linear infinite;display:inline-block;flex-shrink:0}

@keyframes slideIn{from{opacity:0;transform:translateX(16px)}to{opacity:1;transform:none}}
@keyframes spin{to{transform:rotate(360deg)}}

@media(max-width:768px){
  .stat-strip{grid-template-columns:repeat(2,1fr)}
  .user-stat-grid{grid-template-columns:1fr 1fr}
  .audit-row{grid-template-columns:1fr 1fr}
  .topbar{padding:0 14px;gap:8px}
  .content{padding:14px}
  .search-bar{max-width:160px}
}
</style>
</head>
<body>
<!-- ══ TOPBAR ══ -->
<div class="topbar">
  <div class="topbar-brand">Packet<span>Ops</span></div>
  <div class="topbar-sep"></div>
  <div class="topbar-title" id="topbarTitle">Packet Management</div>

  <form method="GET" action="/packet/adminPacket" style="display:flex">
    <div class="month-pick">
      <div class="month-pick-label">Month</div>
      <input type="month" name="month" value="<%= curMonth %>" onchange="this.form.submit()">
    </div>
  </form>

  <div class="search-bar">
    <span class="search-ico">⌕</span>
    <input type="text" id="searchInput" placeholder="Search packets…" oninput="filterTable()">
  </div>

  <select class="status-select" id="statusFilter" onchange="filterTable()">
    <option value="all">All status</option>
    <option value="DELIVERED">Delivered</option>
    <option value="ASSIGNED">Assigned</option>
    <option value="UPLOADED">Uploaded</option>
  </select>

  <div class="topbar-right">
    <div class="admin-chip">
      <div class="admin-av"><%= initials(userName) %></div>
      <div class="admin-name-chip"><%= userName %></div>
    </div>
  </div>
</div>

<!-- ══ CONTENT ══ -->
<div class="content">

  <!-- TABS -->
  <div class="tab-bar">
    <div class="tab active" id="tab-packets" onclick="switchTab('packets',this)">
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="1" width="14" height="14" rx="2"/><path d="M5 8h6M5 5h6"/></svg>
      Packets <span class="tab-badge"><%= total %></span>
    </div>
    <div class="tab" id="tab-map" onclick="switchTab('map',this)">
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="7" r="3"/><path d="M8 2C5.24 2 3 4.24 3 7c0 3.25 5 9 5 9s5-5.75 5-9c0-2.76-2.24-5-5-5z"/></svg>
      Map View
    </div>
