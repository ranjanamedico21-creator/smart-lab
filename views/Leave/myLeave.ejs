<!-- views/Leave/myLeave.ejs -->
<%
  const STATUS = {
    Pending:   { cls: 'warning',   text: 'text-dark', label: 'Waiting for approval', short: 'Waiting',   icon: 'bi-hourglass-split' },
    Approved:  { cls: 'success',   text: '',          label: 'Approved',             short: 'Approved',  icon: 'bi-check-circle-fill' },
    Rejected:  { cls: 'danger',    text: '',          label: 'Rejected',             short: 'Rejected',  icon: 'bi-x-circle-fill' },
    SentBack:  { cls: 'orange',    text: '',          label: 'Sent back – please edit', short: 'Sent back', icon: 'bi-arrow-return-left' },
    Cancelled: { cls: 'secondary', text: '',          label: 'Cancelled by you',     short: 'Cancelled', icon: 'bi-slash-circle' },
  };
  const count = (s) => leaves.filter(l => l.Status === s).length;
  const today = moment().format('YYYY-MM-DD');
  const when = (l) => {
    if (l.Status !== 'Approved') return '';
    if (l.EndDate < today) return 'Completed';
    if (l.StartDate <= today) return 'On leave now';
    const d = moment(l.StartDate).diff(moment(today), 'days');
    return d === 1 ? 'Starts tomorrow' : `Starts in ${d} days`;
  };
%>
<style>
  .bg-orange { background: #fd7e14 !important; color: #fff; }
  .border-orange { border-color: #fd7e14 !important; }
  .text-orange { color: #fd7e14 !important; }
  .ml-card { border-left-width: 4px !important; }
  .ml-stat { border: 1px solid #e9ecef; border-radius: .5rem; padding: .5rem; text-align: center; background: #fff; }
  .ml-stat .n { font-size: 1.4rem; font-weight: 600; line-height: 1.2; }
  .ml-pills { overflow-x: auto; flex-wrap: nowrap; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .ml-pills::-webkit-scrollbar { display: none; }
  .ml-pills .nav-link { white-space: nowrap; padding: .3rem .8rem; font-size: .875rem; }
  .ml-steps { display: flex; margin: .75rem 0 .25rem; }
  .ml-step { flex: 1; position: relative; text-align: center; font-size: .75rem; color: #6c757d; }
  .ml-step::before { content: ''; position: absolute; top: 9px; left: -50%; width: 100%; height: 2px; background: #dee2e6; }
  .ml-step:first-child::before { display: none; }
  .ml-dot { position: relative; z-index: 1; display: inline-flex; align-items: center; justify-content: center;
            width: 20px; height: 20px; border-radius: 50%; background: #dee2e6; color: #fff; font-size: .7rem; }
  .ml-step.done::before, .ml-step.done .ml-dot { background: #0d6efd; }
  .ml-step.active .ml-dot { background: #ffc107; }
  .ml-step.ok .ml-dot { background: #198754; }
  .ml-step.bad .ml-dot { background: #dc3545; }
  .ml-step.back .ml-dot { background: #fd7e14; }
  .ml-step.done, .ml-step.ok, .ml-step.bad, .ml-step.back, .ml-step.active { color: #212529; }
  .ml-remark { background: #f8f9fa; border-radius: 6px; padding: .5rem .75rem; font-size: .875rem; word-break: break-word; }
  .ml-status { font-size: .85rem; }
  @media (max-width: 575.98px) {
    .ml-status { font-size: .75rem; }
    .ml-steps .ml-sub { display: none; }
  }
</style>

<div class="container-fluid py-3 px-2 px-sm-3">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h4 class="mb-0">My Leave Applications</h4>
    <a href="/user/applyLeave" class="btn btn-primary btn-sm">
      <i class="bi bi-plus-circle me-1"></i> Apply Leave
    </a>
  </div>

  <% if (leaves && leaves.length) { %>

    <!-- Summary -->
    <div class="row g-2 mb-3">
      <div class="col-3"><div class="ml-stat"><div class="n text-warning"><%= count('Pending') %></div><div class="small text-muted">Waiting</div></div></div>
      <div class="col-3"><div class="ml-stat"><div class="n text-success"><%= count('Approved') %></div><div class="small text-muted">Approved</div></div></div>
      <div class="col-3"><div class="ml-stat"><div class="n text-orange"><%= count('SentBack') %></div><div class="small text-muted text-truncate">To edit</div></div></div>
      <div class="col-3"><div class="ml-stat"><div class="n text-danger"><%= count('Rejected') %></div><div class="small text-muted">Rejected</div></div></div>
    </div>

    <!-- Filter (scrolls sideways on phones) -->
    <ul class="nav nav-pills ml-pills gap-1 mb-3">
      <li class="nav-item"><button type="button" class="nav-link active" data-filter="all">All (<%= leaves.length %>)</button></li>
      <% ['Pending','Approved','SentBack','Rejected','Cancelled'].forEach(s => { if (count(s)) { %>
        <li class="nav-item"><button type="button" class="nav-link" data-filter="<%= s %>"><%= STATUS[s].short %> (<%= count(s) %>)</button></li>
      <% } }) %>
    </ul>

    <div class="row row-cols-1 row-cols-xl-2 row-cols-xxl-3 g-3">
    <% leaves.forEach(l => {
         const s = STATUS[l.Status] || STATUS.Pending;
         const decided = ['Approved', 'Rejected', 'SentBack'].includes(l.Status);
         const resubmitted = l.Status === 'Pending' && l.AdminRemarks;
    %>
      <div class="col" data-status="<%= l.Status %>">
      <div class="card h-100 shadow-sm ml-card border-<%= s.cls %>">
        <div class="card-body p-3">
          <div class="d-flex justify-content-between align-items-start gap-2">
            <div class="min-w-0">
              <div class="fw-semibold">
                <%= l.Name || 'Leave' %>
                <span class="text-muted fw-normal">· <%= l.DaysCount %> day<%= l.DaysCount > 1 ? 's' : '' %></span>
                <% if (Number(l.UserSeen) === 0) { %><span class="badge bg-primary ms-1">New</span><% } %>
              </div>
              <div class="small">
                <i class="bi bi-calendar3 me-1"></i><%= moment(l.StartDate).format('DD MMM YYYY') %><% if (l.EndDate !== l.StartDate) { %>
                → <%= moment(l.EndDate).format('DD MMM YYYY') %><% } %>
              </div>
              <% if (when(l)) { %><div class="small text-success"><%= when(l) %></div><% } %>
            </div>
            <span class="badge bg-<%= s.cls %> <%= s.text %> ml-status fw-normal flex-shrink-0">
              <i class="bi <%= s.icon %> me-1"></i><span class="d-none d-sm-inline"><%= s.label %></span><span class="d-sm-none"><%= s.short %></span>
            </span>
          </div>

          <!-- Progress -->
          <div class="ml-steps">
            <div class="ml-step done">
              <span class="ml-dot"><i class="bi bi-check"></i></span>
              <div>Applied</div>
              <div class="text-muted ml-sub"><%= moment(l.CreatedAt).format('DD MMM') %></div>
            </div>
            <div class="ml-step <%= l.Status === 'Pending' ? 'active' : (l.Status === 'Cancelled' ? '' : 'done') %>">
              <span class="ml-dot"><i class="bi <%= l.Status === 'Pending' ? 'bi-three-dots' : 'bi-check' %>"></i></span>
              <div><%= resubmitted ? 'Resubmitted' : 'Review' %></div>
            </div>
            <div class="ml-step <%= { Approved: 'ok', Rejected: 'bad', SentBack: 'back' }[l.Status] || '' %>">
              <span class="ml-dot"><i class="bi <%= l.Status === 'Approved' ? 'bi-check' : (l.Status === 'Rejected' || l.Status === 'Cancelled' ? 'bi-x' : (l.Status === 'SentBack' ? 'bi-arrow-return-left' : 'bi-flag')) %>"></i></span>
              <div><%= decided ? s.short : (l.Status === 'Cancelled' ? 'Cancelled' : 'Decision') %></div>
              <% if (decided && l.ReviewedAt) { %><div class="text-muted ml-sub"><%= moment(l.ReviewedAt).format('DD MMM') %></div><% } %>
            </div>
          </div>

          <% if (l.Reason) { %>
            <div class="small text-muted mt-2 text-break"><strong>Your reason:</strong> <%= l.Reason %></div>
          <% } %>

          <% if (l.AdminRemarks) { %>
            <div class="ml-remark mt-2 <%= l.Status === 'SentBack' ? 'border border-orange' : '' %>">
              <i class="bi bi-chat-left-text me-1"></i>
              <strong><%= resubmitted ? 'Earlier remark' : 'Remark' %><%= l.ReviewerName ? ' from ' + l.ReviewerName : '' %>:</strong>
              <%= l.AdminRemarks %>
            </div>
          <% } else if (decided && l.ReviewerName) { %>
            <div class="small text-muted mt-2"><%= s.short %> by <%= l.ReviewerName %></div>
          <% } %>

          <!-- Actions: full-width on phones, inline on larger screens -->
          <% if (l.Status === 'SentBack' || l.Status === 'Pending') { %>
            <div class="d-grid d-sm-flex gap-2 mt-3">
              <% if (l.Status === 'SentBack') { %>
                <a href="/user/leaves/edit/<%= l.Id %>" class="btn btn-sm btn-primary">
                  <i class="bi bi-pencil-square me-1"></i> Edit & resubmit
                </a>
              <% } %>
              <form action="/user/leaves/cancel" method="post" class="m-0 d-grid">
                <input type="hidden" name="leaveId" value="<%= l.Id %>">
                <button class="btn btn-sm btn-outline-danger"
                        data-confirm="Cancel this leave application? You will have to apply again if you change your mind."
                        data-confirm-title="Cancel leave" data-confirm-ok="Yes, cancel it" data-confirm-variant="danger">
                  <i class="bi bi-x-lg me-1"></i> Cancel application
                </button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
      </div>
    <% }) %>
    </div>

  <% } else { %>
    <div class="text-center py-5">
      <i class="bi bi-calendar-x fs-1 text-muted"></i>
      <p class="mt-2 mb-3 text-muted">You haven't applied for any leave yet.</p>
      <a href="/user/applyLeave" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Apply Leave</a>
    </div>
  <% } %>
</div>

<%- include('../partials/confirmModal') %>

<script>
  document.querySelectorAll('[data-filter]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('[data-filter]').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var f = btn.dataset.filter;
      document.querySelectorAll('[data-status]').forEach(function (card) {
        card.classList.toggle('d-none', !(f === 'all' || card.dataset.status === f));
      });
    });
  });
</script>
