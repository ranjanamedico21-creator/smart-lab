            </div>
            <div id="previewBoxTemplateCommon" style="display:none;margin-top:12px;border:1.5px solid var(--ct-border);border-radius:10px;padding:14px;background:var(--ct-surface);max-height:240px;overflow-y:auto;font-size:12px"></div>
            <div id="statusTemplateCommon" style="font-size:11px;margin-top:6px;color:var(--ct-text-3)"></div>
            <textarea name="templateCommon" id="htmlTemplateCommon" style="display:none"></textarea>
          </div>
        </div>

        <div id="ctUploadSeparate" style="display:none">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
            <div>
              <div style="font-size:12px;font-weight:600;color:var(--ct-primary);margin-bottom:8px">♂ Male Template</div>
              <div class="ct-upload-zone" onclick="document.getElementById('fileTemplateMale').click()">
                <input type="file" id="fileTemplateMale" name="fileTemplateMale" accept=".docx" onchange="ctHandleTemplateFile('Male')" style="display:none">
                <svg viewBox="0 0 24 24" style="width:24px;height:24px;margin:0 auto 6px;stroke:var(--ct-primary);fill:none;stroke-width:2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/>
                  <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
                <div style="font-size:12px;font-weight:600;color:var(--ct-primary)" id="lblTemplateMale">Upload male template</div>
              </div>
              <div id="previewTemplateMale" style="display:none;margin-top:10px">
                <button type="button" class="ct-btn ct-btn-ghost" style="padding:6px 14px;font-size:12px" onclick="ctPreviewTemplate('Male')">
                  <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  Preview
                </button>
              </div>
              <div id="previewBoxTemplateMale" style="display:none;margin-top:10px;border:1.5px solid var(--ct-border);border-radius:8px;padding:12px;max-height:200px;overflow-y:auto;font-size:11px"></div>
              <div id="statusTemplateMale" style="font-size:10px;margin-top:4px"></div>
              <textarea name="templateMale" id="htmlTemplateMale" style="display:none"></textarea>
            </div>
            <div>
              <div style="font-size:12px;font-weight:600;color:#A32D2D;margin-bottom:8px">♀ Female Template</div>
              <div class="ct-upload-zone" onclick="document.getElementById('fileTemplateFemale').click()">
                <input type="file" id="fileTemplateFemale" name="fileTemplateFemale" accept=".docx" onchange="ctHandleTemplateFile('Female')" style="display:none">
                <svg viewBox="0 0 24 24" style="width:24px;height:24px;margin:0 auto 6px;stroke:#A32D2D;fill:none;stroke-width:2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/>
                  <line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
                <div style="font-size:12px;font-weight:600;color:#A32D2D" id="lblTemplateFemale">Upload female template</div>
              </div>
              <div id="previewTemplateFemale" style="display:none;margin-top:10px">
                <button type="button" class="ct-btn ct-btn-ghost" style="padding:6px 14px;font-size:12px" onclick="ctPreviewTemplate('Female')">
                  <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  Preview
                </button>
              </div>
              <div id="previewBoxTemplateFemale" style="display:none;margin-top:10px;border:1.5px solid var(--ct-border);border-radius:8px;padding:12px;max-height:200px;overflow-y:auto;font-size:11px"></div>
              <div id="statusTemplateFemale" style="font-size:10px;margin-top:4px"></div>
              <textarea name="templateFemale" id="htmlTemplateFemale" style="display:none"></textarea>
            </div>
          </div>
          <div style="font-size:11px;color:var(--ct-text-3);margin-top:8px;text-align:center">You can upload one or both. Skip whichever doesn't apply.</div>
        </div>

        <div style="margin-top:16px;padding:12px 16px;background:#FAEEDA;border:1px solid #FAC775;border-radius:8px;font-size:11px;color:#633806;line-height:1.8">
          <strong>Available placeholders:</strong><br>
          <code style="background:rgba(0,0,0,.08);padding:1px 5px;border-radius:3px">{{PatientName}}</code>
          <code style="background:rgba(0,0,0,.08);padding:1px 5px;margin-left:2px;border-radius:3px">{{Age}}</code>
          <code style="background:rgba(0,0,0,.08);padding:1px 5px;margin-left:2px;border-radius:3px">{{Gender}}</code>
          <code style="background:rgba(0,0,0,.08);padding:1px 5px;margin-left:2px;border-radius:3px">{{Date}}</code>
          <code style="background:rgba(0,0,0,.08);padding:1px 5px;margin-left:2px;border-radius:3px">{{TestName}}</code>
          <code style="background:rgba(0,0,0,.08);padding:1px 5px;margin-left:2px;border-radius:3px">{{DoctorName}}</code>
          <code style="background:rgba(0,0,0,.08);padding:1px 5px;margin-left:2px;border-radius:3px">{{ReportingDoctor}}</code>
        </div>
      </div>

      <div class="ct-footer">
        <button type="button" class="ct-btn ct-btn-ghost" onclick="ctReset()">
          <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          Reset
        </button>
        <button type="submit" class="ct-btn ct-btn-primary">
          <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
          Create Test
        </button>
      </div>

    </form>
  </div>
</div>

<%# Safe JSON island — browser never executes type="application/json" blocks.
    JSON is stored as text content (not attribute), so <, >, & are safe.
    JS reads el.textContent which gives the raw JSON string. %>
<script type="application/json" id="ctContainerJson"><%- JSON.stringify(typeof containers !== 'undefined' ? containers : []) %></script>

<script>
(function () {
  'use strict';

  /* ═══════════════════════════════════════════════════════════════════
     TOAST SYSTEM
  ═══════════════════════════════════════════════════════════════════ */

  var TOAST_ICONS = {
    danger:  '<svg viewBox="0 0 24 24" fill="none" stroke="#e53e3e" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>',
    success: '<svg viewBox="0 0 24 24" fill="none" stroke="#38a169" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>',
    warning: '<svg viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
    info:    '<svg viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4m0-4h.01"/></svg>',
  };
  var TOAST_TITLES = { danger:'Error', success:'Success', warning:'Warning', info:'Info' };

  window.ctToast = function (type, title, message, ms) {
    var stack    = document.getElementById('ctToastStack');
    var duration = (ms === undefined) ? 5000 : ms;
    var t        = document.createElement('div');
    t.className  = 'ct-toast ct-toast-' + type;
    t.innerHTML  =
      '<div class="ct-toast-icon">' + (TOAST_ICONS[type] || TOAST_ICONS.info) + '</div>' +
      '<div class="ct-toast-body">' +
        '<div class="ct-toast-title">' + ctEsc(title || TOAST_TITLES[type] || 'Notice') + '</div>' +
        '<div class="ct-toast-msg">'   + ctEsc(message || '').replace(/\n/g, '<br>') + '</div>' +
      '</div>' +
      '<button type="button" class="ct-toast-close" aria-label="Dismiss">&times;</button>';
    stack.appendChild(t);
    t.querySelector('.ct-toast-close').addEventListener('click', function () { ctDismissToast(t); });
    if (duration > 0) setTimeout(function () { ctDismissToast(t); }, duration);
    return t;
  };

  function ctDismissToast(el) {
    if (!el || !el.parentNode) return;
    el.classList.add('ct-toast-out');
    setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 220);
  }

  function ctEsc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  window.ctShowErrors = function (errors) {
    ctToast('danger', 'Please fix ' + errors.length + ' error' + (errors.length > 1 ? 's' : '') + ' before submitting', errors.join('\n'), 0);
  };

  /* ═══════════════════════════════════════════════════════════════════
     CONSTANTS
  ═══════════════════════════════════════════════════════════════════ */
  var PATHOLOGY_CATS = ['pathology'];
  var IMAGING_CATS   = ['radiology','mri','ct'];
  var USG_CATS       = ['usg'];
  var PILL_CLASS     = { radiology:'sel-rad', mri:'sel-rad', ct:'sel-rad', usg:'sel-usg', pathology:'sel-path', other:'sel-other' };

  var currentCat = null;

  /* ═══════════════════════════════════════════════════════════════════
     CONTAINER MAP
  ═══════════════════════════════════════════════════════════════════ */
  var ctContainerData = (function () {
    var el = document.getElementById('ctContainerJson');
    if (!el) return [];
    try { return JSON.parse(el.textContent || el.innerHTML || '[]'); } catch (e) { return []; }
  }());

  var ctContainerMap = {};
  ctContainerData.forEach(function (c) {
    var sid = c.SpecimenTypeId || c.specimenTypeId ||
              c.SpecimenTypeID || c.specimenTypeID ||
              c.specimen_type_id;
    if (sid == null) return;
    sid = String(sid);
    if (!ctContainerMap[sid]) ctContainerMap[sid] = [];
    ctContainerMap[sid].push(c);
  });

  /* ═══════════════════════════════════════════════════════════════════
     TOMSELECT HELPERS
  ═══════════════════════════════════════════════════════════════════ */

  /**
   * Get the TomSelect instance for an element id (if it exists).
   */
  function getTS(id) {
    var el = document.getElementById(id);
    return (el && el.tomselect) ? el.tomselect : null;
  }

  /**
   * Replace all options in a TomSelect-controlled select.
   * Uses TomSelect's public API (v2.x compatible).
   */
  function tsReplaceOptions(id, items, placeholder, disabled) {
    var ts = getTS(id);

    if (ts) {
      /* ── TomSelect v2.x public API ─────────────────────────── */
      ts.clear(true);           // deselect silently
      ts.clearOptions();        // wipe internal options cache

      if (items.length) {
        // addOption (singular) is the correct method in TomSelect v2
        items.forEach(function (item) {
          ts.addOption({ value: item.value, text: item.label });
        });
      }

      ts.refreshOptions(false); // refresh dropdown without triggering search
      ts.sync();              // re-sync native <select> for form submission

      /* Update the visible placeholder */
      ts.settings.placeholder = placeholder;
      if (ts.control_input) {
        ts.control_input.placeholder = placeholder;
      }

      if (disabled) {
        ts.disable();
      } else {
        ts.enable();
      }

    } else {
      /* ── Native DOM fallback (TomSelect not yet initialised) ────── */
      var sel = document.getElementById(id);
      if (!sel) return;
      sel.innerHTML = '';
      var ph = document.createElement('option');
      ph.value = ''; ph.disabled = true; ph.selected = true;
      ph.textContent = placeholder;
      sel.appendChild(ph);
      items.forEach(function (item) {
        var opt = document.createElement('option');
        opt.value = item.value; opt.textContent = item.label;
        sel.appendChild(opt);
      });
      if (disabled) sel.setAttribute('disabled','');
      else          sel.removeAttribute('disabled');
    }
  }

  function resetContainerSelect() {
    tsReplaceOptions('ctSampleContainer', [], 'Select specimen type first', true);
  }

  /* ═══════════════════════════════════════════════════════════════════
     ctFilterContainers — specimen → container cascade
  ═══════════════════════════════════════════════════════════════════ */
  window.ctFilterContainers = function () {
    var ts = getTS('ctSpecimenType');
    var specId = String(ts ? ts.getValue() : '').trim();

    var rows = (specId && ctContainerMap[specId]) ? ctContainerMap[specId] : [];

    if (!rows.length) {
      tsReplaceOptions(
        'ctSampleContainer',
        [],
        specId ? 'No containers for this specimen' : 'Select specimen type first',
        true
      );
      var fg = document.getElementById('ctSampleContainer');
      if (fg) {
        var closest = fg.closest && fg.closest('.ct-fg');
        if (closest) closest.classList.remove('ct-error');
      }
      return;
    }

    var items = rows.map(function (c) {
      return { value: String(c.Id), label: c.ContainerName + ' \u2014 ' + c.CapColor + ' cap' };
    });

    tsReplaceOptions('ctSampleContainer', items, 'Select container', false);
  };

  /* ═══════════════════════════════════════════════════════════════════
     TOM SELECT INITIALIZATION
     Must run AFTER DOM is ready and AFTER ctContainerMap is built
  ═══════════════════════════════════════════════════════════════════ */

  function initTomSelect() {
    /* ── Specimen Type ───────────────────────────────────────────── */
    new TomSelect('#ctSpecimenType', {
      plugins: [],
      placeholder: 'Select specimen',
      allowEmptyOption: true,
      maxItems: 1,
      onChange: function () {
        ctFilterContainers();
      }
    });

    /* ── Sample Container (starts empty/disabled) ───────────────── */
    new TomSelect('#ctSampleContainer', {
      plugins: [],
      placeholder: 'Select specimen type first',
      allowEmptyOption: true,
      maxItems: 1
    });

    /* Disable container initially since no specimen selected */
    var tsContainer = getTS('ctSampleContainer');
    if (tsContainer) tsContainer.disable();
  }

  /* ═══════════════════════════════════════════════════════════════════
     PILL SELECTION
  ═══════════════════════════════════════════════════════════════════ */
  window.ctSelectCategory = function (el) {
    document.querySelectorAll('.ct-pill').forEach(function (p) {
      p.classList.remove('sel-rad','sel-path','sel-usg','sel-other');
    });
    el.classList.add(PILL_CLASS[el.dataset.cat] || 'sel-rad');
    document.getElementById('ctMainCategory').value = el.dataset.value;
    currentCat = el.dataset.cat;
    document.getElementById('ctCatErr').style.display = 'none';
    applyRules();
  };

  /* ═══════════════════════════════════════════════════════════════════
     CATEGORY RULES
  ═══════════════════════════════════════════════════════════════════ */
  function applyRules() {
    var isPath    = PATHOLOGY_CATS.indexOf(currentCat) !== -1;
    var isImaging = IMAGING_CATS.indexOf(currentCat)   !== -1;
    var isUSG     = USG_CATS.indexOf(currentCat)       !== -1;

    document.getElementById('ctFilmRow').classList.toggle('ct-d-none', isPath);
    document.getElementById('ctFilmPathMsg').classList.toggle('ct-d-none', !isPath);
    var filmSel = document.getElementById('ctFilmType');
    if (isImaging) { filmSel.setAttribute('required',''); }
    else { filmSel.removeAttribute('required'); if (isPath || isUSG) filmSel.value = ''; }

    document.getElementById('ctPathologySection').classList.toggle('ct-d-none', !isPath);
    setPathRequired(isPath);
    if (!isPath) {
      document.getElementById('ctMinBlood').value = '';
      document.getElementById('ctMaxBlood').value = '';
    }

    var tog = document.getElementById('ctReportToggle');
    var tpl = document.getElementById('ctTemplateSection');
    if (isPath) {
      tpl.classList.add('ct-d-none');
      tog.checked = false;
      setTogLabel(tog, false);
    } else {
      tpl.classList.toggle('ct-d-none', !tog.checked);
    }
  }

  function setPathRequired(on) {
    ['ctMinBlood','ctMaxBlood'].forEach(function (id) {
      var el = document.getElementById(id);
      if (!el) return;
      if (on) el.setAttribute('required','');
      else    el.removeAttribute('required');
    });
    
    /* Handle specimen and container required attributes via TomSelect */
    var tsSpec = getTS('ctSpecimenType');
    var tsCont = getTS('ctSampleContainer');
    
    if (on) {
      document.getElementById('ctSpecimenType').setAttribute('required','');
      document.getElementById('ctSampleContainer').setAttribute('required','');
    } else {
      document.getElementById('ctSpecimenType').removeAttribute('required');
      document.getElementById('ctSampleContainer').removeAttribute('required');
    }

    if (!on) {
      if (tsSpec) tsSpec.clear(true);
      else { var s = document.getElementById('ctSpecimenType'); if (s) s.value = ''; }
      resetContainerSelect();
    }
  }

  /* ═══════════════════════════════════════════════════════════════════
     STEPPER
  ═══════════════════════════════════════════════════════════════════ */
  window.ctStep = function (id, delta) {
    var el = document.getElementById(id);
    var mn = parseInt(el.min,  10); if (isNaN(mn)) mn = 0;
    var mx = parseInt(el.max,  10); if (isNaN(mx)) mx = 999;
    el.value = Math.max(mn, Math.min(mx, (parseInt(el.value,10) || 0) + delta));
  };

  /* ═══════════════════════════════════════════════════════════════════
     REPORT TOGGLE
  ═══════════════════════════════════════════════════════════════════ */
  function setTogLabel(cb, checked) {
    var lbl = cb.nextElementSibling && cb.nextElementSibling.querySelector('.ct-toggle-lbl');
    if (lbl) lbl.textContent = checked ? 'Report Required' : 'No Report Required';
  }

  var togReport = document.getElementById('ctReportToggle');
  if (togReport) {
    togReport.addEventListener('change', function () {
      setTogLabel(this, this.checked);
      if (PATHOLOGY_CATS.indexOf(currentCat) === -1) {
        document.getElementById('ctTemplateSection').classList.toggle('ct-d-none', !this.checked);
      }
    });
  }

  /* ═══════════════════════════════════════════════════════════════════
     TEMPLATE MODE
  ═══════════════════════════════════════════════════════════════════ */
  window.ctSetTemplateMode = function (mode) {
    document.getElementById('ctUploadCommon').style.display   = mode === 'common'   ? '' : 'none';
    document.getElementById('ctUploadSeparate').style.display = mode === 'separate' ? '' : 'none';
    document.getElementById('btnTemplateCommon').classList.toggle('ct-tmpl-active',   mode === 'common');
    document.getElementById('btnTemplateSeparate').classList.toggle('ct-tmpl-active', mode === 'separate');
  };

  /* ═══════════════════════════════════════════════════════════════════
     FILE UPLOAD
  ═══════════════════════════════════════════════════════════════════ */
  window.ctHandleTemplateFile = async function (cap) {
    var inp  = document.getElementById('fileTemplate'       + cap);
    var lbl  = document.getElementById('lblTemplate'        + cap);
    var pr   = document.getElementById('previewTemplate'    + cap);
    var st   = document.getElementById('statusTemplate'     + cap);
    var box  = document.getElementById('previewBoxTemplate' + cap);
    var htm  = document.getElementById('htmlTemplate'       + cap);
    var zone = inp.closest('.ct-upload-zone');

    if (!inp.files.length) {
      lbl.textContent   = cap === 'Common' ? 'Click to upload .docx template' : 'Upload ' + cap.toLowerCase() + ' template';
      st.textContent    = ''; pr.style.display = 'none'; box.style.display = 'none'; htm.value = '';
      return;
    }

    lbl.textContent  = inp.files[0].name;
    zone.classList.remove('ct-upload-err');
    st.textContent   = 'Converting\u2026'; st.style.color = '#633806';
    pr.style.display = 'none'; box.style.display = 'none';

    var fd = new FormData();
    fd.append('docxFile', inp.files[0]);
    try {
      var res  = await fetch('/test/previewTemplate', { method:'POST', body:fd });
      var data = await res.json();
      if (data.success) {
        htm.value = data.html; pr.style.display = 'block';
        st.textContent = '\u2713 Converted successfully'; st.style.color = '#27500A';
        ctToast('success', 'Template converted', cap + ' template ready to preview.', 3000);
      } else {
        st.textContent = 'Conversion failed: ' + data.message; st.style.color = '#A32D2D'; htm.value = '';
        ctToast('danger', 'Template conversion failed', data.message, 0);
      }
    } catch (e) {
      st.textContent = 'Error: ' + e.message; st.style.color = '#A32D2D'; htm.value = '';
      ctToast('danger', 'Upload error', e.message, 0);
    }
  };

  window.ctPreviewTemplate = function (cap) {
    var htm = document.getElementById('htmlTemplate'       + cap);
    var box = document.getElementById('previewBoxTemplate' + cap);
    if (!htm.value) { ctToast('warning','No template','Please upload a template file first.',3000); return; }
    var showing = box.style.display === 'block';
    box.style.display = showing ? 'none' : 'block';
    if (!showing) box.innerHTML = htm.value;
  };

  /* ═══════════════════════════════════════════════════════════════════
     FORM VALIDATION & SUBMIT
  ═══════════════════════════════════════════════════════════════════ */
  var form = document.getElementById('ctForm');
  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();

      document.querySelectorAll('#ctToastStack .ct-toast').forEach(function (t) {
        t.classList.add('ct-toast-out');
        setTimeout(function () { if (t.parentNode) t.parentNode.removeChild(t); }, 220);
      });

      var ok = true, errs = [];

      if (!currentCat) {
        document.getElementById('ctCatErr').style.display = 'block';
        errs.push('Please select a category'); ok = false;
      }

      var pathOnlyIds = ['ctMinBlood','ctMaxBlood'];

      form.querySelectorAll('[required]').forEach(function (el) {
        /* Skip path-only fields when not pathology */
        if (pathOnlyIds.indexOf(el.id) !== -1 && PATHOLOGY_CATS.indexOf(currentCat) === -1) return;
        
        /* Skip film type for non-imaging */
        if (el.id === 'ctFilmType') {
          if (PATHOLOGY_CATS.indexOf(currentCat) !== -1 || USG_CATS.indexOf(currentCat) !== -1 || currentCat === 'other') return;
        }
        
        /* Skip specimen/container when not pathology */
        if ((el.id === 'ctSpecimenType' || el.id === 'ctSampleContainer') && PATHOLOGY_CATS.indexOf(currentCat) === -1) return;

        /* Read value from TomSelect if available, otherwise native */
        var tsInst = getTS(el.id);
        var val    = tsInst ? String(tsInst.getValue() || '').trim() : (el.value || '').trim();
        var fg     = el.closest('.ct-fg');
        if (!val) {
          ok = false;
          if (fg) fg.classList.add('ct-error');
          var lbl = fg && fg.querySelector('label');
          var nm  = lbl ? lbl.textContent.replace('*','').trim() : 'A required field';
          if (errs.indexOf(nm + ' is required') === -1) errs.push(nm + ' is required');
        } else { if (fg) fg.classList.remove('ct-error'); }
      });

      var priceEl = document.getElementById('ctPrice');
      if (priceEl && priceEl.value !== '') {
        var p = parseFloat(priceEl.value);
        if (isNaN(p) || p < 0) { errs.push('Price must be a valid positive number'); ok = false; }
        else if (p > 1000000)  { errs.push('Price seems unusually high (max \u20b910,00,000)'); ok = false; }
      }

      if (PATHOLOGY_CATS.indexOf(currentCat) !== -1) {
        var mn = parseFloat(document.getElementById('ctMinBlood').value);
        var mx = parseFloat(document.getElementById('ctMaxBlood').value);
        if (!isNaN(mn) && !isNaN(mx) && mn > mx) { errs.push('Min blood volume cannot exceed max blood volume'); ok = false; }
      }

      var togRep = document.getElementById('ctReportToggle');
      if (togRep && togRep.checked && PATHOLOGY_CATS.indexOf(currentCat) === -1) {
        var mode = document.querySelector('input[name="templateMode"]:checked');
        if (mode && mode.value === 'common') {
          if (!document.getElementById('htmlTemplateCommon').value) {
            errs.push('Please upload a common report template (.docx)'); ok = false;
            var zc = document.getElementById('zoneCommon'); if (zc) zc.classList.add('ct-upload-err');
          }
        } else if (mode && mode.value === 'separate') {
          if (!document.getElementById('htmlTemplateMale').value && !document.getElementById('htmlTemplateFemale').value) {
            errs.push('Please upload at least one gender template (male or female)'); ok = false;
          }
        }
      }

      if (!ok) {
        ctShowErrors(errs);
        var firstErr = form.querySelector('.ct-fg.ct-error');
        if (firstErr) firstErr.scrollIntoView({ behavior:'smooth', block:'nearest' });
        return;
      }

      form.submit();
    });

    form.querySelectorAll('input, select, textarea').forEach(function (el) {
      el.addEventListener('change', function () { var fg = this.closest('.ct-fg'); if (fg) fg.classList.remove('ct-error'); });
      el.addEventListener('input',  function () {
        var fg = this.closest('.ct-fg'); if (fg) fg.classList.remove('ct-error');
        var z  = this.closest('.ct-upload-zone'); if (z) z.classList.remove('ct-upload-err');
      });
    });
  }

  /* ═══════════════════════════════════════════════════════════════════
     RESET
  ═══════════════════════════════════════════════════════════════════ */
  window.ctReset = function () {
    if (form) form.reset();

    document.querySelectorAll('.ct-pill').forEach(function (p) {
      p.classList.remove('sel-rad','sel-path','sel-usg','sel-other');
    });
    currentCat = null;
    document.getElementById('ctMainCategory').value = '';

    ['ctPathologySection','ctTemplateSection','ctFilmPathMsg'].forEach(function (id) {
      document.getElementById(id).classList.add('ct-d-none');
    });
    document.getElementById('ctFilmRow').classList.remove('ct-d-none');

    var fs = document.getElementById('ctFilmType'); if (fs) fs.setAttribute('required','');
    var tog = document.getElementById('ctReportToggle'); if (tog) setTogLabel(tog, false);

    [['ctNoOfFilms',0],['ctInversion',0],['ctParameter',1]].forEach(function (p) {
      var el = document.getElementById(p[0]); if (el) el.value = p[1];
    });

    ['Common','Male','Female'].forEach(function (cap) {
      var e;
      e = document.getElementById('htmlTemplate'       + cap); if (e) e.value         = '';
      e = document.getElementById('previewTemplate'    + cap); if (e) e.style.display = 'none';
      e = document.getElementById('previewBoxTemplate' + cap); if (e) e.style.display = 'none';
      e = document.getElementById('statusTemplate'     + cap); if (e) e.textContent   = '';
    });

    /* Reset TomSelect instances */
    var tsSpec = getTS('ctSpecimenType');
    var tsCont = getTS('ctSampleContainer');
    if (tsSpec) tsSpec.clear(true);
    if (tsCont) {
      tsCont.clear(true);
      tsCont.disable();
    }

    setPathRequired(false);
    document.getElementById('ctCatErr').style.display = 'none';
    document.querySelectorAll('.ct-fg.ct-error').forEach(function (fg) { fg.classList.remove('ct-error'); });
    document.querySelectorAll('#ctToastStack .ct-toast').forEach(function (t) { ctDismissToast(t); });
  };

  /* ═══════════════════════════════════════════════════════════════════
     INITIALIZE ON DOM READY
  ═══════════════════════════════════════════════════════════════════ */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTomSelect);
  } else {
    initTomSelect();
  }

})();
</script>