<%
  const d    = doctorDetails;
  const ini  = (d.FirstName.charAt(0) + (d.LastName || '').charAt(0)).toUpperCase();
  const degs = [d.Degree1, d.Degree2, d.Degree3, d.Degree4].filter(Boolean);
%>

<style>
  :root {
    --brand:#185FA5; --brand-soft:#E6F1FB; --brand-text:#0C447C;
    --surface:#ffffff; --surface-alt:#F8F9FB;
    --border:rgba(0,0,0,0.08); --border-strong:rgba(0,0,0,0.14);
    --text-primary:#111827; --text-secondary:#6B7280; --text-hint:#9CA3AF;
    --success-bg:#EAF3DE; --success-text:#3B6D11;
    --warning-bg:#FAEEDA; --warning-text:#854F0B;
    --danger-bg:#FCEBEB;  --danger-text:#A32D2D;
    --info-bg:#E6F1FB;    --info-text:#185FA5;
    --purple-bg:#EEEDFE;  --purple-text:#534AB7;
    --radius-sm:6px; --radius-md:10px; --radius-lg:14px;
    --shadow-card:0 1px 4px rgba(0,0,0,0.06),0 0 0 0.5px rgba(0,0,0,0.08);
  }

  .ut-wrapper { padding:16px 0 40px; }
  .ut-card    { background:var(--surface); border-radius:var(--radius-lg); box-shadow:var(--shadow-card); overflow:hidden; margin-bottom:16px; }

  /* Header */
  .ut-card-header  { display:flex; align-items:center; justify-content:space-between; padding:18px 24px; border-bottom:1px solid var(--border); }
  .ut-header-left  { display:flex; align-items:center; gap:12px; }
  .ut-header-icon  { width:36px; height:36px; background:var(--brand-soft); border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; color:var(--brand); font-size:16px; flex-shrink:0; }
  .ut-header-icon.success { background:var(--success-bg); color:var(--success-text); }
  .ut-header-title { font-size:15px; font-weight:600; color:var(--text-primary); margin:0; line-height:1.2; }
  .ut-header-sub   { font-size:12px; color:var(--text-secondary); margin:2px 0 0; }

  /* Section */
  .ut-section       { padding:20px 24px; border-bottom:1px solid var(--border); }
  .ut-section:last-child { border-bottom:none; }
  .ut-section-label { font-size:11px; font-weight:700; color:var(--brand); text-transform:uppercase; letter-spacing:.07em; display:flex; align-items:center; gap:7px; margin-bottom:14px; }
  .ut-section-label.success { color:var(--success-text); }

  /* Doctor hero strip */
  .ut-hero { display:flex; align-items:center; gap:18px; padding:20px 24px; border-bottom:1px solid var(--border); background:var(--surface-alt); }
  .ut-avatar { width:52px; height:52px; border-radius:50%; background:var(--brand-soft); color:var(--brand); display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:700; flex-shrink:0; box-shadow:0 0 0 3px #fff,0 0 0 4px rgba(24,95,165,.15); }
  .ut-hero-name { font-size:16px; font-weight:700; color:var(--text-primary); text-transform:capitalize; margin:0 0 5px; }
  .ut-hero-pills { display:flex; flex-wrap:wrap; gap:5px; }
  .ut-pill { font-size:11px; font-weight:500; padding:2px 9px; border-radius:99px; }
  .ut-pill-info    { background:var(--info-bg);    color:var(--info-text); }
  .ut-pill-purple  { background:var(--purple-bg);  color:var(--purple-text); }
  .ut-pill-success { background:var(--success-bg); color:var(--success-text); }

  /* Input wrap */
  .ut-input-wrap  { display:flex; align-items:center; border:1px solid var(--border-strong); border-radius:var(--radius-sm); background:var(--surface); overflow:hidden; transition:border-color .15s,box-shadow .15s; }
  .ut-input-wrap:focus-within { border-color:var(--brand); box-shadow:0 0 0 3px rgba(24,95,165,.1); }
  .ut-input-icon  { padding:0 10px; color:var(--text-hint); font-size:13px; flex-shrink:0; }
  .ut-input-wrap input,
  .ut-input-wrap select { border:none; outline:none; background:transparent; font-size:13.5px; color:var(--text-primary); padding:9px 12px 9px 0; width:100%; font-family:inherit; }
  .ut-input-wrap select { appearance:none; cursor:pointer; }
  .ut-input-wrap input::placeholder { color:var(--text-hint); }
  .ut-input-wrap input:disabled { background:var(--surface-alt); color:var(--text-hint); cursor:not-allowed; }
  .ut-field-label { font-size:11px; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:.06em; display:block; margin-bottom:6px; }
  .ut-req { color:var(--danger-text); }

  /* Category quick-update strip */
  .ut-quick-grid  { display:grid; grid-template-columns:1fr 1fr auto; gap:12px; align-items:flex-end; }

  /* Search grid */
  .ut-search-grid { display:grid; grid-template-columns:1fr 1fr auto; gap:12px; align-items:flex-end; }

  /* Buttons */
  .ut-btn         { display:inline-flex; align-items:center; gap:6px; padding:9px 18px; border-radius:var(--radius-sm); font-size:13px; font-weight:500; border:none; cursor:pointer; transition:background .15s; text-decoration:none; white-space:nowrap; }
  .ut-btn-primary { background:var(--brand); color:#fff; }
  .ut-btn-primary:hover { background:var(--brand-text); color:#fff; }
  .ut-btn-success { background:#2e7d32; color:#fff; }
  .ut-btn-success:hover { background:#1b5e20; }
  .ut-btn-outline { background:transparent; color:var(--brand); border:1px solid var(--brand); }
  .ut-btn-outline:hover { background:var(--brand-soft); color:var(--brand); }

  /* Table */
  .ut-table       { width:100%; border-collapse:collapse; }
  .ut-table thead th { font-size:10.5px; font-weight:600; text-transform:uppercase; letter-spacing:.06em; color:var(--text-secondary); padding:0 12px 10px; border-bottom:1px solid var(--border-strong); text-align:left; white-space:nowrap; }
  .ut-table tbody td { padding:11px 12px; font-size:13px; color:var(--text-primary); border-bottom:1px solid var(--border); vertical-align:middle; }
  .ut-table tbody tr:last-child td { border-bottom:none; }
  .ut-table tbody tr:hover { background:var(--surface-alt); }
  .ut-table tbody tr.row-selected { background:var(--brand-soft); }

  /* Current commission badge */
  .ut-comm-badge { display:inline-block; padding:2px 8px; border-radius:99px; background:var(--success-bg); color:var(--success-text); font-size:11px; font-weight:600; font-family:'DM Mono',monospace; }

  /* Checkbox custom */
  .ut-check { width:16px; height:16px; cursor:pointer; accent-color:var(--brand); }

  /* No data */
  .ut-no-data { display:flex; align-items:center; gap:8px; padding:12px 16px; background:var(--warning-bg); border:1px solid rgba(133,79,11,.15); border-radius:var(--radius-sm); font-size:13px; color:var(--warning-text); }

  /* Hint */
  .ut-hint { font-size:11px; color:var(--text-hint); margin-top:4px; }

  /* Count pill */
  .ut-count-pill { font-size:11px; font-weight:500; padding:2px 10px; border-radius:99px; background:var(--surface-alt); border:1px solid var(--border); color:var(--text-secondary); }

  /* Selected summary bar */
  .ut-selected-bar { display:none; align-items:center; justify-content:space-between; padding:10px 14px; background:var(--brand-soft); border:1px solid rgba(24,95,165,.15); border-radius:var(--radius-sm); margin-bottom:14px; }
  .ut-selected-bar.show { display:flex; }
  .ut-selected-bar .lbl { font-size:13px; font-weight:500; color:var(--brand); }

  @media(max-width:768px) {
    .ut-quick-grid  { grid-template-columns:1fr; }
    .ut-search-grid { grid-template-columns:1fr; }
    .ut-hero        { flex-direction:column; align-items:flex-start; }
  }
</style>

<%- include("../partials/messages"); %>

<div class="ut-wrapper">

  <!-- ══ DOCTOR PROFILE CARD ════════════════════════════════ -->
  <div class="ut-card">

    <div class="ut-card-header">
      <div class="ut-header-left">
        <div class="ut-header-icon"><i class="bi bi-person-badge"></i></div>
        <div>
          <p class="ut-header-title">Update Doctor Commission (Thanks)</p>
          <p class="ut-header-sub">Update category-level or test-wise commission rates</p>
        </div>
      </div>
      <a href="/doctor/getDoctorDetail?doctorId=<%= d.Id %>" class="ut-btn ut-btn-outline" style="padding:7px 14px;font-size:12px;">
        <i class="bi bi-arrow-left"></i> Back to Profile
      </a>
    </div>

    <!-- Hero -->
    <div class="ut-hero">
      <div class="ut-avatar"><%= ini %></div>
      <div>
        <p class="ut-hero-name">Dr. <%= d.FirstName %> <%= d.LastName %></p>
        <div class="ut-hero-pills">
          <span class="ut-pill ut-pill-info">
            <i class="bi bi-telephone me-1"></i><%= d.MobileNumberFirst %>
          </span>
          <span class="ut-pill ut-pill-info">
            <i class="bi bi-card-text me-1"></i><%= d.Registration || 'No Reg.' %>
          </span>
          <span class="ut-pill ut-pill-info">
            <i class="bi bi-clock-history me-1"></i><%= d.YearOfExperience %> yrs exp.
          </span>
          <span class="ut-pill ut-pill-purple">
            <i class="bi bi-percent me-1"></i><%= d.FlatDiscount %>% flat discount
          </span>
          <% degs.forEach(deg => { %>
            <span class="ut-pill ut-pill-purple"><%= deg %></span>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- ── Category-level quick update ─────────────────────── -->
    <div class="ut-section">
      <div class="ut-section-label"><i class="bi bi-vials"></i> Update Category Commission</div>
      <p style="font-size:12.5px;color:var(--text-secondary);margin-bottom:14px;">
        Select a category, review the current rate, then enter a new rate and save.
      </p>

      <form action="/doctor/updateThanks" method="post" class="needs-validation" novalidate>
        <div class="ut-quick-grid">

          <div>
            <label class="ut-field-label">Category <span class="ut-req">*</span></label>
            <div class="ut-input-wrap">
              <span class="ut-input-icon"><i class="bi bi-grid"></i></span>
              <select id="selectDoctorThanksCategory" name="SelectDoctorThanksCategory" required>
                <option value="">— Select category —</option>
                <% categoryCommissionDetail.forEach(function(cat){ %>
                  <option value="<%= cat.CommissionRate %>"
                    data-thanks-category-id="<%= cat.Id %>"
                    data-thanks="<%= cat.CommissionRate %>">
                    <%= cat.Name %>
                  </option>
                <% }) %>
              </select>
            </div>
          </div>

          <div>
            <label class="ut-field-label">
              New Commission % <span class="ut-req">*</span>
              <span id="currentRateBadge" style="display:none;margin-left:6px;" class="ut-comm-badge"></span>
            </label>
            <div class="ut-input-wrap">
              <span class="ut-input-icon"><i class="bi bi-percent"></i></span>
              <input type="number" name="doctorCategoryThanks" id="doctorCategoryThanks"
                placeholder="Enter new %" step="0.01" min="0" max="100" required>
            </div>
            <p class="ut-hint" id="currentRateHint" style="display:none;"></p>
          </div>

          <div>
            <label class="ut-field-label" style="visibility:hidden">.</label>
            <button type="submit" class="ut-btn ut-btn-primary" style="width:100%;">
              <i class="bi bi-check2"></i> Update Category
            </button>
          </div>

        </div>
        <input type="hidden" name="doctorThanksCategory" id="doctorThanksCategory">
        <input type="hidden" name="doctorId" value="<%= d.Id %>">
      </form>
    </div>

    <!-- ── Test-wise search ─────────────────────────────────── -->
    <div class="ut-section">
      <div class="ut-section-label success"><i class="bi bi-search"></i> Search Tests to Update</div>
      <p style="font-size:12.5px;color:var(--text-secondary);margin-bottom:14px;">
        Filter by category and test name, then set new commission rates per test.
      </p>

      <form action="/test/searchTest" method="post" class="needs-validation" novalidate>
        <div class="ut-search-grid">

          <div>
            <label class="ut-field-label">Category <span class="ut-req">*</span></label>
            <div class="ut-input-wrap">
              <span class="ut-input-icon"><i class="bi bi-grid"></i></span>
              <select name="SelectDoctorThanksCategorySearch" id="selectDoctorThanksCategorySearch" required>
                <option value="">— Select category —</option>
                <% categoryCommissionDetail.forEach(function(cat){ %>
                  <option value="<%= cat.Id %>"
                    data-thanks="<%= cat.CommissionRate %>"
                    <% if(typeof categoryId != 'undefined' && cat.Id == categoryId){ %>selected<% } %>>
                    <%= cat.Name %>
                  </option>
                <% }) %>
              </select>
            </div>
          </div>

          <div>
            <label class="ut-field-label">Test Name <span class="ut-req">*</span></label>
            <div class="ut-input-wrap">
              <span class="ut-input-icon"><i class="bi bi-flask"></i></span>
              <input type="text" id="searchTest" name="searchTest" placeholder="Enter test name"
                value="<%= typeof searchedTest != 'undefined' ? searchedTest : '' %>" required>
            </div>
          </div>

          <div>
            <label class="ut-field-label" style="visibility:hidden">.</label>
            <button class="ut-btn ut-btn-primary" style="width:100%;" type="submit">
              <i class="bi bi-search"></i> Search
            </button>
          </div>

        </div>
        <input type="hidden" name="doctorId" value="<%= d.Id %>">
      </form>
    </div>

    <!-- ── Test results table ───────────────────────────────── -->
    <% if (typeof testDetails != 'undefined' && testDetails.length) { %>
    <div class="ut-section">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
        <div class="ut-section-label success" style="margin-bottom:0;">
          <i class="bi bi-table"></i> Test Results
        </div>
        <span class="ut-count-pill"><%= testDetails.length %> test<%= testDetails.length !== 1 ? 's' : '' %> found</span>
      </div>

      <!-- Selected count bar -->
      <div class="ut-selected-bar" id="selectedBar">
        <span class="lbl"><i class="bi bi-check2-square me-2"></i><span id="selectedCount">0</span> test(s) selected</span>
        <span style="font-size:12px;color:var(--text-hint);">Fill in new % for each selected row</span>
      </div>

      <form action="/doctor/updateTestWiseThanksForADoctor" method="POST" id="updateThanksForm">
        <div style="overflow-x:auto;">
          <table class="ut-table">
            <thead>
              <tr>
                <th style="width:36px;">#</th>
                <th>Test Name</th>
                <th>Current Commission</th>
                <th style="width:180px;">New Commission %</th>
                <th style="width:60px;text-align:center;">
                  <input type="checkbox" class="ut-check" id="selectAll" title="Select all">
                </th>
              </tr>
            </thead>
            <tbody>
              <% let i = 1; testDetails.forEach(function(test){ %>
              <tr id="row_<%= test.Id %>">
                <td style="color:var(--text-hint);font-size:12px;"><%= i++ %></td>
                <td style="font-weight:500;"><%= test.TestName %></td>
                <td><span class="ut-comm-badge"><%= test.Commission %>%</span></td>
                <td>
                  <div class="ut-input-wrap">
                    <span class="ut-input-icon"><i class="bi bi-percent"></i></span>
                    <input type="number"
                      name="newThanks_<%= test.Id %>"
                      id="newThanks_<%= test.Id %>"
                      placeholder="New %"
                      step="0.01" min="0" max="100"
                      disabled>
                  </div>
                </td>
                <td style="text-align:center;">
                  <input type="checkbox"
                    name="selectedTests[]"
                    value="<%= test.Id %>"
                    class="ut-check row-check"
                    onchange="toggleInput('<%= test.Id %>')">
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <input type="hidden" name="doctorId"                       value="<%= d.Id %>">
        <input type="hidden" name="searchTest"                     id="searchedTestName">
        <input type="hidden" name="SelectDoctorThanksCategorySearch" id="selectedCategory">

        <div style="display:flex;justify-content:flex-end;margin-top:16px;">
          <button type="submit" class="ut-btn ut-btn-success" id="submitBtn">
            <i class="bi bi-check2-all"></i> Update Selected Tests
          </button>
        </div>
      </form>
    </div>
    <% } else if (typeof testDetails != 'undefined' && testDetails.length === 0) { %>
    <div class="ut-section">
      <div class="ut-no-data">
        <i class="bi bi-search"></i> No tests found for your search. Try a different name or category.
      </div>
    </div>
    <% } %>

  </div>
</div><!-- /ut-wrapper -->

<script>
/* ── Category select → show current rate hint ─────────────── */
document.getElementById('selectDoctorThanksCategory')
  .addEventListener('change', function () {
    const opt     = this.options[this.selectedIndex];
    const rate    = opt.dataset.thanks;
    const catId   = opt.dataset.thanksCategoryId;
    const badge   = document.getElementById('currentRateBadge');
    const hint    = document.getElementById('currentRateHint');
    const hidden  = document.getElementById('doctorThanksCategory');

    hidden.value = catId || '';
    if (rate) {
      badge.textContent    = 'Current: ' + rate + '%';
      badge.style.display  = 'inline-block';
      hint.textContent     = 'Current rate is ' + rate + '%. Enter a new value above.';
      hint.style.display   = 'block';
    } else {
      badge.style.display  = 'none';
      hint.style.display   = 'none';
    }
  });

/* ── Toggle individual test row ───────────────────────────── */
function toggleInput(testId) {
  const cb    = document.querySelector(`input[value="${testId}"].row-check`);
  const input = document.getElementById(`newThanks_${testId}`);
  const row   = document.getElementById(`row_${testId}`);

  input.disabled = !cb.checked;
  row.classList.toggle('row-selected', cb.checked);
  if (!cb.checked) input.value = '';

  // Sync hidden fields
  document.getElementById('selectedCategory').value  =
    document.getElementById('selectDoctorThanksCategorySearch')?.value || '';
  document.getElementById('searchedTestName').value  =
    document.getElementById('searchTest')?.value || '';

  updateSelectedCount();
}

/* ── Select all ───────────────────────────────────────────── */
const selectAll = document.getElementById('selectAll');
if (selectAll) {
  selectAll.addEventListener('change', function () {
    document.querySelectorAll('.row-check').forEach(cb => {
      cb.checked = this.checked;
      toggleInput(cb.value);
    });
  });
}

/* ── Selected count bar ───────────────────────────────────── */
function updateSelectedCount() {
  const checked = document.querySelectorAll('.row-check:checked').length;
  const bar     = document.getElementById('selectedBar');
  if (!bar) return;
  document.getElementById('selectedCount').textContent = checked;
  bar.classList.toggle('show', checked > 0);
}
</script>
