<%
  const d    = doctorDetails;
  const degs = [d.Degree1, d.Degree2, d.Degree3, d.Degree4].filter(Boolean);
  const ini  = (d.FirstName.charAt(0) + (d.LastName || '').charAt(0)).toUpperCase();
%>

<style>
  :root {
    --brand:#185FA5; --brand-soft:#E6F1FB; --brand-text:#0C447C;
    --surface:#ffffff; --surface-alt:#F8F9FB;
    --border:rgba(0,0,0,0.08); --border-strong:rgba(0,0,0,0.14);
    --text-primary:#111827; --text-secondary:#6B7280; --text-hint:#9CA3AF;
    --success-bg:#EAF3DE; --success-text:#3B6D11;
    --warning-bg:#FAEEDA; --warning-text:#854F0B;
    --danger-bg:#FCEBEB;  --danger-text:#A32D2D;
    --info-bg:#E6F1FB;    --info-text:#185FA5;
    --purple-bg:#EEEDFE;  --purple-text:#534AB7;
    --radius-sm:6px; --radius-md:10px; --radius-lg:14px;
    --shadow-card:0 1px 4px rgba(0,0,0,0.06),0 0 0 0.5px rgba(0,0,0,0.08);
  }

  .dd-wrapper { padding:16px 0 40px; }

  /* ── Card base ── */
  .dd-card  { background:var(--surface); border-radius:var(--radius-lg); box-shadow:var(--shadow-card); overflow:hidden; margin-bottom:16px; }

  /* ── Card header ── */
  .dd-card-header { display:flex; align-items:center; justify-content:space-between; padding:18px 24px; border-bottom:1px solid var(--border); }
  .dd-header-left { display:flex; align-items:center; gap:12px; }
  .dd-header-icon { width:36px; height:36px; background:var(--brand-soft); border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; color:var(--brand); font-size:16px; flex-shrink:0; }
  .dd-header-icon.success { background:var(--success-bg); color:var(--success-text); }
  .dd-header-icon.purple  { background:var(--purple-bg);  color:var(--purple-text); }
  .dd-header-title { font-size:15px; font-weight:600; color:var(--text-primary); margin:0; line-height:1.2; }
  .dd-header-sub   { font-size:12px; color:var(--text-secondary); margin:2px 0 0; }

  /* ── Hero strip ── */
  .dd-hero { display:flex; align-items:center; gap:20px; padding:24px; border-bottom:1px solid var(--border); background:var(--surface-alt); }
  .dd-hero-avatar {
    width:72px; height:72px; border-radius:50%; flex-shrink:0;
    background:var(--brand-soft); color:var(--brand);
    display:flex; align-items:center; justify-content:center;
    font-size:22px; font-weight:700; letter-spacing:.02em;
    box-shadow:0 0 0 4px #fff, 0 0 0 5px rgba(24,95,165,.15);
  }
  .dd-hero-name  { font-size:20px; font-weight:700; color:var(--text-primary); text-transform:capitalize; margin:0 0 4px; }
  .dd-hero-spec  { font-size:13px; color:var(--text-secondary); display:flex; align-items:center; gap:6px; }
  .dd-hero-pills { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
  .dd-pill       { font-size:11px; font-weight:500; padding:3px 10px; border-radius:99px; }
  .dd-pill-info  { background:var(--info-bg);    color:var(--info-text); }
  .dd-pill-purple{ background:var(--purple-bg);  color:var(--purple-text); }
  .dd-pill-success{ background:var(--success-bg);color:var(--success-text); }
  .dd-pill-warn  { background:var(--warning-bg); color:var(--warning-text); }

  /* ── Two-col layout ── */
  .dd-2col { display:grid; grid-template-columns:1fr 360px; gap:16px; align-items:start; }
  .dd-3col { display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; }

  /* ── Section ── */
  .dd-section       { padding:20px 24px; border-bottom:1px solid var(--border); }
  .dd-section:last-child { border-bottom:none; }
  .dd-section-label { font-size:11px; font-weight:700; color:var(--brand); text-transform:uppercase; letter-spacing:.07em; display:flex; align-items:center; gap:7px; margin-bottom:16px; }
  .dd-section-label.success { color:var(--success-text); }
  .dd-section-label.purple  { color:var(--purple-text); }

  /* ── Info rows ── */
  .dd-info-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .dd-info-item { display:flex; flex-direction:column; gap:3px; }
  .dd-info-lbl  { font-size:10.5px; font-weight:600; color:var(--text-hint); text-transform:uppercase; letter-spacing:.06em; }
  .dd-info-val  { font-size:13.5px; color:var(--text-primary); font-weight:500; text-transform:capitalize; }
  .dd-info-val.muted { color:var(--text-hint); font-weight:400; font-style:italic; }

  /* ── Schedule table ── */
  .dd-sched-table { width:100%; border-collapse:collapse; }
  .dd-sched-table thead th { font-size:10.5px; font-weight:600; text-transform:uppercase; letter-spacing:.06em; color:var(--text-secondary); padding:0 0 8px; border-bottom:1px solid var(--border-strong); text-align:left; }
  .dd-sched-table tbody td { padding:8px 0; font-size:12.5px; color:var(--text-primary); border-bottom:1px solid var(--border); vertical-align:middle; }
  .dd-sched-table tbody tr:last-child td { border-bottom:none; }
  .dd-day-badge { display:inline-block; padding:2px 8px; border-radius:99px; background:var(--brand-soft); color:var(--brand); font-size:11px; font-weight:600; }
  .dd-time-val  { font-size:12px; font-family:'DM Mono',monospace; color:var(--text-secondary); }

  /* ── Commission cards ── */
  .dd-comm-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .dd-comm-card { background:var(--surface-alt); border:1px solid var(--border); border-radius:var(--radius-md); padding:12px 14px; display:flex; justify-content:space-between; align-items:center; }
  .dd-comm-name { font-size:12.5px; font-weight:500; color:var(--text-primary); }
  .dd-comm-rate { font-size:14px; font-weight:700; color:var(--success-text); font-family:'DM Mono',monospace; }

  /* ── Select input ── */
  .dd-input-wrap  { display:flex; align-items:center; border:1px solid var(--border-strong); border-radius:var(--radius-sm); background:var(--surface); overflow:hidden; transition:border-color .15s; }
  .dd-input-wrap:focus-within { border-color:var(--brand); box-shadow:0 0 0 3px rgba(24,95,165,.1); }
  .dd-input-icon  { padding:0 10px; color:var(--text-hint); font-size:13px; flex-shrink:0; }
  .dd-input-wrap select { border:none; outline:none; background:transparent; font-size:13.5px; color:var(--text-primary); padding:9px 12px 9px 0; width:100%; font-family:inherit; appearance:none; cursor:pointer; }

  /* ── Buttons ── */
  .dd-btn         { display:inline-flex; align-items:center; gap:6px; padding:9px 18px; border-radius:var(--radius-sm); font-size:13px; font-weight:500; border:none; cursor:pointer; transition:background .15s; text-decoration:none; }
  .dd-btn-primary { background:var(--brand);       color:#fff; }
  .dd-btn-primary:hover { background:var(--brand-text); color:#fff; }
  .dd-btn-success { background:#2e7d32;             color:#fff; }
  .dd-btn-success:hover { background:#1b5e20; }
  .dd-btn-outline { background:transparent; color:var(--brand); border:1px solid var(--brand); }
  .dd-btn-outline:hover { background:var(--brand-soft); color:var(--brand); }

  /* ── No data ── */
  .dd-no-data { padding:10px 14px; background:var(--warning-bg); border:1px solid rgba(133,79,11,.15); border-radius:var(--radius-sm); font-size:12.5px; color:var(--warning-text); display:flex; align-items:center; gap:7px; }

  @media(max-width:992px) {
    .dd-2col { grid-template-columns:1fr; }
    .dd-3col { grid-template-columns:1fr 1fr; }
  }
  @media(max-width:576px) {
    .dd-3col { grid-template-columns:1fr; }
    .dd-info-grid { grid-template-columns:1fr; }
    .dd-comm-grid { grid-template-columns:1fr; }
    .dd-hero { flex-direction:column; align-items:flex-start; }
  }
</style>

<%- include("../partials/messages"); %>

<div class="dd-wrapper">

  <!-- ══ PROFILE + COMMISSION ═══════════════════════════════ -->
  <div style="display:grid;grid-template-columns:1fr 340px;gap:16px;align-items:start;" class="dd-2col">

    <!-- LEFT: Profile card -->
    <div class="dd-card">

      <!-- Header -->
      <div class="dd-card-header">
        <div class="dd-header-left">
          <div class="dd-header-icon"><i class="bi bi-person-badge"></i></div>
          <div>
            <p class="dd-header-title">Doctor Profile</p>
            <p class="dd-header-sub">Full details and visiting schedule</p>
          </div>
        </div>
        <a href="/doctor/editDoctor/<%= d.Id %>" class="dd-btn dd-btn-outline" style="padding:7px 14px;font-size:12px;">
          <i class="bi bi-pencil"></i> Edit
        </a>
      </div>

      <!-- Hero -->
      <div class="dd-hero">
        <div class="dd-hero-avatar"><%= ini %></div>
        <div>
          <h2 class="dd-hero-name">Dr. <%= d.FirstName %> <%= d.LastName %></h2>
          <div class="dd-hero-spec">
            <i class="bi bi-clipboard2-pulse"></i>
            <%= d.SpecialistIn || 'Specialist not set' %>
          </div>
          <div class="dd-hero-pills">
            <span class="dd-pill dd-pill-info">
              <i class="bi bi-clock-history me-1"></i><%= d.YearOfExperience %> yrs exp.
            </span>
            <span class="dd-pill dd-pill-purple">
              <i class="bi bi-percent me-1"></i><%= d.FlatDiscount %>% flat discount
            </span>
            <% if (d.Award) { %>
              <span class="dd-pill dd-pill-warn">
                <i class="bi bi-trophy me-1"></i><%= d.Award %>
              </span>
            <% } %>
            <% degs.forEach(deg => { %>
              <span class="dd-pill dd-pill-purple"><%= deg %></span>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- Info grid -->
      <div class="dd-section">
        <div class="dd-section-label"><i class="bi bi-info-circle"></i> Contact &amp; Registration</div>
        <div class="dd-info-grid">
          <div class="dd-info-item">
            <span class="dd-info-lbl"><i class="bi bi-telephone me-1"></i>Primary Phone</span>
            <span class="dd-info-val"><%= d.MobileNumberFirst || '—' %></span>
          </div>
          <div class="dd-info-item">
            <span class="dd-info-lbl"><i class="bi bi-telephone-plus me-1"></i>Secondary Phone</span>
            <span class="dd-info-val <%= !d.MobileNumberSecond ? 'muted' : '' %>">
              <%= d.MobileNumberSecond || 'Not provided' %>
            </span>
          </div>
          <div class="dd-info-item">
            <span class="dd-info-lbl"><i class="bi bi-card-text me-1"></i>Registration No.</span>
            <span class="dd-info-val <%= !d.Registration ? 'muted' : '' %>">
              <%= d.Registration || 'Not provided' %>
            </span>
          </div>
          <div class="dd-info-item">
            <span class="dd-info-lbl"><i class="bi bi-building-cross me-1"></i>Worked At</span>
            <span class="dd-info-val <%= !d.WorkedAt ? 'muted' : '' %>">
              <%= d.WorkedAt || 'Not specified' %>
            </span>
          </div>
          <div class="dd-info-item" style="grid-column:1/-1">
            <span class="dd-info-lbl"><i class="bi bi-info-square me-1"></i>Prescription Instruction</span>
            <span class="dd-info-val <%= !d.Instruction ? 'muted' : '' %>">
              <%= d.Instruction || 'Not set' %>
            </span>
          </div>
        </div>
      </div>

      <!-- Visiting schedule -->
      <div class="dd-section">
        <div class="dd-section-label"><i class="bi bi-calendar-week"></i> Visiting Schedule</div>
        <% if (visitingSchedule && visitingSchedule.length) { %>
          <table class="dd-sched-table">
            <thead>
              <tr>
                <th>Area</th>
                <th>Day</th>
                <th>Start</th>
                <th>End</th>
              </tr>
            </thead>
            <tbody>
              <% visitingSchedule.forEach(s => { %>
              <tr>
                <td style="font-size:12.5px;color:var(--text-secondary);text-transform:capitalize;">
                  <i class="bi bi-geo-alt" style="color:var(--text-hint);margin-right:4px;"></i>
                  <%= s.Area || '—' %>
                </td>
                <td><span class="dd-day-badge"><%= s.DayOfWeek %></span></td>
                <td><span class="dd-time-val"><%= s.StartTime %></span></td>
                <td><span class="dd-time-val"><%= s.EndTime %></span></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div class="dd-no-data"><i class="bi bi-calendar-x"></i> No visiting schedule added.</div>
        <% } %>
      </div>

    </div><!-- /profile card -->

    <!-- RIGHT: Commission card -->
    <div class="dd-card">
      <div class="dd-card-header">
        <div class="dd-header-left">
          <div class="dd-header-icon success"><i class="bi bi-vials"></i></div>
          <div>
            <p class="dd-header-title">Test Commission</p>
            <p class="dd-header-sub">Per category commission rates</p>
          </div>
        </div>
      </div>

      <div class="dd-section">
        <% if (categoryCommissionDetail && categoryCommissionDetail.length) { %>
          <div class="dd-comm-grid">
            <% categoryCommissionDetail.forEach(cat => { %>
            <div class="dd-comm-card">
              <span class="dd-comm-name"><%= cat.Name %></span>
              <span class="dd-comm-rate"><%= cat.CommissionRate %>%</span>
            </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="dd-no-data"><i class="bi bi-info-circle"></i> No commission rates set.</div>
        <% } %>
        <div style="margin-top:14px;">
          <a href="/doctor/updateDoctorThanks?doctorId=<%= d.Id %>" class="dd-btn dd-btn-outline" style="width:100%;justify-content:center;">
            <i class="bi bi-pencil-square"></i> Update Commission
          </a>
          <a href="/test/doctorSubTestRates/<%= d.Id %>" class="dd-btn dd-btn-outline" style="width:100%;justify-content:center;margin-top:8px;">
            <i class="bi bi-sliders"></i> Sub-test thanks &amp; discount
          </a>
        </div>
      </div>
    </div>

  </div><!-- /top 2col -->


  <!-- ══ ASSIGN CARDS ════════════════════════════════════════ -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;" class="dd-2col">

    <!-- Reporting Doctor -->
    <div class="dd-card">
      <div class="dd-card-header">
        <div class="dd-header-left">
          <div class="dd-header-icon"><i class="bi bi-file-earmark-medical"></i></div>
          <div>
            <p class="dd-header-title">Preferred Reporting Doctor</p>
            <p class="dd-header-sub">Assign a doctor for report sign-off (optional)</p>
          </div>
        </div>
      </div>
      <form method="post" action="/doctor/associateReportingDoctor/<%= d.Id %>" novalidate>
        <div class="dd-section">
          <label class="dd-section-label" style="margin-bottom:10px;">
            <i class="bi bi-person-check"></i> Select Reporting Doctor
          </label>
          <div class="dd-input-wrap">
            <span class="dd-input-icon"><i class="bi bi-person-badge"></i></span>
            <select name="reportingDoctor" id="reportingDoctor">
              <option value="0">— No preference —</option>
              <% reportingDoctors.forEach(function(rd){ %>
                <option class="text-capitalize"
                  value="<%= rd.Id %>"
                  <%= (typeof reportingDoctorId != 'undefined' && rd.Id == reportingDoctorId) ? 'selected' : '' %>>
                  Dr. <%= rd.FirstName %> <%= rd.LastName %>
                </option>
              <% }) %>
            </select>
          </div>
          <input type="hidden" value="<%= marketingPersonId %>" name="marketingPerson">
        </div>
        <div style="padding:0 24px 18px;display:flex;justify-content:flex-end;">
          <button type="submit" class="dd-btn dd-btn-primary">
            <i class="bi bi-check2"></i> Save
          </button>
        </div>
      </form>
    </div>

    <!-- Marketing Person -->
    <div class="dd-card">
      <div class="dd-card-header">
        <div class="dd-header-left">
          <div class="dd-header-icon success"><i class="bi bi-person-lines-fill"></i></div>
          <div>
            <p class="dd-header-title">Assigned Marketing Person</p>
            <p class="dd-header-sub">Link a marketing rep to this doctor (optional)</p>
          </div>
        </div>
      </div>
      <form method="post" action="/doctor/associateMarketingPersonForDoctor/<%= d.Id %>" novalidate>
        <div class="dd-section">
          <label class="dd-section-label" style="margin-bottom:10px;">
            <i class="bi bi-briefcase"></i> Select Marketing Person
          </label>
          <div class="dd-input-wrap">
            <span class="dd-input-icon"><i class="bi bi-person"></i></span>
            <select name="marketingPerson" id="marketingPerson">
              <option value="0">— No person assigned —</option>
              <% marketingPersons.forEach(function(mp){ %>
                <option class="text-capitalize"
                  value="<%= mp.Id %>"
                  <%= (typeof marketingPersonId != 'undefined' && mp.Id == marketingPersonId) ? 'selected' : '' %>>
                  <%= mp.FirstName %> <%= mp.LastName %>
                </option>
              <% }) %>
            </select>
          </div>
          <input type="hidden" value="<%= reportingDoctorId %>" name="reportingDoctor">
        </div>
        <div style="padding:0 24px 18px;display:flex;justify-content:flex-end;">
          <button type="submit" class="dd-btn dd-btn-success">
            <i class="bi bi-check2"></i> Save
          </button>
        </div>
      </form>
    </div>

  </div><!-- /assign cards -->

</div><!-- /dd-wrapper -->
