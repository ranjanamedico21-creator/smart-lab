<%
  /* One form for Register Doctor (step by step) and Edit Doctor (everything on one page).
     From the controller: mode, doctorId, v (values), original (saved values, edit), errors [{field,msg,warn}],
     duplicates [{id,name,spec,mobile,reason}], testCategoriesList, lookups {areas,specialities,degrees} */
  var isEdit  = (typeof mode !== 'undefined' && mode === 'edit');
  var V       = (typeof v !== 'undefined' && v) ? v : {};
  var ORIG    = (typeof original !== 'undefined' && original) ? original : null;
  var ERR     = (typeof errors !== 'undefined' && errors) ? errors : [];
  var DUPS    = (typeof duplicates !== 'undefined' && duplicates) ? duplicates : [];
  var CATS    = (typeof testCategoriesList !== 'undefined' && testCategoriesList) ? testCategoriesList : [];
  var LK      = (typeof lookups !== 'undefined' && lookups) ? lookups : { areas: [], specialities: [], degrees: [] };
  var DID     = (typeof doctorId !== 'undefined') ? doctorId : null;
  var COM     = V.commission || {};
  var OCOM    = ORIG && ORIG.commission ? ORIG.commission : {};
  var FE = {}; ERR.forEach(function (e) { if (e && e.field && !FE[e.field]) FE[e.field] = e; });
  var fe   = function (f) { return FE[f] && !FE[f].warn ? FE[f].msg : ''; };
  var fw   = function (f) { return FE[f] && FE[f].warn ? FE[f].msg : ''; };
  var hardErrors = ERR.filter(function (e) { return !e.warn; });
  var esc  = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); };
  var json = function (o) { return JSON.stringify(o).replace(/</g, '\\u003c'); };
  var docName = ['Dr.', ORIG ? ORIG.firstName : V.firstName, ORIG ? ORIG.lastName : V.lastName].filter(Boolean).join(' ');

  /* one labelled input */
  var field = function (o) {
    var err = fe(o.name), warn = fw(o.name);
    return '<div class="rd-field' + (o.full ? ' rd-full' : '') + '" data-field="' + o.name + '">' +
      '<label class="rd-field-label" for="f_' + o.name + '">' + esc(o.label) + (o.req ? ' <span class="rd-req">*</span>' : '') + '</label>' +
      '<div class="rd-input-wrap' + (err ? ' error' : '') + '"><span class="rd-input-icon"><i class="bi ' + o.icon + '"></i></span>' +
      '<input id="f_' + o.name + '" type="' + (o.type || 'text') + '" name="' + o.name + '" value="' + esc(V[o.name]) + '"' +
        ' placeholder="' + esc(o.ph || '') + '"' + (o.req ? ' required' : '') + (o.cap ? ' style="text-transform:capitalize"' : '') +
        (o.list ? ' list="' + o.list + '"' : '') + (o.extra || '') + ' autocomplete="off"></div>' +
      (o.hint ? '<p class="rd-hint">' + o.hint + '</p>' : '') +
      (warn ? '<p class="rd-warn-note"><i class="bi bi-info-circle"></i> ' + esc(warn) + '</p>' : '') +
      '<span class="rd-error-msg' + (err ? ' show' : '') + '" data-default="' + esc(o.msg || 'Required') + '">' + esc(err || o.msg || 'Required') + '</span></div>';
  };
  /* which step an error belongs to (register) */
  var stepOf = function (f) { return /^schedule/.test(f) ? 1 : /^commission/.test(f) ? 2 : 0; };
  var firstErrStep = hardErrors.length ? Math.min.apply(null, hardErrors.map(function (e) { return stepOf(e.field || ''); })) : 0;
  var rowErrors = {}; ERR.forEach(function (e) { var m = /^schedule\.(\d+)$/.exec(e.field || ''); if (m) (rowErrors[m[1]] = rowErrors[m[1]] || []).push(e.msg); });
  var RATES = []; for (var r = 0; r <= 50; r++) RATES.push(r);
%>
<style>
  .rd-wrapper{--brand:#185FA5;--brand-soft:#E6F1FB;--brand-text:#0C447C;--surface:#fff;--surface-alt:#F8F9FB;
    --border:rgba(0,0,0,.08);--border-strong:rgba(0,0,0,.14);--text-primary:#111827;--text-secondary:#6B7280;--text-hint:#9CA3AF;
    --success:#10B981;--success-bg:#ECFDF5;--warning-bg:#FAEEDA;--warning-text:#854F0B;--danger-bg:#FCEBEB;--danger-text:#A32D2D;
    --radius-sm:8px;--radius-md:10px;--radius-lg:14px;--radius-xl:18px;
    --shadow-card:0 1px 4px rgba(0,0,0,.06),0 0 0 .5px rgba(0,0,0,.08);--shadow-elevated:0 10px 25px -5px rgba(0,0,0,.08),0 4px 6px -2px rgba(0,0,0,.04);
    --transition:all .25s cubic-bezier(.4,0,.2,1);
    width:100%;max-width:1180px;margin:0 auto;padding:12px 0 40px;container:rd / inline-size;color:var(--text-primary)}
  .rd-wrapper *,.rd-wrapper *::before,.rd-wrapper *::after{box-sizing:border-box}

  .rd-top{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:16px}
  .rd-crumb{font-size:12.5px;color:var(--text-secondary)}.rd-crumb a{color:var(--brand);text-decoration:none}
  /* stepper */
  .rd-stepper{display:flex;align-items:flex-start;justify-content:center;margin-bottom:22px}
  .rd-step{display:flex;flex-direction:column;align-items:center;gap:8px;flex-shrink:0;cursor:default;background:none;border:0;padding:0}
  .rd-step.done{cursor:pointer}
  .rd-step-circle{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;background:var(--surface);color:var(--text-hint);border:2px solid var(--border-strong);transition:var(--transition)}
  .rd-step.active .rd-step-circle{background:var(--brand);color:#fff;border-color:var(--brand);box-shadow:0 0 0 4px var(--brand-soft)}
  .rd-step.done .rd-step-circle{background:var(--success);color:#fff;border-color:var(--success)}
  .rd-step.has-error .rd-step-circle{border-color:var(--danger-text);color:var(--danger-text);background:var(--danger-bg)}
  .rd-step-label{font-size:12px;font-weight:600;color:var(--text-hint);white-space:nowrap}
  .rd-step.active .rd-step-label{color:var(--brand)}.rd-step.done .rd-step-label{color:var(--success)}
  .rd-step-line{flex:1;max-width:100px;height:3px;background:var(--border);margin:18px 8px 0;border-radius:2px;transition:var(--transition)}
  .rd-step-line.done{background:var(--success)}

  /* card */
  .rd-card{background:var(--surface);border-radius:var(--radius-xl);box-shadow:var(--shadow-card)}
  .rd-card-header{padding:20px 24px;border-bottom:1px solid var(--border);background:linear-gradient(135deg,var(--surface) 0%,var(--surface-alt) 100%);border-radius:var(--radius-xl) var(--radius-xl) 0 0}
  .rd-header-left{display:flex;align-items:center;gap:14px}
  .rd-header-icon{width:44px;height:44px;background:var(--brand-soft);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;color:var(--brand);font-size:18px;flex-shrink:0}
  .rd-header-title{font-size:17px;font-weight:700;margin:0;text-transform:capitalize}
  .rd-header-sub{font-size:13px;color:var(--text-secondary);margin:4px 0 0}
  .rd-msgs{padding:0 24px}.rd-msgs:empty{display:none}
  .rd-errbox{margin:16px 24px 0;padding:12px 14px;border-radius:var(--radius-md);background:var(--danger-bg);color:var(--danger-text);font-size:13px;border:1px solid rgba(163,45,45,.15)}
  .rd-errbox ul{margin:6px 0 0;padding-left:18px}

  /* sections (register: one step at a time / edit: all visible) */
  .rd-panel{padding:24px;display:none}
  .rd-panel.active{display:block;animation:rdIn .3s ease}
  .rd-flat .rd-panel{display:block;animation:none;border-bottom:1px solid var(--border)}
  .rd-flat .rd-panel:last-of-type{border-bottom:0}
  @keyframes rdIn{from{opacity:0;transform:translateX(16px)}to{opacity:1;transform:none}}
  .rd-section-label{font-size:11px;font-weight:700;color:var(--brand);text-transform:uppercase;letter-spacing:.08em;display:flex;align-items:center;gap:8px;margin-bottom:18px;padding-bottom:10px;border-bottom:1px dashed var(--border)}
  .rd-section-note{font-size:13px;color:var(--text-secondary);margin:-8px 0 16px}
  .rd-jump{display:flex;gap:6px;flex-wrap:wrap;padding:12px 24px;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:5;background:#fff}
  .rd-jump a{font-size:12.5px;font-weight:600;color:var(--text-secondary);text-decoration:none;padding:6px 12px;border-radius:99px;border:1px solid var(--border)}
  .rd-jump a:hover{color:var(--brand);border-color:var(--brand)}
  .rd-jump a.bad{color:var(--danger-text);border-color:var(--danger-text);background:var(--danger-bg)}

  /* fields */
  .rd-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .rd-full{grid-column:1/-1}
  .rd-field{min-width:0}
  .rd-field-label{font-size:11px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.06em;display:block;margin-bottom:6px}
  .rd-req{color:var(--danger-text);margin-left:2px}
  .rd-input-wrap{display:flex;align-items:center;border:1.5px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);transition:var(--transition);min-height:42px;min-width:0}
  .rd-input-wrap:hover{border-color:var(--border-strong)}
  .rd-input-wrap:focus-within{border-color:var(--brand);box-shadow:0 0 0 4px rgba(24,95,165,.08)}
  .rd-input-wrap.error{border-color:var(--danger-text);background:var(--danger-bg)}
  .rd-input-icon{padding:0 10px 0 12px;color:var(--text-hint);font-size:14px;flex-shrink:0}
  .rd-input-wrap input,.rd-input-wrap select{border:0;outline:0;background:transparent;font-size:14px;color:var(--text-primary);padding:10px 12px 10px 0;flex:1 1 auto;min-width:0;width:100%;font-family:inherit}
  .rd-input-wrap select{appearance:none;-webkit-appearance:none;cursor:pointer}
  .rd-input-wrap input::placeholder{color:var(--text-hint);text-transform:none}
  .rd-input-wrap .ts-control .item[data-value=""]{color:var(--text-hint)}
  .rd-input-wrap input.flatpickr-input[type=hidden]{display:none}
  .rd-error-msg{font-size:11.5px;color:var(--danger-text);margin-top:4px;display:none}
  .rd-error-msg.show{display:block}
  .rd-hint{font-size:11px;color:var(--text-hint);margin:4px 0 0}
  .rd-warn-note{font-size:11.5px;color:var(--warning-text);background:var(--warning-bg);border-radius:6px;padding:5px 8px;margin:6px 0 0}

  /* Tom Select inside our boxes */
  .rd-input-wrap .ts-wrapper{flex:1 1 auto;min-width:0;padding:0!important;border:0!important}
  .rd-input-wrap .ts-wrapper .ts-control{border:0!important;box-shadow:none!important;background:transparent!important;padding:9px 28px 9px 0!important;min-height:0!important}
  .rd-input-wrap .ts-wrapper.single .ts-control::after{right:10px!important}
  body>.ts-dropdown{background:#fff;z-index:10500;font-size:14px;border-radius:var(--radius-sm);border:1px solid var(--border-strong);box-shadow:var(--shadow-elevated)}
  .flatpickr-calendar{z-index:10500!important}

  /* duplicate warning */
  .rd-dup{grid-column:1/-1;border:1.5px solid #f0c27b;background:#fff8ec;color:#7a4b06;border-radius:var(--radius-md);padding:12px 14px;font-size:13px;display:none}
  .rd-dup.show{display:block}
  .rd-dup.error{border-color:var(--danger-text);background:var(--danger-bg);color:var(--danger-text)}
  .rd-dup ul{margin:6px 0 8px;padding-left:18px}
  .rd-dup a{color:inherit;font-weight:600}

  /* schedule */
  .rd-visit-card{background:var(--surface-alt);border:1.5px solid var(--border);border-radius:var(--radius-md);padding:14px 16px;margin-bottom:12px;transition:var(--transition)}
  .rd-visit-card.error{border-color:var(--danger-text);background:#fff7f7}
  .rd-visit-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:12px}
  .rd-visit-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;background:var(--brand-soft);color:var(--brand-text);font-size:12px;font-weight:600;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .rd-visit-tools{display:flex;gap:6px;flex-shrink:0}
  .rd-icon-btn{width:34px;height:34px;border-radius:var(--radius-sm);border:1px solid var(--border);background:#fff;color:var(--text-secondary);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:var(--transition)}
  .rd-icon-btn:hover{color:var(--brand);border-color:var(--brand)}
  .rd-icon-btn.danger{color:var(--danger-text);background:var(--danger-bg);border-color:transparent}
  .rd-visit-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:12px}
  .rd-row-err{font-size:12px;color:var(--danger-text);margin-top:8px}
  .rd-row-err:empty{display:none}

  /* commission */
  .rd-bulk{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:14px;padding:10px 12px;background:var(--surface-alt);border-radius:var(--radius-md);font-size:13px}
  .rd-bulk select{height:36px;border:1.5px solid var(--border);border-radius:var(--radius-sm);padding:0 8px;background:#fff}
  .rd-commission-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
  .rd-commission-item{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;background:var(--surface-alt);border:1.5px solid var(--border);border-radius:var(--radius-md);transition:var(--transition)}
  .rd-commission-item.error{border-color:var(--danger-text);background:var(--danger-bg)}
  .rd-commission-item.changed{border-color:#f0c27b;background:#fffaf0}
  .rd-commission-name{font-size:13px;font-weight:600;min-width:0;overflow-wrap:anywhere}
  .rd-commission-name small{display:block;font-weight:500;color:var(--warning-text);font-size:11px}
  .rd-commission-item .rd-input-wrap{flex:0 0 120px}
  .rd-commission-item .rd-input-wrap .ts-wrapper .ts-control{padding:8px 24px 8px 0!important}

  /* review */
  .rd-review-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
  .rd-review-item{padding:10px 14px;background:var(--surface-alt);border-radius:var(--radius-md);border:1px solid var(--border);min-width:0}
  .rd-review-label{font-size:10px;font-weight:700;color:var(--text-hint);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px}
  .rd-review-value{font-size:14px;font-weight:600;overflow-wrap:anywhere}
  .rd-review-empty{color:var(--text-hint);font-style:italic;font-weight:400}
  .rd-review-section{margin-bottom:20px}
  .rd-review-title{font-size:13px;font-weight:700;color:var(--brand);margin-bottom:10px;display:flex;align-items:center;justify-content:space-between;gap:8px}
  .rd-review-title button{font-size:12px;border:0;background:none;color:var(--brand);text-decoration:underline;cursor:pointer}

  /* buttons */
  .rd-btn-bar{padding:16px 24px;background:var(--surface-alt);border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;border-radius:0 0 var(--radius-xl) var(--radius-xl)}
  .rd-flat .rd-btn-bar{position:sticky;bottom:0;z-index:6;box-shadow:0 -6px 16px rgba(0,0,0,.05)}
  .rd-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 20px;border-radius:var(--radius-sm);font-size:14px;font-weight:600;border:0;cursor:pointer;transition:var(--transition);text-decoration:none;white-space:nowrap}
  .rd-btn-primary{background:var(--brand);color:#fff}.rd-btn-primary:hover{background:var(--brand-text);color:#fff}
  .rd-btn-primary:disabled{opacity:.6;cursor:not-allowed}
  .rd-btn-outline{background:#fff;color:var(--brand);border:1.5px solid var(--brand)}.rd-btn-outline:hover{background:var(--brand-soft)}
  .rd-btn-ghost{background:transparent;color:var(--text-secondary)}.rd-btn-ghost:hover{color:var(--text-primary);background:rgba(0,0,0,.04)}
  .rd-btn-sm{padding:7px 14px;font-size:12.5px}
  .rd-btn-group{display:flex;gap:8px;margin-left:auto}

  .rd-toast{position:fixed;top:20px;right:20px;max-width:calc(100vw - 40px);padding:12px 18px;border-radius:var(--radius-md);color:#fff;font-size:13px;font-weight:500;box-shadow:0 10px 25px -5px rgba(0,0,0,.2);transform:translateX(150%);transition:transform .35s ease;z-index:11000;display:flex;align-items:center;gap:10px;background:#A32D2D}
  .rd-toast.show{transform:none}
  .rd-toast.success{background:#10B981}

  /* the page sizes itself by the space it gets (works with the sidebar) */
  @container rd (max-width:900px){ .rd-grid,.rd-review-grid{grid-template-columns:repeat(2,minmax(0,1fr))} }
  @container rd (max-width:760px){ .rd-visit-grid{grid-template-columns:1fr 1fr} }
  @container rd (max-width:560px){
    .rd-grid,.rd-review-grid,.rd-visit-grid{grid-template-columns:1fr}
    .rd-panel{padding:18px 14px}.rd-card-header{padding:16px 14px}.rd-btn-bar{padding:12px 14px}.rd-jump{padding:10px 14px}
    .rd-errbox{margin:14px 14px 0}.rd-msgs{padding:0 14px}
    .rd-step-line{max-width:28px;margin:18px 4px 0}.rd-step-label{font-size:10px}.rd-step-circle{width:34px;height:34px;font-size:13px}
    .rd-commission-grid{grid-template-columns:1fr}
    .rd-btn-group{width:100%}.rd-btn-group .rd-btn{flex:1}
  }
  @supports not (container-type:inline-size){
    @media (max-width:768px){ .rd-grid,.rd-review-grid{grid-template-columns:1fr}.rd-visit-grid{grid-template-columns:1fr 1fr} }
  }
</style>

<div class="rd-wrapper">
  <div class="rd-top">
    <div class="rd-crumb"><a href="/user/home">Home</a> › <a href="/doctor/getDoctorListView">Doctors</a> ›
      <% if (isEdit) { %><a href="/doctor/getDoctorDetail?doctorId=<%= DID %>" class="text-capitalize"><%= docName %></a> › Edit<% } else { %>Register<% } %></div>
  </div>

  <% if (!isEdit) { %>
  <div class="rd-stepper" id="stepper">
    <% [['bi-person','Details'],['bi-calendar-week','Schedule'],['bi-percent','Thanks %'],['bi-check2-circle','Review']].forEach(function (s, i) { %>
      <% if (i) { %><div class="rd-step-line"></div><% } %>
      <button type="button" class="rd-step" data-step="<%= i %>" aria-label="Step <%= i + 1 %>: <%= s[1] %>">
        <span class="rd-step-circle"><i class="bi <%= s[0] %>"></i></span><span class="rd-step-label"><%= s[1] %></span>
      </button>
    <% }) %>
  </div>
  <% } %>

  <form action="<%= isEdit ? '/doctor/updateDoctor/' + DID : '/doctor/registerDoctor' %>" method="post" novalidate id="doctorForm" autocomplete="off"
        class="<%= isEdit ? 'rd-flat' : '' %>" data-mode="<%= isEdit ? 'edit' : 'register' %>" data-doctor-id="<%= DID || '' %>"
        data-orig="<%= ORIG ? JSON.stringify({ f: ORIG.firstName, l: ORIG.lastName, m: [ORIG.mobileNumberFirst, ORIG.mobileNumberSecond] }) : '' %>">
    <div class="rd-card">
      <div class="rd-card-header">
        <div class="rd-header-left">
          <div class="rd-header-icon"><i class="bi <%= isEdit ? 'bi-pencil-square' : 'bi-person-badge' %>"></i></div>
          <div style="min-width:0">
            <p class="rd-header-title"><%= isEdit ? 'Edit ' + docName : 'Register Doctor' %></p>
            <p class="rd-header-sub" id="headerSub"><%= isEdit ? 'Change any detail and save. Thanks of tests change only for the categories whose % you change.' : "Fill in the doctor's personal and professional details" %></p>
          </div>
        </div>
      </div>

      <div class="rd-msgs"><%- include("../partials/messages") %></div>

      <% if (hardErrors.length) { %>
        <div class="rd-errbox" role="alert" id="rdErrBox">
          <b><i class="bi bi-exclamation-triangle"></i> <%= isEdit ? 'Changes were not saved' : 'The doctor was not registered' %> — please fix:</b>
          <ul><% hardErrors.forEach(function (e) { %><li><%= e.msg %></li><% }) %></ul>
        </div>
      <% } %>

      <% if (isEdit) { %>
        <nav class="rd-jump" aria-label="Sections">
          <a href="#sec0" data-jump="0"><i class="bi bi-person"></i> Details</a>
          <a href="#sec1" data-jump="1"><i class="bi bi-calendar-week"></i> Schedule</a>
          <a href="#sec2" data-jump="2"><i class="bi bi-percent"></i> Thanks %</a>
        </nav>
      <% } %>

      <!-- ══ 1. Doctor details ══ -->
      <section class="rd-panel <%= (!isEdit && firstErrStep === 0) || isEdit ? 'active' : '' %>" data-panel="0" id="sec0">
        <div class="rd-section-label"><i class="bi bi-person-circle"></i> Doctor details</div>
        <div class="rd-grid">
          <%- field({ name: 'firstName', label: 'First name', icon: 'bi-person', req: true, ph: "Without 'Dr.'", cap: true, msg: 'Enter the first name' }) %>
          <%- field({ name: 'lastName', label: 'Last name', icon: 'bi-person', ph: 'Surname (optional)', cap: true, msg: 'Letters only' }) %>
          <%- field({ name: 'specialistIn', label: 'Speciality', icon: 'bi-clipboard2-pulse', req: true, ph: 'e.g. Physician, Gynaecologist', cap: true, list: 'dlSpecs', msg: 'Enter the speciality' }) %>
          <%- field({ name: 'degree1', label: 'Degree 1', icon: 'bi-mortarboard', req: true, ph: 'e.g. MBBS', list: 'dlDegrees', msg: 'Enter at least one degree' }) %>
          <%- field({ name: 'degree2', label: 'Degree 2', icon: 'bi-mortarboard', ph: 'Optional, e.g. MD', list: 'dlDegrees' }) %>
          <%- field({ name: 'degree3', label: 'Degree 3', icon: 'bi-mortarboard', ph: 'Optional', list: 'dlDegrees' }) %>
          <%- field({ name: 'degree4', label: 'Degree 4', icon: 'bi-mortarboard', ph: 'Optional', list: 'dlDegrees' }) %>
          <%- field({ name: 'yearOfExperience', label: 'Years of experience', icon: 'bi-clock-history', req: true, type: 'number', ph: 'e.g. 10', extra: ' min="0" max="70" step="1" inputmode="numeric"', msg: 'Enter 0 to 70' }) %>
          <%- field({ name: 'workedAt', label: 'Worked at', icon: 'bi-building', ph: 'Hospital / clinic (optional)', cap: true }) %>

          <%- field({ name: 'mobileNumberFirst', label: 'Mobile number', icon: 'bi-phone', req: true, type: 'tel', ph: '9876543210', extra: ' inputmode="tel" maxlength="20" data-validate="phone"', hint: '10-digit number, or with +91', msg: 'Enter a valid 10–15 digit number' }) %>
          <%- field({ name: 'mobileNumberSecond', label: 'Second mobile', icon: 'bi-phone-vibrate', type: 'tel', ph: 'Optional', extra: ' inputmode="tel" maxlength="20" data-validate="phone"', msg: 'Enter a valid 10–15 digit number' }) %>
          <%- field({ name: 'registration', label: 'Registration no.', icon: 'bi-card-text', ph: 'Medical council reg. no. (optional)' }) %>

          <div class="rd-dup <%= DUPS.length ? 'show' : '' %> <%= fe('duplicate') ? 'error' : '' %>" id="dupBox" role="status" aria-live="polite">
            <div><i class="bi bi-people"></i> <b>A doctor with the same <span id="dupWhat"><%= DUPS.length && DUPS.every(function (d) { return d.reason === 'same name'; }) ? 'name' : 'details' %></span> is already registered:</b></div>
            <ul id="dupList">
              <% DUPS.forEach(function (d) { %><li><a href="/doctor/getDoctorDetail?doctorId=<%= d.id %>" target="_blank" rel="noopener"><%= d.name %></a><%= d.spec ? ' · ' + d.spec : '' %><%= d.mobile ? ' · ' + d.mobile : '' %> <i>(<%= d.reason %>)</i></li><% }) %>
            </ul>
            <label class="d-flex gap-2 align-items-start" style="cursor:pointer">
              <input type="checkbox" name="confirmDuplicate" value="1" id="confirmDuplicate" class="form-check-input mt-0" <%= V.confirmDuplicate ? 'checked' : '' %>>
              <span>This is a <b>different doctor</b> (e.g. shared clinic number) — save anyway.</span>
            </label>
          </div>

          <div class="rd-field" data-field="authorizeForBloodTest">
            <label class="rd-field-label" for="f_authorizeForBloodTest">Blood sample authorisation <span class="rd-req">*</span></label>
            <div class="rd-input-wrap <%= fe('authorizeForBloodTest') ? 'error' : '' %>">
              <span class="rd-input-icon"><i class="bi bi-droplet-half"></i></span>
              <select name="authorizeForBloodTest" id="f_authorizeForBloodTest" class="rd-ts" data-ts-no-search required>
                <option value="">Select</option>
                <option value="1" <%= String(V.authorizeForBloodTest) === '1' ? 'selected' : '' %>>Yes — authorised</option>
                <option value="2" <%= String(V.authorizeForBloodTest) === '2' ? 'selected' : '' %>>No — not authorised</option>
              </select>
            </div>
            <span class="rd-error-msg <%= fe('authorizeForBloodTest') ? 'show' : '' %>" data-default="Choose yes or no"><%= fe('authorizeForBloodTest') || 'Choose yes or no' %></span>
          </div>

          <div class="rd-field" data-field="flatDiscount">
            <label class="rd-field-label" for="f_flatDiscount">Flat discount <span class="rd-req">*</span></label>
            <div class="rd-input-wrap <%= fe('flatDiscount') ? 'error' : '' %>">
              <span class="rd-input-icon"><i class="bi bi-tag"></i></span>
              <select name="flatDiscount" id="f_flatDiscount" class="rd-ts" data-ts-no-search required>
                <option value="">Select</option>
                <% [0,5,10,15,20,25,30,35,40,50].forEach(function (d) { %>
                  <option value="<%= d %>" <%= V.flatDiscount !== '' && V.flatDiscount != null && Number(V.flatDiscount) === d ? 'selected' : '' %>><%= d %>%<%= d === 0 ? ' — no discount' : '' %></option>
                <% }) %>
              </select>
            </div>
            <% if (fw('flatDiscount')) { %><p class="rd-warn-note"><i class="bi bi-info-circle"></i> <%= fw('flatDiscount') %></p><% } %>
            <span class="rd-error-msg <%= fe('flatDiscount') ? 'show' : '' %>" data-default="Choose the discount"><%= fe('flatDiscount') || 'Choose the discount' %></span>
          </div>

          <%- field({ name: 'award', label: 'Award', icon: 'bi-trophy', ph: 'Optional' }) %>
          <%- field({ name: 'instruction', label: 'Prescription instruction', icon: 'bi-info-circle', ph: 'Printed for this doctor (optional)', full: true }) %>
        </div>
      </section>

      <!-- ══ 2. Visiting schedule ══ -->
      <section class="rd-panel <%= !isEdit && firstErrStep === 1 ? 'active' : '' %>" data-panel="1" id="sec1">
        <div class="rd-section-label"><i class="bi bi-calendar-week"></i> Visiting schedule</div>
        <p class="rd-section-note">Where and when the doctor sits. Marketing officers see these days and times on their <i>My visits</i> page. Use the <i class="bi bi-copy"></i> button to repeat a row for another day.</p>
        <div class="rd-errbox mb-3 mx-0 <%= fe('schedule') ? '' : 'd-none' %>" id="schedErr" style="margin:0 0 12px"><%= fe('schedule') || 'Add at least one visiting schedule.' %></div>
        <div id="visitingDaysContainer"></div>
        <button type="button" class="rd-btn rd-btn-outline rd-btn-sm" id="addDayButton"><i class="bi bi-plus-lg"></i> Add schedule</button>

        <template id="visitRowTemplate">
          <div class="rd-visit-card visiting-day">
            <div class="rd-visit-head">
              <span class="rd-visit-badge"><i class="bi bi-geo-alt"></i> <span class="area-label">New schedule</span></span>
              <span class="rd-visit-tools">
                <button type="button" class="rd-icon-btn copy-day" title="Copy this row for another day" aria-label="Copy row"><i class="bi bi-copy"></i></button>
                <button type="button" class="rd-icon-btn danger remove-day" title="Remove" aria-label="Remove row"><i class="bi bi-trash3"></i></button>
              </span>
            </div>
            <div class="rd-visit-grid">
              <div class="rd-field">
                <label class="rd-field-label">Area <span class="rd-req">*</span></label>
                <div class="rd-input-wrap"><span class="rd-input-icon"><i class="bi bi-geo-alt"></i></span>
                  <input type="text" name="area[]" placeholder="e.g. Kankarbagh" list="dlAreas" maxlength="60" required autocomplete="off" style="text-transform:capitalize"></div>
              </div>
              <div class="rd-field">
                <label class="rd-field-label">Day <span class="rd-req">*</span></label>
                <div class="rd-input-wrap"><span class="rd-input-icon"><i class="bi bi-calendar3"></i></span>
                  <select name="days[]" class="rd-ts-day" required>
                    <option value="">Select day</option>
                    <option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option>
                    <option>Friday</option><option>Saturday</option><option>Sunday</option><option value="AllDay">All days</option>
                  </select></div>
              </div>
              <div class="rd-field">
                <label class="rd-field-label">From <span class="rd-req">*</span></label>
                <div class="rd-input-wrap"><span class="rd-input-icon"><i class="bi bi-clock"></i></span>
                  <input type="text" name="startTimes[]" class="rd-time" placeholder="Start" required autocomplete="off"></div>
              </div>
              <div class="rd-field">
                <label class="rd-field-label">To <span class="rd-req">*</span></label>
                <div class="rd-input-wrap"><span class="rd-input-icon"><i class="bi bi-clock-fill"></i></span>
                  <input type="text" name="endTimes[]" class="rd-time" placeholder="End" required autocomplete="off"></div>
              </div>
            </div>
            <div class="rd-row-err"></div>
          </div>
        </template>
      </section>

      <!-- ══ 3. Thanks % per test category ══ -->
      <section class="rd-panel <%= !isEdit && firstErrStep === 2 ? 'active' : '' %>" data-panel="2" id="sec2">
        <div class="rd-section-label"><i class="bi bi-percent"></i> Thanks % per test category</div>
        <p class="rd-section-note">
          Each test's thanks = test price × this %.
          <% if (isEdit) { %><b>Changing a category's %</b> re-calculates the thanks of all its tests (custom test-wise thanks in that category are replaced). Categories you do not change keep their test-wise thanks.<% } %>
        </p>
        <div class="rd-errbox mb-3 <%= fe('commission') ? '' : 'd-none' %>" style="margin:0 0 12px"><%= fe('commission') %></div>
        <% if (CATS.length > 1) { %>
          <div class="rd-bulk">
            <i class="bi bi-lightning-charge" style="color:var(--brand)"></i> Set every category to
            <select id="bulkRate" aria-label="Thanks % for all categories"><option value="">%</option><% RATES.forEach(function (x) { %><option value="<%= x %>"><%= x %>%</option><% }) %></select>
            <button type="button" class="rd-btn rd-btn-outline rd-btn-sm" id="bulkApply">Apply</button>
          </div>
        <% } %>
        <div class="rd-commission-grid" id="commissionGrid">
          <% CATS.forEach(function (cat) {
               var key = 'c' + cat.Id, cur = COM[key] == null ? '' : String(COM[key]), orig = OCOM[key] == null ? '' : String(OCOM[key]);
               var opts = RATES.slice(); if (cur !== '' && opts.indexOf(Number(cur)) === -1 && isFinite(Number(cur))) { opts.push(Number(cur)); opts.sort(function (a, b) { return a - b; }); }
               var err = fe('commission.' + key);
               var changed = isEdit && orig !== '' && cur !== '' && Number(orig) !== Number(cur);
          %>
            <div class="rd-commission-item <%= err ? 'error' : '' %> <%= changed ? 'changed' : '' %>" data-cat="<%= cat.Name %>" title="<%= err %>">
              <span class="rd-commission-name"><%= cat.Name %>
                <small class="<%= changed ? '' : 'd-none' %>" data-changed>was <%= orig %>% — tests will be re-calculated</small>
                <% if (isEdit && orig === '') { %><small>new category — not set before</small><% } %>
              </span>
              <div class="rd-input-wrap">
                <span class="rd-input-icon"><i class="bi bi-percent"></i></span>
                <select name="commission[<%= key %>]" class="thanks" data-category-id="<%= cat.Id %>" data-original="<%= orig %>" required aria-label="Thanks % for <%= cat.Name %>">
                  <option value="">%</option>
                  <% opts.forEach(function (x) { %><option value="<%= x %>" <%= cur !== '' && Number(cur) === x ? 'selected' : '' %>><%= x %>%</option><% }) %>
                </select>
              </div>
            </div>
          <% }) %>
        </div>
      </section>

      <% if (!isEdit) { %>
      <!-- ══ 4. Review ══ -->
      <section class="rd-panel" data-panel="3" id="sec3">
        <div class="rd-section-label"><i class="bi bi-clipboard-check"></i> Review &amp; confirm</div>
        <p class="rd-section-note">Check everything once. Tap <i>Edit</i> on a section to change it.</p>
        <div id="reviewContent"></div>
      </section>
      <% } %>

      <div class="rd-btn-bar">
        <a href="<%= isEdit ? '/doctor/getDoctorDetail?doctorId=' + DID : '/doctor/getDoctorListView' %>" class="rd-btn rd-btn-ghost" id="cancelBtn"><i class="bi bi-x-lg"></i> Cancel</a>
        <div class="rd-btn-group">
          <% if (!isEdit) { %>
            <button type="button" class="rd-btn rd-btn-outline" id="prevBtn" style="display:none"><i class="bi bi-arrow-left"></i> Back</button>
            <button type="button" class="rd-btn rd-btn-primary" id="nextBtn">Next <i class="bi bi-arrow-right"></i></button>
          <% } %>
          <button type="submit" class="rd-btn rd-btn-primary" id="submitBtn" <%= !isEdit ? 'style="display:none"' : '' %> <%= CATS.length ? '' : 'disabled' %>>
            <i class="bi bi-check2-circle"></i> <span><%= isEdit ? 'Save changes' : 'Register doctor' %></span>
          </button>
        </div>
      </div>
    </div>
  </form>

  <datalist id="dlAreas"><% LK.areas.forEach(function (a) { %><option value="<%= a %>"></option><% }) %></datalist>
  <datalist id="dlSpecs"><% LK.specialities.forEach(function (a) { %><option value="<%= a %>"></option><% }) %></datalist>
  <datalist id="dlDegrees"><% LK.degrees.forEach(function (a) { %><option value="<%= a %>"></option><% }) %></datalist>
</div>

<div class="rd-toast" id="rdToast" role="status"><i class="bi bi-exclamation-circle"></i> <span id="rdToastMsg"></span></div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  'use strict';
  var form = document.getElementById('doctorForm');
  var IS_EDIT = form.dataset.mode === 'edit';
  var DOCTOR_ID = form.dataset.doctorId || '';
  var INITIAL_ROWS = <%- json((V.schedules && V.schedules.length) ? V.schedules : [{ area: '', day: '', start: '', end: '' }]) %>;
  var ROW_ERRORS = <%- json(rowErrors) %>;
  var FIRST_STEP = <%= isEdit ? 0 : firstErrStep %>;
  var HAS_SERVER_ERRORS = <%= hardErrors.length ? 'true' : 'false' %>;
  var STEP_TITLES = ["Fill in the doctor's personal and professional details", 'Where and when the doctor sits', 'Thanks % for each test category', 'Check everything before registering'];
  var $ = function (id) { return document.getElementById(id); };
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); };
  var dirty = false, submitting = false, msgOverride = '';
  var title = function (s) { return String(s || '').toLowerCase().replace(/(^|[\s.'-])([a-z])/g, function (m, a, b) { return a + b.toUpperCase(); }); };

  /* ── values (Tom Select aware) ── */
  function val(el) {
    if (!el) return '';
    if (el.tomselect && typeof el.tomselect.getValue === 'function') { var t = el.tomselect.getValue(); if (t !== '' && t != null) return String(t); }
    return el.value == null ? '' : String(el.value).trim();
  }
  var fieldVal = function (n) { return val(form.querySelector('[name="' + n + '"]')); };
  var listVals = function (n) { return [].map.call(form.querySelectorAll('[name="' + n + '"]'), val); };

  function toast(msg, type) {
    var t = $('rdToast'); $('rdToastMsg').textContent = msg;
    t.className = 'rd-toast ' + (type || '') + ' show';
    t.querySelector('i').className = type === 'success' ? 'bi bi-check-circle' : 'bi bi-exclamation-circle';
    clearTimeout(t._h); t._h = setTimeout(function () { t.classList.remove('show'); }, 3500);
  }

  /* ── Tom Select + Flatpickr (each optional: plain inputs still work) ── */
  function initSelect(sel) {
    if (!sel || !window.TomSelect) return;
    if (sel.tomselect) sel.tomselect.destroy();             // common.js may have made one already
    // allowEmptyOption: the "Select …" option shows in the box until something is chosen
    var ts = new TomSelect(sel, { create: false, allowEmptyOption: true, maxOptions: null, controlInput: null, dropdownParent: 'body' });
    ts.on('change', function () { clearError(sel); sel.dispatchEvent(new Event('rd-change', { bubbles: true })); dirty = true; });
  }
  function initTime(input) {
    if (!input) return;
    if (!window.flatpickr) { input.type = 'time'; return; }
    if (input._flatpickr) input._flatpickr.destroy();
    flatpickr(input, {
      enableTime: true, noCalendar: true, time_24hr: false, minuteIncrement: 5,
      dateFormat: 'H:i', altInput: true, altFormat: 'h:i K', allowInput: false, disableMobile: true,
      onChange: function () { clearError(input); dirty = true; var c = input.closest('.rd-visit-card'); if (c) checkRows(); }
    });
  }

  /* ── errors ── */
  function wrapOf(el) { return el.closest('.rd-input-wrap'); }
  function msgOf(el) { var f = el.closest('.rd-field'); return f ? f.querySelector('.rd-error-msg') : null; }
  function setError(el, text) {
    var w = wrapOf(el), m = msgOf(el);
    if (w) w.classList.add('error');
    if (m) { m.textContent = text || m.dataset.default || 'Required'; m.classList.add('show'); }
  }
  function clearError(el) {
    var w = wrapOf(el), m = msgOf(el);
    if (w) w.classList.remove('error');
    if (m) m.classList.remove('show');
    var item = el.closest('.rd-commission-item'); if (item) item.classList.remove('error');
  }
  form.addEventListener('input', function (e) { dirty = true; if (e.target.matches('input')) clearError(e.target); });
  form.addEventListener('change', function (e) { dirty = true; clearError(e.target); });

  /* ── tidy-ups: "Dr." prefix, phone spaces ── */
  var fn = form.querySelector('[name=firstName]');
  fn.addEventListener('blur', function () { var t = fn.value.replace(/^\s*(dr\.?\s+|dr\.)+/i, '').trim(); if (t !== fn.value) fn.value = t; });
  form.querySelectorAll('[data-validate=phone]').forEach(function (p) {
    p.addEventListener('blur', function () { p.value = p.value.replace(/[\s\-().]/g, ''); });
  });

  /* ── validation ── */
  var PHONE = /^\+?\d{10,15}$/, NAME = /^[A-Za-z][A-Za-z .'-]*$/;
  function toMin(t) { var m = /^(\d{1,2}):(\d{2})/.exec(String(t || '')); return m ? (+m[1]) * 60 + (+m[2]) : null; }
  function h12(min) { var h = Math.floor(min / 60), m = min % 60, ap = h >= 12 ? 'PM' : 'AM'; h = h % 12 || 12; return h + ':' + String(m).padStart(2, '0') + ' ' + ap; }

  function checkDetails() {
    var ok = true;
    var need = function (n, test, msg) {
      var el = form.querySelector('[name="' + n + '"]'); var v = val(el);
      if (!test(v)) { setError(el, msg); ok = false; } else clearError(el);
    };
    need('firstName', function (v) { return v && NAME.test(v); }, 'Enter the first name (letters only)');
    need('lastName', function (v) { return !v || NAME.test(v); }, 'Letters, spaces, dot and hyphen only');
    need('specialistIn', function (v) { return !!v; }, 'Enter the speciality');
    need('degree1', function (v) { return !!v; }, 'Enter at least one degree');
    need('yearOfExperience', function (v) { return v !== '' && /^\d+$/.test(v) && +v <= 70; }, 'Enter a whole number from 0 to 70');
    need('mobileNumberFirst', function (v) { return PHONE.test(v.replace(/[\s\-().]/g, '')); }, 'Enter a valid 10–15 digit number');
    need('mobileNumberSecond', function (v) { return !v || PHONE.test(v.replace(/[\s\-().]/g, '')); }, 'Enter a valid 10–15 digit number');
    need('authorizeForBloodTest', function (v) { return v === '1' || v === '2'; }, 'Choose yes or no');
    need('flatDiscount', function (v) { return v !== ''; }, 'Choose the discount');
    var dup = $('dupBox');
    if (dup.classList.contains('show') && !$('confirmDuplicate').checked) {
      dup.classList.add('error');
      if (ok) msgOverride = 'This doctor may already be registered — open the existing one, or tick "different doctor".';
      ok = false;
    } else dup.classList.remove('error');
    return ok;
  }

  /* schedule rows: required fields, end after start, no overlap on the same day */
  function checkRows(showAll) {
    var cards = [].slice.call(form.querySelectorAll('.visiting-day')), ok = true, filled = [];
    cards.forEach(function (c, i) {
      var area = val(c.querySelector('[name="area[]"]')), day = val(c.querySelector('[name="days[]"]'));
      var s = toMin(val(c.querySelector('[name="startTimes[]"]'))), e = toMin(val(c.querySelector('[name="endTimes[]"]')));
      var blank = !area && !day && s == null && e == null, msg = '';
      if (blank && cards.length > 1) { c.classList.remove('error'); c.querySelector('.rd-row-err').textContent = ''; return; }
      if (!area) msg = 'Enter the area.';
      else if (!day) msg = 'Choose the day.';
      else if (s == null || e == null) msg = 'Choose the start and end time.';
      else if (e <= s) msg = 'End time must be after the start time.';
      if (!msg) {
        filled.forEach(function (f) {
          if (!msg && (f.day === day || f.day === 'AllDay' || day === 'AllDay') && s < f.e && f.s < e)
            msg = 'Overlaps row ' + (f.i + 1) + ' (' + (f.day === 'AllDay' ? 'All days' : f.day) + ' ' + h12(f.s) + '–' + h12(f.e) + ').';
        });
        filled.push({ i: i, day: day, s: s, e: e });
      }
      var show = msg && (showAll || c.dataset.touched === '1');
      c.classList.toggle('error', !!show);
      c.querySelector('.rd-row-err').textContent = show ? msg : '';
      if (msg) ok = false;
    });
    var none = !filled.length;
    $('schedErr').classList.toggle('d-none', !(none && showAll));
    return ok && !none;
  }

  function checkThanks(showAll) {
    var ok = true;
    form.querySelectorAll('#commissionGrid select.thanks').forEach(function (s) {
      var bad = val(s) === '';
      if (showAll) s.closest('.rd-commission-item').classList.toggle('error', bad);
      if (bad) ok = false;
    });
    return ok;
  }

  var checks = [checkDetails, function () { return checkRows(true); }, function () { return checkThanks(true); }];
  var stepMsgs = ['Please fix the highlighted details.', 'Please complete the visiting schedule.', 'Choose the thanks % for every category.'];

  /* ── visiting schedule rows ── */
  var box = $('visitingDaysContainer'), tpl = $('visitRowTemplate');
  function badge(card) {
    var area = val(card.querySelector('[name="area[]"]')) || 'New schedule', day = val(card.querySelector('[name="days[]"]'));
    var s = val(card.querySelector('[name="startTimes[]"]')), e = val(card.querySelector('[name="endTimes[]"]'));
    var b = card.querySelector('.rd-visit-badge');
    b.innerHTML = '<i class="bi bi-geo-alt"></i> ' + esc(area) + (day ? ' · ' + esc(day === 'AllDay' ? 'All days' : day) : '') +
      (s && e && toMin(s) != null && toMin(e) != null ? ' · ' + esc(h12(toMin(s)) + '–' + h12(toMin(e))) : '');
  }
  function addRow(data, after) {
    var frag = tpl.content.cloneNode(true), card = frag.querySelector('.rd-visit-card');
    data = data || {};
    card.querySelector('[name="area[]"]').value = data.area || '';
    card.querySelector('[name="days[]"]').value = data.day || '';
    card.querySelector('[name="startTimes[]"]').value = (data.start || '').slice(0, 5);
    card.querySelector('[name="endTimes[]"]').value = (data.end || '').slice(0, 5);
    if (after && after.nextSibling) box.insertBefore(frag, after.nextSibling); else box.appendChild(frag);
    initSelect(card.querySelector('[name="days[]"]'));
    card.querySelectorAll('input.rd-time').forEach(initTime);
    card.addEventListener('input', function () { card.dataset.touched = '1'; badge(card); checkRows(); });
    card.addEventListener('rd-change', function () { card.dataset.touched = '1'; badge(card); checkRows(); });
    card.addEventListener('change', function () { card.dataset.touched = '1'; badge(card); checkRows(); });
    card.querySelector('.remove-day').addEventListener('click', function () {
      if (form.querySelectorAll('.visiting-day').length === 1) {         // keep one row: just clear it
        card.remove(); addRow({}); dirty = true; return;
      }
      card.remove(); dirty = true; checkRows();
    });
    card.querySelector('.copy-day').addEventListener('click', function () {
      var copy = addRow({ area: val(card.querySelector('[name="area[]"]')), day: '',
        start: val(card.querySelector('[name="startTimes[]"]')), end: val(card.querySelector('[name="endTimes[]"]')) }, card);
      dirty = true;
      var d = copy.querySelector('[name="days[]"]'); if (d.tomselect) d.tomselect.focus(); else d.focus();
    });
    badge(card);
    return card;
  }
  INITIAL_ROWS.forEach(function (r, i) {
    var c = addRow(r);
    if (ROW_ERRORS[i]) { c.classList.add('error'); c.dataset.touched = '1'; c.querySelector('.rd-row-err').textContent = ROW_ERRORS[i].join(' '); }
  });
  $('addDayButton').addEventListener('click', function () { var c = addRow({}); dirty = true; c.querySelector('[name="area[]"]').focus(); });

  /* ── thanks % ── */
  form.querySelectorAll('select.rd-ts').forEach(initSelect);
  form.querySelectorAll('#commissionGrid select.thanks').forEach(function (s) {
    initSelect(s);
    var mark = function () {
      var item = s.closest('.rd-commission-item'), o = s.dataset.original, cur = val(s), tag = item.querySelector('[data-changed]');
      var changed = IS_EDIT && o !== '' && cur !== '' && Number(o) !== Number(cur);
      item.classList.toggle('changed', changed);
      if (tag) { tag.classList.toggle('d-none', !changed); tag.textContent = 'was ' + o + '% — tests will be re-calculated'; }
      if (cur !== '') item.classList.remove('error');
    };
    s.addEventListener('change', mark); s.addEventListener('rd-change', mark);
  });
  var bulk = $('bulkApply');
  if (bulk) bulk.addEventListener('click', function () {
    var r = $('bulkRate').value; if (r === '') { toast('Choose the % first.'); return; }
    form.querySelectorAll('#commissionGrid select.thanks').forEach(function (s) {
      if (s.tomselect) s.tomselect.setValue(r); else { s.value = r; s.dispatchEvent(new Event('change', { bubbles: true })); }
    });
    toast('Every category set to ' + r + '%.', 'success'); dirty = true;
  });

  /* ── live duplicate check (needs GET /doctor/api/check-duplicate; silently skipped if missing) ── */
  var dupTimer, lastQ = '';
  var ORIG_DATA = null; try { ORIG_DATA = form.dataset.orig ? JSON.parse(form.dataset.orig) : null; } catch (e) {}
  var l10 = function (x) { return String(x || '').replace(/\D/g, '').slice(-10); };
  function checkDup() {
    var f = fieldVal('firstName'), l = fieldVal('lastName'), m1 = fieldVal('mobileNumberFirst'), m2 = fieldVal('mobileNumberSecond');
    if (ORIG_DATA) {           // edit: check only what was changed
      var low = function (x) { return String(x || '').trim().toLowerCase(); }, old = ORIG_DATA.m.map(l10);
      if (low(f) === low(ORIG_DATA.f) && low(l) === low(ORIG_DATA.l)) { f = ''; l = ''; }
      if (old.indexOf(l10(m1)) !== -1) m1 = '';
      if (old.indexOf(l10(m2)) !== -1) m2 = '';
      if (!f && !m1 && !m2) { $('dupBox').classList.remove('show', 'error'); lastQ = ''; return; }
    }
    var q = new URLSearchParams({ firstName: f, lastName: l, mobile: m1, mobile2: m2, excludeId: DOCTOR_ID }).toString();
    if (q === lastQ) return; lastQ = q;
    if (!f && l10(m1).length < 10 && l10(m2).length < 10) return;
    fetch('/doctor/api/check-duplicate?' + q, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || !d.success) return;
        var m = d.matches || [];
        $('dupBox').classList.toggle('show', m.length > 0);
        if (!m.length) { $('dupBox').classList.remove('error'); $('confirmDuplicate').checked = false; return; }
        $('dupWhat').textContent = m.every(function (x) { return x.reason === 'same name'; }) ? 'name' : (m.some(function (x) { return x.reason !== 'same name'; }) ? 'mobile number' : 'details');
        $('dupList').innerHTML = m.map(function (x) {
          return '<li><a href="/doctor/getDoctorDetail?doctorId=' + encodeURIComponent(x.id) + '" target="_blank" rel="noopener">' + esc(x.name) + '</a>' +
                 (x.spec ? ' · ' + esc(x.spec) : '') + (x.mobile ? ' · ' + esc(x.mobile) : '') + ' <i>(' + esc(x.reason) + ')</i></li>';
        }).join('');
      })
      .catch(function () {});
  }
  ['firstName', 'lastName', 'mobileNumberFirst', 'mobileNumberSecond'].forEach(function (n) {
    var el = form.querySelector('[name="' + n + '"]');
    el.addEventListener('blur', function () { clearTimeout(dupTimer); dupTimer = setTimeout(checkDup, 150); });
  });
  $('confirmDuplicate').addEventListener('change', function () { if (this.checked) $('dupBox').classList.remove('error'); });

  /* ── steps (register) ── */
  var panels = [].slice.call(form.querySelectorAll('.rd-panel'));
  var current = 0;
  function showStep(n) {
    current = n;
    panels.forEach(function (p, i) { p.classList.toggle('active', i === n); });
    document.querySelectorAll('.rd-step').forEach(function (s, i) {
      s.classList.toggle('active', i === n); s.classList.toggle('done', i < n);
    });
    document.querySelectorAll('.rd-step-line').forEach(function (l, i) { l.classList.toggle('done', i < n); });
    $('prevBtn').style.display = n === 0 ? 'none' : '';
    $('nextBtn').style.display = n === panels.length - 1 ? 'none' : '';
    $('submitBtn').style.display = n === panels.length - 1 ? '' : 'none';
    $('cancelBtn').style.display = n === 0 ? '' : 'none';
    $('headerSub').textContent = STEP_TITLES[n];
    if (n === panels.length - 1) renderReview();
    var top = form.getBoundingClientRect().top + window.scrollY - 80;
    if (window.scrollY > top) window.scrollTo({ top: top, behavior: 'smooth' });
  }
  function goTo(n) {
    if (n > current) {
      for (var s = current; s < n; s++) {
        msgOverride = '';
        if (s < checks.length && !checks[s]()) { if (s !== current) showStep(s); toast(msgOverride || stepMsgs[s]); markStepError(s); return; }
        markStepError(s, true);
      }
    }
    showStep(n);
  }
  function markStepError(s, clear) { var el = document.querySelector('.rd-step[data-step="' + s + '"]'); if (el) el.classList.toggle('has-error', !clear); }

  if (!IS_EDIT) {
    $('nextBtn').addEventListener('click', function () { goTo(current + 1); });
    $('prevBtn').addEventListener('click', function () { showStep(current - 1); });
    document.querySelectorAll('.rd-step').forEach(function (s) {
      s.addEventListener('click', function () { var n = +s.dataset.step; if (n < current) showStep(n); else if (n > current) goTo(n); });
    });
    // Enter in a text box = Next (not "submit half a form")
    form.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && e.target.matches('input:not([type=checkbox])') && current < panels.length - 1) { e.preventDefault(); goTo(current + 1); }
    });
    showStep(FIRST_STEP);
    if (HAS_SERVER_ERRORS) markStepError(FIRST_STEP);
  } else {
    document.querySelectorAll('[data-jump]').forEach(function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); panels[+a.dataset.jump].scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    });
  }

  /* ── review (register) ── */
  function renderReview() {
    var item = function (label, v) { return '<div class="rd-review-item"><div class="rd-review-label">' + esc(label) + '</div>' + (v ? '<div class="rd-review-value">' + esc(v) + '</div>' : '<div class="rd-review-value rd-review-empty">—</div>') + '</div>'; };
    var sec = function (title, step, body) { return '<div class="rd-review-section"><div class="rd-review-title"><span>' + title + '</span><button type="button" data-goto="' + step + '">Edit</button></div>' + body + '</div>'; };
    var auth = { '1': 'Yes — authorised', '2': 'No — not authorised' }[fieldVal('authorizeForBloodTest')] || '';
    var name = ('Dr. ' + title(fieldVal('firstName')) + ' ' + title(fieldVal('lastName'))).trim();
    var html = sec('<i class="bi bi-person-circle"></i> Doctor', 0, '<div class="rd-review-grid">' +
      item('Name', name) + item('Speciality', title(fieldVal('specialistIn'))) +
      item('Degrees', ['degree1', 'degree2', 'degree3', 'degree4'].map(fieldVal).filter(Boolean).join(', ')) +
      item('Experience', fieldVal('yearOfExperience') !== '' ? fieldVal('yearOfExperience') + ' years' : '') +
      item('Mobile', [fieldVal('mobileNumberFirst'), fieldVal('mobileNumberSecond')].filter(Boolean).join(' / ')) +
      item('Worked at', fieldVal('workedAt')) + item('Registration', fieldVal('registration')) +
      item('Blood sample', auth) + item('Flat discount', fieldVal('flatDiscount') !== '' ? fieldVal('flatDiscount') + '%' : '') +
      item('Award', fieldVal('award')) + item('Instruction', fieldVal('instruction')) + '</div>');
    var areas = listVals('area[]'), days = listVals('days[]'), st = listVals('startTimes[]'), et = listVals('endTimes[]'), rows = '';
    areas.forEach(function (a, i) {
      if (!a && !days[i]) return;
      rows += '<div class="rd-review-item" style="margin-bottom:8px"><div class="rd-review-value"><i class="bi bi-geo-alt" style="color:var(--brand)"></i> ' +
        esc(title(a)) + ' · ' + esc(days[i] === 'AllDay' ? 'All days' : days[i]) + ' · ' + (toMin(st[i]) != null ? h12(toMin(st[i])) : '—') + ' – ' + (toMin(et[i]) != null ? h12(toMin(et[i])) : '—') + '</div></div>';
    });
    html += sec('<i class="bi bi-calendar-week"></i> Visiting schedule', 1, rows || '<p class="rd-review-empty">No schedule</p>');
    var com = '<div class="rd-review-grid">';
    form.querySelectorAll('#commissionGrid .rd-commission-item').forEach(function (it) {
      var v = val(it.querySelector('select.thanks')); com += item(it.dataset.cat, v !== '' ? v + '%' : '');
    });
    html += sec('<i class="bi bi-percent"></i> Thanks %', 2, com + '</div>');
    $('reviewContent').innerHTML = html;
  }
  var rc = $('reviewContent');
  if (rc) rc.addEventListener('click', function (e) { var b = e.target.closest('[data-goto]'); if (b) showStep(+b.dataset.goto); });

  /* ── submit ── */
  form.addEventListener('submit', function (e) {
    if (submitting) { e.preventDefault(); return; }
    for (var s = 0; s < checks.length; s++) {
      msgOverride = '';
      if (!checks[s]()) {
        e.preventDefault();
        toast(msgOverride || stepMsgs[s]);
        if (IS_EDIT) {
          var bad = panels[s].querySelector('.error, .rd-error-msg.show') || panels[s];
          bad.scrollIntoView({ behavior: 'smooth', block: 'center' });
          document.querySelectorAll('[data-jump]').forEach(function (a) { a.classList.toggle('bad', +a.dataset.jump === s); });
        } else { showStep(s); markStepError(s); }
        return;
      }
    }
    submitting = true;
    var btn = $('submitBtn'); btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving…';
  });

  /* unsaved changes */
  window.addEventListener('beforeunload', function (e) { if (dirty && !submitting) { e.preventDefault(); e.returnValue = ''; } });
  // a fresh page has no changes yet (Tom Select / Flatpickr init fire events)
  setTimeout(function () { dirty = HAS_SERVER_ERRORS; }, 0);

  if (HAS_SERVER_ERRORS && IS_EDIT) {
    var first = form.querySelector('.rd-input-wrap.error, .rd-visit-card.error, .rd-commission-item.error, .rd-dup.error');
    if (first) setTimeout(function () { first.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 200);
  }
});
</script>
