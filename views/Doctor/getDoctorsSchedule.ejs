<%
  var docs   = (typeof doctors !== 'undefined' && doctors) ? doctors : [];
  var open   = (typeof openVisit !== 'undefined') ? openVisit : null;
  var mine   = (typeof myToday !== 'undefined' && myToday) ? myToday : [];
  var S      = (typeof summary !== 'undefined' && summary) ? summary : { planned: docs.length, visited: 0, verified: 0 };
  var photoMode = (typeof photoMode !== 'undefined' && ['required','optional','off'].indexOf(photoMode) !== -1) ? photoMode : 'required';
  var needPhoto = photoMode !== 'off';
  var DAYS   = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
  var selDay = (typeof day !== 'undefined' && day) ? day : '';
  var todayN = (typeof today !== 'undefined' && today) ? today : '';
  var DC     = (typeof dayCounts !== 'undefined' && dayCounts) ? dayCounts : {};
  var team   = (typeof canViewTeam !== 'undefined') && !!canViewTeam;
  var ready  = (typeof assignReady !== 'undefined') && !!assignReady;
  var SCOPE  = (typeof scope !== 'undefined' && scope) ? String(scope) : 'all';
  var MRS    = (typeof mrOptions !== 'undefined' && mrOptions) ? mrOptions : [];
  var showMr = team && ready && SCOPE !== 'mine';
  var fmtTime = function (d) { if (!d) return ''; return new Date(d).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true }); };
  var initials = function (a, b) { return ((a || '').charAt(0) + (b || '').charAt(0)).toUpperCase() || 'DR'; };
  var cap = function (s) { s = String(s || ''); return s.split(' ').map(function (w) { return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase(); }).join(' '); };
  var statusLabel = { verified: ['✓ At clinic', 'ok'], far: ['Far from clinic', 'bad'], new_location: ['New clinic pin', 'info'], weak_gps: ['Weak GPS', 'warn'], no_gps: ['No GPS', 'gray'] };
  var reviewLabel = { approved: ['Verified by admin', 'ok'], rejected: ['Rejected', 'bad'], pending: ['Awaiting review', 'gray'] };
  var outcomeLabel = { met: 'Met doctor', not_available: 'Not available', left_material: 'Left material', follow_up: 'Follow-up needed', other: 'Other' };
  var allAreas = []; docs.forEach(function (d) { d.areas.forEach(function (a) { if (allAreas.indexOf(a) === -1) allAreas.push(a); }); }); allAreas.sort();
  var cnt = { follow: 0, stale: 0, nopin: 0 };
  docs.forEach(function (d) { if (d.followUpDue) cnt.follow++; if (d.daysSinceVisit == null || d.daysSinceVisit > 14) cnt.stale++; if (!d.hasLocation) cnt.nopin++; });
%>
<script>
  /* Phones need this tag, or they show the page at desktop width, zoomed out.
     Best place for it is the <head> of your layout; this adds it if the layout has none. */
  (function () { if (!document.querySelector('meta[name="viewport"]')) { var m = document.createElement('meta'); m.name = 'viewport'; m.content = 'width=device-width, initial-scale=1, viewport-fit=cover'; document.head.appendChild(m); } })();
</script>
<style>
  /* colours shared by the page AND its pop-up sheets (Bootstrap places those outside .mr) */
  .mr,.mr-sheet,.mr-busy{--card:#fff;--line:#e8ebf3;--ink:#101828;--ink2:#475467;--ink3:#98a2b3;--pri:#3056d3;--pris:#eef2ff;
      --ok:#0f7b55;--oks:#e7f6ef;--bad:#c0362c;--bads:#fdeeec;--warn:#b45309;--warns:#fff5e6;--info:#0e7490;--infos:#e7f6f9}
  .mr{max-width:1240px;margin:0 auto;padding:4px 0 110px;color:var(--ink);container:mr / inline-size;width:100%;box-sizing:border-box}
  .mr *,.mr-sheet *{box-sizing:border-box}
  .mr-main{container:mrmain / inline-size}
  .dc-name,.dc-spec,.dc-slot{overflow-wrap:anywhere}
  .mr h1{font-size:1.3rem;font-weight:700;margin:0}
  .mr-sub{font-size:.8rem;color:var(--ink2)}
  .mr-card{background:var(--card);border:1px solid var(--line);border-radius:16px}
  .mr-btn{border:0;border-radius:12px;font-weight:700;font-size:.9rem;padding:0 16px;height:46px;display:inline-flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap;text-decoration:none;cursor:pointer}
  .mr-btn:disabled{opacity:.6;cursor:default}
  .b-pri{background:var(--pri);color:#fff}.b-pri:hover{background:#2747b8;color:#fff}
  .b-ok{background:#16a34a;color:#fff}.b-bad{background:#dc2626;color:#fff}.b-bad:hover{background:#b91c1c;color:#fff}
  .b-ghost{background:#fff;border:1px solid var(--line);color:var(--ink2)}.b-ghost:hover{background:#f8f9fc;color:var(--ink)}

  /* layout: one column on phones; list + sticky side panel on laptops */
  .mr-head{display:flex;justify-content:space-between;align-items:flex-end;gap:10px;flex-wrap:wrap;margin:4px 0 12px}
  .mr-head-r{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
  .mr-scope{height:38px;border-radius:10px;border:1px solid var(--line);font-size:.84rem;font-weight:600;min-width:170px;max-width:230px}
  .mr-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:0 20px}
  .mr-side{display:contents}
  .mr-side-top{order:1}.mr-main{order:2;min-width:0}.mr-side-bot{order:3}
  @container mr (min-width:920px){
    .mr-grid{grid-template-columns:minmax(0,1fr) 320px;align-items:start}
    .mr-main{grid-column:1;grid-row:1}
    .mr-side{display:block;grid-column:2;grid-row:1;position:sticky;top:12px;max-height:calc(100vh - 24px);overflow:auto;scrollbar-width:thin}
    .mr-side .mr-open{position:static;margin-top:0}
    .mr-side .mr-stats{margin-top:0}
  }

  .mr-open{position:sticky;top:8px;z-index:20;display:flex;align-items:center;gap:10px;padding:12px 14px;margin:0 0 12px;background:#0f172a;color:#fff;border-radius:16px;box-shadow:0 10px 24px rgba(15,23,42,.25)}
  .mr-open .t{font-size:.72rem;opacity:.75}.mr-open .n{font-weight:700;text-transform:capitalize}
  .mr-open .dot{width:9px;height:9px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 4px rgba(34,197,94,.25);flex-shrink:0;animation:mrPulse 1.6s infinite}
  @keyframes mrPulse{50%{box-shadow:0 0 0 8px rgba(34,197,94,0)}}
  .mr-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:0 0 12px}
  .mr-stat{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:10px 12px}
  .mr-stat b{font-size:1.25rem;display:block;line-height:1.1}.mr-stat span{font-size:.72rem;color:var(--ink3)}
  .mr-prog{grid-column:1/-1;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:10px 12px;font-size:.78rem;color:var(--ink2)}
  .mr-prog .bar{height:6px;border-radius:99px;background:#eef1f6;margin-top:6px;overflow:hidden}
  .mr-prog .bar i{display:block;height:100%;background:linear-gradient(90deg,#3056d3,#16a34a);border-radius:99px;transition:width .3s}

  /* filters */
  .mr-tools{padding:12px;margin-bottom:12px}
  .mr-days{display:flex;gap:6px;overflow-x:auto;padding-bottom:2px;margin-bottom:10px;scrollbar-width:none}
  .mr-days::-webkit-scrollbar{display:none}
  .mr-days button{flex:0 0 auto;font-size:.8rem;font-weight:600;padding:6px 12px;border-radius:99px;border:1px solid var(--line);background:#fff;color:var(--ink2);display:inline-flex;gap:6px;align-items:center}
  .mr-days button small{font-size:.68rem;font-weight:700;background:#f2f4f7;color:var(--ink2);border-radius:99px;padding:0 6px;min-width:18px;text-align:center}
  .mr-days button.on{background:var(--pri);border-color:var(--pri);color:#fff}.mr-days button.on small{background:rgba(255,255,255,.22);color:#fff}
  .mr-days button.today:not(.on){border-color:var(--pri);color:var(--pri)}
  .mr-days button.zero:not(.on){opacity:.55}
  .mr-row{display:flex;gap:8px;flex-wrap:wrap}
  .mr-search{position:relative;flex:1 1 240px;min-width:0}
  .mr-search i{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--ink3)}
  .mr-search input{width:100%;height:42px;border:1px solid var(--line);border-radius:12px;padding:0 14px 0 38px;font-size:.92rem;background:#fff}
  .mr-row select{flex:1 1 140px;min-width:0;height:42px;border:1px solid var(--line);border-radius:12px;font-size:.88rem;color:var(--ink2)}
  .mr-search input:focus,.mr-row select:focus{outline:0;border-color:var(--pri);box-shadow:0 0 0 4px rgba(48,86,211,.12)}
  .mr-quick{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
  .mr-quick button{font-size:.76rem;font-weight:600;border:1px dashed #cfd5e3;background:#fff;color:var(--ink2);border-radius:99px;padding:5px 11px}
  .mr-quick button.on{border-style:solid;border-color:var(--pri);background:var(--pris);color:var(--pri)}
  .mr-quick .clr{border:0;color:var(--ink3);text-decoration:underline;background:none}
  .mr-count{font-size:.76rem;color:var(--ink3);margin:0 2px 8px}

  /* doctor cards */
  .mr-list{display:grid;grid-template-columns:minmax(0,1fr);gap:10px}
  @container mrmain (min-width:580px){ .mr-list{grid-template-columns:repeat(2,minmax(0,1fr))} }
  @container mrmain (min-width:1000px){ .mr-list{grid-template-columns:repeat(3,minmax(0,1fr))} }
  /* very old browsers without container queries: fall back to screen width */
  @supports not (container-type:inline-size){
    @media (min-width:768px){ .mr-list{grid-template-columns:repeat(2,minmax(0,1fr))} }
  }
  .dc{padding:14px;display:flex;flex-direction:column;transition:box-shadow .15s}
  .dc:hover{box-shadow:0 6px 18px rgba(16,24,40,.06)}
  .dc.done{background:#fbfdfc;border-color:#cdebd9}
  .dc.here{border:2px solid #16a34a}
  .dc-head{display:flex;gap:12px;align-items:flex-start}
  .dc-av{width:44px;height:44px;border-radius:14px;background:var(--pris);color:var(--pri);display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0}
  .dc.done .dc-av{background:var(--oks);color:var(--ok)}
  .dc-name{font-weight:700;font-size:.98rem;line-height:1.25}
  .dc-spec{font-size:.78rem;color:var(--ink2)}
  .dc-slot{font-size:.8rem;color:var(--ink);margin-top:6px;display:flex;gap:6px;align-items:flex-start}
  .dc-slot i{color:var(--pri);margin-top:1px}
  .dc-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
  .tg{font-size:.7rem;font-weight:600;border-radius:99px;padding:3px 9px;background:#f2f4f7;color:var(--ink2);white-space:nowrap}
  .tg.ok{background:var(--oks);color:var(--ok)}.tg.bad{background:var(--bads);color:var(--bad)}.tg.warn{background:var(--warns);color:var(--warn)}.tg.info{background:var(--infos);color:var(--info)}.tg.pri{background:var(--pris);color:var(--pri)}
  .dc-act{display:flex;gap:8px;margin-top:auto;padding-top:12px}
  .dc-act .mr-btn{height:44px;font-size:.88rem}
  .dc-act .grow{flex:1}
  @container mr (min-width:920px){ .dc-act .mr-btn{height:40px} }
  @container mr (max-width:380px){
    .mr-stats{gap:6px}.mr-stat{padding:8px 9px}.mr-stat b{font-size:1.1rem}
    .mr-tools{padding:10px}.mr-row select{flex-basis:100%}
    .dc{padding:12px}.dc-av{width:38px;height:38px;border-radius:12px}
  }
  .mr-sec{font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink3);margin:18px 2px 8px}
  .mr-side .mr-sec{margin-top:4px}
  .tl{padding:4px 14px}
  .tl-row{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid #f0f2f8}
  .tl-row:last-child{border-bottom:0}
  .tl-time{font-size:.74rem;color:var(--ink3);width:66px;flex-shrink:0;padding-top:2px}
  .mr-empty{text-align:center;padding:36px 16px;color:var(--ink2);grid-column:1/-1}
  .mr-warnbox{background:var(--warns);color:#7a3e06;border-radius:12px;padding:10px 12px;font-size:.82rem;margin:0 0 12px}
  .mr-infobox{background:var(--pris);color:#1e3a8a;border-radius:12px;padding:10px 12px;font-size:.82rem;margin:0 0 12px}

  /* sheets: bottom sheet on phones, centred dialog on laptops */
  .mr-sheet .modal-content{border:0;border-radius:20px}
  @media (max-width:575.98px){ .mr-sheet:not(.mr-cam) .modal-dialog{margin:0;position:fixed;bottom:0;left:0;right:0;max-width:none;min-height:0;display:block}
    .mr-sheet:not(.mr-cam) .modal-content{border-radius:20px 20px 0 0} }
  .oc{display:flex;flex-wrap:wrap;gap:6px}
  .oc input{display:none}
  .oc label{border:1px solid var(--line);border-radius:99px;padding:8px 13px;font-size:.84rem;font-weight:600;color:var(--ink2);cursor:pointer}
  .oc input:checked+label{background:var(--pri);border-color:var(--pri);color:#fff}
  .hist-row{border-bottom:1px solid #f0f2f8;padding:10px 0}
  .hist-row:last-child{border-bottom:0}
  .mr-busy{position:fixed;inset:0;background:rgba(255,255,255,.82);z-index:2100;display:none;align-items:center;justify-content:center;flex-direction:column;gap:12px;font-weight:600;color:var(--ink2);text-align:center;padding:24px}
  .mr-busy.on{display:flex}
  .mr-busy img{width:120px;height:120px;object-fit:cover;border-radius:16px;box-shadow:0 6px 18px rgba(0,0,0,.15)}

  /* live camera */
  .mr-cam .modal-content{background:#0b0f19;color:#fff;overflow:hidden}
  @media (min-width:576px){ .mr-cam .modal-dialog{max-width:680px} }
  .cam-top{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 16px}
  .cam-top .n{font-weight:700;font-size:.95rem}
  .cam-top .s{font-size:.74rem;opacity:.7}
  .cam-view{position:relative;background:#000;aspect-ratio:4/3;width:100%;display:flex;align-items:center;justify-content:center}
  @media (max-width:575.98px){ .mr-cam .modal-content{display:flex;flex-direction:column;height:100%} .cam-view{flex:1;aspect-ratio:auto} }
  .cam-view video,.cam-view img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .cam-view video.mirror{transform:scaleX(-1)}
  .cam-view img{object-fit:contain;background:#000}
  .cam-msg{position:relative;z-index:2;text-align:center;padding:24px;max-width:420px;font-size:.9rem}
  .cam-msg .bi{font-size:2rem;display:block;margin-bottom:8px;opacity:.8}
  .cam-bar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px calc(14px + env(safe-area-inset-bottom))}
  .cam-bar .side{flex:1;display:flex;gap:8px}.cam-bar .side.r{justify-content:flex-end}
  .cam-shot{width:68px;height:68px;border-radius:50%;border:4px solid #fff;background:#fff;box-shadow:inset 0 0 0 3px #0b0f19;flex-shrink:0}
  .cam-shot:active{transform:scale(.94)}
  .cam-shot:disabled{opacity:.4}
  .cam-ghost{background:rgba(255,255,255,.12);color:#fff;border:0;border-radius:12px;height:42px;padding:0 14px;font-weight:600;font-size:.86rem;display:inline-flex;align-items:center;gap:6px}
  .cam-ghost:hover{background:rgba(255,255,255,.2);color:#fff}
  .cam-use{background:#16a34a;color:#fff;border:0;border-radius:12px;height:46px;padding:0 18px;font-weight:700;display:inline-flex;align-items:center;gap:8px}
</style>

<div class="mr">
  <%- include("../partials/messages") %>

  <div class="mr-head">
    <div>
      <h1>My visits</h1>
      <div class="mr-sub"><%= new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' }) %></div>
    </div>
    <div class="mr-head-r">
      <% if (team && ready) { %>
        <select class="form-select mr-scope ts-exclude" id="mrScope" aria-label="Whose doctors">
          <option value="mine" <%= SCOPE === 'mine' ? 'selected' : '' %>>My doctors</option>
          <option value="all" <%= SCOPE === 'all' ? 'selected' : '' %>>All doctors</option>
          <option value="unassigned" <%= SCOPE === 'unassigned' ? 'selected' : '' %>>Not assigned</option>
          <optgroup label="Officer">
            <% MRS.forEach(function (u) { %><option value="<%= u.Id %>" <%= SCOPE === String(u.Id) ? 'selected' : '' %>><%= u.Name %></option><% }) %>
          </optgroup>
        </select>
      <% } %>
      <% if (team) { %>
        <a href="/schedule/team" class="mr-btn b-ghost" style="height:38px;font-size:.8rem"><i class="bi bi-people"></i> Team</a>
      <% } %>
    </div>
  </div>

  <div class="mr-warnbox d-none" id="mrInsecure"><i class="bi bi-shield-exclamation me-1"></i>Location and camera only work on a secure (https://) address. Ask the admin to open SmartLab with https.</div>
  <% if (team && !ready) { %>
    <div class="mr-infobox"><i class="bi bi-info-circle me-1"></i>Doctors are not assigned to officers yet, so everyone sees all doctors. Set it up on <a href="/schedule/team?tab=doctors">Team → Doctors</a>.</div>
  <% } %>

  <div class="mr-grid">
    <!-- side panel (top part): punched-in bar + today's numbers -->
    <aside class="mr-side">
      <div class="mr-side-top">
        <% if (open) { %>
          <div class="mr-open">
            <span class="dot" aria-hidden="true"></span>
            <div class="flex-grow-1" style="min-width:0">
              <div class="t">Punched in since <%= fmtTime(open.CheckInAt) %></div>
              <div class="n text-truncate">Dr. <%= open.DoctorName %></div>
            </div>
            <button type="button" class="mr-btn b-bad" style="height:42px" data-bs-toggle="modal" data-bs-target="#mrOut"><i class="bi bi-box-arrow-right"></i> Punch out</button>
          </div>
        <% } %>
        <div class="mr-stats">
          <div class="mr-stat"><b id="mrPlanned"><%= S.planned %></b><span id="mrPlannedLbl"><%= selDay === 'all' ? 'Doctors' : 'Planned' %></span></div>
          <div class="mr-stat"><b style="color:var(--pri)"><%= S.visited %></b><span>Visited today</span></div>
          <div class="mr-stat"><b style="color:var(--ok)"><%= S.verified %></b><span>At clinic ✓</span></div>
          <div class="mr-prog" id="mrProg"><span id="mrProgTxt">&nbsp;</span><div class="bar"><i id="mrProgBar" style="width:0"></i></div></div>
        </div>
      </div>

      <div class="mr-side-bot">
        <% if (mine.length) { %>
          <div class="mr-sec">Today's visits</div>
          <div class="mr-card tl">
            <% mine.forEach(function (v) { var st = statusLabel[v.LocationStatus] || ['—', 'gray']; var rv = reviewLabel[v.ReviewStatus] || reviewLabel.pending; %>
              <div class="tl-row">
                <div class="tl-time"><%= v.InAt || '' %></div>
                <div class="flex-grow-1" style="min-width:0">
                  <div class="fw-semibold text-capitalize">Dr. <%= v.DoctorName %></div>
                  <div class="d-flex flex-wrap gap-1 mt-1">
                    <span class="tg <%= st[1] %>"><%= st[0] %><%= v.LocationStatus === 'far' && v.DistanceM ? ' · ' + (v.DistanceM >= 1000 ? (v.DistanceM / 1000).toFixed(1) + ' km' : v.DistanceM + ' m') : '' %></span>
                    <span class="tg"><%= v.OutAt ? v.InAt + ' – ' + v.OutAt + ' · ' + v.Minutes + ' min' : 'In progress' %></span>
                    <% if (v.Outcome) { %><span class="tg pri"><%= outcomeLabel[v.Outcome] %></span><% } %>
                    <span class="tg <%= rv[1] %>"><%= rv[0] %></span>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
        <div class="text-center mt-3">
          <button type="button" class="btn btn-link btn-sm text-secondary" data-bs-toggle="modal" data-bs-target="#mrManual">Phone GPS not working? Log a visit manually</button>
        </div>
      </div>
    </aside>

    <!-- main: filters + doctors -->
    <section class="mr-main">
      <div class="mr-card mr-tools">
        <div class="mr-days" role="tablist" aria-label="Visiting day">
          <% DAYS.forEach(function (d) { %>
            <button type="button" data-day="<%= d %>" class="<%= selDay === d ? 'on' : '' %> <%= todayN === d ? 'today' : '' %> <%= DC[d] ? '' : 'zero' %>" aria-pressed="<%= selDay === d %>"><%= todayN === d ? 'Today' : d.slice(0, 3) %><small><%= DC[d] || 0 %></small></button>
          <% }) %>
          <button type="button" data-day="all" class="<%= selDay === 'all' ? 'on' : '' %>" aria-pressed="<%= selDay === 'all' %>">All days<small><%= docs.length %></small></button>
        </div>
        <div class="mr-row">
          <div class="mr-search">
            <i class="bi bi-search"></i>
            <input type="search" id="mrFilter" placeholder="Search doctor, speciality or area" autocomplete="off" aria-label="Search">
          </div>
          <select id="mrArea" class="form-select ts-exclude" aria-label="Area">
            <option value="">All areas</option>
            <% allAreas.forEach(function (a) { %><option value="<%= a.toLowerCase() %>"><%= a %></option><% }) %>
          </select>
          <select id="mrSort" class="form-select ts-exclude" aria-label="Sort">
            <option value="due">Sort: who to visit first</option>
            <option value="name">Sort: name A–Z</option>
            <option value="biz">Sort: most business</option>
            <option value="lowbiz">Sort: least business</option>
            <option value="month">Sort: fewest visits this month</option>
          </select>
        </div>
        <div class="mr-quick" id="mrQuick">
          <button type="button" data-q="follow">Follow-up due · <%= cnt.follow %></button>
          <button type="button" data-q="stale">Not visited 15+ days · <%= cnt.stale %></button>
          <button type="button" data-q="pending">Not visited today</button>
          <button type="button" data-q="nopin">No clinic pin · <%= cnt.nopin %></button>
          <button type="button" data-q="nobiz">No patients in 30 days</button>
          <button type="button" class="clr d-none" id="mrClear">Clear filters</button>
        </div>
      </div>

      <div class="mr-count" id="mrCount"></div>
      <div class="mr-list" id="mrList">
        <% if (!docs.length) { %>
          <div class="mr-card mr-empty">
            <i class="bi bi-person-x fs-2 d-block mb-2"></i>
            <% if (ready && SCOPE === 'mine') { %>No doctors are assigned to you yet.<br><span class="small">Ask your admin to assign your doctors<%= team ? ' on Team → Doctors' : '' %>.</span>
            <% } else { %>No doctors found.<% } %>
          </div>
        <% } %>
        <% docs.forEach(function (d) {
             var nm = 'Dr. ' + cap(d.first + ' ' + d.last);
             var stale = d.daysSinceVisit == null || d.daysSinceVisit > 14;
             var here = open && open.DoctorId === d.id;
        %>
          <div class="mr-card dc <%= d.visitedTodayByMe ? 'done' : '' %> <%= here ? 'here' : '' %>"
               data-id="<%= d.id %>"
               data-days="<%= d.days.join('|') %>"
               data-areas="<%= d.areas.join('|').toLowerCase() %>"
               data-text="<%= (d.first + ' ' + d.last + ' ' + d.spec + ' ' + d.degrees + ' ' + d.areas.join(' ') + ' ' + (d.assignedName || '')).toLowerCase() %>"
               data-name="<%= (d.first + ' ' + d.last).toLowerCase() %>"
               data-since="<%= d.daysSinceVisit == null ? 9999 : d.daysSinceVisit %>"
               data-month="<%= d.monthVisits %>" data-biz="<%= d.refBilled %>" data-pts="<%= d.refPatients %>"
               data-visited="<%= d.visitedTodayByMe ? 1 : 0 %>" data-follow="<%= d.followUpDue ? 1 : 0 %>" data-pin="<%= d.hasLocation ? 1 : 0 %>"
               data-slots="<%= JSON.stringify(d.slots) %>">
            <div class="dc-head">
              <div class="dc-av" aria-hidden="true"><%= d.visitedTodayByMe ? '✓' : initials(d.first, d.last) %></div>
              <div class="flex-grow-1" style="min-width:0">
                <div class="dc-name"><%= nm %></div>
                <div class="dc-spec"><%= [d.degrees, d.spec].filter(Boolean).join(' · ') %></div>
                <div class="dc-slot"><i class="bi bi-calendar2-week"></i><span data-slot></span></div>
              </div>
            </div>
            <div class="dc-tags">
              <% if (d.followUpDue) { %><span class="tg bad"><i class="bi bi-bell"></i> Follow-up due · <%= d.followUp %></span><% } else if (d.followUp) { %><span class="tg info">Next visit <%= d.followUp %></span><% } %>
              <% if (d.visitedTodayByMe) { %><span class="tg ok">Visited today</span>
              <% } else if (d.lastVisit) { %><span class="tg <%= stale ? 'bad' : '' %>">Last <%= d.lastVisit %><%= d.daysSinceVisit ? ' · ' + d.daysSinceVisit + 'd ago' : '' %></span>
              <% } else { %><span class="tg bad">Never visited</span><% } %>
              <span class="tg pri"><%= d.monthVisits %> this month</span>
              <% if (d.refPatients) { %><span class="tg ok" title="Patients referred in the last 30 days"><i class="bi bi-person-plus"></i> <%= d.refPatients %> pts · ₹<%= d.refBilled.toLocaleString('en-IN') %></span>
              <% } else { %><span class="tg warn">0 patients · 30d</span><% } %>
              <% if (!d.hasLocation) { %><span class="tg info" title="The first punch-in with GPS saves the clinic location"><i class="bi bi-pin-map"></i> <%= d.locationPending ? 'Pin awaiting approval' : 'No clinic pin' %></span><% } %>
              <% if (showMr) { %><span class="tg <%= d.assignedName ? '' : 'warn' %>"><i class="bi bi-person"></i> <%= d.assignedName ? cap(d.assignedName) : 'Not assigned' %></span><% } %>
            </div>
            <div class="dc-act">
              <% if (here) { %>
                <button type="button" class="mr-btn b-bad grow" data-bs-toggle="modal" data-bs-target="#mrOut"><i class="bi bi-box-arrow-right"></i> Punch out</button>
              <% } else if (!open) { %>
                <button type="button" class="mr-btn b-pri grow" data-act="punch-in" data-doctor="<%= d.id %>" data-name="<%= nm %>"><i class="bi <%= needPhoto ? 'bi-camera-fill' : 'bi-geo-alt-fill' %>"></i> Punch in</button>
              <% } %>
              <button type="button" class="mr-btn b-ghost <%= (here || !open) ? '' : 'grow' %>" data-act="history" data-doctor="<%= d.id %>" data-name="<%= nm %>" title="Visit history"><i class="bi bi-clock-history"></i><span class="<%= (here || !open) ? 'd-none d-sm-inline' : '' %>">History</span></button>
              <a class="mr-btn b-ghost" target="_blank" rel="noopener" title="Directions" aria-label="Directions to <%= nm %>"
                 href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(nm + ' ' + (d.areas[0] || '') + ' Patna') %>"><i class="bi bi-sign-turn-right"></i></a>
            </div>
          </div>
        <% }) %>
        <div class="mr-card mr-empty d-none" id="mrNoMatch">
          <i class="bi bi-funnel fs-2 d-block mb-2"></i><span id="mrNoMatchTxt">No doctor matches.</span>
          <div class="mt-2 d-flex gap-2 justify-content-center flex-wrap">
            <button type="button" class="mr-btn b-ghost" style="height:38px" id="mrNoMatchAll">Show all days</button>
            <button type="button" class="mr-btn b-ghost" style="height:38px" id="mrNoMatchClr">Clear filters</button>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<!-- fallback only: phone/browser without live camera support -->
<input type="file" id="mrCam" accept="image/*" capture="environment" class="d-none">

<!-- Live camera (laptop webcam or phone camera) -->
<div class="modal fade mr-sheet mr-cam" id="mrCamSheet" tabindex="-1" aria-labelledby="mrCamTitle" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
    <div class="modal-content">
      <div class="cam-top">
        <div style="min-width:0"><div class="n text-truncate" id="mrCamTitle">Photo at clinic</div><div class="s" id="mrCamSub">Live photo · time-stamped</div></div>
        <button type="button" class="btn-close btn-close-white" data-cam="cancel" aria-label="Cancel"></button>
      </div>
      <div class="cam-view">
        <video id="mrVideo" autoplay playsinline muted></video>
        <img id="mrShot" class="d-none" alt="Captured photo">
        <div class="cam-msg" id="mrCamMsg"><div class="spinner-border spinner-border-sm mb-2"></div><div>Starting camera…</div></div>
      </div>
      <div class="cam-bar">
        <div class="side">
          <button type="button" class="cam-ghost d-none" data-cam="switch" title="Switch camera"><i class="bi bi-arrow-repeat"></i><span class="d-none d-sm-inline">Switch</span></button>
          <button type="button" class="cam-ghost d-none" data-cam="retake"><i class="bi bi-arrow-counterclockwise"></i> Retake</button>
        </div>
        <button type="button" class="cam-shot" data-cam="shoot" aria-label="Take photo" disabled></button>
        <button type="button" class="cam-use d-none" data-cam="use"><i class="bi bi-check-lg"></i> Use photo</button>
        <div class="side r">
          <button type="button" class="cam-ghost d-none" data-cam="upload"><i class="bi bi-upload"></i> Upload</button>
          <button type="button" class="cam-ghost d-none" data-cam="skip">Skip photo</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Punch-out sheet -->
<% if (open) { %>
<div class="modal fade mr-sheet" id="mrOut" tabindex="-1" aria-labelledby="mrOutTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content"><div class="modal-body p-4">
      <div class="d-flex justify-content-between align-items-start mb-3">
        <div><h5 class="fw-bold mb-0" id="mrOutTitle" style="font-size:1.05rem">Punch out — how did it go?</h5>
             <div class="mr-sub text-capitalize">Dr. <%= open.DoctorName %> · since <%= fmtTime(open.CheckInAt) %></div></div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="mrOutForm" novalidate>
        <input type="hidden" name="visitId" value="<%= open.Id %>">
        <div class="oc mb-3">
          <% Object.keys(outcomeLabel).forEach(function (k, i) { %>
            <input type="radio" name="outcome" id="oc<%= i %>" value="<%= k %>"><label for="oc<%= i %>"><%= outcomeLabel[k] %></label>
          <% }) %>
        </div>
        <label class="form-label small fw-semibold" for="mrNotes">Notes</label>
        <textarea class="form-control mb-3" id="mrNotes" name="notes" rows="3" maxlength="2000" placeholder="What was discussed, tests promised, feedback…"></textarea>
        <label class="form-label small fw-semibold" for="mrNext">Next visit (optional)</label>
        <div class="d-flex gap-2 mb-2 flex-wrap" id="mrNextQuick">
          <button type="button" class="btn btn-sm btn-light border rounded-pill" data-next="1">Tomorrow</button>
          <button type="button" class="btn btn-sm btn-light border rounded-pill" data-next="7">In a week</button>
          <button type="button" class="btn btn-sm btn-light border rounded-pill" data-next="14">In 2 weeks</button>
        </div>
        <input type="date" class="form-control mb-3" id="mrNext" name="nextVisitOn">
        <div class="text-danger small mb-2 d-none" id="mrOutErr"></div>
        <button type="submit" class="mr-btn b-bad w-100"><i class="bi bi-box-arrow-right"></i> Save & punch out</button>
      </form>
    </div></div>
  </div>
</div>
<% } %>

<!-- History -->
<div class="modal fade mr-sheet" id="mrHist" tabindex="-1" aria-labelledby="mrHistTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content"><div class="modal-body p-4">
      <div class="d-flex justify-content-between align-items-start mb-2">
        <h5 class="fw-bold mb-0" id="mrHistTitle" style="font-size:1.05rem">Visit history</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div id="mrHistBody" class="small"></div>
