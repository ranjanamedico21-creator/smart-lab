<div class="mr-busy" id="mrBusy"><img id="mrBusyImg" class="d-none" alt=""><div class="spinner-border text-primary"></div><div id="mrBusyTxt">Please wait…</div></div>

<%- include("../partials/uiNotify") %>

<script>
(function () {
  'use strict';
  var PHOTO_MODE = '<%= photoMode %>';   // required | optional | off (admin sets it per officer on the Team page)
  var TODAY = '<%= todayN %>';
  var DAYS = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
  var $ = function (id) { return document.getElementById(id); };
  var toast = function (t, m) { if (window.ui) ui.toast(t, null, m); else alert(m); };
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); };
  var busy = function (on, txt, img) {
    $('mrBusy').classList.toggle('on', !!on);
    if (txt) $('mrBusyTxt').textContent = txt;
    var i = $('mrBusyImg'); if (img) { i.src = img; i.classList.remove('d-none'); } else if (!on) i.classList.add('d-none');
  };
  var secure = window.isSecureContext || location.hostname === 'localhost';
  if (!secure) $('mrInsecure').classList.remove('d-none');

  /* ───────────── Filters (instant, no reload) ───────────── */
  var cards = [].slice.call(document.querySelectorAll('#mrList .dc'));
  var params = new URLSearchParams(location.search);
  var state = {
    day:  '<%= selDay %>' || TODAY,
    q:    params.get('q') || '',
    area: params.get('area') || '',
    sort: params.get('sort') || 'due',
    quick: (params.get('f') || '').split(',').filter(Boolean)
  };
  $('mrFilter').value = state.q; $('mrArea').value = state.area; $('mrSort').value = state.sort;
  if ($('mrArea').value !== state.area) state.area = '';
  cards.forEach(function (c) { try { c._slots = JSON.parse(c.dataset.slots || '[]'); } catch (e) { c._slots = []; } });

  var short = function (d) { return d === 'AllDay' ? 'Every day' : d.slice(0, 3); };
  function slotText(c) {
    var sl = c._slots;
    if (state.day === 'all') {
      if (sl.some(function (s) { return s.day === 'AllDay'; })) return 'Every day' + (sl[0] && sl[0].area ? ' · ' + sl[0].area : '');
      var groups = {};
      sl.forEach(function (s) { var k = (s.area || '') + '|' + (s.time || ''); (groups[k] = groups[k] || []).push(s.day); });
      return Object.keys(groups).map(function (k) {
        var p = k.split('|'), ds = groups[k].sort(function (a, b) { return DAYS.indexOf(a) - DAYS.indexOf(b); }).map(short).join(', ');
        return ds + (p[0] ? ' · ' + p[0] : '') + (p[1] ? ' · ' + p[1] : '');
      }).join('  |  ') || 'No visiting day set';
    }
    var hit = sl.filter(function (s) { return s.day === state.day || s.day === 'AllDay'; });
    if (!hit.length) return 'Not on ' + state.day;
    return (state.day === TODAY ? 'Today' : state.day) + hit.map(function (s) { return (s.area ? ' · ' + s.area : '') + (s.time ? ' · ' + s.time : ''); }).join(' / ');
  }

  function score(c) {   // who to visit first: follow-up due, not visited today, longest gap
    return (c.dataset.visited === '1' ? 0 : 1e6) + (c.dataset.follow === '1' ? 5e5 : 0) + Math.min(Number(c.dataset.since), 9999);
  }
  function apply(push) {
    var q = state.q.trim().toLowerCase(), shown = [], dayCount = 0, dayVisited = 0;
    cards.forEach(function (c) {
      var days = c.dataset.days ? c.dataset.days.split('|') : [];
      var onDay = state.day === 'all' || days.indexOf(state.day) !== -1;
      if (onDay) { dayCount++; if (c.dataset.visited === '1') dayVisited++; }
      var ok = onDay
        && (!q || c.dataset.text.indexOf(q) !== -1)
        && (!state.area || c.dataset.areas.split('|').indexOf(state.area) !== -1)
        && state.quick.every(function (f) {
          return f === 'follow' ? c.dataset.follow === '1'
               : f === 'stale' ? Number(c.dataset.since) > 14
               : f === 'pending' ? c.dataset.visited !== '1'
               : f === 'nopin' ? c.dataset.pin !== '1'
               : f === 'nobiz' ? Number(c.dataset.pts) === 0 : true;
        });
      c.classList.toggle('d-none', !ok);
      c.querySelector('[data-slot]').textContent = slotText(c);
      if (ok) shown.push(c);
    });
    var by = {
      due:    function (a, b) { return score(b) - score(a); },
      name:   function (a, b) { return a.dataset.name.localeCompare(b.dataset.name); },
      biz:    function (a, b) { return Number(b.dataset.biz) - Number(a.dataset.biz); },
      lowbiz: function (a, b) { return Number(a.dataset.biz) - Number(b.dataset.biz); },
      month:  function (a, b) { return Number(a.dataset.month) - Number(b.dataset.month); }
    }[state.sort] || function () { return 0; };
    var list = $('mrList'), noMatch = $('mrNoMatch');
    cards.slice().sort(by).forEach(function (c) { list.insertBefore(c, noMatch); });

    document.querySelectorAll('.mr-days [data-day]').forEach(function (b) { var on = b.dataset.day === state.day; b.classList.toggle('on', on); b.setAttribute('aria-pressed', on); });
    document.querySelectorAll('#mrQuick [data-q]').forEach(function (b) { b.classList.toggle('on', state.quick.indexOf(b.dataset.q) !== -1); });
    var filtered = q || state.area || state.quick.length;
    $('mrClear').classList.toggle('d-none', !filtered);
    $('mrPlanned').textContent = dayCount;
    $('mrPlannedLbl').textContent = state.day === 'all' ? 'Doctors' : (state.day === TODAY ? 'Planned today' : 'On ' + state.day.slice(0, 3));
    $('mrProgTxt').textContent = state.day === TODAY ? dayVisited + ' of ' + dayCount + ' planned doctors visited'
                               : state.day === 'all' ? dayVisited + ' of ' + dayCount + ' doctors visited today'
                               : state.day + ' list · ' + dayVisited + ' of ' + dayCount + ' visited today';
    $('mrProgBar').style.width = (dayCount ? Math.round(dayVisited * 100 / dayCount) : 0) + '%';
    $('mrCount').textContent = cards.length ? 'Showing ' + shown.length + ' of ' + dayCount + (state.day === 'all' ? ' doctors' : ' doctors on ' + (state.day === TODAY ? 'today' : state.day)) : '';
    if (cards.length) {
      noMatch.classList.toggle('d-none', shown.length > 0);
      $('mrNoMatchTxt').textContent = !dayCount ? 'No doctor visits on ' + state.day + '.' : 'No doctor matches these filters.';
      $('mrNoMatchAll').classList.toggle('d-none', state.day === 'all');
      $('mrNoMatchClr').classList.toggle('d-none', !filtered);
    }
    if (push !== false && window.history && history.replaceState) {
      var p = new URLSearchParams(location.search);
      p.set('day', state.day);
      ['q', 'area'].forEach(function (k) { if (state[k]) p.set(k, state[k]); else p.delete(k); });
      if (state.sort !== 'due') p.set('sort', state.sort); else p.delete('sort');
      if (state.quick.length) p.set('f', state.quick.join(',')); else p.delete('f');
      history.replaceState(null, '', location.pathname + '?' + p.toString());
    }
  }
  document.querySelector('.mr-days').addEventListener('click', function (e) { var b = e.target.closest('[data-day]'); if (b) { state.day = b.dataset.day; apply(); } });
  $('mrQuick').addEventListener('click', function (e) {
    var b = e.target.closest('[data-q]');
    if (b) { var i = state.quick.indexOf(b.dataset.q); if (i === -1) state.quick.push(b.dataset.q); else state.quick.splice(i, 1); apply(); }
  });
  var clearAll = function () { state.q = ''; state.area = ''; state.quick = []; $('mrFilter').value = ''; $('mrArea').value = ''; apply(); };
  $('mrClear').addEventListener('click', clearAll);
  $('mrNoMatchClr').addEventListener('click', clearAll);
  $('mrNoMatchAll').addEventListener('click', function () { state.day = 'all'; apply(); });
  var t; $('mrFilter').addEventListener('input', function () { clearTimeout(t); var v = this.value; t = setTimeout(function () { state.q = v; apply(); }, 120); });
  $('mrArea').addEventListener('change', function () { state.area = this.value; apply(); });
  $('mrSort').addEventListener('change', function () { state.sort = this.value; apply(); });
  var sc = $('mrScope');
  if (sc) sc.addEventListener('change', function () { var p = new URLSearchParams(location.search); p.set('scope', sc.value); location.search = p.toString(); });
  apply(false);

  /* ───────────── GPS: several readings (fake-GPS apps return identical points) ───────────── */
  function locate(want, maxMs, onProgress) {
    want = want || 3; maxMs = maxMs || 9000;
    return new Promise(function (resolve, reject) {
      if (!navigator.geolocation) return reject(new Error('This phone/browser cannot share location.'));
      var samples = [], done = false, started = Date.now(), lastErr = null;
      var finish = function () {
        if (done) return; done = true; clearTimeout(guard);
        if (samples.length) resolve(samples);
        else reject(lastErr || new Error('No location yet. If the browser asked "Allow location?", tap Allow and try again.'));
      };
      // the browser's own timeout does not run while the "Allow location?" prompt is open
      var guard = setTimeout(finish, Math.max(maxMs, 20000));
      var ask = function () {
        if (done) return;
        navigator.geolocation.getCurrentPosition(function (p) {
          if (done) return;
          samples.push({ lat: p.coords.latitude, lng: p.coords.longitude, acc: Math.round(p.coords.accuracy) });
          if (onProgress) onProgress(samples.length, want);
          if (samples.length >= want || Date.now() - started > maxMs) return finish();
          setTimeout(ask, 1200);
        }, function (e) {
          lastErr = new Error(e.code === 1 ? 'Location permission is blocked. Allow location for this site in your browser settings, then try again.'
                            : e.code === 3 ? 'Could not get your location in time. Move to an open area and try again.'
                            : 'Could not get your location. Turn on GPS / Wi-Fi and try again.');
          if (e.code === 1 || samples.length || Date.now() - started > maxMs) return finish();
          setTimeout(ask, 1200);
        }, { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 });
      };
      ask();
    });
  }

  /* ───────────── Live camera: laptop webcam or phone camera, in the page ───────────── */
  var CANCEL = 'No photo taken.';
  var camEl = $('mrCamSheet'), video = $('mrVideo'), shotImg = $('mrShot');
  var cam = { stream: null, facing: 'environment', mirror: false, photo: null, resolve: null, reject: null, name: '' };
  var camBtn = function (k) { return camEl.querySelector('[data-cam="' + k + '"]'); };
  var show = function (k, on) { camBtn(k).classList.toggle('d-none', !on); };
  var hasLiveCamera = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia) && secure;

  function stopCam() { if (cam.stream) { cam.stream.getTracks().forEach(function (tr) { tr.stop(); }); cam.stream = null; } video.srcObject = null; }
  function camState(st, msg) {
    var msgEl = $('mrCamMsg');
    msgEl.classList.toggle('d-none', st === 'live' || st === 'shot');
    if (st === 'loading') msgEl.innerHTML = '<div class="spinner-border spinner-border-sm mb-2"></div><div>Starting camera…</div>';
    if (st === 'error')   msgEl.innerHTML = '<i class="bi bi-camera-video-off"></i><div>' + esc(msg) + '</div>';
    video.classList.toggle('d-none', st !== 'live');
    shotImg.classList.toggle('d-none', st !== 'shot');
    camBtn('shoot').classList.toggle('d-none', st === 'shot');
    camBtn('shoot').disabled = st !== 'live';
    show('use', st === 'shot'); show('retake', st === 'shot');
    show('switch', st === 'live' && cam.many);
    show('upload', st === 'error');
    show('skip', PHOTO_MODE === 'optional' && st !== 'shot');
  }
  function startCam() {
    stopCam(); camState('loading');
    if (!hasLiveCamera) return camState('error', secure ? 'This browser cannot open the camera. Upload a photo instead (the visit will be marked for review).' : 'Camera needs a secure (https://) address.');
    navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: cam.facing }, width: { ideal: 1280 }, height: { ideal: 960 } }, audio: false })
      .then(function (s) {
        if (!camEl.classList.contains('show')) { s.getTracks().forEach(function (tr) { tr.stop(); }); return; }   // sheet closed meanwhile
        cam.stream = s; video.srcObject = s;
        var st = (s.getVideoTracks()[0].getSettings && s.getVideoTracks()[0].getSettings()) || {};
        // laptop webcams and phone front cameras face the user → show as a mirror (the saved photo is not mirrored)
        cam.mirror = st.facingMode ? st.facingMode === 'user' : !/Android|iPhone|iPad|Mobile/i.test(navigator.userAgent);
        video.classList.toggle('mirror', cam.mirror);
        var go = function () { camState('live'); };
        if (video.readyState >= 2) go(); else video.onloadeddata = go;
        video.play().catch(function () {});
        return navigator.mediaDevices.enumerateDevices().then(function (ds) {
          cam.many = ds.filter(function (d) { return d.kind === 'videoinput'; }).length > 1; show('switch', cam.many && !video.classList.contains('d-none'));
        }).catch(function () {});
      })
      .catch(function (e) {
        var n = e && e.name;
        camState('error', n === 'NotAllowedError' || n === 'SecurityError' ? 'Camera permission is blocked. Allow the camera for this site (lock icon in the address bar), then tap Retry — or upload a photo (marked for review).'
                         : n === 'NotFoundError' || n === 'OverconstrainedError' ? 'No camera found on this device. Upload a photo instead (marked for review).'
                         : n === 'NotReadableError' ? 'The camera is busy in another app (Zoom, WhatsApp…). Close it and tap Retry.'
                         : 'Could not start the camera. Tap Retry or upload a photo.');
        show('retake', true); camBtn('retake').innerHTML = '<i class="bi bi-arrow-repeat"></i> Retry'; camBtn('retake').dataset.retry = '1';
      });
  }
  function stamp(canvas) {
    var g = canvas.getContext('2d'), w = canvas.width, fs = Math.max(14, Math.round(w / 34));
    var lines = [cam.name, new Date().toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true })];
    g.font = '600 ' + fs + 'px sans-serif';
    var bw = Math.max.apply(null, lines.map(function (l) { return g.measureText(l).width; })) + fs * 1.2, bh = fs * 2.9;
    g.fillStyle = 'rgba(0,0,0,.55)'; g.fillRect(w - bw - fs * .6, canvas.height - bh - fs * .6, bw, bh);
    g.fillStyle = '#fff'; g.textBaseline = 'top';
    lines.forEach(function (l, i) { g.fillText(l, w - bw - fs * .6 + fs * .6, canvas.height - bh - fs * .6 + fs * .45 + i * fs * 1.25); });
  }
  function toJpeg(src, sw, sh) {
    var s = Math.min(1, 1280 / Math.max(sw, sh));
    var c = document.createElement('canvas'); c.width = Math.round(sw * s); c.height = Math.round(sh * s);
    c.getContext('2d').drawImage(src, 0, 0, c.width, c.height);
    stamp(c);
    return c.toDataURL('image/jpeg', 0.75);
  }
  function finishCam(result, err) {
    var res = cam.resolve, rej = cam.reject; cam.resolve = cam.reject = null;
    stopCam();
    if (window.bootstrap) bootstrap.Modal.getOrCreateInstance(camEl).hide();
    if (err) { if (rej) rej(err); } else if (res) res(result);
  }
  camEl.addEventListener('shown.bs.modal', startCam);
  camEl.addEventListener('hidden.bs.modal', function () { stopCam(); if (cam.reject) { var r = cam.reject; cam.resolve = cam.reject = null; r(new Error(CANCEL)); } });
  camEl.addEventListener('click', function (e) {
    var b = e.target.closest('[data-cam]'); if (!b) return;
    var k = b.dataset.cam;
    if (k === 'cancel') return finishCam(null, new Error(CANCEL));
    if (k === 'skip')   return finishCam(null);
    if (k === 'switch') { cam.facing = cam.facing === 'environment' ? 'user' : 'environment'; return startCam(); }
    if (k === 'shoot') {
      if (!video.videoWidth) return;
      cam.photo = { data: toJpeg(video, video.videoWidth, video.videoHeight), ageSec: 0, source: 'live' };
      shotImg.src = cam.photo.data; stopCam(); return camState('shot');
    }
    if (k === 'retake') { cam.photo = null; delete b.dataset.retry; b.innerHTML = '<i class="bi bi-arrow-counterclockwise"></i> Retake'; return startCam(); }
    if (k === 'use')    return finishCam(cam.photo);
    if (k === 'upload') return pickFile().then(function (p) { cam.photo = p; shotImg.src = p.data; camState('shot'); }, function (er) { if (er.message !== CANCEL) toast('danger', er.message); });
  });
  /* last resort: a file / gallery photo (server marks the visit "photo uploaded") */
  function pickFile() {
    return new Promise(function (resolve, reject) {
      var inp = $('mrCam'); inp.value = '';
      var onChange = function () {
        inp.removeEventListener('change', onChange);
        var f = inp.files && inp.files[0];
        if (!f) return reject(new Error(CANCEL));
        if (!/^image\//.test(f.type)) return reject(new Error('Please choose a photo.'));
        var age = f.lastModified ? Math.round((Date.now() - f.lastModified) / 1000) : 0;
        var img = new Image(), url = URL.createObjectURL(f);
        img.onload = function () { URL.revokeObjectURL(url); resolve({ data: toJpeg(img, img.width, img.height), ageSec: Math.max(0, age), source: 'file' }); };
        img.onerror = function () { URL.revokeObjectURL(url); reject(new Error('The photo could not be read. Please try again.')); };
        img.src = url;
      };
      inp.addEventListener('change', onChange);
      inp.click();
    });
  }
  /** Resolves with { data, ageSec, source } — or null when the officer taps "Skip photo" (optional mode). */
  function takePhoto(name) {
    return new Promise(function (resolve, reject) {
      cam.resolve = resolve; cam.reject = reject; cam.photo = null; cam.name = name || '';
      $('mrCamTitle').textContent = name ? 'Photo at ' + name : 'Photo at clinic';
      $('mrCamSub').textContent = PHOTO_MODE === 'optional' ? 'Optional · makes your visit easy to verify' : 'Required to punch in · time-stamped';
      camState('loading');
      if (!window.bootstrap) return pickFile().then(resolve, reject);
      bootstrap.Modal.getOrCreateInstance(camEl).show();
    });
  }

  function post(url, data) {
    return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(data) })
      .then(function (r) {
        var ct = r.headers.get('content-type') || '';
        if (ct.indexOf('json') === -1) throw new Error(r.status === 413 ? 'The photo is too large. Please try again.' : r.status === 401 || r.redirected ? 'Your session has expired. Please log in again.' : 'Server error. Please try again.');
        return r.json();
      })
      .then(function (d) { if (!d.success) throw new Error(d.message || 'Failed.'); return d; });
  }

  /* Punch in: photo → GPS readings → server */
  function punchIn(btn) {
    btn.disabled = true;
    var photo = null;
    var start = PHOTO_MODE === 'off' ? Promise.resolve() : takePhoto(btn.dataset.name).then(function (p) { photo = p; });
    start
      .then(function () {
        busy(true, 'Getting your location…', photo && photo.data);
        return locate(3, 9000, function (n, w) { busy(true, 'Getting your location… ' + n + '/' + w, photo && photo.data); });
      })
      .then(function (samples) {
        busy(true, 'Punching in at ' + btn.dataset.name + '…', photo && photo.data);
        return post('/schedule/api/punch-in', { doctorId: btn.dataset.doctor, samples: samples, photo: photo && photo.data, photoAgeSec: photo && photo.ageSec, photoSource: photo && photo.source });
      })
      .then(function (d) { busy(false); toast(d.status === 'far' || (d.flags && d.flags.length) ? 'warning' : 'success', d.message); setTimeout(function () { location.reload(); }, 1500); })
      .catch(function (e) { busy(false); btn.disabled = false; if (e.message !== CANCEL) toast('danger', e.message); });
  }

  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-act]'); if (!b) return;
    if (b.dataset.act === 'punch-in') punchIn(b);
    if (b.dataset.act === 'history')  openHistory(b.dataset.doctor, b.dataset.name);
  });

  /* Punch out */
  var ymd = function (d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); };
  var of = $('mrOutForm');
  if (of) of.addEventListener('submit', function (e) {
    e.preventDefault();
    var f = new FormData(of), err = $('mrOutErr');
    var data = { visitId: f.get('visitId'), outcome: f.get('outcome'), notes: (f.get('notes') || '').trim(), nextVisitOn: f.get('nextVisitOn') };
    var msg = !data.outcome ? 'Choose how the visit went.' : data.notes.length < 3 ? 'Write a short note.' : '';
    if (msg) { err.textContent = msg; err.classList.remove('d-none'); return; }
    err.classList.add('d-none');
    var btn = of.querySelector('button[type=submit]'); btn.disabled = true;
    busy(true, 'Getting your location…');
    locate(2, 5000).catch(function () { return []; })        // punch-out still saves without GPS (it is flagged)
      .then(function (samples) { busy(true, 'Punching out…'); data.samples = samples; return post('/schedule/api/punch-out', data); })
      .then(function (d) { busy(false); toast('success', d.message); setTimeout(function () { location.reload(); }, 1000); })
      .catch(function (e2) { busy(false); btn.disabled = false; err.textContent = e2.message; err.classList.remove('d-none'); });
  });
  var next = $('mrNext');
  if (next) {
    next.min = ymd(new Date());
    $('mrNextQuick').addEventListener('click', function (e) {
      var b = e.target.closest('[data-next]'); if (!b) return;
      var d = new Date(); d.setDate(d.getDate() + Number(b.dataset.next)); next.value = ymd(d);
    });
  }

  /* History */
  var ST = { verified: ['✓ At clinic', 'ok'], far: ['Far', 'bad'], new_location: ['New pin', 'info'], weak_gps: ['Weak GPS', 'warn'], no_gps: ['No GPS', ''] };
  var RV = { approved: ['Verified', 'ok'], rejected: ['Rejected', 'bad'], pending: ['Awaiting review', ''] };
  var OC = { met: 'Met doctor', not_available: 'Not available', left_material: 'Left material', follow_up: 'Follow-up', other: 'Other' };
  function openHistory(id, name) {
    $('mrHistTitle').textContent = name;
    $('mrHistBody').innerHTML = '<div class="text-center py-4"><div class="spinner-border spinner-border-sm"></div></div>';
    if (window.bootstrap) bootstrap.Modal.getOrCreateInstance($('mrHist')).show();
    fetch('/schedule/api/doctor-visits/' + encodeURIComponent(id), { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.success) throw new Error(d.message);
        if (!d.visits.length) { $('mrHistBody').innerHTML = '<div class="mr-empty">No visits yet.</div>'; return; }
        $('mrHistBody').innerHTML = d.visits.map(function (v) {
          var st = ST[v.LocationStatus] || ['—', ''], rv = RV[v.ReviewStatus] || RV.pending;
          return '<div class="hist-row"><div class="d-flex justify-content-between gap-2 flex-wrap"><b>' + esc(v.VisitedAt) + '</b>' +
                 '<span><span class="tg ' + st[1] + '">' + st[0] + '</span> <span class="tg ' + rv[1] + '">' + rv[0] + '</span></span></div>' +
                 '<div class="text-secondary text-capitalize">' + esc(v.ByName || '') + (v.Minutes != null ? ' · ' + v.Minutes + ' min' : '') + (v.Outcome ? ' · ' + esc(OC[v.Outcome] || v.Outcome) : '') + '</div>' +
                 (v.Notes ? '<div class="mt-1" style="white-space:pre-wrap">' + esc(v.Notes) + '</div>' : '') +
                 (v.NextVisitOn ? '<div class="mt-1 text-primary">Next visit: ' + esc(v.NextVisitOn) + '</div>' : '') + '</div>';
        }).join('');
      })
      .catch(function (e) { $('mrHistBody').innerHTML = '<div class="text-danger">' + esc(e.message || 'Could not load history.') + '</div>'; });
  }

  $('mrManForm').addEventListener('submit', function (e) {
    if (!this.checkValidity()) { e.preventDefault(); this.classList.add('was-validated'); return; }
    this.querySelector('button[type=submit]').disabled = true;
  });
})();
</script>
