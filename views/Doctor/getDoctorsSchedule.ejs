          <option value="">Choose doctor</option>
          <% docs.forEach(function (d) { %><option value="<%= d.id %>">Dr. <%= cap(d.first + ' ' + d.last) %></option><% }) %>
        </select>
        <textarea name="notes" class="form-control mb-3" rows="3" minlength="3" maxlength="2000" required placeholder="Visit notes"></textarea>
        <button type="submit" class="mr-btn b-pri w-100">Save visit</button>
