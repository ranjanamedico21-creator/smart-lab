<!-- views/Admin/Leave/leaveReview.ejs -->
<%- include('../../partials/leaveAssets') %>
<%
  const pendingCount = requests.filter(r => r.Status === 'Pending').length;
  const clashCount = requests.filter(r => r.clashes.length).length;
  const currentMonth = moment(monthLabel, 'MMMM YYYY').format('YYYY-MM');
%>
<style>
  /* Timeline */
  .lv-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .lv-grid { border-collapse: separate; border-spacing: 0; font-size: .78rem; width: 100%; }
  .lv-grid th, .lv-grid td {
    border-right: 1px solid #edf0f2; border-bottom: 1px solid #edf0f2;
    text-align: center; padding: 0; min-width: 28px; height: 34px; vertical-align: middle;
  }
  .lv-grid thead th { background: #f8f9fa; font-weight: 600; padding: 4px 0; line-height: 1.1; }
  .lv-grid .lv-name {
    position: sticky; left: 0; z-index: 2; background: #fff; text-align: left;
    padding: 0 .6rem; min-width: 150px; max-width: 150px; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis; font-weight: 500; box-shadow: 1px 0 0 #dee2e6;
  }
  .lv-grid thead .lv-name, .lv-grid tfoot .lv-name { background: #f8f9fa; }
  .lv-dow { font-weight: 400; color: #6c757d; font-size: .68rem; }
  .lv-sun { background: #f3f4f6 !important; }
  .lv-today { box-shadow: inset 0 -3px 0 #0d6efd; }
  .lv-clash-col { background: #fff1f1 !important; }
  .lv-count { display: inline-block; min-width: 16px; padding: 0 3px; margin-top: 2px;
              border-radius: 8px; background: #dc3545; color: #fff; font-size: .65rem; }
  .lv-bar { display: block; height: 20px; cursor: pointer; }
  .lv-start { margin-left: 3px; border-top-left-radius: 5px; border-bottom-left-radius: 5px; }
  .lv-end   { margin-right: 3px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; }
  .lv-Approved { background: #198754; }
  .lv-Pending  { background: #ffc107; }
  .lv-SentBack { background: repeating-linear-gradient(45deg, #adb5bd 0 4px, #e9ecef 4px 8px); }
  .lv-clash    { box-shadow: inset 0 0 0 2px #dc3545; }
  .lv-highlight .lv-name { background: #e7f1ff !important; }
  .lv-legend .lv-bar { width: 20px; height: 12px; display: inline-block; border-radius: 3px; vertical-align: -1px; cursor: default; }
  .lv-off-hi { color: #dc3545; font-weight: 700; }
  .lv-info { white-space: pre-line; }

  /* Request cards */
  .lv-req { border-left: 4px solid #ffc107 !important; }
  .lv-req.has-clash { border-left-color: #dc3545 !important; }
  .lv-req .ts-wrapper { min-width: 0; }
  .lv-month { max-width: 150px; text-align: center; font-weight: 600; }

  @media (max-width: 575.98px) {
    .lv-grid .lv-name { min-width: 96px; max-width: 96px; padding: 0 .4rem; font-size: .72rem; }
    .lv-grid th, .lv-grid td { min-width: 30px; }
    .lv-month { max-width: none; flex: 1; }
  }
</style>

<div class="container-fluid py-3 px-2 px-sm-3">

  <!-- ── Header ─────────────────────────────────────────── -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h4 class="mb-0">Leave Review</h4>
    <div class="d-flex flex-wrap gap-2">
      <span class="badge bg-warning text-dark fs-6 fw-normal"><%= pendingCount %> pending</span>
      <span class="badge <%= clashCount ? 'bg-danger' : 'bg-success' %> fs-6 fw-normal"><%= clashCount %> with overlap</span>
    </div>
  </div>

  <!-- ── Requests (cards: 1 per row on phones, 2 on large, 3 on xxl) ── -->
  <h6 class="text-muted text-uppercase small fw-semibold mb-2">Waiting for a decision</h6>
  <% if (!requests.length) { %>
    <div class="card card-body text-muted mb-4"><span><i class="bi bi-check2-all me-1"></i> No pending leave requests.</span></div>
  <% } else { %>
  <div class="row row-cols-1 row-cols-lg-2 row-cols-xxl-3 g-3 mb-4">
    <% requests.forEach(r => { %>
      <div class="col">
        <div class="card h-100 shadow-sm lv-req <%= r.clashes.length ? 'has-clash' : '' %>">
          <div class="card-body p-3 d-flex flex-column">

            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
              <div class="min-w-0">
                <div class="fw-semibold text-truncate"><%= r.UserName %></div>
                <div class="small text-muted"><%= r.LeaveType || 'Leave' %> · <%= r.days %> day<%= r.days > 1 ? 's' : '' %></div>
              </div>
              <% if (r.Status === 'SentBack') { %>
                <span class="badge bg-secondary flex-shrink-0">Sent back</span>
              <% } else { %>
                <span class="badge bg-warning text-dark flex-shrink-0">Pending</span>
              <% } %>
            </div>

            <div class="small mb-2">
              <i class="bi bi-calendar3 me-1"></i>
              <%= moment(r.StartDate).format('DD MMM') %> – <%= moment(r.EndDate).format('DD MMM YYYY') %>
              <a class="ms-1 text-nowrap" href="?month=<%= r.month %>#user-<%= r.UserId %>">see on timeline</a>
            </div>

            <% if (r.Reason) { %>
              <div class="small text-break mb-2"><span class="text-muted">Reason:</span> <%= r.Reason %></div>
            <% } %>
            <% if (r.AdminRemarks) { %>
              <div class="small text-danger mb-2"><i class="bi bi-arrow-return-left me-1"></i>Earlier remark: <%= r.AdminRemarks %></div>
            <% } %>

            <div class="small rounded p-2 mb-3 <%= r.clashes.length ? 'bg-danger-subtle' : 'bg-success-subtle' %>">
              <% if (r.clashes.length) { %>
                <div class="fw-semibold text-danger mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Also away</div>
                <% r.clashes.forEach(c => { %>
                  <div class="d-flex flex-wrap align-items-center gap-1">
                    <span class="badge <%= c.Status === 'Approved' ? 'bg-success' : 'bg-warning text-dark' %>"><%= c.Status %></span>
                    <span><%= c.UserName %></span>
                    <span class="text-muted"><%= moment(c.StartDate).format('DD MMM') %>–<%= moment(c.EndDate).format('DD MMM') %></span>
                  </div>
                <% }) %>
              <% } else { %>
                <span class="text-success"><i class="bi bi-check2-circle me-1"></i>No one else is away on these dates</span>
              <% } %>
            </div>

            <form action="/user/leaveAction" method="post" class="mt-auto">
              <input type="hidden" name="leaveId" value="<%= r.Id %>">
              <input type="hidden" name="returnTo" value="<%= reviewUrl %>">
              <input type="text" name="remarks" class="form-control form-control-sm mb-2"
                     placeholder="Remark (required to reject / send back)">
              <div class="d-grid d-sm-flex gap-2">
                <button name="status" value="Approved" class="btn btn-success btn-sm flex-sm-fill"
                  <% if (r.clashes.length) { %>
                    data-confirm="<%= r.clashes.map(c => c.UserName).join(', ') %> <%= r.clashes.length > 1 ? 'are' : 'is' %> also away on some of these dates. Approve anyway?"
                    data-confirm-title="Overlapping leave" data-confirm-ok="Approve anyway" data-confirm-variant="success"
                  <% } %>><i class="bi bi-check-lg me-1"></i>Approve</button>
                <button name="status" value="Rejected" class="btn btn-outline-danger btn-sm flex-sm-fill"
                  data-confirm="Reject <%= r.UserName %>'s leave?" data-confirm-title="Reject leave"
                  data-confirm-ok="Reject" data-confirm-variant="danger"><i class="bi bi-x-lg me-1"></i>Reject</button>
                <button name="status" value="SentBack" class="btn btn-outline-secondary btn-sm flex-sm-fill">
                  <i class="bi bi-arrow-return-left me-1"></i>Send back</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
  <% } %>

  <!-- ── Timeline ──────────────────────────────────────── -->
  <div class="card shadow-sm">
    <div class="card-header bg-white p-2 p-sm-3">
      <div class="row g-2 align-items-center">
        <!-- Month: arrows + Flatpickr month picker -->
        <div class="col-12 col-md-auto">
          <div class="d-flex align-items-center gap-1">
            <a class="btn btn-sm btn-outline-secondary" href="?month=<%= prevMonth %>" aria-label="Previous month"><i class="bi bi-chevron-left"></i></a>
            <input type="text" id="monthPicker" class="form-control form-control-sm lv-month" value="<%= currentMonth %>" aria-label="Month">
            <a class="btn btn-sm btn-outline-secondary" href="?month=<%= nextMonth %>" aria-label="Next month"><i class="bi bi-chevron-right"></i></a>
            <a class="btn btn-sm btn-link text-nowrap" href="?month=<%= thisMonth %>">This month</a>
          </div>
        </div>
        <!-- Staff filter: Tom Select -->
        <% if (timeline.length) { %>
        <div class="col-12 col-md">
          <select id="staffFilter" multiple placeholder="Show only these staff…">
            <% timeline.forEach(u => { %><option value="<%= u.userId %>"><%= u.name %></option><% }) %>
          </select>
        </div>
        <% } %>
        <div class="col-12 col-xl-auto">
          <div class="lv-legend small d-flex flex-wrap gap-3">
            <span><span class="lv-bar lv-Approved"></span> Approved</span>
            <span><span class="lv-bar lv-Pending"></span> Pending</span>
            <span><span class="lv-bar lv-SentBack"></span> Sent back</span>
            <span><span class="lv-bar lv-Pending lv-clash"></span> Overlap</span>
          </div>
        </div>
      </div>
    </div>

    <% if (clashDays) { %>
      <div class="alert alert-danger rounded-0 border-0 mb-0 py-2 small">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        <%= clashDays %> day<%= clashDays > 1 ? 's' : '' %> in <%= monthLabel %> with 2 or more staff away
        (peak <%= peakOff %> on one day). Tap a red-outlined bar to see who.
      </div>
    <% } %>

    <% if (!timeline.length) { %>
      <div class="card-body text-muted">No leaves in <%= monthLabel %>.</div>
    <% } else { %>
    <div class="lv-wrap" id="lvWrap">
      <table class="lv-grid">
        <thead>
          <tr>
            <th class="lv-name">Staff</th>
            <% days.forEach(d => { %>
              <th data-day="<%= d.key %>" class="<%= d.isSunday ? 'lv-sun' : '' %> <%= d.offCount > 1 ? 'lv-clash-col' : '' %> <%= d.isToday ? 'lv-today' : '' %>">
                <div><%= d.date %></div>
                <div class="lv-dow"><%= d.dow %></div>
                <% if (d.offCount > 1) { %><span class="lv-count"><%= d.offCount %></span><% } %>
              </th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% timeline.forEach(u => { %>
            <tr id="user-<%= u.userId %>" data-user="<%= u.userId %>">
              <td class="lv-name" title="<%= u.name %>"><%= u.name %></td>
              <% days.forEach((d, i) => { const c = u.cells[i]; %>
                <td class="<%= d.isSunday ? 'lv-sun' : '' %> <%= d.offCount > 1 ? 'lv-clash-col' : '' %>">
                  <% if (c) { %>
                    <span class="lv-bar lv-<%= c.status %> <%= c.start ? 'lv-start' : '' %> <%= c.end ? 'lv-end' : '' %> <%= c.clash ? 'lv-clash' : '' %>"
                          title="<%= c.title %>" data-info="<%= c.title %>"></span>
                  <% } %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <td class="lv-name small text-muted">Staff away</td>
            <% days.forEach(d => { %>
              <td class="small <%= d.isSunday ? 'lv-sun' : '' %> <%= d.offCount > 1 ? 'lv-clash-col lv-off-hi' : 'text-muted' %>"><%= d.offCount || '' %></td>
            <% }) %>
          </tr>
        </tfoot>
      </table>
    </div>
    <!-- Details of the tapped bar (hover tooltips don't work on phones) -->
    <div class="card-footer bg-white small lv-info" id="lvInfo">
      <span class="text-muted"><i class="bi bi-hand-index me-1"></i>Tap a bar for details<span class="d-md-none">, swipe sideways to see the whole month</span>.</span>
    </div>
    <% } %>
  </div>
</div>

<%- include('../../partials/confirmModal') %>

<script>
  (function () {
    // ── Month picker (Flatpickr monthSelect) ─────────────
    flatpickr('#monthPicker', {
      disableMobile: true,
      plugins: [new monthSelectPlugin({ shorthand: true, dateFormat: 'Y-m', altFormat: 'F Y' })],
      altInput: true,
      altInputClass: 'form-control form-control-sm lv-month',
      onChange: function (dates, str) {
        if (str && str !== '<%= currentMonth %>') {
          var url = new URL(window.location.href);
          url.searchParams.set('month', str);
          url.hash = '';
          window.location.href = url.toString();
        }
      }
    });

    // ── Staff filter (Tom Select, multi) ─────────────────
    var filterEl = document.getElementById('staffFilter');
    if (filterEl) {
      new TomSelect(filterEl, {
        plugins: ['remove_button'],
        maxOptions: null,
        onChange: function (values) {
          var keep = (values || []).map(String);
          document.querySelectorAll('tr[data-user]').forEach(function (row) {
            row.classList.toggle('d-none', keep.length > 0 && keep.indexOf(row.dataset.user) === -1);
          });
        }
      });
    }

    // ── Tap a bar → show details below the timeline ──────
    var info = document.getElementById('lvInfo');
    document.querySelectorAll('.lv-bar[data-info]').forEach(function (bar) {
      bar.addEventListener('click', function () {
        info.textContent = bar.dataset.info;
        info.classList.toggle('text-danger', bar.classList.contains('lv-clash'));
      });
    });

    // ── Scroll the timeline to today / the linked staff row ──
    var wrap = document.getElementById('lvWrap');
    if (wrap) {
      var today = wrap.querySelector('th.lv-today');
      if (today) wrap.scrollLeft = Math.max(0, today.offsetLeft - 160);
      if (location.hash) {
        var row = document.querySelector(location.hash);
        if (row) {
          row.classList.add('lv-highlight');
          var firstBar = row.querySelector('.lv-bar');
          if (firstBar) wrap.scrollLeft = Math.max(0, firstBar.parentElement.offsetLeft - 160);
        }
      }
    }
  })();
</script>
