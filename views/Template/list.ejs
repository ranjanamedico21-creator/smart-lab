<% const gIcon = { male:'♂', female:'♀', common:'⚥' }; %>

<% 
// Group templates by TestId
const grouped = {};
templates.forEach(t => {
    if (!grouped[t.TestId]) {
        grouped[t.TestId] = { testName: t.TestName, templates: [] };
    }
    grouped[t.TestId].templates.push(t);
});
%>

<style>
.tl-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.05);margin:20px auto;max-width:1200px}
.tl-header{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #e2e8f0;background:#f8f9fb}
.tl-title{font-size:15px;font-weight:600;color:#111;display:flex;align-items:center;gap:8px}
.tl-count{font-size:12px;padding:2px 8px;background:#E6F1FB;color:#0C447C;border-radius:99px;font-weight:600}
.tl-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 18px;background:#185FA5;color:#fff;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;transition:all .15s}
.tl-btn:hover{background:#0C447C;color:#fff}
.tl-table{width:100%;border-collapse:collapse}
.tl-table thead th{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#666;padding:12px 16px;border-bottom:2px solid #e2e8f0;text-align:left;background:#f8f9fb}
.tl-table tbody tr{border-bottom:1px solid #e2e8f0;transition:background .15s}
.tl-table tbody tr:hover{background:#f8fbff}
.tl-table tbody td{padding:14px 16px;font-size:13px;vertical-align:middle}
.ib{display:inline-flex;align-items:center;gap:4px;padding:5px 12px;border-radius:6px;font-size:11.5px;font-weight:600;text-decoration:none;border:1px solid;transition:all .15s;cursor:pointer}
.ib-blue{background:#E6F1FB;color:#0C447C;border-color:#B5D4F4}
.ib-blue:hover{background:#0C447C;color:#fff;border-color:#0C447C}
.ib-red{background:#FCEBEB;color:#791F1F;border-color:#F7C1C1}
.ib-red:hover{background:#791F1F;color:#fff;border-color:#791F1F}
.empty-state{text-align:center;padding:60px 20px;color:#888}
.empty-icon{font-size:48px;color:#d1d5db;margin-bottom:16px}
.empty-text{font-size:14px;color:#666;margin-bottom:20px}
.test-group-header{padding:12px 20px;background:#f8f9fb;border-bottom:1px solid #e2e8f0}
.test-group-title{font-size:13px;font-weight:600;color:#185FA5;display:flex;align-items:center;gap:8px}
.test-group-badge{font-size:11px;padding:2px 8px;background:#E6F1FB;color:#0C447C;border-radius:99px;font-weight:600}
</style>

<!-- Breadcrumb -->
<section class="py-3">
  <div class="container-xl">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
          <a href="/user/home" class="text-decoration-none">Home</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">My Templates</li>
      </ol>
    </nav>
  </div>
</section>

<div class="tl-card">
  <div class="tl-header">
    <div class="tl-title">
      <i class="bi bi-file-earmark-text"></i>
      My Report Templates
      <span class="tl-count"><%= templates.length %></span>
    </div>
    <a href="/template/new" class="tl-btn">
      <i class="bi bi-plus-lg"></i> New Template
    </a>
  </div>

  <%- include("../partials/messages") %>

  <% if(!templates.length){ %>
    <div class="empty-state">
      <div class="empty-icon">📋</div>
      <div class="empty-text">
        No templates created yet.<br>
        Click "New Template" to create your first report template.
      </div>
    </div>
  <% } else { %>
    
    <% Object.entries(grouped).forEach(([testId, group]) => { %>
      <div style="border-bottom:1px solid #e2e8f0">
        <!-- Test Header -->
        <div class="test-group-header">
          <div class="test-group-title">
            <i class="bi bi-folder2-open"></i>
            <%= group.testName %>
            <span class="test-group-badge">
              <%= group.templates.length %> template<%= group.templates.length > 1 ? 's' : '' %>
            </span>
          </div>
        </div>

        <!-- Templates for this test -->
        <div style="overflow-x:auto">
          <table class="tl-table">
            <thead>
              <tr>
                <th style="width:60px">#</th>
                <th>Template Name</th>
                <th style="width:120px;text-align:center">Gender</th>
                <th style="width:100px;text-align:center">Created</th>
                <th style="width:140px;text-align:center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% group.templates.forEach((t, i) => { %>
              <tr>
                <td style="color:#aaa;font-size:12px;font-weight:600">
                  <%= String(i+1).padStart(2,'0') %>
                </td>
                <td>
                  <div style="font-weight:600;color:#111;margin-bottom:2px">
                    <%= t.Name %>
                  </div>
                  <div style="font-size:11px;color:#888">
                    ID: <%= t.Id %>
                  </div>
                </td>
                <td style="text-align:center">
                  <div style="display:inline-flex;align-items:center;gap:5px;
                              padding:4px 12px;border-radius:6px;
                              background:<%= t.GenderType==='male'?'#E6F1FB':t.GenderType==='female'?'#FCE7F3':'#F3F4F6' %>">
                    <span style="font-size:16px"><%= gIcon[t.GenderType] %></span>
                    <span style="font-size:11px;font-weight:600;
                                 color:<%= t.GenderType==='male'?'#0C447C':t.GenderType==='female'?'#831843':'#374151' %>">
                      <%= t.GenderType.charAt(0).toUpperCase()+t.GenderType.slice(1) %>
                    </span>
                  </div>
                </td>
                <td style="text-align:center;font-size:11px;color:#666">
                  <%= new Date(t.CreatedAt).toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}) %>
                </td>
                <td style="text-align:center">
                  <a href="/template/<%= t.Id %>/edit" class="ib ib-blue">
                    <i class="bi bi-pencil-square"></i> Edit
                  </a>
                  <button class="ib ib-red" style="background:transparent"
                          onclick="deleteTemplate(<%= t.Id %>, '<%= t.Name.replace(/'/g, "\\'") %>')">
                    <i class="bi bi-trash"></i>
                  </button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% }) %>
    
  <% } %>
</div>

<script>
async function deleteTemplate(id, name) {
    if (!confirm(`Delete template "${name}"?\n\nThis action cannot be undone.`)) return;
    
    try {
        const res = await fetch("/template/delete", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id })
        });
        const data = await res.json();
        
        if (data.success) location.reload();
        else alert("Delete failed: " + data.message);
    } catch (err) {
        alert("Error: " + err.message);
    }
}
</script>