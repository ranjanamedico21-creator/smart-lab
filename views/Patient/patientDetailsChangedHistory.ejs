<%
  const n   = v => Number(v) || 0;
  const rs  = v => '₹' + (Math.round(n(v) * 100) / 100).toLocaleString('en-IN');
  const esc = v => String(v == null ? '' : v);

  const levelCfg = {
    none:     { cls:'lv-none',     label:'No risk'  },
    low:      { cls:'lv-low',      label:'Low'      },
    medium:   { cls:'lv-medium',   label:'Medium'   },
    high:     { cls:'lv-high',     label:'High'     },
    critical: { cls:'lv-critical', label:'Critical' }
  };
  const actionCfg = {
    REGISTER:     { icon:'bi-person-plus',     color:'#0ea882', bg:'#e6f8f4' },
    EDIT:         { icon:'bi-pencil-square',   color:'#1a56e8', bg:'#e8effe' },
    CANCEL:       { icon:'bi-x-octagon',       color:'#e53e3e', bg:'#fff5f5' },
    DUES_COLLECT: { icon:'bi-cash-coin',       color:'#854d0e', bg:'#fefce8' },
    ARRIVED:      { icon:'bi-door-open',       color:'#0891b2', bg:'#ecfeff' },
    THANKS_SAVE:  { icon:'bi-gift',            color:'#7c3aed', bg:'#f5f3ff' },
    THANKS_REMOVE:{ icon:'bi-gift',            color:'#7c3aed', bg:'#f5f3ff' },
    LEGACY:       { icon:'bi-clock-history',   color:'#475569', bg:'#f1f5f9' }
  };
  const catConfig = {
    info:    { icon:'bi-person',        color:'#0f172a', bg:'#f1f5f9', label:'Patient Info' },
    doctor:  { icon:'bi-person-badge',  color:'#1a56e8', bg:'#e8effe', label:'Doctor'       },
    clinic:  { icon:'bi-hospital',      color:'#0ea882', bg:'#e6f8f4', label:'Clinic'       },
    payment: { icon:'bi-cash-stack',    color:'#854d0e', bg:'#fefce8', label:'Payment'      },
    tests:   { icon:'bi-clipboard2-pulse', color:'#7c3aed', bg:'#f5f3ff', label:'Tests'    },
    cancel:  { icon:'bi-x-circle',      color:'#e53e3e', bg:'#fff5f5', label:'Cancellation' },
    thanks:  { icon:'bi-gift',          color:'#7c3aed', bg:'#f5f3ff', label:'Doctor Thanks'}
  };
  const verdictCfg = {
    ok:         { cls:'vd-ok',   icon:'bi-check-circle-fill',        label:'OK — genuine'    },
    explained:  { cls:'vd-ok',   icon:'bi-chat-left-text-fill',      label:'Explained'       },
    suspicious: { cls:'vd-warn', icon:'bi-exclamation-triangle-fill', label:'Suspicious'     },
    fraud:      { cls:'vd-bad',  icon:'bi-shield-fill-exclamation',  label:'Fraud confirmed' }
  };
  function shortUA(ua) {
    ua = String(ua || '');
    if (!ua) return '';
    const os = /Android/i.test(ua) ? 'Android' : /iPhone|iPad/i.test(ua) ? 'iOS' : /Windows/i.test(ua) ? 'Windows' : /Mac OS/i.test(ua) ? 'Mac' : /Linux/i.test(ua) ? 'Linux' : 'Device';
    const br = /Edg\//.test(ua) ? 'Edge' : /Chrome\//.test(ua) ? 'Chrome' : /Firefox\//.test(ua) ? 'Firefox' : /Safari\//.test(ua) ? 'Safari' : 'Browser';
    return br + ' on ' + os;
  }
  const moneyRows = [
    ['gross','Gross'], ['discount','Discount'], ['net','Net bill'], ['cashKept','Cash kept'], ['online','Online'], ['dues','Dues']
  ];
  const isRisky = it => it.kind === 'raw' || (it.risk && ['medium','high','critical'].indexOf(it.risk.level) >= 0);
  const isMoney = it => it.kind === 'print' || it.kind === 'raw' || (it.changes || []).some(c => c.category === 'payment' || c.category === 'tests' || c.category === 'cancel');
  const csrf = locals.csrfToken || '';
%>

<style>
:root {
  --primary:#1a56e8; --surface:#f7f9fc; --card:#ffffff; --border:#e2e8f0;
  --text-primary:#0f172a; --text-secondary:#64748b; --text-muted:#94a3b8;
  --radius:10px; --radius-lg:16px;
}
.ph-wrap{ max-width:1100px; margin:0 auto; }
.ph-header{ background:linear-gradient(135deg,#0f172a,#1e293b); border-radius:var(--radius-lg) var(--radius-lg) 0 0;
  padding:18px 22px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; }
.ph-av{ width:44px; height:44px; border-radius:50%; flex-shrink:0; background:rgba(255,255,255,.12); border:2px solid rgba(255,255,255,.2);
  display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:700; color:#fff; }
.ph-name{ font-size:1.08rem; font-weight:700; color:#fff; text-transform:capitalize; }
.ph-sub{ font-size:.75rem; color:rgba(255,255,255,.6); margin-top:2px; }
.ph-pill{ display:inline-flex; align-items:center; gap:5px; padding:4px 11px; border-radius:99px; font-size:.72rem; font-weight:600; }
.pill-active{ background:#0ea882; color:#fff; } .pill-cancelled{ background:#e53e3e; color:#fff; }
.pill-ok{ background:rgba(14,168,130,.18); color:#6ee7b7; border:1px solid rgba(110,231,183,.35); }
.pill-bad{ background:#e53e3e; color:#fff; animation:pulse 1.6s infinite; }
.pill-warn{ background:rgba(250,204,21,.18); color:#fde68a; border:1px solid rgba(253,230,138,.35); }
@keyframes pulse{ 0%,100%{opacity:1} 50%{opacity:.65} }
.ph-btn{ display:inline-flex; align-items:center; gap:5px; padding:6px 12px; border-radius:var(--radius); border:1px solid rgba(255,255,255,.2);
  color:rgba(255,255,255,.8); font-size:.78rem; font-weight:500; text-decoration:none; background:rgba(255,255,255,.08); }
.ph-btn:hover{ background:rgba(255,255,255,.16); color:#fff; }

.ph-stats{ background:var(--card); border:1px solid var(--border); border-top:none; display:grid; grid-template-columns:repeat(6,1fr);
  border-radius:0 0 var(--radius-lg) var(--radius-lg); overflow:hidden; margin-bottom:18px; }
.ph-stat{ padding:12px 14px; border-right:1px solid var(--border); }
.ph-stat:last-child{ border-right:none; }
.ph-stat-l{ font-size:.63rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:.07em; margin-bottom:3px; }
.ph-stat-v{ font-size:.95rem; font-weight:700; font-variant-numeric:tabular-nums; color:var(--text-primary); }
.c-g{color:#0ea882} .c-b{color:#1a56e8} .c-r{color:#e53e3e} .c-p{color:#7c3aed} .c-o{color:#c2410c}

.box{ background:var(--card); border:1px solid var(--border); border-radius:var(--radius-lg); padding:14px 16px; margin-bottom:16px; }
.box-h{ font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:var(--text-secondary); margin-bottom:10px;
  display:flex; align-items:center; gap:6px; }
.alert-fraud{ border:2px solid #fecaca; background:#fff5f5; border-radius:var(--radius-lg); padding:14px 16px; margin-bottom:16px; color:#7f1d1d; }
.alert-fraud h6{ font-weight:700; margin:0 0 4px; color:#b91c1c; }

.cmp{ width:100%; font-size:.8rem; border-collapse:collapse; }
.cmp th{ font-size:.66rem; text-transform:uppercase; letter-spacing:.06em; color:var(--text-muted); font-weight:700; padding:4px 8px; text-align:right; }
.cmp th:first-child,.cmp td:first-child{ text-align:left; }
.cmp td{ padding:5px 8px; border-top:1px solid #f1f5f9; text-align:right; font-variant-numeric:tabular-nums; }
.cmp .down{ color:#dc2626; font-weight:700; } .cmp .up{ color:#16a34a; font-weight:600; }

.tchips{ display:flex; flex-wrap:wrap; gap:6px; }
.tchip{ font-size:.72rem; padding:3px 9px; border-radius:99px; background:#f1f5f9; color:#334155; border:1px solid #e2e8f0; }
.tchip.st{ background:#eff6ff; border-color:#bfdbfe; color:#1d4ed8; }
.tchip.dn{ background:#ecfdf5; border-color:#a7f3d0; color:#047857; }

.filters{ display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px; }
.filters .btn{ font-size:.75rem; border-radius:99px; }

.ph-tl{ position:relative; padding-left:38px; padding-bottom:30px; }
.ph-tl::before{ content:''; position:absolute; left:13px; top:8px; bottom:0; width:2px; background:#e2e8f0; }
.ph-ev{ position:relative; margin-bottom:14px; }
.ph-ev-dot{ position:absolute; left:-33px; top:12px; width:26px; height:26px; border-radius:50%; z-index:2;
  display:flex; align-items:center; justify-content:center; font-size:11px; border:3px solid var(--card); box-shadow:0 0 0 2px #cbd5e1; }
.ph-ev-card{ background:var(--card); border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; box-shadow:0 1px 3px rgba(0,0,0,.05); }
.ph-ev-card.risk-high{ border-color:#fca5a5; box-shadow:0 0 0 2px #fee2e2; }
.ph-ev-card.risk-critical{ border-color:#ef4444; box-shadow:0 0 0 3px #fecaca; }
.ph-ev-card.risk-medium{ border-color:#fcd34d; }
.ph-ev-card.raw-card{ border:2px dashed #ef4444; }
.ph-ev-top{ display:flex; align-items:center; justify-content:space-between; padding:9px 14px; border-bottom:1px solid var(--border); flex-wrap:wrap; gap:6px; }
.ph-ev-label{ display:inline-flex; align-items:center; gap:5px; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; padding:3px 10px; border-radius:99px; }
.ph-ev-when{ font-size:.72rem; color:var(--text-muted); display:flex; align-items:center; gap:4px; }

.lv{ display:inline-flex; align-items:center; gap:4px; font-size:.68rem; font-weight:700; padding:2px 8px; border-radius:99px; }
.lv-none{ background:#f1f5f9; color:#64748b; } .lv-low{ background:#ecfeff; color:#0e7490; }
.lv-medium{ background:#fef3c7; color:#92400e; } .lv-high{ background:#fee2e2; color:#b91c1c; }
.lv-critical{ background:#dc2626; color:#fff; }

.ph-actor{ display:flex; align-items:center; gap:8px; padding:7px 14px; background:var(--surface); border-bottom:1px solid var(--border); flex-wrap:wrap; }
.ph-actor-av{ width:26px; height:26px; border-radius:50%; background:#e8effe; color:#1a56e8; display:flex; align-items:center; justify-content:center; font-size:9px; font-weight:700; flex-shrink:0; }
.ph-actor-name{ font-size:.8rem; font-weight:600; color:var(--text-primary); }
.ph-actor-role{ font-size:.68rem; color:var(--text-muted); }
.ph-actor-auth{ margin-left:auto; font-size:.66rem; padding:2px 8px; border-radius:99px; background:#f5f3ff; color:#7c3aed; font-weight:600; }

.reason{ padding:8px 14px; font-size:.8rem; color:#334155; border-bottom:1px solid var(--border); background:#fffdf5; }
.reason i{ color:#ca8a04; }
.flags{ padding:8px 14px; border-bottom:1px solid var(--border); background:#fff8f8; display:flex; flex-direction:column; gap:4px; }
.flag{ font-size:.76rem; color:#7f1d1d; display:flex; gap:6px; align-items:flex-start; }
.flag b{ font-weight:600; } .flag .pts{ margin-left:auto; font-size:.66rem; color:#b91c1c; font-weight:700; white-space:nowrap; }
.flag .det{ color:#991b1b; opacity:.85; }

.mny{ padding:8px 14px; border-bottom:1px solid var(--border); display:grid; grid-template-columns:repeat(6,1fr); gap:6px; }
.mny div{ font-size:.7rem; color:var(--text-muted); }
.mny strong{ display:block; font-size:.78rem; color:var(--text-primary); font-variant-numeric:tabular-nums; }
.mny .chg strong{ color:#dc2626; } .mny .chg-up strong{ color:#16a34a; }

.ph-changes{ padding:10px 14px; display:flex; flex-direction:column; gap:5px; }
.ph-cat-head{ display:flex; align-items:center; gap:5px; font-size:.64rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; margin:6px 0 3px; padding:3px 8px; border-radius:5px; }
.ph-chg{ display:grid; grid-template-columns:150px 1fr auto 1fr; align-items:center; gap:6px; padding:5px 8px; border-radius:7px; background:#fafbff; border:1px solid #eef2ff; font-size:.78rem; }
.ph-chg.added{ background:#f0fdf4; border-color:#bbf7d0; } .ph-chg.removed{ background:#fff5f5; border-color:#fecaca; }
.ph-chg-field{ font-weight:600; color:#1e40af; font-size:.72rem; }
.ph-chg-old{ color:var(--text-muted); text-decoration:line-through; font-size:.75rem; word-break:break-word; }
.ph-chg-arrow{ color:#cbd5e1; font-size:.7rem; text-align:center; }
.ph-chg-new{ font-weight:600; color:var(--text-primary); font-size:.75rem; word-break:break-word; }
.ph-chg.added .ph-chg-field,.ph-chg.added .ph-chg-new{ color:#15803d; }
.ph-chg.removed .ph-chg-field{ color:#b91c1c; } .ph-chg.removed .ph-chg-old{ color:#dc2626; }

.foot{ padding:7px 14px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px; font-size:.7rem; color:var(--text-muted); background:#fbfcfe; }
.vd{ display:inline-flex; align-items:center; gap:4px; font-size:.7rem; font-weight:600; padding:2px 8px; border-radius:99px; }
.vd-ok{ background:#dcfce7; color:#166534; } .vd-warn{ background:#fef3c7; color:#92400e; } .vd-bad{ background:#dc2626; color:#fff; }
.vd-none{ background:#f1f5f9; color:#64748b; }

.ph-empty{ text-align:center; padding:40px 20px; background:var(--card); border-radius:var(--radius-lg); border:1px solid var(--border); color:var(--text-muted); }

@media(max-width:768px){
  .ph-stats{ grid-template-columns:repeat(3,1fr); }
  .ph-stat:nth-child(3){ border-right:none; }
  .mny{ grid-template-columns:repeat(3,1fr); }
  .ph-chg{ grid-template-columns:1fr; }
  .ph-chg-arrow{ display:none; }
}
@media print{
  .no-print,.filters,.modal{ display:none !important; }
  .ph-ev-card{ break-inside:avoid; box-shadow:none; }
  .ph-header{ -webkit-print-color-adjust:exact; print-color-adjust:exact; }
}
</style>

<div class="ph-wrap">

<% (notifications || []).forEach(function(nt){ %>
  <div class="alert alert-<%= nt.type %> alert-dismissible fade show no-print" role="alert" style="white-space:pre-line">
    <i class="bi <%= nt.icon %> me-1"></i><%= nt.messages %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% }) %>

<!-- ── Header ── -->
<div class="ph-header">
  <div style="display:flex;align-items:center;gap:12px;">
    <div class="ph-av"><%= (patient.Name||'?').charAt(0).toUpperCase() %></div>
    <div>
      <div class="ph-name"><%= patient.Title %> <%= patient.Name %></div>
      <div class="ph-sub">
        Bill #<%= patientId %> · <%= patient.Age %> <%= patient.YMD %> · <%= patient.PhoneNumber %>
        · Registered <%= patient.RegDate %> <%= patient.RegisteredTime || '' %> by <%= patient.RegisteredByName || '—' %>
        <% if (patient.DoctorName) { %>· Ref. Dr. <%= patient.DoctorName %><% } %>
      </div>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
    <span class="ph-pill <%= Number(patient.Status)===0?'pill-cancelled':'pill-active' %>">
      <i class="bi <%= Number(patient.Status)===0?'bi-x-circle':'bi-check-circle' %>"></i><%= Number(patient.Status)===0?'Cancelled':'Active' %>
    </span>
    <% if (integrity.ok) { %>
      <span class="ph-pill pill-ok" title="Every event re-checked against its signature"><i class="bi bi-shield-check"></i>Audit trail intact (<%= integrity.checked %>)</span>
    <% } else { %>
      <span class="ph-pill pill-bad"><i class="bi bi-shield-exclamation"></i>AUDIT TAMPERED</span>
    <% } %>
    <% if (integrity.unverifiable) { %><span class="ph-pill pill-warn" title="<%= integrity.note %>"><i class="bi bi-key"></i>Key missing</span><% } %>
    <button type="button" class="ph-btn no-print" onclick="window.print()"><i class="bi bi-printer"></i>Print</button>
    <a href="/audit?q=<%= patientId %>&from=2000-01-01" class="ph-btn no-print"><i class="bi bi-shield-lock"></i>Audit Center</a>
    <a href="/patient/getPatientDetail?patientId=<%= patientId %>" class="ph-btn no-print"><i class="bi bi-arrow-left"></i>Back</a>
  </div>
</div>

<!-- ── Stats ── -->
<div class="ph-stats">
  <div class="ph-stat"><div class="ph-stat-l">Net bill</div><div class="ph-stat-v c-b"><%= rs(current.net) %></div></div>
  <div class="ph-stat"><div class="ph-stat-l">Paid</div><div class="ph-stat-v c-g"><%= rs(current.cashKept + current.online) %></div></div>
  <div class="ph-stat"><div class="ph-stat-l">Dues</div><div class="ph-stat-v <%= current.dues>0?'c-r':'' %>"><%= rs(current.dues) %></div></div>
  <div class="ph-stat"><div class="ph-stat-l">Edits</div><div class="ph-stat-v c-p"><%= summary.edits %></div></div>
  <div class="ph-stat"><div class="ph-stat-l">Receipts printed</div><div class="ph-stat-v"><%= prints %></div></div>
  <div class="ph-stat"><div class="ph-stat-l">High-risk</div><div class="ph-stat-v <%= summary.highRisk?'c-r':'c-g' %>"><%= summary.highRisk %></div></div>
</div>

<% if (!integrity.ok) { %>
  <div class="alert-fraud">
    <h6><i class="bi bi-shield-fill-exclamation me-1"></i>Audit records of this patient were changed or deleted directly in the database</h6>
    <ul class="mb-0 small"><% integrity.problems.forEach(function(p){ %><li><%= p %></li><% }) %></ul>
  </div>
<% } %>

<% if (receiptMismatch) { %>
  <div class="alert-fraud">
    <h6><i class="bi bi-receipt-cutoff me-1"></i>Receipt shows <%= rs(receiptMismatch.printed) %> but the bill is now <%= rs(receiptMismatch.now) %></h6>
    <div class="small">The patient was handed a receipt for <strong><%= rs(receiptMismatch.diff) %> more</strong> than what is recorded now.
      Call the patient on <strong><%= patient.PhoneNumber %></strong> and confirm how much they actually paid.</div>
  </div>
<% } %>

<% if (summary.outside) { %>
  <div class="alert-fraud">
    <h6><i class="bi bi-database-exclamation me-1"></i><%= summary.outside %> change(s) made outside SmartLab</h6>
    <div class="small">Money fields of this bill were changed directly in the database (phpMyAdmin or another program). See the red dashed cards below.</div>
  </div>
<% } %>

<!-- ── Original vs now ── -->
<div class="row g-3">
  <div class="col-lg-7">
    <div class="box">
      <div class="box-h"><i class="bi bi-arrow-left-right"></i>Original bill vs now
        <% if (original) { %><span class="ms-auto fw-normal text-lowercase" style="letter-spacing:0">from <%= original.source %></span><% } %></div>
      <% if (!original) { %>
        <div class="small text-muted">No registration snapshot found for this bill (registered before the audit upgrade).</div>
      <% } else { %>
        <table class="cmp">
          <thead><tr><th></th><th>At registration</th><th>Now</th><th>Difference</th></tr></thead>
          <tbody>
          <% moneyRows.forEach(function(r){
               const o = n(original[r[0]]), c = n(current[r[0]]), d = Math.round((c - o) * 100) / 100;
               const bad = (r[0] === 'discount' || r[0] === 'dues') ? d > 0.5 : d < -0.5; %>
            <tr><td><%= r[1] %></td><td><%= rs(o) %></td><td><%= rs(c) %></td>
              <td class="<%= Math.abs(d) < 0.5 ? '' : (bad ? 'down' : 'up') %>"><%= Math.abs(d) < 0.5 ? '—' : (d > 0 ? '+' : '−') + rs(Math.abs(d)) %></td></tr>
          <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="box">
      <div class="box-h"><i class="bi bi-clipboard2-pulse"></i>Tests on bill now</div>
      <% if (!tests.length) { %><div class="small text-muted">No tests.</div><% } %>
      <div class="tchips">
        <% tests.forEach(function(t){ %>
          <span class="tchip <%= t.done ? 'dn' : (t.started ? 'st' : '') %>" title="<%= t.delivered ? 'Delivered' : t.reported ? 'Reported' : t.done ? 'Done' : t.started ? 'In room' : 'Waiting' %>">
            <%= t.name %> · <%= rs(t.price) %>
            <% if (t.delivered) { %><i class="bi bi-box-arrow-up-right"></i><% } else if (t.reported) { %><i class="bi bi-file-earmark-check"></i><% } else if (t.done) { %><i class="bi bi-check2"></i><% } else if (t.started) { %><i class="bi bi-door-open"></i><% } %>
          </span>
        <% }) %>
      </div>
      <div class="small text-muted mt-2"><i class="bi bi-door-open"></i> in room · <i class="bi bi-check2"></i> done · <i class="bi bi-file-earmark-check"></i> reported · <i class="bi bi-box-arrow-up-right"></i> delivered</div>
    </div>
  </div>
</div>

<!-- ── Filters ── -->
<div class="filters no-print" id="tlFilters">
  <button type="button" class="btn btn-sm btn-dark" data-f="all">All (<%= items.length %>)</button>
  <button type="button" class="btn btn-sm btn-outline-danger" data-f="risky">Risky only (<%= items.filter(isRisky).length %>)</button>
  <button type="button" class="btn btn-sm btn-outline-secondary" data-f="money">Money &amp; tests (<%= items.filter(isMoney).length %>)</button>
  <button type="button" class="btn btn-sm btn-outline-secondary" data-f="print">Receipt prints (<%= prints %>)</button>
</div>

<!-- ── Timeline ── -->
<% if (!items.length) { %>
  <div class="ph-empty"><i class="bi bi-clock-history" style="font-size:2rem;display:block;margin-bottom:8px;"></i>No audit history recorded yet.</div>
<% } else { %>
<div class="ph-tl">
<% items.forEach(function(it, idx){
     const tags = ['all'];
     if (isRisky(it)) tags.push('risky');
     if (isMoney(it)) tags.push('money');
     if (it.kind === 'print') tags.push('print');
%>

<% if (it.kind === 'print') { %>
  <div class="ph-ev" data-tags="<%= tags.join(' ') %>">
    <div class="ph-ev-dot" style="background:#f0f9ff;color:#0369a1"><i class="bi bi-printer"></i></div>
    <div class="ph-ev-card">
      <div class="ph-ev-top">
        <span class="ph-ev-label" style="background:#f0f9ff;color:#0369a1"><i class="bi bi-receipt"></i>Receipt #<%= it.print.no %> printed<%= it.print.no > 1 ? ' (duplicate)' : '' %></span>
        <span class="ph-ev-when"><i class="bi bi-clock"></i><%= it.displayAt %> · by <%= it.actor %></span>
      </div>
      <div class="mny">
        <div>Gross<strong><%= rs(it.print.gross) %></strong></div>
        <div>Discount<strong><%= rs(it.print.discount) %></strong></div>
        <div class="<%= it.print.net > current.net + 0.5 && Number(patient.Status)===1 ? 'chg' : '' %>">Net on receipt<strong><%= rs(it.print.net) %></strong></div>
        <div>Paid on receipt<strong><%= rs(it.print.paid) %></strong></div>
        <div>Dues on receipt<strong><%= rs(it.print.dues) %></strong></div>
        <div>Tests<strong style="font-weight:500;font-size:.7rem"><%= it.print.tests || '—' %></strong></div>
      </div>
    </div>
  </div>

<% } else if (it.kind === 'raw') { %>
  <div class="ph-ev" data-tags="<%= tags.join(' ') %>">
    <div class="ph-ev-dot" style="background:#dc2626;color:#fff"><i class="bi bi-database-exclamation"></i></div>
    <div class="ph-ev-card raw-card">
      <div class="ph-ev-top">
        <span class="ph-ev-label" style="background:#dc2626;color:#fff"><i class="bi bi-exclamation-octagon"></i>Changed outside SmartLab — <%= it.raw.table %> <%= it.raw.op %></span>
        <span class="ph-ev-when"><i class="bi bi-clock"></i><%= it.displayAt %> · DB user <code><%= it.actor %></code></span>
      </div>
      <div class="ph-changes">
        <% String(it.raw.columns || '').split(',').filter(Boolean).forEach(function(col){ %>
          <div class="ph-chg removed">
            <span class="ph-chg-field"><%= col %></span>
            <span class="ph-chg-old"><%= it.raw.old && it.raw.old[col] != null ? it.raw.old[col] : (col === 'ROW' || col === 'TestId' ? JSON.stringify(it.raw.old) : '—') %></span>
            <span class="ph-chg-arrow">→</span>
            <span class="ph-chg-new"><%= it.raw.neu && it.raw.neu[col] != null ? it.raw.neu[col] : (it.raw.op === 'DELETE' ? 'deleted' : '—') %></span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

<% } else {
     const ac  = actionCfg[it.action] || actionCfg.LEGACY;
     const lv  = levelCfg[it.risk.level] || levelCfg.none;
     const ini = String(it.actor||'?').split(' ').map(function(w){ return w[0]||''; }).join('').toUpperCase().slice(0,2);
     const grouped = {};
     (it.changes || []).forEach(function(c){ const k = c.category || 'info'; (grouped[k] = grouped[k] || []).push(c); });
     const showMoney = it.before && it.after && ['EDIT','CANCEL','DUES_COLLECT'].indexOf(it.action) >= 0;
%>
  <div class="ph-ev" data-tags="<%= tags.join(' ') %>">
    <div class="ph-ev-dot" style="background:<%= ac.bg %>;color:<%= ac.color %>"><i class="bi <%= ac.icon %>"></i></div>
    <div class="ph-ev-card risk-<%= it.risk.level %>">
      <div class="ph-ev-top">
        <span style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
          <span class="ph-ev-label" style="background:<%= ac.bg %>;color:<%= ac.color %>"><i class="bi <%= ac.icon %>"></i><%= it.actionLabel %></span>
          <% if (it.kind === 'event' && it.risk.level !== 'none') { %>
            <span class="lv <%= lv.cls %>"><i class="bi bi-activity"></i><%= lv.label %> · <%= it.risk.score %></span>
          <% } %>
          <% if (it.risk.impact > 0 && ['EDIT','CANCEL'].indexOf(it.action) >= 0) { %>
            <span class="lv lv-high"><i class="bi bi-currency-rupee"></i><%= rs(it.risk.impact).replace('₹','') %> out</span>
          <% } %>
        </span>
        <span class="ph-ev-when"><i class="bi bi-clock"></i><%= it.displayAt %></span>
      </div>

      <div class="ph-actor">
        <div class="ph-actor-av"><%= ini %></div>
        <div>
          <div class="ph-actor-name"><%= it.actor %></div>
          <div class="ph-actor-role"><%= it.role || 'User' %></div>
        </div>
        <% if (it.authorisedAs) { %><span class="ph-actor-auth"><i class="bi bi-shield-check me-1"></i><%= it.authorisedAs %></span><% } %>
      </div>

      <% if (it.reason) { %><div class="reason"><i class="bi bi-chat-quote-fill me-1"></i><%= it.reason %></div><% } %>

      <% if (it.risk.flags && it.risk.flags.length) { %>
        <div class="flags">
          <% it.risk.flags.forEach(function(fl){ %>
            <div class="flag"><i class="bi bi-flag-fill" style="margin-top:2px"></i>
              <span><b><%= fl.label %></b><% if (fl.detail) { %> <span class="det">— <%= fl.detail %></span><% } %></span>
              <% if (fl.points) { %><span class="pts">+<%= fl.points %></span><% } %></div>
          <% }) %>
        </div>
      <% } %>

      <% if (showMoney) { %>
        <div class="mny">
          <% moneyRows.forEach(function(r){
               const b = n(it.before[r[0]]), a = n(it.after[r[0]]), d = a - b;
               const bad = (r[0] === 'discount' || r[0] === 'dues') ? d > 0.5 : d < -0.5; %>
            <div class="<%= Math.abs(d) < 0.5 ? '' : (bad ? 'chg' : 'chg-up') %>"><%= r[1] %>
              <strong><%= Math.abs(d) < 0.5 ? rs(a) : rs(b) + ' → ' + rs(a) %></strong></div>
          <% }) %>
        </div>
      <% } %>

      <% if (it.changes && it.changes.length) { %>
        <div class="ph-changes">
          <% Object.keys(grouped).forEach(function(cat){ const cc = catConfig[cat] || catConfig.info; %>
            <div class="ph-cat-head" style="color:<%= cc.color %>;background:<%= cc.bg %>"><i class="bi <%= cc.icon %>"></i><%= cc.label %></div>
            <% grouped[cat].forEach(function(c){
                 const added   = /Added$/.test(c.field) || c.field === 'CashCollected' || c.field === 'OnlineCollected';
                 const removed = /Removed$/.test(c.field) || c.field === 'TestCancelled'; %>
              <div class="ph-chg <%= added ? 'added' : removed ? 'removed' : '' %>">
                <span class="ph-chg-field"><%= c.fieldLabel %></span>
                <% if (added) { %>
                  <span class="ph-chg-old"></span><span class="ph-chg-arrow"></span>
                  <span class="ph-chg-new"><i class="bi bi-plus-circle-fill me-1"></i><%= c.newDisplay %></span>
                <% } else if (removed) { %>
                  <span class="ph-chg-old"><%= c.oldDisplay %></span><span class="ph-chg-arrow"></span>
                  <span class="ph-chg-new" style="color:#dc2626"><i class="bi bi-dash-circle-fill me-1"></i>Removed</span>
                <% } else { %>
                  <span class="ph-chg-old"><%= c.oldDisplay %></span><span class="ph-chg-arrow">→</span>
                  <span class="ph-chg-new"><%= c.newDisplay %></span>
                <% } %>
              </div>
            <% }) %>
          <% }) %>
        </div>
      <% } %>

      <% if (it.kind === 'event') { %>
        <div class="foot">
          <span><i class="bi bi-pc-display me-1"></i><%= shortUA(it.ua) || 'unknown device' %><% if (it.ip) { %> · IP <%= it.ip %><% } %> · Event #<%= it.id %></span>
          <span style="display:flex;gap:6px;align-items:center">
            <% if (it.review) { const vc = verdictCfg[it.review.verdict] || verdictCfg.ok; %>
              <span class="vd <%= vc.cls %>" title="<%= it.review.note || '' %>"><i class="bi <%= vc.icon %>"></i><%= vc.label %> · <%= it.review.by %>, <%= it.review.at %></span>
            <% } else if (it.risk.level !== 'none') { %>
              <span class="vd vd-none">Not reviewed</span>
            <% } %>
            <% if (canReview && String(currentUserId) !== String(it.actorId) && it.risk.level !== 'none') { %>
              <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 no-print js-review" style="font-size:.7rem"
                      data-id="<%= it.id %>" data-title="<%= it.actionLabel %> by <%= it.actor %> — <%= it.displayAt %>">
                <i class="bi bi-clipboard-check"></i> <%= it.review ? 'Re-review' : 'Review' %></button>
            <% } %>
          </span>
        </div>
        <% if (it.review && it.review.note) { %><div class="foot" style="border-top:1px solid var(--border)"><span><i class="bi bi-sticky me-1"></i>Review note: <%= it.review.note %></span></div><% } %>
      <% } %>
    </div>
  </div>
<% } %>
<% }) %>
</div>
<% } %>
</div>

<% if (canReview) { %>
<!-- ── Review modal ── -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" method="post" action="/audit/review">
      <% if (csrf) { %><input type="hidden" name="_csrf" value="<%= csrf %>"><% } %>
      <input type="hidden" name="eventIds" id="rvEventId">
      <input type="hidden" name="back" id="rvBack" value="">
      <div class="modal-header">
        <h6 class="modal-title"><i class="bi bi-clipboard-check me-1"></i>Review event</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="small text-muted mb-2" id="rvTitle"></div>
        <div class="d-grid gap-2 mb-3">
          <% Object.keys(verdictCfg).forEach(function(k, i){ const v = verdictCfg[k]; %>
            <label class="border rounded p-2 d-flex align-items-center gap-2" style="cursor:pointer">
              <input type="radio" class="form-check-input m-0" name="verdict" value="<%= k %>" <%= i===0?'checked':'' %>>
              <span class="vd <%= v.cls %>"><i class="bi <%= v.icon %>"></i><%= v.label %></span>
            </label>
          <% }) %>
        </div>
        <label class="form-label small fw-semibold">Note <span class="text-muted fw-normal">(required unless OK)</span></label>
        <textarea name="note" class="form-control" rows="3" maxlength="1000" placeholder="e.g. Called patient — confirmed paid ₹800 only. Genuine correction."></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save review</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<script>
(function () {
  var wrap = document.getElementById('tlFilters');
  if (wrap) wrap.addEventListener('click', function (e) {
    var b = e.target.closest('button[data-f]'); if (!b) return;
    var f = b.getAttribute('data-f');
    wrap.querySelectorAll('button').forEach(function (x) {
      x.classList.remove('btn-dark'); x.classList.add(x.getAttribute('data-f') === 'risky' ? 'btn-outline-danger' : 'btn-outline-secondary');
    });
    b.classList.remove('btn-outline-danger', 'btn-outline-secondary'); b.classList.add('btn-dark');
    document.querySelectorAll('.ph-tl .ph-ev').forEach(function (el) {
      el.style.display = (' ' + el.getAttribute('data-tags') + ' ').indexOf(' ' + f + ' ') >= 0 ? '' : 'none';
    });
  });
  // Bootstrap may be loaded by the layout AFTER this script — look it up only when clicked.
  var modalEl = document.getElementById('reviewModal');
  function showReview() {
    if (window.bootstrap && bootstrap.Modal) return bootstrap.Modal.getOrCreateInstance(modalEl).show();
    modalEl.style.display = 'block'; modalEl.classList.add('show'); modalEl.removeAttribute('aria-hidden');
    var bd = document.createElement('div'); bd.className = 'modal-backdrop fade show'; bd.id = 'rvBackdrop'; document.body.appendChild(bd);
  }
  function hideReview() {
    if (window.bootstrap && bootstrap.Modal) return bootstrap.Modal.getOrCreateInstance(modalEl).hide();
    modalEl.style.display = 'none'; modalEl.classList.remove('show'); var bd = document.getElementById('rvBackdrop'); if (bd) bd.remove();
  }
  if (modalEl) {
    modalEl.querySelectorAll('[data-bs-dismiss="modal"]').forEach(function (b) {
      b.addEventListener('click', function () { if (!(window.bootstrap && bootstrap.Modal)) hideReview(); });
    });
    document.querySelectorAll('.js-review').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.getElementById('rvEventId').value = btn.getAttribute('data-id');
        document.getElementById('rvBack').value = location.pathname + location.search;
        document.getElementById('rvTitle').textContent = btn.getAttribute('data-title');
        modalEl.querySelector('textarea').value = '';
        showReview();
      });
    });
  }
})();
</script>
