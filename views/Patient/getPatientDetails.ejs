<%#
  Variables from controller:
  patientDetail     → array, [0] is patient row
  patientTestDetail → array, each has .subTests[], .TestStatus, .StatusNote, .RoomName
  testList          → array of deliverable groups
  patientId         → number
  isEmergency       → bool
  NOTE: queueStatus / isPatientEntered / isPatientExited removed — now derived from test statuses
%>

<style>
:root {
  --card:#fff; --border:#e2e8f0; --surface:#f8f9fb;
  --text-primary:#111; --text-secondary:#666; --text-muted:#aaa;
  --radius-lg:14px;
}

.pd-card { background:var(--card); border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; margin-bottom:12px; box-shadow:0 1px 4px rgba(0,0,0,.05); position:relative; }
.pd-header { padding:16px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
.pd-avatar { width:44px; height:44px; border-radius:50%; background:#E6F1FB; display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:600; color:#0C447C; flex-shrink:0; }
.pd-name { font-size:15px; font-weight:600; color:var(--text-primary); }
.pd-meta { font-size:12px; color:var(--text-secondary); margin-top:3px; display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
.pd-meta span { display:flex; align-items:center; gap:4px; }
.pd-sep { color:var(--border); }
.pd-actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }

.pd-btn { display:inline-flex; align-items:center; gap:5px; padding:6px 14px; border-radius:8px; font-size:12px; font-weight:600; text-decoration:none; border:1px solid; cursor:pointer; white-space:nowrap; font-family:inherit; background:transparent; }
.pd-btn-edit { background:#E6F1FB; color:#0C447C;  border-color:#B5D4F4; }
.pd-btn-list { background:var(--surface); color:var(--text-secondary); border-color:var(--border); }

.pd-kpi { display:grid; grid-template-columns:repeat(4,1fr); border-bottom:1px solid var(--border); }
.pd-kpi-cell { padding:14px 20px; border-right:1px solid var(--border); }
.pd-kpi-cell:last-child { border-right:none; }
.pd-kpi-label { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--text-secondary); margin-bottom:4px; }
.pd-kpi-val   { font-size:18px; font-weight:600; font-family:'DM Mono',monospace; }
.pd-kpi-val.info   { color:#0C447C; }
.pd-kpi-val.danger { color:#A32D2D; }
.pd-kpi-val.muted  { color:var(--text-secondary); }
.pd-kpi-sub { font-size:11px; color:var(--text-muted); margin-top:2px; }

.pd-section-head { display:flex; align-items:center; justify-content:space-between; padding:13px 20px; border-bottom:1px solid var(--border); background:var(--surface); }
.pd-section-title { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:var(--text-secondary); display:flex; align-items:center; gap:7px; }

.pd-table { width:100%; border-collapse:collapse; }
.pd-table thead th { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--text-secondary); padding:9px 16px; border-bottom:1px solid var(--border); text-align:left; background:var(--surface); }
.pd-table tbody tr { border-bottom:1px solid var(--border); }
.pd-table tbody tr:last-child { border-bottom:none; }
.pd-table tbody tr:hover td { background:#f8fbff; }
.pd-table tbody td { padding:11px 16px; font-size:13px; color:var(--text-primary); vertical-align:middle; }

.pd-pill { display:inline-block; padding:2px 9px; border-radius:99px; font-size:11px; font-weight:600; }
.pill-success { background:#EAF3DE; color:#27500A; }
.pill-danger  { background:#FCEBEB; color:#791F1F; }
.pill-info    { background:#E6F1FB; color:#0C447C; }
.pill-warn    { background:#FAEEDA; color:#633806; }
.pill-gray    { background:var(--surface); color:var(--text-secondary); border:1px solid var(--border); }

.pd-icon-btn { display:inline-flex; align-items:center; gap:4px; padding:3px 9px; border-radius:6px; font-size:11.5px; font-weight:600; text-decoration:none; border:1px solid; cursor:pointer; white-space:nowrap; margin-right:3px; font-family:inherit; }
.ib-blue { background:#E6F1FB; color:#0C447C; border-color:#B5D4F4; }
.ib-gray { background:var(--surface); color:var(--text-secondary); border-color:var(--border); }
.ib-red  { background:#FCEBEB; color:#791F1F; border-color:#F7C1C1; }

.pd-check-yes { color:#27500A; font-weight:600; }
.pd-check-no  { color:#A32D2D; font-weight:600; }
.pd-complete-btn { display:inline-flex; align-items:center; gap:7px; padding:9px 20px; background:#185FA5; color:#fff; border:none; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; margin:14px 20px; }
.pd-complete-btn:hover { background:#0C447C; }

.pd-card.is-cancelled::after {
  content:'CANCELLED'; position:absolute; top:50%; left:50%;
  transform:translate(-50%,-50%) rotate(-20deg);
  font-size:58px; font-weight:900; letter-spacing:.12em;
  color:rgba(220,38,38,.05); pointer-events:none; white-space:nowrap; z-index:0;
}
.pd-cancelled-banner {
  background:#fef2f2; border-bottom:2px dashed #fca5a5;
  padding:12px 20px; display:flex; align-items:center; gap:12px;
  position:relative; overflow:hidden;
}
.pd-cancelled-banner::before,
.pd-cancelled-banner::after {
  content:''; position:absolute; left:-10%; right:-10%; height:2px;
  background:repeating-linear-gradient(90deg,#dc2626 0,#dc2626 14px,transparent 14px,transparent 22px);
  opacity:.18; pointer-events:none;
}
.pd-cancelled-banner::before { top:38%; }
.pd-cancelled-banner::after  { top:62%; }

.pq-status-tag { display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:99px; font-size:11px; font-weight:600; }

/* Deliverables */
.dlv-table { width:100%; border-collapse:collapse; }
.dlv-table thead th { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#888; padding:9px 14px; border-bottom:1px solid #e2e8f0; text-align:left; background:#f8f9fb; }
.dlv-table tbody tr { border-bottom:1px solid #f0f2f5; }
.dlv-table tbody tr:last-child { border-bottom:none; }
.dlv-table tbody td { padding:10px 14px; font-size:12.5px; color:#111; vertical-align:middle; }
.dlv-type { display:inline-flex; align-items:center; gap:5px; padding:3px 10px; border-radius:99px; font-size:11px; font-weight:700; }
.dlv-type-film   { background:#f0f4ff; color:#1a56e8; border:1px solid #c3d4fc; }
.dlv-type-report { background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0; }
.dlv-state { display:inline-flex; align-items:center; gap:4px; padding:3px 9px; border-radius:99px; font-size:11px; font-weight:600; }
.dlv-done    { background:#EAF3DE; color:#27500A; }
.dlv-pending { background:#f8f9fb; color:#888; border:1px solid #e2e8f0; }
.dlv-by      { font-size:10.5px; color:#94a3b8; margin-top:2px; }
.dlv-btn { display:inline-flex; align-items:center; gap:4px; padding:4px 11px; border-radius:6px; font-size:11.5px; font-weight:600; border:1px solid; cursor:pointer; font-family:inherit; white-space:nowrap; background:transparent; text-decoration:none; }
.dlv-btn-generate { background:#E6F1FB; color:#0C447C; border-color:#B5D4F4; }
.dlv-btn-deliver  { background:#EAF3DE; color:#27500A; border-color:#C0DD97; }
.dlv-progress-wrap { padding:10px 20px 14px; border-top:1px solid #f0f2f5; display:flex; align-items:center; gap:10px; }
.dlv-progress-bar  { flex:1; height:6px; background:#f0f2f5; border-radius:99px; overflow:hidden; }
.dlv-progress-fill { height:100%; background:linear-gradient(90deg,#1a56e8,#0ea882); border-radius:99px; }
.dlv-progress-text { font-size:11px; color:#888; white-space:nowrap; }

.dlv-modal-overlay { display:none; position:fixed; inset:0; z-index:9998; background:rgba(0,0,0,.45); align-items:center; justify-content:center; padding:16px; }
.dlv-modal-overlay.open { display:flex; }
.dlv-modal-box { background:#fff; border-radius:12px; padding:24px; max-width:400px; width:100%; box-shadow:0 8px 32px rgba(0,0,0,.18); }
.dlv-modal-title { font-size:15px; font-weight:700; color:#111; margin-bottom:4px; }
.dlv-modal-sub   { font-size:12px; color:#6b7280; margin-bottom:16px; }
.dlv-modal-label { font-size:11.5px; font-weight:600; color:#444; margin-bottom:6px; display:block; }
.dlv-modal-input { width:100%; border:1.5px solid #e2e8f0; border-radius:8px; padding:9px 12px; font-size:13.5px; font-family:inherit; color:#111; transition:border-color .15s; }
.dlv-modal-input:focus { outline:none; border-color:#1a56e8; box-shadow:0 0 0 3px rgba(26,86,232,.1); }
.dlv-modal-input.is-err { border-color:#dc2626; }
.dlv-modal-err  { font-size:11.5px; color:#dc2626; margin-top:5px; display:none; }
.dlv-modal-err.show { display:block; }
.dlv-modal-btns { display:flex; gap:8px; justify-content:flex-end; margin-top:16px; }
.dlv-modal-cancel  { background:#f8f9fb; color:#374151; border:1px solid #e2e8f0; border-radius:7px; padding:7px 16px; font-size:13px; font-weight:500; cursor:pointer; font-family:inherit; }
.dlv-modal-confirm { background:linear-gradient(135deg,#0ea882,#0c9474); color:#fff; border:none; border-radius:7px; padding:7px 18px; font-size:13px; font-weight:600; cursor:pointer; font-family:inherit; }

@media(max-width:768px) { .pd-kpi { grid-template-columns:1fr 1fr; } .pd-header{padding:14px} .pd-actions{width:100%} .pd-actions .pd-btn{flex:1 1 auto;justify-content:center} .pd-kpi-cell{padding:12px 14px} .pd-kpi-cell:nth-child(2){border-right:none} }
@media(max-width:480px) { .pd-kpi { grid-template-columns:1fr; } }
</style>

<%
  const pd          = patientDetail[0];
  const isCancelled = pd.Status == 0;
  const initials    = (pd.Name||'').trim().split(' ').slice(0,2).map(w=>w[0]).join('').toUpperCase();

  // Derive overall test status from individual test statuses — no queue needed
  const allStatuses   = patientTestDetail.map(function(t){ return t.TestStatus || 'Pending'; });
  const overallStatus = (function(){
    if (allStatuses.length === 0)                                          return 'pending';
    if (allStatuses.every(function(s){ return s === 'Completed'; }))       return 'allDone';
    if (allStatuses.every(function(s){ return s === 'Aborted'; }))         return 'allAborted';
    if (allStatuses.some(function(s){ return s === 'InProgress'; }))       return 'inProgress';
    if (allStatuses.some(function(s){ return s === 'Completed' || s === 'Aborted'; })) return 'partial';
    if (allStatuses.some(function(s){ return s === 'Waiting'; }))          return 'waiting';
    return 'pending';
  })();

  const allTestsCompleted = allStatuses.every(function(s){ return s === 'Completed'; });
%>


<%# ══ HEADER CARD ══════════════════════════════════════════════════════════ %>
<div class="pd-card <%= isCancelled ? 'is-cancelled' : '' %>">

  <% if(isCancelled) { %>
  <div class="pd-cancelled-banner">
    <i class="bi bi-x-octagon-fill" style="color:#dc2626;font-size:22px;flex-shrink:0;"></i>
    <div style="flex:1;min-width:0;">
      <div style="font-size:13.5px;font-weight:800;color:#991b1b;letter-spacing:.05em;">PATIENT CANCELLED</div>
      <div style="font-size:11.5px;color:#b91c1c;margin-top:2px;display:flex;gap:12px;flex-wrap:wrap;">
        <% if(pd.CancelReason){ %><span><strong>Reason:</strong> <%= pd.CancelReason %></span><% } %>
        <% if(pd.CancelledAt){ %><span><%= new Date(pd.CancelledAt).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) %></span><% } %>
      </div>
    </div>
  </div>
  <% } %>

  <div class="pd-header">
    <div style="display:flex;align-items:center;gap:12px">
      <div class="pd-avatar"><%= initials %></div>
      <div>
        <div class="pd-name text-capitalize">
          <%= pd.Title %> <%= pd.Name %>
          <% if(isCancelled){ %>
            <span style="font-size:10.5px;background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;padding:2px 8px;border-radius:99px;font-weight:700;margin-left:6px;vertical-align:middle;">
              <i class="bi bi-x-circle-fill me-1" style="font-size:9px;"></i>CANCELLED
            </span>
          <% } %>
          <% if(isEmergency){ %>
            <span style="font-size:10.5px;background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;padding:2px 8px;border-radius:99px;font-weight:700;margin-left:6px;vertical-align:middle;">
              🚨 EMERGENCY
            </span>
          <% } %>
        </div>
        <div class="pd-meta">
          <span>
            <% if(pd.Gender == 1) { %><i class="bi bi-gender-male" style="color:#185FA5;font-size:13px"></i> Male
            <% } else { %><i class="bi bi-gender-female" style="color:#A32D2D;font-size:13px"></i> Female<% } %>
          </span>
          <span class="pd-sep">|</span>
          <span><%= pd.Age %> <%= pd.YMD %></span>
          <span class="pd-sep">|</span>
          <span><i class="bi bi-phone" style="color:#27500A;font-size:12px"></i> +91 <%= pd.PhoneNumber %></span>
        </div>
      </div>
    </div>

    <div class="pd-actions">
      <% if(!isCancelled) { %>
        <a href="/patient/editPatientDetails?id=<%= pd.Id %>" class="pd-btn pd-btn-edit">
          <i class="bi bi-pencil" style="font-size:11px"></i> Edit
        </a>
      <% } %>
      <a href="/patient/getPatientListView" class="pd-btn pd-btn-list">
        <i class="bi bi-list-ul" style="font-size:11px"></i> List
      </a>
      <a href="/patient/patientHistory?patientId=<%= patientId %>" class="pd-btn pd-btn-list">
        <i class="bi bi-clock-history"></i> View History
      </a>
      <a href="/patient/invoices/?id=<%= pd.Id %>" class="pd-btn pd-btn-list" target="_blank">
        <i class="bi bi-receipt" style="font-size:11px"></i> Invoice
      </a>

      <%# ── Overall test status — READ ONLY — technician manages this ── %>
      <% if(!isCancelled) { %>
        <% if(overallStatus === 'allDone') { %>
          <span class="pq-status-tag" style="background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0;">
            <i class="bi bi-check-circle-fill" style="font-size:10px"></i> All Tests Completed
          </span>
        <% } else if(overallStatus === 'allAborted') { %>
          <span class="pq-status-tag" style="background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;">
            <i class="bi bi-x-circle-fill" style="font-size:10px"></i> All Tests Aborted
          </span>
        <% } else if(overallStatus === 'inProgress') { %>
          <span class="pq-status-tag" style="background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;">
            <i class="bi bi-activity" style="font-size:10px"></i> In Progress
          </span>
        <% } else if(overallStatus === 'partial') { %>
          <span class="pq-status-tag" style="background:#fefce8;color:#854d0e;border:1px solid #fde68a;">
            <i class="bi bi-hourglass-split" style="font-size:10px"></i> Partially Done
          </span>
        <% } else if(overallStatus === 'waiting') { %>
          <span class="pq-status-tag" style="background:#f0f9ff;color:#0369a1;border:1px solid #bae6fd;">
            <i class="bi bi-hourglass" style="font-size:10px"></i> Waiting
          </span>
        <% } else { %>
          <span class="pq-status-tag" style="background:#f8f9fb;color:#6B7280;border:1px solid #e2e8f0;">
            <i class="bi bi-clock" style="font-size:10px"></i> Pending
          </span>
        <% } %>
      <% } %>
    </div>
  </div>

  <%- include("../partials/messages") %>

  <div class="pd-kpi">
    <div class="pd-kpi-cell">
      <div class="pd-kpi-label">Gross Amount</div>
      <div class="pd-kpi-val info">₹ <%= Number(pd.GrossAmount).toLocaleString('en-IN') %></div>
      <div class="pd-kpi-sub">Dr. <%= pd.DoctorFirstName %> <%= pd.DoctorLastName %><% if(pd.DoctorSpecialistIn) { %> · <%= pd.DoctorSpecialistIn %><% } %></div>
    </div>
    <div class="pd-kpi-cell">
      <div class="pd-kpi-label">Discount</div>
      <div class="pd-kpi-val muted">₹ <%= Number(pd.Discount).toLocaleString('en-IN') %></div>
      <div class="pd-kpi-sub"><% if(pd.DiscountApprovedBy) { %>By: <%= pd.DiscountApprovedBy %><% } else { %>—<% } %></div>
    </div>
    <div class="pd-kpi-cell">
      <div class="pd-kpi-label">Dues Amount</div>
      <div class="pd-kpi-val <%= pd.DuesAmount > 0 ? 'danger' : 'muted' %>">₹ <%= Number(pd.DuesAmount).toLocaleString('en-IN') %></div>
      <div class="pd-kpi-sub"><%= pd.DuesAmount > 0 ? 'Pending recovery' : 'Fully paid' %></div>
    </div>
    <div class="pd-kpi-cell">
      <div class="pd-kpi-label">Status</div>
      <div style="margin-top:4px">
        <% if(!isCancelled) { %>
          <span class="pd-pill pill-success"><i class="bi bi-check-circle" style="font-size:11px"></i> Active</span>
        <% } else { %>
          <span class="pd-pill pill-danger"><i class="bi bi-x-circle" style="font-size:11px"></i> Cancelled</span>
        <% } %>
      </div>
      <div class="pd-kpi-sub"><i class="bi bi-calendar3" style="font-size:10px"></i> <%= pd.RegisteredOn %></div>
    </div>
  </div>
</div>


<%# ══ TEST DETAILS CARD ════════════════════════════════════════════════════ %>
<div class="pd-card <%= isCancelled ? 'is-cancelled' : '' %>">
  <div class="pd-section-head">
    <span class="pd-section-title"><i class="bi bi-clipboard2-pulse"></i> Test Details</span>
    <div style="display:flex;align-items:center;gap:10px;">
      <span style="font-size:11px;color:var(--text-muted)"><%= patientTestDetail.length %> test<%= patientTestDetail.length!==1?'s':'' %></span>
      <% if(isCancelled) { %>
        <span style="font-size:11px;color:#dc2626;font-weight:600;display:flex;align-items:center;gap:4px;"><i class="bi bi-lock-fill"></i> Read only</span>
      <% } %>
    </div>
  </div>

  <% if(isCancelled) { %><fieldset disabled style="border:none;padding:0;margin:0;"><% } %>
  <form id="completeTestsForm" method="POST" action="/patient/markTestCompleted/<%= pd.Id %>">
    <div style="overflow-x:auto">
      <table class="pd-table">
        <thead>
          <tr>
            <th style="width:40px;text-align:center">
              <% if(!allTestsCompleted) { %>
                <input type="checkbox" id="selectAll" class="form-check-input" style="width:14px;height:14px;cursor:pointer;accent-color:#185FA5">
              <% } %>
            </th>
            <th>Test Name</th>
            <th>Added On</th>
            <th>Reporting Time</th>
            <th>Room</th>
            <th>Test Status</th>
            <th>Actions</th>
            <th style="width:70px;text-align:center">Report</th>
          </tr>
        </thead>
        <tbody>
          <% patientTestDetail.forEach(function(t) { %>
          <%
            // Status config — maps new TestStatus values + legacy 'Incomplete'
            var tsMap = {
              Pending:    { cls:'pill-gray',    icon:'bi-clock',        label:'Pending' },
              Waiting:    { cls:'pill-warn',    icon:'bi-hourglass',    label:'Waiting' },
              InProgress: { cls:'pill-info',    icon:'bi-play-circle',  label:'In Progress' },
              Completed:  { cls:'pill-success', icon:'bi-check-circle', label:'Completed' },
              Aborted:    { cls:'pill-danger',  icon:'bi-x-circle',     label:'Aborted' },
              Incomplete: { cls:'pill-warn',    icon:'bi-clock',        label:'Pending' }
            };
            var ts = tsMap[t.TestStatus] || tsMap['Pending'];
            var isDone = t.TestStatus === 'Completed';
          %>
          <tr>
            <td style="text-align:center">
              <% if(!isDone) { %>
                <input type="checkbox" name="selectedTests[]" value="<%= t.TestId %>"
                  class="form-check-input test-checkbox"
                  style="width:14px;height:14px;cursor:pointer;accent-color:#185FA5">
              <% } else { %>
                <span class="pd-pill pill-success" style="font-size:10px">Done</span>
              <% } %>
            </td>

            <td style="font-weight:600;text-transform:uppercase;font-size:12px">
              <%= t.TestName %>
              <% if(t.subTests && t.subTests.length) { %>
                <span class="pd-pill pill-info" style="font-size:10px;margin-left:4px;">
                  <%= t.subTests.length %> sub-test<%= t.subTests.length>1?'s':'' %>
                </span>
              <% } %>
            </td>

            <td style="color:var(--text-secondary)"><%= pd.RegisteredOn %></td>
            <td style="color:var(--text-secondary)"><%= t.ReportingTime %></td>

            <%# Room — shows which physical room this test belongs to %>
            <td style="font-size:12px;color:var(--text-secondary)">
              <% if(t.RoomName) { %>
                <span style="display:inline-flex;align-items:center;gap:4px;">
                  <i class="bi bi-display" style="font-size:10px;color:#185FA5"></i>
                  <%= t.RoomName %>
                </span>
              <% } else { %>
                <span style="color:var(--text-muted)">—</span>
              <% } %>
            </td>

            <%# Test status — read only, updated by technician %>
            <td>
              <span class="pd-pill <%= ts.cls %>">
                <i class="bi <%= ts.icon %>" style="font-size:10px"></i> <%= ts.label %>
              </span>
              <% if(t.StatusNote) { %>
                <br><small class="text-muted" style="font-size:10.5px" title="<%= t.StatusNote %>">
                  <i class="bi bi-info-circle"></i>
                  <%= t.StatusNote.length > 35 ? t.StatusNote.substring(0,35) + '...' : t.StatusNote %>
                </small>
              <% } %>
            </td>

            <td>
              <% if(t.IsReportRequired && !isCancelled) { %>
                <%
                  // Pathology bridge: Category "Pathology" (CategoryId = 2) goes to the
                  // specimen-first pathology flow. The /pathology/go route resolves the
                  // PatientTestRefference and sends the user to accept-specimen / result
                  // entry / verify depending on where this test currently is.
                  var __isPatho = (t.CategoryId != null && Number(t.CategoryId) === 2)
                    || (t.categoryName && String(t.categoryName).toLowerCase() === 'pathology');
                %>
                <% if(__isPatho) { %>
                  <%
                    var _sst = (t.SpecimenStatus || '').toString().toLowerCase();
                    var _rst = (t.PathoReportStatus || '').toString().toLowerCase();
                  %>
                  <% if(_sst === 'rejected') { %>
                    <%# Bug 3: specimen rejected -> show reason, no Report button, offer recollect %>
                    <span class="pd-icon-btn ib-red" style="cursor:default" title="<%= t.SpecimenRejectionReason || 'Specimen rejected' %>">
                      <i class="bi bi-x-octagon" style="font-size:11px"></i> Rejected<%= t.SpecimenRejectionReason ? (' · ' + t.SpecimenRejectionReason) : '' %>
                    </span>
                    <a href="/pathology/go?patientId=<%= patientId %>&testId=<%= t.TestId %>" class="pd-icon-btn ib-gray">
                      <i class="bi bi-arrow-repeat" style="font-size:11px"></i> Recollect
                    </a>
                  <% } else if(['approved','delivered'].includes(_rst)) { %>
                    <%# Bug 2: pathology report is ready -> download its PDF (pathology route) %>
                    <a href="/pathology/reports/<%= t.PathoReportId %>/pdf" class="pd-icon-btn ib-gray" target="_blank">
                      <i class="bi bi-file-earmark-pdf" style="font-size:11px;color:#A32D2D"></i> PDF
                    </a>
                    <a href="/pathology/go?patientId=<%= patientId %>&testId=<%= t.TestId %>" class="pd-icon-btn ib-blue">
                      <i class="bi bi-eye" style="font-size:11px"></i> View
                    </a>
                  <% } else { %>
                    <a href="/pathology/go?patientId=<%= patientId %>&testId=<%= t.TestId %>" class="pd-icon-btn ib-blue">
                      <i class="bi bi-pencil" style="font-size:11px"></i> Report
                    </a>
                  <% } %>
                <% } else { %>
                  <a href="/report/createReport?patientId=<%= patientId %>&testId=<%= t.TestId %>" class="pd-icon-btn ib-blue">
                    <i class="bi bi-pencil" style="font-size:11px"></i> Report
                  </a>
                  <% if(t.ReportReady) { %>
                    <a href="/report/downloadPdf?patientId=<%= patientId %>&testId=<%= t.TestId %>" class="pd-icon-btn ib-gray" target="_blank">
                      <i class="bi bi-file-earmark-pdf" style="font-size:11px;color:#A32D2D"></i> PDF
                    </a>
                    <a href="/report/downloadDoc?patientId=<%= patientId %>&testId=<%= t.TestId %>&header=false" class="pd-icon-btn ib-gray" target="_blank">
                      <i class="bi bi-file-earmark-word" style="font-size:11px;color:#0C447C"></i> Word
                    </a>
                    <a href="/report/generateLinkForReportDownload?patientId=<%= patientId %>&testId=<%= t.TestId %>&header=false" class="pd-icon-btn ib-red">
                      <i class="bi bi-box-arrow-up-right" style="font-size:11px"></i> Link
                    </a>
                  <% } %>
                <% } %>
              <% } else if(isCancelled) { %>
                <span style="font-size:11px;color:var(--text-muted)">—</span>
              <% } %>
            </td>

            <td style="text-align:center">
              <% if(t.ReportReady && !isCancelled) { %>
                <span class="pd-check-yes"><i class="bi bi-check-lg"></i></span>
              <% } else if(!t.ReportReady && !isCancelled) { %>
                <span class="pd-check-no"><i class="bi bi-x-lg"></i></span>
              <% } else { %>
                <span style="color:var(--text-muted)">—</span>
              <% } %>
            </td>
          </tr>

          <%# Sub-tests %>
          <% if(t.subTests && t.subTests.length) { %>
            <% t.subTests.forEach(function(s) { %>
            <tr style="background:#f8fafc;">
              <td></td>
              <td style="font-size:11.5px;color:var(--text-secondary);padding-left:28px;">
                <span style="color:var(--text-muted);margin-right:5px;">↳</span><%= s.SubTestName %>
              </td>
              <td style="font-size:11.5px;color:var(--text-secondary);">₹<%= Number(s.Price).toLocaleString('en-IN') %></td>
              <td colspan="5" style="font-size:11px;color:var(--text-muted);">Sub-test</td>
            </tr>
            <% }) %>
          <% } %>

          <% }) %>
        </tbody>
      </table>
    </div>

    <% if(!isCancelled && !allTestsCompleted) { %>
      <button type="button" id="completeBtn" class="pd-complete-btn">
        <i class="bi bi-check2-circle"></i> Complete Selected
      </button>
    <% } %>
  </form>
  <% if(isCancelled) { %></fieldset><% } %>
</div>


<%# ══ DELIVERABLES CARD ════════════════════════════════════════════════════ %>
<div class="pd-card <%= isCancelled ? 'is-cancelled' : '' %>">
  <div class="pd-section-head">
    <span class="pd-section-title"><i class="bi bi-box-seam"></i> Patient Deliverables</span>
    <% if(isCancelled) { %>
      <span style="font-size:11px;color:#dc2626;font-weight:600;display:flex;align-items:center;gap:4px;"><i class="bi bi-lock-fill"></i> Read only</span>
    <% } %>
  </div>

  <% if(isCancelled) { %><fieldset disabled style="border:none;padding:0;margin:0;"><% } %>

  <%
    var totalComponents = 0, doneComponents = 0;
    testList.forEach(function(test) {
      test.Components.forEach(function(c) {
        totalComponents++;
        if(c.IsDelivered) doneComponents++;
      });
    });
    var progressPct = totalComponents > 0 ? Math.round((doneComponents/totalComponents)*100) : 0;
  %>

  <div style="overflow-x:auto">
    <table class="dlv-table">
      <thead>
        <tr><th>Test</th><th>Type</th><th>Generated</th><th>Delivered</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% testList.forEach(function(test) { %>
          <% test.Components.forEach(function(c, idx) { %>
          <tr>
            <% if(idx === 0) { %>
              <td rowspan="<%= test.Components.length %>" style="font-weight:600;vertical-align:middle;font-size:12px;text-transform:uppercase"><%= test.TestName %></td>
            <% } %>
            <td>
              <span class="dlv-type <%= c.ComponentType === 'Film' ? 'dlv-type-film' : 'dlv-type-report' %>">
                <i class="bi <%= c.ComponentType === 'Film' ? 'bi-film' : 'bi-file-earmark-text' %>" style="font-size:10px"></i>
                <%= c.ComponentType %>
              </span>
            </td>
            <td>
              <% if(c.IsGenerated) { %>
                <span class="dlv-state dlv-done"><i class="bi bi-check-circle-fill" style="font-size:10px"></i> Done</span>
                <div class="dlv-by"><%= c.GeneratedOnFormatted %><% if(c.GeneratedByName){ %> · <%= c.GeneratedByName %><% } %></div>
              <% } else { %>
                <span class="dlv-state dlv-pending"><i class="bi bi-hourglass" style="font-size:10px"></i> Pending</span>
              <% } %>
            </td>
            <td>
              <% if(c.IsDelivered) { %>
                <span class="dlv-state dlv-done"><i class="bi bi-check-circle-fill" style="font-size:10px"></i> Done</span>
                <div class="dlv-by">
                  <%= c.DeliveredOnFormatted %>
                  <% if(c.DeliveredTo){ %> · To: <strong><%= c.DeliveredTo %></strong><% } %>
                  <% if(c.DeliveredByName){ %> · by <%= c.DeliveredByName %><% } %>
                </div>
              <% } else if(c.IsGenerated) { %>
                <span class="dlv-state dlv-pending"><i class="bi bi-clock" style="font-size:10px"></i> Not delivered</span>
              <% } else { %>
                <span style="color:#aaa;font-size:11px">—</span>
              <% } %>
            </td>
            <td>
              <% if(!isCancelled) { %>
                <% if(c.ComponentType === 'Film') { %>
                  <% if(!c.IsGenerated) { %>
                    <form action="/patient/markGenerated" method="POST" class="d-inline">
                      <input type="hidden" name="patientTestRefId" value="<%= c.PatientTestRefId %>">
                      <input type="hidden" name="componentType"    value="Film">
                      <input type="hidden" name="patientId"        value="<%= patientId %>">
                      <button type="submit" class="dlv-btn dlv-btn-generate"><i class="bi bi-film" style="font-size:10px"></i> Mark Film Generated</button>
                    </form>
                  <% } else if(!c.IsDelivered) { %>
                    <button type="button" class="dlv-btn dlv-btn-deliver"
                      data-deliver data-ref="<%= c.PatientTestRefId %>" data-type="Film" data-pid="<%= patientId %>" data-name="<%= test.TestName %>">
                      <i class="bi bi-box-arrow-up-right" style="font-size:10px"></i> Mark Film Delivered
                    </button>
                  <% } else { %>
                    <span style="font-size:11px;color:#27500A;font-weight:500"><i class="bi bi-check2-all"></i> Complete</span>
                  <% } %>
                <% } else { %>
                  <% if(!c.IsGenerated) { %>
                    <a href="/report/createReport?patientId=<%= patientId %>&testId=<%= test.TestId %>" class="dlv-btn dlv-btn-generate">
                      <i class="bi bi-pencil" style="font-size:10px"></i> Create Report
                    </a>
                  <% } else if(!c.IsDelivered) { %>
                    <div style="display:flex;gap:5px;flex-wrap:wrap;">
                      <% if(test.ReportReady) { %>
                        <a href="/report/downloadReportAsPdf?patientId=<%= patientId %>&testId=<%= test.TestId %>" class="dlv-btn" style="background:#f0f4ff;color:#1a56e8;border-color:#c3d4fc;" target="_blank"><i class="bi bi-file-earmark-pdf" style="font-size:10px;color:#A32D2D"></i> PDF</a>
                        <a href="/report/downloadReportAsDoc?patientId=<%= patientId %>&testId=<%= test.TestId %>&header=false" class="dlv-btn" style="background:#f0f4ff;color:#1a56e8;border-color:#c3d4fc;" target="_blank"><i class="bi bi-file-earmark-word" style="font-size:10px;color:#0C447C"></i> Word</a>
                      <% } %>
                      <button type="button" class="dlv-btn dlv-btn-deliver"
                        data-deliver data-ref="<%= c.PatientTestRefId %>" data-type="Report" data-pid="<%= patientId %>" data-name="<%= test.TestName %>">
                        <i class="bi bi-hand-thumbs-up" style="font-size:10px"></i> Mark Report Delivered
                      </button>
                    </div>
                  <% } else { %>
                    <div style="display:flex;gap:5px;align-items:center;">
                      <span style="font-size:11px;color:#27500A;font-weight:500"><i class="bi bi-check2-all"></i> Complete</span>
                      <% if(test.ReportReady) { %>
                        <a href="/report/downloadReportAsPdf?patientId=<%= patientId %>&testId=<%= test.TestId %>" class="dlv-btn" style="background:#f8f9fb;color:#888;border-color:#e2e8f0;font-size:10.5px;" target="_blank">
                          <i class="bi bi-file-earmark-pdf" style="font-size:9px;color:#A32D2D"></i> PDF
                        </a>
                      <% } %>
                    </div>
                  <% } %>
                <% } %>
              <% } else { %>
                <span style="font-size:11px;color:var(--text-muted)">—</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="dlv-progress-wrap">
    <div class="dlv-progress-bar"><div class="dlv-progress-fill" style="width:<%= progressPct %>%"></div></div>
    <div class="dlv-progress-text"><%= doneComponents %>/<%= totalComponents %> delivered (<%= progressPct %>%)</div>
  </div>

  <% if(isCancelled) { %></fieldset><% } %>
</div>


<%# ══ THANKS CARD ══════════════════════════════════════════════════════════
    New entry → form. Saved entry → summary with Edit / Remove (both need a reason, both audited). %>
<% if(!isCancelled) {
     var hasThanks = !!pd.ThanksGivenTo;
     var maxThanks = Number(pd.ActualAmount) || 999999;
%>
<div class="pd-card" id="thanksCard">
  <div class="pd-section-head">
    <span class="pd-section-title">
      <i class="bi <%= hasThanks ? 'bi-heart-fill' : 'bi-heart' %>" style="<%= hasThanks ? 'color:#A32D2D;font-size:12px' : '' %>"></i> Thanks Details
    </span>
    <% if (hasThanks) { %>
      <div class="d-flex gap-2">
        <button type="button" class="pd-icon-btn ib-blue" id="thanksEditBtn" aria-expanded="false" aria-controls="thanksForm">
          <i class="bi bi-pencil" style="font-size:11px"></i> Edit
        </button>
        <button type="button" class="pd-icon-btn ib-red" data-bs-toggle="modal" data-bs-target="#thanksRemoveModal">
          <i class="bi bi-trash3" style="font-size:11px"></i> Remove
        </button>
      </div>
    <% } %>
  </div>

  <% if (hasThanks) { %>
    <div style="overflow-x:auto" id="thanksView">
      <table class="pd-table">
        <thead><tr><th>Name</th><th>Mobile</th><th>Amount</th><th>Asked by</th><th>Date</th></tr></thead>
        <tbody>
          <tr>
            <td class="text-capitalize" style="font-weight:600"><%= pd.ThanksGivenTo %></td>
            <td><%= pd.ThanksGivenToMobile %></td>
            <td style="font-family:'DM Mono',monospace;font-weight:600">₹ <%= Number(pd.ThanksAmount).toLocaleString('en-IN') %></td>
            <td class="text-capitalize"><% if (pd.ThanksRequestedBy) { %><%= pd.ThanksRequestedBy %><% } else { %><span style="color:var(--text-muted)">Not recorded</span><% } %></td>
            <td style="color:var(--text-secondary)"><%= pd.ThanksGivenOn ? new Date(pd.ThanksGivenOn).toLocaleDateString('en-GB').replace(/\//g,'-') : '—' %></td>
          </tr>
        </tbody>
      </table>
    </div>
  <% } %>

  <form action="/patient/thanks/?patientId=<%= pd.Id %>" method="post" id="thanksForm" novalidate
        class="<%= hasThanks ? 'd-none' : '' %>" style="padding:20px">
    <input type="hidden" name="thanksAction" value="save">
    <% if (hasThanks) { %>
      <div class="small mb-3 p-2 px-3 rounded-3" style="background:#FAEEDA;color:#633806">
        <i class="bi bi-pencil-square me-1"></i>Editing the saved thanks. The change and your reason are kept in the patient history.
      </div>
    <% } %>
    <div class="row g-3">
      <div class="col-md-3">
        <label class="field-label" for="thGivenTo">Thanks given to</label>
        <input type="text" class="form-control" id="thGivenTo" name="thanksGivenTo" placeholder="Person name"
               value="<%= pd.ThanksGivenTo || '' %>" minlength="2" maxlength="100" required>
        <div class="invalid-feedback">Enter the name</div>
      </div>
      <div class="col-md-2">
        <label class="field-label" for="thMobile">Mobile number</label>
        <input type="tel" class="form-control" id="thMobile" name="thanksPaidMobile" placeholder="10-digit mobile"
               value="<%= pd.ThanksGivenToMobile || '' %>" inputmode="numeric" maxlength="10" pattern="[6-9][0-9]{9}" required>
        <div class="invalid-feedback">Enter a valid 10-digit mobile</div>
      </div>
      <div class="col-md-2">
        <label class="field-label" for="thAmount">Amount (₹)</label>
        <input type="number" class="form-control" id="thAmount" name="thanksAmount" placeholder="Amount"
               value="<%= hasThanks ? Number(pd.ThanksAmount) : '' %>" min="1" max="<%= maxThanks %>" step="1" inputmode="decimal" required>
        <div class="invalid-feedback">Enter an amount from ₹1 to ₹<%= maxThanks.toLocaleString('en-IN') %></div>
      </div>
      <div class="col-md-<%= hasThanks ? 2 : 3 %>">
        <label class="field-label" for="thAskedBy">Asked by (our person)</label>
        <input type="text" class="form-control" id="thAskedBy" name="thanksRequestedBy" list="thAskedByList"
               placeholder="MR / staff who told us to pay" autocomplete="off"
               value="<%= pd.ThanksRequestedBy || '' %>" minlength="2" maxlength="100" required>
        <datalist id="thAskedByList">
          <% (locals.thanksRequesters || []).forEach(function(n){ %><option value="<%= n %>"></option><% }) %>
        </datalist>
        <div class="invalid-feedback">Enter who asked us to pay this thanks</div>
      </div>
      <% if (hasThanks) { %>
        <div class="col-md-3">
          <label class="field-label" for="thReason">Reason for change</label>
          <input type="text" class="form-control" id="thReason" name="thanksChangeReason" placeholder="e.g. wrong amount entered"
                 minlength="3" maxlength="200" required>
          <div class="invalid-feedback">Write why you are changing it</div>
        </div>
        <div class="col-12 d-flex justify-content-end gap-2">
          <button type="button" class="btn btn-light border btn-sm" id="thanksCancelEdit">Cancel</button>
          <button type="submit" class="pd-complete-btn" style="margin:0"><i class="bi bi-check2"></i> Save changes</button>
        </div>
      <% } else { %>
        <div class="col-md-2 d-flex align-items-end">
          <button type="submit" class="pd-complete-btn" style="margin:0;width:100%;justify-content:center">
            <i class="bi bi-check2"></i> Submit Thanks
          </button>
        </div>
      <% } %>
    </div>
  </form>
</div>

<% if (hasThanks) { %>
<div class="modal fade" id="thanksRemoveModal" tabindex="-1" aria-labelledby="thanksRemoveTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
    <div class="modal-content" style="border:none;border-radius:14px">
      <form action="/patient/thanks/?patientId=<%= pd.Id %>" method="post" id="thanksRemoveForm" novalidate>
        <div class="modal-body p-4">
          <h5 class="fw-bold mb-1" id="thanksRemoveTitle" style="font-size:15px"><i class="bi bi-trash3 text-danger me-1"></i>Remove thanks entry?</h5>
          <p class="small text-secondary mb-3">₹<%= Number(pd.ThanksAmount).toLocaleString('en-IN') %> to <span class="text-capitalize"><%= pd.ThanksGivenTo %></span> will be removed. The old entry stays in the patient history.</p>
          <input type="hidden" name="thanksAction" value="remove">
          <label class="field-label" for="thRemoveReason">Reason</label>
          <input type="text" class="form-control" id="thRemoveReason" name="thanksChangeReason" minlength="3" maxlength="200" required placeholder="e.g. entered on the wrong patient">
          <div class="invalid-feedback">Write why you are removing it</div>
          <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-light border btn-sm" data-bs-dismiss="modal">Keep</button>
            <button type="submit" class="btn btn-danger btn-sm fw-semibold">Remove</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>
<% } %>


<%# ══ BOOTSTRAP MODALS ═════════════════════════════════════════════════════ %>
<div class="modal fade" id="warningModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:none;border-radius:12px;overflow:hidden">
      <div class="modal-header" style="background:#FAEEDA">
        <h5 class="modal-title fw-bold" style="color:#633806;font-size:14px"><i class="bi bi-exclamation-triangle-fill me-2"></i> Warning</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" style="font-size:14px;padding:20px">Please select at least one test before completing.</div>
      <div class="modal-footer" style="border-top:1px solid var(--border)">
        <button type="button" class="btn btn-dark btn-sm" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="completeConfirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border:none;border-radius:12px;overflow:hidden">
      <div class="modal-header" style="background:#EAF3DE">
        <h5 class="modal-title fw-bold" style="color:#27500A;font-size:14px"><i class="bi bi-check-circle-fill me-2"></i> Confirm Completion</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" style="font-size:14px;padding:20px">
        Mark selected tests as <span class="fw-bold" style="color:#27500A">completed</span>?
      </div>
      <div class="modal-footer" style="border-top:1px solid var(--border)">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="confirmComplete" class="btn btn-success btn-sm">Yes, Complete</button>
      </div>
    </div>
  </div>
</div>


<%# ══ DELIVER MODAL ════════════════════════════════════════════════════════ %>
<div class="dlv-modal-overlay" id="dlvModal">
  <div class="dlv-modal-box">
    <div class="dlv-modal-title" id="dlvModalTitle">Mark as Delivered</div>
    <div class="dlv-modal-sub"  id="dlvModalSub">Enter the name of the person collecting</div>
    <form action="/patient/markDelivered" method="POST" id="dlvDeliverForm">
      <input type="hidden" name="patientTestRefId" id="dlvRefId">
      <input type="hidden" name="componentType"    id="dlvType">
      <input type="hidden" name="patientId"        id="dlvPatientId">
      <label class="dlv-modal-label" for="dlvDeliveredTo">Collected by <span style="color:#dc2626">*</span></label>
      <input type="text" class="dlv-modal-input" id="dlvDeliveredTo" name="deliveredTo"
             placeholder="e.g. Patient self, Rahul (son), Courier">
      <div class="dlv-modal-err" id="dlvDeliveredToErr">Please enter the name of the person collecting.</div>
      <div class="dlv-modal-btns">
        <button type="button" class="dlv-modal-cancel" onclick="closeDlvModal()">Cancel</button>
        <button type="submit" class="dlv-modal-confirm"><i class="bi bi-check2"></i> Confirm Delivery</button>
      </div>
    </form>
  </div>
</div>


<script>
// ── Select all ────────────────────────────────────────────────────
document.getElementById('selectAll')?.addEventListener('change', function() {
  document.querySelectorAll('.test-checkbox').forEach(cb => cb.checked = this.checked);
});

// ── Complete selected ─────────────────────────────────────────────
document.getElementById('completeBtn')?.addEventListener('click', function() {
  if (!document.querySelectorAll('.test-checkbox:checked').length) {
    new bootstrap.Modal(document.getElementById('warningModal')).show();
    return;
  }
  new bootstrap.Modal(document.getElementById('completeConfirmModal')).show();
});
document.getElementById('confirmComplete')?.addEventListener('click', function() {
  bootstrap.Modal.getInstance(document.getElementById('completeConfirmModal'))?.hide();
  document.getElementById('completeTestsForm').submit();
});

// ── Deliver buttons (data attributes → safe with any test name) ──
document.querySelectorAll('[data-deliver]').forEach(function (b) {
  b.addEventListener('click', function () { openDeliverModal(b.dataset.ref, b.dataset.type, b.dataset.pid, b.dataset.name); });
});

// ── Thanks: validation, edit toggle, no double submit ──
(function () {
  var form = document.getElementById('thanksForm');
  if (!form) return;
  var view = document.getElementById('thanksView');
  var editBtn = document.getElementById('thanksEditBtn');
  var initial = Array.prototype.map.call(form.elements, function (el) { return el.value; });
  function showEdit(on) {
    form.classList.toggle('d-none', !on);
    if (view) view.classList.toggle('d-none', on);
    if (editBtn) editBtn.setAttribute('aria-expanded', on);
    if (on) { var f = document.getElementById('thAmount'); if (f) f.focus(); }
    else { Array.prototype.forEach.call(form.elements, function (el, i) { el.value = initial[i]; }); form.classList.remove('was-validated'); }
  }
  if (editBtn) editBtn.addEventListener('click', function () { showEdit(form.classList.contains('d-none')); });
  var cancel = document.getElementById('thanksCancelEdit');
  if (cancel) cancel.addEventListener('click', function () { showEdit(false); });
  // server sent us back with an error → reopen the form so the user can fix it
  if (view && document.querySelector('.alert-danger')) showEdit(true);

  [form, document.getElementById('thanksRemoveForm')].forEach(function (f) {
    if (!f) return;
    f.addEventListener('submit', function (e) {
      Array.prototype.forEach.call(f.querySelectorAll('input[type=text]'), function (el) { el.value = el.value.trim(); });
      if (!f.checkValidity()) { e.preventDefault(); e.stopPropagation(); f.classList.add('was-validated'); return; }
      var btn = f.querySelector('button[type=submit]'); if (btn) btn.disabled = true;
    });
  });
})();


// ── Deliver modal ─────────────────────────────────────────────────
function openDeliverModal(refId, type, patientId, testName) {
  document.getElementById('dlvRefId').value       = refId;
  document.getElementById('dlvType').value        = type;
  document.getElementById('dlvPatientId').value   = patientId;
  document.getElementById('dlvDeliveredTo').value = '';
  document.getElementById('dlvDeliveredTo').classList.remove('is-err');
  document.getElementById('dlvDeliveredToErr').classList.remove('show');
  document.getElementById('dlvModalTitle').textContent = 'Mark ' + type + ' Delivered';
  document.getElementById('dlvModalSub').textContent   = (type === 'Film' ? '🎞️' : '📋') + ' ' + testName;
  document.getElementById('dlvModal').classList.add('open');
  setTimeout(() => document.getElementById('dlvDeliveredTo').focus(), 80);
}
function closeDlvModal() {
  document.getElementById('dlvModal').classList.remove('open');
}
document.getElementById('dlvModal')?.addEventListener('click', function(e) {
  if (e.target === this) closeDlvModal();
});
document.getElementById('dlvDeliverForm')?.addEventListener('submit', function(e) {
  const inp = document.getElementById('dlvDeliveredTo');
  const err = document.getElementById('dlvDeliveredToErr');
  if (!inp.value.trim()) {
    e.preventDefault();
    inp.classList.add('is-err');
    err.classList.add('show');
    inp.focus();
  }
});
document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeDlvModal(); });
document.getElementById('dlvDeliveredTo')?.addEventListener('input', function() {
  this.classList.remove('is-err');
  document.getElementById('dlvDeliveredToErr').classList.remove('show');
});
</script>
